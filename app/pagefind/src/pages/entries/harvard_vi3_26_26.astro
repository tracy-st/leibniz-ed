---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi3_26",
  "series": "Band VI 3 (1672-1676); durchgesehener Nachdruck 1980",
  "seq": 26,
  "text": "[[364.26]] <b>26. Epistolae tres D. B. de Spinoza ad D. Oldenburgium </b> <span>364.0;0:63:026:76?      :E:l^</span>.\n[[364.16]] Epistolae tres D.B. de Spinoza ad D. Oldenburgium.\n[[364.17]] Video tandem quid id fuerit, quod a me postulabas ne evulgarem.\n[[364.18]] Sed quia id ipsum praecipuum fundamentum est eorum omnium, quae in tractatu\n[[364.19]] quem edere destinaveram habentur, volo hic paucis explicare qua ratione ego fatalem\n[[364.20]] omnium rerum et actionum necessitatem statuam. Nam Deum nullo modo fato subjicio,\n[[364.21]] sed omnia inevitabili necessitate ex Dei natura sequi concipio, eodem modo, quo\n[[364.22]] omnes concipiunt quod ex ipsius Dei natura sequatur, ut Deus se ipsum intelligat,\n[[364.23]] quod sane nemo negat ex divina natura necessario sequi; et tamen nemo concipit, quod Deus\n[[364.24]] fato aliquo coactus, sed quod omnino libere, tametsi necessario, se ipsum intelligat.\n[[364.25]] Deinde haec inevitabilis rerum necessitas nec jura divina, nec humana tollit.\n[[364.26]] Nam ipsa moralia documenta sive formam Legis cujusvis ab ipso Deo accipiant sive\n[[364.27]] non, divina tamen sunt ac salutaria, et si bonum quod ex virtute et amore divino\n[[364.28]] sequitur, a Deo tanquam judice accipiamus, vel quod ex necessitate divinae naturae\n[[365.1]] emanet, non erit propterea magis vel minus optabile, ut nec contra mala quae ex\n[[365.2]] pravis actionibus et affectibus sequuntur, ideo quia necessario ex iisdem sequuntur,\n[[365.3]] minus timenda sunt; et denique sive ea quae agimus necessario, sive contingenter\n[[365.4]] agamus, spe tamen ac metu ducimur.\n[[365.5]] Porro homines coram Deo nulla alia de causa sunt inexcusabiles quam quia in\n[[365.6]] ipsius Dei potestate sunt ut lutum in potestate figuli, qui ex eadem massa vasa facit\n[[365.7]] alia ad decus, alia ad dedecus. Ad haec pauca si aliquantulum attendere velis, non\n[[365.8]] dubito quin facili negotio ad omnia argumenta quae in hanc sententiam objici solent,\n[[365.9]] respondere possis, ut multi jam mecum experti sunt.\n[[365.10]] Miracula et ignorantiam pro aequipollentibus sumsi, quia ii qui Dei existentiam\n[[365.11]] et religionem miraculis astruere conantur, rem obscuram per aliam magis obscuram,\n[[365.12]] et quam maxime ignorant, ostendere volunt, atque ita novum argumentandi genus\n[[365.13]] afferunt, redigendo scilicet; non ad impossibile, ut ajunt, sed ad ignorantiam. Caeterum\n[[365.14]] meam de miraculis sententiam satis opinor explicui in tractatu theologico--\n[[365.15]] politico. Hoc tantum hic addo, quod si ad haec attendas, quod scilicet Christus nec\n[[365.16]] Senatui, nec Pilato, nec cuiquam infidelium, sed Sanctis tantummodo apparuerit, et\n[[365.17]] quod Deus neque dextram neque sinistram habeat, nec in loco sed ubique secundum\n[[365.18]] Essentiam sit, et quod materia ubique sit eadem, et quod Deus extra Mundum, in\n[[366.1]] spatio quod fingunt; imaginario sese non manifestet; et quod denique corporis humani\n[[366.2]] compages intra debitos limites solo aëris pondere coerceatur, facile videbis\n[[366.3]] hanc Christi apparitionem non absimilem esse ab illa qua Deus Abrahamo apparuit,\n[[366.4]] quando tres vidit homines, quos ad secum prandendum invitavit. At dices, Apostolos\n[[366.5]] omnino credidisse quod Christus a morte resurrexerit, et ad coelum revera\n[[366.6]] ascenderit; quod ego non nego. Nam ipse etiam Abrahamus credidit quod Deus apud\n[[366.7]] ipsum pransus fuerit, et omnes Israëlitae, quod Deus ex coelo igne circumductus ad\n[[366.8]] montem Sinai descenderit et cum ipsis immediate locutus fuerit, cum tamen haec\n[[366.9]] pluresque aliae ejusmodi apparitiones seu revelationes fuerint captui et opinionibus\n[[366.10]] eorum hominum accommodatae, quibus Deus mentem suam iisdem revelare voluit.\n[[366.11]] Concludo itaque Christi a mortuis resurrectionem revera spiritualem, et solis fidelibus\n[[366.12]] ad eorum captum revelatam fuisse, nempe quod Christus aeternitate donatus\n[[366.13]] fuerit, et a mortuis (mortuos hic intelligo, eo sensu quo Christus dixit, sinite mortuos,\n[[366.14]] mortuos suos sepelire) surrexit, simulatque vita ac morte singularis sanctitatis exemplum\n[[366.15]] dedit, et eatenus discipulos suos a morte suscitat, quatenus ipsi hoc eius vitae et\n[[366.16]] mortis exemplum sequuntur. Nec difficile esset totam Evangelii doctrinam secundum\n[[366.17]] hanc hypothesin explicare. Imo caput 15. Epist. 1. ad Corinth. ex sola hac\n[[367.1]] hypothesi explicari potest, et Pauli argumenta intelligi, cum alias communem hypothesin\n[[367.2]] sequendo infirma appareant, et facili negotio refelli possint. Ut taceam,\n[[367.3]] quod Christiani omnia, quae Judaei Carnaliter, Spiritualiter interpretati sunt. Humanam\n[[367.4]] imbecillitatem tecum agnosco. Sed te contra rogare mihi liceat, an nos homunciones\n[[367.5]] tantam naturae cognitionem habeamus ut determinare possimus, quousque\n[[367.6]] eius vis et potentia se extendat, et quid ejusdem vim superet? Quod quia nemo\n[[367.7]] sine arrogantia praesumere potest, licet ergo, absque jactantia, miracula per causas\n[[367.8]] naturales quantum fieri potest explicare; et quae explicare non possumus, nec etiam\n[[367.9]] demonstrare quod absurda sint, satius erit de iisdem judicium suspendere, et religionem\n[[367.10]] ut dixi sola doctrinae sapientia astruere.  Loca denique Evangelii Iohannis, et\n[[367.11]] Epistolae ad Hebraeos, iis quae dixi repugnare credis, quia linguarum Orientalium\n[[367.12]] phrases Europaeis loquendi modis metiris; et quamvis Iohannes suum Evangelium\n[[367.13]] Graece scripserit, Hebraizat tamen. Quicquid sit, an credis, quando scriptura ait quod\n[[367.14]] Deus in nube sese manifestaverit, aut quod in Tabernaculo et in templo habitaverit,\n[[367.15]] quod ipse Deus naturam tabernaculi aut templi sumserit? atqui hoc summum est,\n[[367.16]] quod Christus de se ipso dixerit, se scilicet templum Dei esse; nimirum, quia, ut in\n[[367.17]] praecedentibus meis dixi, Deus sese maxime in Christo manifestavit, quod Johannes\n[[367.18]] ut efficacius exprimeret, dixit, verbum factum esse carnem.\n[[368.1]] Epistola. Quod in praecedentibus meis dixi, nos ideo esse inexcusabiles,\n[[368.2]] quod in Dei potestate sumus, ut lutum in manu figuli, hoc sensu intelligi\n[[368.3]] volui, videlicet quod nemo Deum redarguere potest, quod ipsi naturam infirmam, seu\n[[368.4]] animum impotentem dederit. Sicuti enim absurde circulus quereretur, quod Deus ipsi\n[[368.5]] globi proprietates, vel infans qui calculo cruciatur, quod ei corpus sanum non dederit;\n[[368.6]] sic etiam homo animi impotens, queri non potest, quod Deus ipsi fortitudinem, veramque\n[[368.7]] ipsius Dei cognitionem et amorem negaverit, quodque ipsi naturam adeo infirmam\n[[368.8]] dederit, ut cupiditates suas nec coërcere, nec moderari possit. Nam ad naturam\n[[368.9]] cuiuscunque rei nihil aliud competit, quam quod ex data ipsius causa necessario\n[[368.10]] sequitur. Quod autem ad naturam cuiusque hominis non competat ut animo forti sit,\n[[368.11]] et quod in potestate nostra non magis sit corpus sanum quam mentem sanam habere,\n[[368.12]] negare nemo potest, nisi qui tam experientiam quam rationem negare velit. At instas,\n[[368.13]] si homines ex naturae necessitate peccant, sunt ergo excusabiles, nec quid inde\n[[368.14]] concludere velis explicas, an scilicet quod Deus in eos irasci nequeat, an vero quod\n[[368.15]] beatitudine, hoc est Dei cognitione et amore digni sint. Sed si primum putas, omnino\n[[368.16]] concedo Deum non irasci, sed omnia ex ipsius sententia fieri, at nego, quod propterea\n[[368.17]] omnes beati esse debeant: possunt quippe homines excusabiles esse, et nihilominus\n[[368.18]] beatitudine carere, et multis modis cruciari. Est enim equus excusabilis,\n[[368.19]] quod equus et non homo sit, at nihilominus equus et non homo esse debet. Qui ex\n[[368.20]] morsu canis furit, excusandus quidem est, et tamen jure suffocatur, et qui denique\n[[368.21]] cupiditates suas regere, et metu legum easdem coërcere nequit, quamvis aliam ob\n[[368.22]] infirmitatem excusandus sit, non potest tamen animi acquiescentia, Deique cognitione\n[[368.23]] et amore frui, sed necessario perit. Neque hic necesse esse puto, monere, quod\n[[369.1]] quando scriptura ait, Deum in peccatores irasci, eumque judicem esse, qui de hominum\n[[369.2]] actionibus cognoscit, judicat et statuit, more humano, et secundum receptas\n[[369.3]] vulgi opiniones loquatur; quia ipsius intentum non est philosophiam docere, nec\n[[369.4]] homines doctos, sed obtemperantes facere. Quo propterea pacto videar, ex eo quod\n[[369.5]] miracula et ignorantiam pro aequipollentibus sumserim, potentiam Dei et hominum\n[[369.6]] scientiam iisdem finibus concludere, non video. Caeterum Christi passionem, mortem,\n[[369.7]] ac sepulturam tecum literaliter accipio, eius autem resurrectionem allegorice.\n[[369.8]] Fateor quidem hanc etiam, ab Evangelistis iis narrari circumstantiis, ut negare non\n[[369.9]] possimus, ipsos Evangelistas credidisse, Christi corpus resurrexisse, et ad coelum\n[[369.10]] ascendisse, ut ad Dei dextram sederet, et quod ab infidelibus etiam potuisset videri, si\n[[369.11]] una iis in locis affuissent, in quibus ipse Christus discipulis apparuit, in quo tamen\n[[369.12]] salva Evangelii doctrina potuerunt decipi, ut aliis etiam prophetis contigit, cuius rei\n[[369.13]] exempla in praecedentibus dedi. At Paulus cui Christus postea etiam apparuit, gloriatur\n[[369.14]] quod Christum non secundum carnem, sed secundum spiritum noverit. Pro\n[[369.15]] Catalogo librorum nobilissimi Domini Boylii maximas ago gratias. Denique R. Societatis\n[[369.16]] praesentia negotia data occasione ex te scire expecto. Vale vir Amplissime, et\n[[369.17]] me omni affectu atque studio tuum esse crede.\n[[369.18]] Epist. Perbreves tuas literas 15. Novembr. die Saturni modo elapsa accepi;\n[[369.19]] in iis ea tantummodo indicas, quae in tract. theologico-politico crucem lectoribus\n[[369.20]] fixere. Cum tamen iis etiam cognoscere speraverim, quaenam eae opiniones essent,\n[[369.21]] quae religiosae virtutis praxin labefactare viderentur, de quibus multa monueras.\n[[369.22]] Sed ut de tribus illis capitibus, quae notas, mentem meam tibi aperiam, dicam,\n[[369.23]] et quidem ad primum, me de Deo et natura longe diversam (fovere) sententiam\n[[369.24]] ab ea, quam neoterici Christiani defendere solent, Deum enim rerum omnium causam\n[[370.1]] immanentem, ut ajunt, non vero transeuntem statuo. Omnia, inquam, in Deo\n[[370.2]] esse, et in Deo moveri, cum Paulo affirmo, et forte etiam cum omnibus antiquis\n[[370.3]] philosophis, licet alio modo, et auderem dicere, cum antiquis omnibus Hebraeis,\n[[370.4]] quantum ex quibusdam traditionibus, tametsi multis modis adulteratis conjicere licet.\n[[370.5]] Attamen quod quidam putant Tractatum Theol.-polit. eo niti, quod Deus et natura\n[[370.6]] unum et idem sit, tota errant via. Ad miracula deinde quod attinet, mihi contra\n[[370.7]] persuasum est, divinae revelationis certitudinem, sola doctrinae sapientia, non autem\n[[370.8]] miraculis, hoc est ignorantia, adstrui posse. Quod satis prolixe cap. 6. de Miraculis\n[[370.9]] ostendi. Hoc tamen hic addo, me inter religionem et superstitionem hanc\n[[370.10]] praecipue agnoscere differentiam, quod haec ignorantiam, illa autem sapientiam pro\n[[370.11]] fundamento habeat, et hanc causam esse credo, cur Christiani non fide, neque caritate,\n[[370.12]] neque reliquis spiritus s. fructibus, sed sola opinione inter reliquos dignoscuntur,\n[[370.13]] nempe, quia ut omnes, solis miraculis, hoc est ignorantia, quae omnis malitiae\n[[370.14]] fons est, se defendunt, atque adeo fidem, licet veram, in superstitionem vertunt. Verum\n[[370.15]] an huic malo remedium adhibere Reges unquam concedent, valde dubito. Denique\n[[370.16]] ut de tertio etiam capite, mentem meam clarius aperiam, dico ad salutem\n[[370.17]] non esse omnino necesse Christum secundum carnem noscere; sed de aeterno illo\n[[370.18]] Dei filio, hoc est Dei aeterna sapientia, quae sese in omnibus rebus, et maxime in\n[[370.19]] mente humana, et maxime in mente Christi Iesu manifestavit, longe aliter sentiendum.\n[[370.20]] Nam nemo absque hac ad statum beatitudinis potest pervenire, utpote quae sola\n[[370.21]] docet, quid verum, quid falsum, bonum et malum sit. Et quia uti dixi, haec sapientia\n[[370.22]] per J. Christum maxime manifestata fuit, ideo ipsius discipuli eandem quatenus ab\n[[370.23]] ipso fuit revelata, praedicaverunt, seseque spiritu illo Christi super reliquos gloriari\n[[370.24]] posse ostenderunt. Caeterum quod quaedam Ecclesiae his addunt, ut quod Deus naturam\n[[371.1]] humanam sumserit, monui expresse, me quid dicant nescire, imo ut verum\n[[371.2]] fatear non minus absurde mihi loqui videntur, quam si quis mihi diceret, quod circulus\n[[371.3]] naturam quadrati induerit. Atque haec sufficere arbitror, ad explicandum\n[[371.4]] quid de tribus illis capitibus sentiam, an eadem Christianis, quos nosti placitura sint,\n[[371.5]] id tu melius scire poteris. Vale.\n",
  "number": "26.",
  "title": "Epistolae tres D. B. de Spinoza ad D. Oldenburgium",
  "date": ""
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:26. Epistolae tres D. B. de Spinoza ad D. Oldenburgium 364.0;0:63:026:76? :E:l^. Epistolae tres D.B. de Spinoza ad D. Oldenburgium. Video tandem quid id fuerit, quod a me postulabas ne evulgarem. Sed quia id ipsum praecipuum fundamentum est eorum omnium, quae in tractatu quem edere destinaveram habe...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>