---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_482",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 482,
  "text": "[[2145.1]] <b>385₃.  Stellensammlung STELLENSAMMLUNG\n [[2145.2]] <petit> </p>\n<p> [[2145.3]] Diese Stellensammlung, bes. zu Matthaeus V, Lukas XII und 1. Korinther III, folgt <k>R. Bellarmino</k>,\n[[2145.4]] <i>Disputationes de controversiis christianae fidei adversus huius temporis haereticos. Editio ultima</i>, in <i>Opera\n[[2145.5]] omnia</i>, 7 Tle in 4 Bdn, Köln 1617-1620, Tl II, Controv. III <i>De ecclesia quae est in purgatorio</i>, lib. I, cap. 3 u. 4,\n[[2145.6]] Sp. 574-609. </petit> </p>\n<p> [[2145.7]] Orig. <i>Hom. 25 in Num</i>. de psalm. 65; <i>Homil. 6 in Exod.</i>; <i>Homil. 14. in Levit</i>.;\n[[2145.8]] <i>Homil. 12. in Hierem</i>.; <i>Hom. 35. in Luc</i>. </p>\n<p> [[2145.9]] Ambros. <i>psalm. 36</i>; <i>serm. 3 in Psalm. 118</i>. (de psalm. 65.) <i>ad 1. Cor. 3.</i>, <i>in\n[[2145.10]] psalm. 118. Concione 20</i>. super illud <i>vide humilitatem meam</i>, in cap. XII <i>Lucae</i>. </p>\n<p> [[2145.11]] Augustin. <i>C. D.</i> XX, 25 de Is. 4; <i>Ep. ad Eunod</i>. 99. lib. 12. <i>in Genes</i>. c. 33 ad\n[[2145.12]] Zach. 9; <i>C. D.</i> XXI, 24. VI. <i>in Julian</i>. 5. (ad Luc. 23.); <i>lib. de fide et operibus</i> cap. 15\n[[2145.13]] (1. ad. Corinth. 3.) et c. 16. <i>Quaest. 1. ad Dulcitium</i>; <i>Enchirid</i>. c. 68. in psalm. 37.\n[[2145.14]] (1. Cor. 5.) lib. 1. <i>de sermone Domini in monte</i> c. 21. etc. (Matth. 5.) ibi novissimum\n[[2145.15]] quadrantem intelligit de aeternis poenis; <i>de C. D.</i> XXI, 26. 27. (Matth. 5.) 21. cap. 16.\n[[2145.16]] <b>lib. 21, cap. 27.</b> NB. <Fn><i>Am Rande</i>: NB.</Fn> Homil. 16. ex lib. 50. <i>homiliarum</i>. Lib. 2. <i>Genes</i>. <i>contra\n[[2145.17]] Manich</i>. c. 20. </p>\n<p> [[2146.1]] Hieron. in c. ult. <i>Isaiae</i> (de Mich. 7.), <i>ad Malach</i>. 3. lib. 2. <i>in Jovinianum</i>\n[[2146.2]] (1. Cor. 3.), <i>ad Isaiae</i> 5 (1. ad Corinth.) ad illa verba <i>vae qui conjungitis domum ad\n[[2146.3]] domum</i>, in 4. cap. <i>Amos</i>, in ultimis verbis ultimi libri supra Isaiam, ad Matth. (<i>baptizabit\n[[2146.4]] in spiritu S. et igne. Spiritus S. in hac vita, igne in futura</i>). <i>Epist. 8. ad Demetriadem</i>\n[[2146.5]] (Matth. 5.), ad Matth. 5. </p>\n<p> [[2146.6]] Basil. <i>ad Is</i>. 9; <i>Lib. de Spir. S.</i> c. 15 (Matth. 3) </p>\n<p> [[2146.7]] Gregor. 4. <i>dialog</i>. 39. </p>\n<p> [[2146.8]] Chrysost. <i>ad 1. Cor. 3</i>. <i>Hom. 3. in Epist. ad Philipp</i>; <i>Hom. 69. in populum Antiochenum</i>\n[[2146.9]] ad Matth. 5. (interpretatur quadrantem de vita praesenti). </p>\n<p> [[2146.10]] Theodor. <i>ad I. Cor. 3</i>. </p>\n<p> [[2146.11]] Theophyl. <i>ad 1. Cor. 3</i>, in c. 5. <i>Matth</i>. (sequitur Chrysost. de quadrante), in c. 12.\n[[2146.12]] <i>Lucae</i> explicat parabolice item Euthymius. </p>\n<p> [[2146.13]] Oecumen. <i>ad. 1. Cor. 3</i>. </p>\n<p> [[2146.14]] Sedul. <i>ad 1. Cor. 3</i>. (parum) </p>\n<p> [[2146.15]] Cyprian. lib. 4. <i>Ep. 2. ad Antonianum</i>. </p>\n<p> [[2146.16]] Gregor. Nazianz. in fine orationis <i>de Epiphania</i> vocat purgatorium alterius vitae\n[[2146.17]] ultimum Baptisma. </p>\n<p> [[2146.18]] Matth. 5. Luc. 12. 1. Cor. 3. </p>\n<p> [[2146.19]] Euthymius; v. Theophylact. </p>\n<p> [[2146.20]] Euseb. Emissenus <i>hom. 3. de Epiphanias</i>. <Fn><i>Am Rande</i>: NB.</Fn> </p>\n<p> [[2147.1]] Epiphan. <i>ad haeresin Tatiani</i> quae est ultima primi libri. (Act. 2) Christum cum\n[[2147.2]] descendit ad inferos liberasse eos qui per ignorantiam peccavere. </p>\n<p> [[2147.3]] Gregor. Nyssen. <i>orat. pro mortuis</i>, non procul a medio. NB. <Fn><i>Am Rande</i>: NB.</Fn> </p>\n<p> [[2147.4]] Cyrillus <i>Catechesi 5. mystagogica</i> animarum juvamen. NB. <Fn><i>Am Rande</i>: NB.</Fn> </p>\n",
  "number": "385₃.",
  "title": "Stellensammlung",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:385₃. Stellensammlung STELLENSAMMLUNG Diese Stellensammlung, bes. zu Matthaeus V, Lukas XII und 1. Korinther III, folgt R. Bellarmino, Disputationes de controversiis christianae fidei adversus huius temporis haereticos. Editio ultima, in Opera omnia, 7 Tle in 4 Bdn, Köln 1617-1620, Tl II, Controv. I...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>