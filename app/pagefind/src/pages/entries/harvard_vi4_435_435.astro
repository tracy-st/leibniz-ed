---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_435",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 435,
  "text": "[[1965.19]] <b>357.  De qualitatibus quae referuntur ad extensionem [1677 bis 1678 (?)]</b>\n [[1965.20]] <tab/>[1677 bis 1678 (?)] </p>\n<p> [[1966.1]] Considerare <Fn><i>Am Kopf</i>: Ens rat<angle bracket>ionis</angle bracket> realis effectio</Fn> possumus in rebus tum eas qualitates quae respondent quidem\n[[1966.2]] extensioni nihil tamen per se in ea mutant, quae sunt perceptio et voluntas, et alia id\n[[1966.3]] genus; tum vero eas quae referuntur ad extensionem. Haec sunt mutatio et conatus ad\n[[1966.4]] mutationem vel contra mutationem. Mutatio esse possit magnitudinis et situs; vel utriusque.\n[[1966.5]] Magnitudinis cum eadem materia in arctius vel amplius spatium ire fingitur. Situs\n[[1966.6]] seu loci cum fingimus materiae quantitate servata, esse motum, seu assumtis quibusdam\n[[1966.7]] partibus elementaribus fieri earum transpositionem; utriusque autem compositio est cum\n[[1966.8]] apparet quibus gradibus ab una magnitudine ad aliam sit transitum, et quod punctum\n[[1966.9]] cujusque situs cui respondeat. Nisus ad augendam vel minuendam magnitudinem intelligi\n[[1966.10]] potest proportionalis materiae compressae vel dilatatae. Potest tamen et alius fingi.\n[[1966.11]] Revera tamen hoc est Ens mathematicum, seu apparens, quod in omnibus suis partibus\n[[1966.12]] etiam minimis hoc modo in natura non reperitur, sed per spongiam explicari potest, quae\n[[1966.13]] idem praestat ad sensum. Possunt vero et aliae causae nisus ad dilatationem aut contractionem\n[[1966.14]] intelligi, quales calor et frigus. In tali autem nisu, vel etiam renisu, sequitur\n[[1966.15]] motus qui facillime effectus obtinetur nisi aliqua causa alium fieri jubeat. </p>\n<p> [[1966.16]] Si aliquod principium moveatur causa motus poni potest varia utcunque caetera\n[[1966.17]] autem ipsa connexione regantur; tunc nihil opus supponi quod non intelligatur in parte.\n[[1966.18]] Sed tamen et fingi possunt leges motus quarum efficiendarum ratio non constat quia\n[[1966.19]] tamen nihil illis inest impossibile, possunt assumi ut si diversi motus certa ratione\n[[1966.20]] contemperentur; causae motus variae intelligi possunt, seposita vi in materia mutandi,\n[[1966.21]] seposito item impulsu vel concursu; talis est attractio corporis ad corpus, item repulsus\n[[1966.22]] corporis a corpore; item adhaesio corporis ad corpus, quae referenda ad impedimenta\n[[1966.23]] tantum, si modo adhaesio nulla est, quae non revera sit attractio in exigua tamen distantia.\n[[1966.24]] Fingi etiam potest attractionem vel repulsionem valere in infinitum, aut contra certa\n[[1966.25]] distantia penitus evanescere. Fingi etiam possunt attractiones aut repulsus per lineas\n[[1966.26]] curvas. </p>\n<p> [[1967.1]] Haec quae de corpore diximus, possunt etiam fingi de ipso loco, quasi in puncto\n[[1967.2]] aliquo esset vis attrahendi, repellendi, retinendi. Idem de plaga aliqua concipi posset, ut\n[[1967.3]] in gravitate. Quod de loco idem est ac si fingeremus de corpore immobili. </p>\n<p> [[1967.4]] Licet etiam quasdam connexiones, inter se diversorum fingere, v.g. emissiones\n[[1967.5]] quasdam seu radiationes virtuales, ut cum ex sole emanat calor qui habet vim dilatandi,\n[[1967.6]] ex lumine lumen; huc suppositio de quovis puncto radii luminis rursus radiante. </p>\n",
  "number": "357.",
  "title": "De qualitatibus quae referuntur ad extensionem",
  "date": "[1677 bis 1678 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:357. De qualitatibus quae referuntur ad extensionem [1677 bis 1678 (?)] [1677 bis 1678 (?)] Considerare Am Kopf: Ens rationis realis effectio possumus in rebus tum eas qualitates quae respondent quidem extensioni nihil tamen per se in ea mutant, quae sunt perceptio et voluntas, et alia id genus; tum...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>