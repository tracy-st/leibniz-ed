---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_118",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 118,
  "text": "<p> [[381.1]] <b>118. LEIBNIZ AN JACQUES BERNARD</p>\n<p> [[381.2]] [Hannover, 19.] Januar 1706. [133.] </b></p>\n<p> [[382.13]] Monsieur </p>\n<p> [[382.14]] J'ay <Fn><i>Am Kopf von L^#'1 von Leibniz' Hand</i>: janvier 1706 A Mons. Bernard à Leide nicht abgangen</Fn> receu une lettre de M. Burnet, gentilhomme Ecossois, qui me dit de vous avoir\n[[382.15]] monstré un papier que je luy avois donné sur les natures plastiques, que vous avés paru disposé\n[[382.16]] à le publier, Monsieur, et que vous avés bien voulu aussi donner conseil sur quelques bagatelles\n[[382.17]] que j'avois projettées pour les faire imprimer en Hollande. </p>\n<p> [[382.18]] Je vous suis obligé, Monsieur, de ces manieres officieuses; et je profiteray un de ces jours\n[[382.19]] de vostre bonne volonté en vous envoyant quelque reponse que j'ay faite au Pere <b>Lami</b> qui\n[[383.1]] avoit attaqué mon systeme de l'Harmonie preétablie dans son livre de la <i>Connoissance de soy\n[[383.2]] même</i>. Mais ce que j'avois fait sur les natures plastiques, a déja esté envoyé à Mons. Beauval-Banage. </p>\n<p> [[383.4]] Feu M. Lock m'avoit encouragé à faire des remarques sur son Ouvrage: mais sa mort\n[[383.5]] m'en a découragé. J'avois eu en veue principalement de donner quelque occasion au public de\n[[383.6]] profiter de nostre conference. </p>\n<p> [[383.7]] J'ay echangé plusieurs lettres sur la philosophie et sur d'autres matieres, avec des personnes\n[[383.8]] distinguées; dont il ne seroit peutestre pas mal de donner un recueil au public, commençant par\n[[383.9]] les Françoises. J'ay joint quelques fois des Memoires aux Lettres, quand les lettres auroient esté\n[[383.10]] trop prolixes en y mettant le tout. Si quelque libraire s'en charge un jour, je ne luy demanderay\n[[383.11]] qu'un bon nombre d'exemplaires, car il m'en faudra beaucoup pour quantité d'amis. </p>\n<p> [[383.12]] J'ay remarqué dernierement dans un de vos journaux des reflexions curieuses sur les\n[[383.13]] couleurs. Il seroit bon de les comparer avec les profondes recherches de M. Newton sur ce sujet. </p>\n<p> [[383.14]] Au reste je suis </p>\n<p> [[383.15]] Monsieur vostre tres humble et tres obeissant serviteur Leibniz </p>\n<p> [[383.16]] En me voulant adresser quelque chose, il suffira de l'envoyer à M. de Bothmar Ministre\n[[383.17]] d'Estat et Envoyé extraordinaire de cette Cour qui est à la Haye. </p>\n",
  "number": "118.",
  "title": "LEIBNIZ AN JACQUES BERNARD",
  "date": "[Hannover, 19.] Januar 1706. [133.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:118. LEIBNIZ AN JACQUES BERNARD [Hannover, 19.] Januar 1706. [133.] Monsieur J'ay Am Kopf von L^#'1 von Leibniz' Hand: janvier 1706 A Mons. Bernard à Leide nicht abgangen receu une lettre de M. Burnet, gentilhomme Ecossois, qui me dit de vous avoir monstré un papier que je luy avois donné sur les na...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii4_118","series":"Band II 4 (1701 - 1707)","seq":118,"text":"<p> [[381.1]] <b>118. LEIBNIZ AN JACQUES BERNARD</p>\n<p> [[381.2]] [Hannover, 19.] Januar 1706. [133.] </b></p>\n<p> [[382.13]] Monsieur </p>\n<p> [[382.14]] J'ay <Fn><i>Am Kopf von L^#'1 von Leibniz' Hand</i>: janvier 1706 A Mons. Bernard à Leide nicht abgangen</Fn> receu une lettre de M. Burnet, gentilhomme Ecossois, qui me dit de vous avoir\n[[382.15]] monstré un papier que je luy avois donné sur les natures plastiques, que vous avés paru disposé\n[[382.16]] à le publier, Monsieur, et que vous avés bien voulu aussi donner conseil sur quelques bagatelles\n[[382.17]] que j'avois projettées pour les faire imprimer en Hollande. </p>\n<p> [[382.18]] Je vous suis obligé, Monsieur, de ces manieres officieuses; et je profiteray un de ces jours\n[[382.19]] de vostre bonne volonté en vous envoyant quelque reponse que j'ay faite au Pere <b>Lami</b> qui\n[[383.1]] avoit attaqué mon systeme de l'Harmonie preétablie dans son livre de la <i>Connoissance de soy\n[[383.2]] même</i>. Mais ce que j'avois fait sur les natures plastiques, a déja esté envoyé à Mons. Beauval-Banage. </p>\n<p> [[383.4]] Feu M. Lock m'avoit encouragé à faire des remarques sur son Ouvrage: mais sa mort\n[[383.5]] m'en a découragé. J'avois eu en veue principalement de donner quelque occasion au public de\n[[383.6]] profiter de nostre conference. </p>\n<p> [[383.7]] J'ay echangé plusieurs lettres sur la philosophie et sur d'autres matieres, avec des personnes\n[[383.8]] distinguées; dont il ne seroit peutestre pas mal de donner un recueil au public, commençant par\n[[383.9]] les Françoises. J'ay joint quelques fois des Memoires aux Lettres, quand les lettres auroient esté\n[[383.10]] trop prolixes en y mettant le tout. Si quelque libraire s'en charge un jour, je ne luy demanderay\n[[383.11]] qu'un bon nombre d'exemplaires, car il m'en faudra beaucoup pour quantité d'amis. </p>\n<p> [[383.12]] J'ay remarqué dernierement dans un de vos journaux des reflexions curieuses sur les\n[[383.13]] couleurs. Il seroit bon de les comparer avec les profondes recherches de M. Newton sur ce sujet. </p>\n<p> [[383.14]] Au reste je suis </p>\n<p> [[383.15]] Monsieur vostre tres humble et tres obeissant serviteur Leibniz </p>\n<p> [[383.16]] En me voulant adresser quelque chose, il suffira de l'envoyer à M. de Bothmar Ministre\n[[383.17]] d'Estat et Envoyé extraordinaire de cette Cour qui est à la Haye. </p>\n","number":"118.","title":"LEIBNIZ AN JACQUES BERNARD","date":"[Hannover, 19.] Januar 1706. [133.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>