---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_139",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 139,
  "text": "<p> [[401.13]] <b>124. NICOLAS MALEBRANCHE AN LEIBNIZ</p>\n<p> [[401.14]] [Paris, 1. Hälfte 1676.] [123.125.]</b></p>\n<p> [[402.1]] Monsieur </p>\n<p> [[402.2]] Je croy qu'il y a encore bien plus de tems à perdre et de difficultez à vaincre dans les\n[[402.3]] disputes par écrit, que dans celles qui se terminent dans la conversation. Vous en voyez bien les\n[[402.4]] raisons. Cependant puisque vous m'avez fait l'honneur de m'écrire vous soufrirez bien que je\n[[402.5]] vous reponde. </p>\n<p> [[402.6]] Vous niez deux propositions dont voicy la 1^#'e^#'r^#'e. <i>Deux choses reellement distinctes sont\n[[402.7]] separables.</i> et vous dites sur la preuve de cette proposition, que quoyque 2 choses soient\n[[402.8]] reel[l]ement distinctes, tous les requisits de l'une ne peuvent pas toujours estre entendus sans\n[[402.9]] les <b>requisits</b> de l'autre. À quoy je vous repons que cela n'est point vray dans les estres\n[[402.10]] absolus mais seulement dans les manieres des estres et dans toutes les choses qui consistent\n[[402.11]] dans des rapports: car les estres absolus n'ont point de <b>requisits</b>, leur idée est simple. Vous\n[[402.12]] pouvez penser à une partie d'étendue sans panser à une autre. Mais si deux parties d'etendue se\n[[402.13]] joignent et que vous les vouliez separer, alors il faut penser à une autre etendue qui les separe.\n[[402.14]] Ce <b>requisit</b> est concû necessairement; mais on voit clairement qu'il est aussi possible que les\n[[402.15]] autres parties d'etenduë qu'on conçevoit jointes [soient separées.] On n'y conçoit point de\n[[402.16]] contradiction si ce n'est que l'on suppose ce qui est en question que l'estendue est immobile. </p>\n<p> [[402.17]] La 2^#'e proposition que vous niez est celle cy. <i>Deux choses etenduës separables sont\n[[402.18]] mobiles.</i> Cela me paroist evident. Car si l'on conçoit que l'etenduë qui separe deux parties\n[[402.19]] d'etendue croisse ou augmente incessamment, les deux parties d'etendue s'eloigneront sans\n[[402.20]] cesse et par consequent [elles] seront en mouvement. Et je ne voi pas que si l'on peut metre\n[[402.21]] l'etenduë d'un pouce entre 2 parties d'etendue on ne puisse mettre un pied une toise etc. Au\n[[402.22]] reste je tombe d'accord que les parties de l'etendue sont separables en ce que l'une peut estre\n[[402.23]] detruite sans l'autre, mais cela n'empeche pas que l'une ne puisse s'eloigner de l'autre si ce\n[[402.24]] n'est que l'on veuille toujours se representer l'etendue comme immobile c'est à dire supposer\n[[402.25]] ce qui est en question. </p>\n<p> [[402.26]] Voilà Monsieur ce qu'il est necessaire que je reponde pour satisfaire à vostre lettre. je ne\n[[402.27]] vous en dis pas davantage parceque j'espere, en vous rendant la civilité que je vous dois depuis\n[[402.28]] si long temps, vous repondre plus clairement et plus agreablement sur les difficultez que vous\n[[402.29]] me ferez l'honneur de me proposer. Je suis </p>\n<p> [[402.30]] Monsieur Vostre tres humble et tres obeissant serviteur Malebranche. </p>\n<p> [[402.31]] A Monsieur Monsieur De Leibniz à l'hotel de St. Quentin. </p>\n",
  "number": "124.",
  "title": "NICOLAS MALEBRANCHE AN LEIBNIZ",
  "date": "[Paris, 1. Hälfte 1676.] [123.125.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:124. NICOLAS MALEBRANCHE AN LEIBNIZ [Paris, 1. Hälfte 1676.] [123.125.] Monsieur Je croy qu'il y a encore bien plus de tems à perdre et de difficultez à vaincre dans les disputes par écrit, que dans celles qui se terminent dans la conversation. Vous en voyez bien les raisons. Cependant puisque vous ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>