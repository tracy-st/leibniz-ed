---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_126",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 126,
  "text": "<p> [[333.1]] <b>126. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[333.2]] Venedig, 28. Juni [1697]. [123.128.]</b></p>\n\n<p> [[333.7]] Ill^#'m^#'o Sig^#'r^#'e, Sig^#'r^#'e, Padron mio colend^#'m^#'o </p>\n<p> [[333.8]] Il Sig^#'r^#'e Mendelino m' hà consegnata la benignissima lettera di V. S. Ill^#'m^#'a, che m' hà\n[[333.9]] sommamente consolato per le buone nuove della sua salute, e sicurezza che mi dà del suo\n[[333.10]] pretiosissimo amore, e continuatione del suo stimatissimo patrocinio. Qui è così difficile\n[[333.11]] trovare le scritture ricercate, che si sono disanimati tutti questi che n' havevano la cura, ed\n[[333.12]] hanno incaricato a me tutto il peso. Io doppo una lunga diligenza per mezo dell'amorevole\n[[333.13]] assistenza e somma autorità del Sig^#'r^#'e Conte Bertolli Consultore di Stato hò ricevuto i lumi\n[[333.14]] necessarii, e spero haverla indovinata. In quanto al piccolo dittionario della lingua Cumana,\n[[333.15]] s'attende il Sig^#'r^#'e Januario Negri il quale tiene la chiave di quel luoghetto nella sommita del\n[[333.16]] Tempio di San Marco, ove si conservano i manuscritti, e libri del Petrarca, insieme con altre\n[[333.17]] scritture appartenenti a' Principi di Carrara, se questo manuscritto vi sarà, assicuro V. S. Ill^#'m^#'a\n[[333.18]] che n'[haveremo] subito la copia. Per il diploma del Monasterio delle Carceri il Sig^#'r^#'e Conte\n[[333.19]] Bertolli doppo molte diligenze hà finalmente saputo che i privileggi e diplomi sono in potere\n[[333.20]] del Sig^#'r^#'e Carminati, che comprò i beni di quel Monastero, e già è stato parlato, ed hà promesso\n[[333.21]] di favorirci, ed oggi mi devo portare da lui con un biglietto del Sig^#'r^#'e Conte, e se il diploma si\n[[333.22]] trovarà, come s' hà per sicuro n' haverò la copia, e nel vegnente mese, le mandarò l'una e\n[[333.23]] l'altra scrittura. Nella Scrittura fatta per ordine del Publico dal Sig^#'r^#'e Conte, ove sono notati i\n[[333.24]] diplomi e concessioni di beni fatte alle Carceri, solamente si fà mentione d'un Enrico che fù\n[[333.25]] Duca di Sassonia l'anno mille e trenta se non fallo, né vi è altro Enrico di Germania che habbia\n[[334.1]] beneficato le Carceri, onde credo sia quello che cerchiamo. Il Sig^#'r^#'e Mocenigo credeva havere\n[[334.2]] trovato il diploma in un vecchio manuscritto che si trova in potere d'un tale Sig^#'r^#'e Benvenuti,\n[[334.3]] però s'è ingannato, mentre i diplomi sono a parte, e l' hà il Carminati. È più d'un mese che\n[[334.4]] m'affatico ed assisto col Sig^#'r^#'e Bertolli per perfettionare questo affare e pure ancora non hò\n[[334.5]] potuto servirla. In questo Paese si viva in un'intiera ignoranza delle cose antiche, non v'è\n[[334.6]] nessuna curiosità, e ci vogliono miracoli per solamente venire in cognitione d'una scrittura\n[[334.7]] antica, e le giuro, che nessuno sapeva che in San Marco si conservasse la piccola libreria del\n[[334.8]] Petrarca, tolto il Sig^#'r^#'e Procuratore Giustiniano che n' hà dato la notitia al Sig^#'r^#'e Conte, doppo\n[[334.9]] haverla fallata sul principio. Priego Dio possa presto servirla per mostrarle quanto l'amo, e\n[[334.10]] stimo i suoi comandi, come anche il mio profondo rispetto versa cotesto Serenissimo Principe,\n[[334.11]] e mi sono trattenuto qui finora per terminare questo affare, mentre qui ci vuole gran flemma ed\n[[334.12]] assistenza per un negotio di questa natura, come a me costì per sperienza. Godo che habbia\n[[334.13]] ricevuto l'Ongarello. Circa il mio viaggio coll'Ordinario vegnente le darò parte della mia\n[[334.14]] risolutione, e con sincerità l'aprirò i miei sentimenti, e mi creda che se presentemente mi\n[[334.15]] trovassi tutto il denaro necessario per un viaggio così lungo, e dispendioso, mi partirei senza\n[[334.16]] fallo nel venturo Luglio. Le spese che hò fatto per stabilirmi casa in Padova con quel decoro\n[[334.17]] che si ricerca ad un publico Professore m' han tolto tutto il superfluo, e non mi resta presentemente\n[[334.18]] che il puro necessario per il sostentamento mio e della mia servitù; vero è che per\n[[334.19]] l'anno venturo spererei ottenere la prima catedra di filosofia occupata del Conte Rinaldini, che\n[[334.20]] vuole abbandonare l'impiego, con un grosso accrescimento il che mi accommodarebbe al\n[[334.21]] magiore segno. Onde se per settembre non mi mettessi in viaggio la cagione sarà l'impotenza di\n[[334.22]] spendere, non già difetto di volontà, essendo bramosissimo di rivederla. Io però farò tutto per\n[[334.23]] superare questo impedimento, e non più ritardare il mio viaggio. Disponga Dio le mie cose, e\n[[334.24]] pregandola della sua stimatissima protettione mi resto </p>\n<p> [[334.25]] Di V. S. Ill^#'m^#'a Umil^#'m^#'o, Dev^#'m^#'o, Ob^#'m^#'o S^#'r^#'e Michel Angelo Fardella </p>\n<p> [[334.26]] Venetia 28 Giugno </p>\n",
  "number": "126.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Venedig, 28. Juni [1697]. [123.128.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:126. MICHEL ANGELO FARDELLA AN LEIBNIZ Venedig, 28. Juni [1697]. [123.128.] Ill^#'m^#'o Sig^#'r^#'e, Sig^#'r^#'e, Padron mio colend^#'m^#'o Il Sig^#'r^#'e Mendelino m' hà consegnata la benignissima lettera di V. S. Ill^#'m^#'a, che m' hà sommamente consolato per le buone nuove della sua salute, e si...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>