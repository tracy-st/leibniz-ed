---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_8",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 8,
  "text": "<p> [[23.6]] <b>8. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[23.7]] Padua, 3. März 1695. [10.]</b></p>\n\n<p> [[23.20]] Illu^#'m^#'o Sig^#'r^#'e, mio Sig^#'r^#'e, Padron Colend^#'m^#'o </p>\n<p> [[23.21]] Il Tempo, e la lontananza non saranno mai capaci di rendermi ingrato con scordarmi di\n[[23.22]] quanto devo all'incomparabile bontà di V. S. Illu^#'m^#'a, le di cui pretiose gratie viveranno sempre\n[[23.23]] nel mio cuore. Il Signore Magliabechi m' hà consolato coll'avviso felice della sua ottima\n[[23.24]] salute, e dell'eruditissime opere, che ella mette alle stampe, e mi scrive d' haverle mandata una\n[[23.25]] mia Pagina, in cui si contiene l'ordine delle mie lettioni di questo anno, che devono essere da\n[[24.1]] me dette in questa Università, ove hò insegnato la materia delle Comete, e per ordine de\n[[24.2]] gl'Eccell^#'m^#'i nostri Riformatori presentemente raggiono in catedra del Terremoto con gran concorso\n[[24.3]] d'Uditori, e ciò per sodisfare alla comune curiosità circa le particolarità osservate in\n[[24.4]] questa orribile scossa, che fù qui intesa nel mese caduto. Sarei molto contento se tanto circa la\n[[24.5]] natura delle Comete, quanto del Terremoto potessi sapere il suo dotto, e purgato sentimento, e\n[[24.6]] principalmente vorrei sapere <i>An Cometae sint potius Corpora sempiterna, quam temporanea, et\n[[24.7]] posito quod non sint Planetae ut arridet Domenico Cassini, sed potius corpora quaedam de\n[[24.8]] novo procreata, an Sint Corpora semidiaphana ex Stellarum effluviis efformata, ut potius\n[[24.9]] appellanda sint Spectra, et ludibria sensuum ex lumine reflexo atque refracto potissimum\n[[24.10]] profluentia, quam substantiae verae, et reales. Quemadmodum etiam vellem a te scire, an in\n[[24.11]] Centro Telluris vere ignis ardeat, qui centralis, ac perpetuus dici valeat</i>. Con altra occasione la\n[[24.12]] supplicarò d'illuminarmi circa quello che concerne la natura del Corpo, e sua divisibilità, se si\n[[24.13]] distingue dallo Spatio, se riceve il movimento da un altro, come anche intorno alla natura\n[[24.14]] dell'Etere, e cimento che unisce insieme le parti nel Solido, ed in che principalmente consiste\n[[24.15]] l'energia, e forza architettonica, che si racchiude nel Seme delle cose. Se mai potrò, ed haverò\n[[24.16]] soldo che basta nelle vacanze dello Studio penso di mettermi in viaggio a cotesta volta per\n[[24.17]] rivederla, e di presenza ringratiarla dei rilevanti beneficii, che ella m' hà fatto, come anche\n[[24.18]] renderla capace delli forti motivi che m'indussero a fermarmi qui, e non portarmi costì secondo\n[[24.19]] il concertato; l' hò comunicato con tutta secretezza a Monsieur Bouchet, il quale non sa\n[[24.20]] disapprovare la mia condotta. Del resto mi creda che con il cuore sono sempre costì, ed il\n[[24.21]] commodo onorevole che qui godo non hà già estinto i lumi che per tanto tempo mercé la Divina\n[[24.22]] Misericordia vivono nella mia Mente, essendo costantemente l'istesso che prima. La priego\n[[24.23]] perciò con tutto il cuore a continuarmi la sua protettione, e perdonarmi se le circostanze del\n[[24.24]] tempo m'obligarono a rifiutare le sue gratie, come anche persuadersi che mai mi scordarò di\n[[24.25]] quanto le sono obligato, inalterabilmente protestandomi </p>\n<p> [[24.26]] Di V. S. Illu^#'m^#'a Umil^#'m^#'o, Oblig^#'m^#'o, Affett^#'m^#'o S^#'r^#'e vero Michel Angelo Fardella </p>\n<p> [[24.27]] Padova 3 Marzo 1695 </p>\n",
  "number": "8.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Padua, 3. März 1695. [10.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:8. MICHEL ANGELO FARDELLA AN LEIBNIZ Padua, 3. März 1695. [10.] Illu^#'m^#'o Sig^#'r^#'e, mio Sig^#'r^#'e, Padron Colend^#'m^#'o Il Tempo, e la lontananza non saranno mai capaci di rendermi ingrato con scordarmi di quanto devo all'incomparabile bontà di V. S. Illu^#'m^#'a, le di cui pretiose gratie ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii3_8","series":"Band II 3 (1695 - 1700)","seq":8,"text":"<p> [[23.6]] <b>8. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[23.7]] Padua, 3. März 1695. [10.]</b></p>\n\n<p> [[23.20]] Illu^#'m^#'o Sig^#'r^#'e, mio Sig^#'r^#'e, Padron Colend^#'m^#'o </p>\n<p> [[23.21]] Il Tempo, e la lontananza non saranno mai capaci di rendermi ingrato con scordarmi di\n[[23.22]] quanto devo all'incomparabile bontà di V. S. Illu^#'m^#'a, le di cui pretiose gratie viveranno sempre\n[[23.23]] nel mio cuore. Il Signore Magliabechi m' hà consolato coll'avviso felice della sua ottima\n[[23.24]] salute, e dell'eruditissime opere, che ella mette alle stampe, e mi scrive d' haverle mandata una\n[[23.25]] mia Pagina, in cui si contiene l'ordine delle mie lettioni di questo anno, che devono essere da\n[[24.1]] me dette in questa Università, ove hò insegnato la materia delle Comete, e per ordine de\n[[24.2]] gl'Eccell^#'m^#'i nostri Riformatori presentemente raggiono in catedra del Terremoto con gran concorso\n[[24.3]] d'Uditori, e ciò per sodisfare alla comune curiosità circa le particolarità osservate in\n[[24.4]] questa orribile scossa, che fù qui intesa nel mese caduto. Sarei molto contento se tanto circa la\n[[24.5]] natura delle Comete, quanto del Terremoto potessi sapere il suo dotto, e purgato sentimento, e\n[[24.6]] principalmente vorrei sapere <i>An Cometae sint potius Corpora sempiterna, quam temporanea, et\n[[24.7]] posito quod non sint Planetae ut arridet Domenico Cassini, sed potius corpora quaedam de\n[[24.8]] novo procreata, an Sint Corpora semidiaphana ex Stellarum effluviis efformata, ut potius\n[[24.9]] appellanda sint Spectra, et ludibria sensuum ex lumine reflexo atque refracto potissimum\n[[24.10]] profluentia, quam substantiae verae, et reales. Quemadmodum etiam vellem a te scire, an in\n[[24.11]] Centro Telluris vere ignis ardeat, qui centralis, ac perpetuus dici valeat</i>. Con altra occasione la\n[[24.12]] supplicarò d'illuminarmi circa quello che concerne la natura del Corpo, e sua divisibilità, se si\n[[24.13]] distingue dallo Spatio, se riceve il movimento da un altro, come anche intorno alla natura\n[[24.14]] dell'Etere, e cimento che unisce insieme le parti nel Solido, ed in che principalmente consiste\n[[24.15]] l'energia, e forza architettonica, che si racchiude nel Seme delle cose. Se mai potrò, ed haverò\n[[24.16]] soldo che basta nelle vacanze dello Studio penso di mettermi in viaggio a cotesta volta per\n[[24.17]] rivederla, e di presenza ringratiarla dei rilevanti beneficii, che ella m' hà fatto, come anche\n[[24.18]] renderla capace delli forti motivi che m'indussero a fermarmi qui, e non portarmi costì secondo\n[[24.19]] il concertato; l' hò comunicato con tutta secretezza a Monsieur Bouchet, il quale non sa\n[[24.20]] disapprovare la mia condotta. Del resto mi creda che con il cuore sono sempre costì, ed il\n[[24.21]] commodo onorevole che qui godo non hà già estinto i lumi che per tanto tempo mercé la Divina\n[[24.22]] Misericordia vivono nella mia Mente, essendo costantemente l'istesso che prima. La priego\n[[24.23]] perciò con tutto il cuore a continuarmi la sua protettione, e perdonarmi se le circostanze del\n[[24.24]] tempo m'obligarono a rifiutare le sue gratie, come anche persuadersi che mai mi scordarò di\n[[24.25]] quanto le sono obligato, inalterabilmente protestandomi </p>\n<p> [[24.26]] Di V. S. Illu^#'m^#'a Umil^#'m^#'o, Oblig^#'m^#'o, Affett^#'m^#'o S^#'r^#'e vero Michel Angelo Fardella </p>\n<p> [[24.27]] Padova 3 Marzo 1695 </p>\n","number":"8.","title":"MICHEL ANGELO FARDELLA AN LEIBNIZ","date":"Padua, 3. März 1695. [10.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>