---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_99",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 99,
  "text": "<p> [[269.14]] <b>99. GABRIEL WAGNER AN LEIBNIZ</p>\n<p> [[269.15]] Hamburg, 7. (17.) Februar 1697. [96.103.]</b></p>\n\n<p> [[270.2]] Hamburg, 7. Februar 97 </p>\n<p> [[270.3]] HochEdler, Vest= u. Hochgelehrter Herr, Hochgeneigter Hr. HofRaht </p>\n<p> [[270.4]] Ihren brief vom 19. Jan. habe gestern erst bekommen von Doct. Christiani alhir, welcher\n[[270.5]] damit so saümselig gewesen: ich bin hoch verpflichtet vor di gute Vorsorge vor mich; hätte ich\n[[270.6]] eher das glük gehabt, mit einem wahren Philosopho bekant zu werden, deßen eigenschaft nicht\n[[270.7]] nur weisheit, sondern auch gütigk. ist, vileicht wäre ich längst nicht mehr so in der irre\n[[270.8]] herumgezogen. Und weil großen Hrn. vor 200. dinen, vileicht eher zur beföderung hilft, als\n[[270.9]] bürgersleüten vor 300., wil ichs ohn bedenken annehmen, wünsche nur, tüchtig gnung zusein,\n[[270.10]] des Hrn. Grafen curiosität zustillen, welches ich doch hoffen wil, wenn er nicht zuviel practica,\n[[270.11]] architectur u. ingenieurswesen wird verlangen, welches denn bei denen, di mathesin nur zur\n[[270.12]] lust studiren, gemeinigl. zugeschehen pflegt, ich aber mit meinem großen leidwesen, ein\n[[270.13]] lauterer theoreticus bin, fast keines geschäfts, als des stetigen denkens u. grillisirens fähig; doch\n[[270.14]] weil Bükenburg in der landkarte etwa 6. 7. meile von Hannover scheint, wird meiner künheit,\n[[270.15]] im fal einiger unwißenheit, verhoffentlich di Zuflucht nicht versagt werden. Ich wundere mich,\n[[270.16]] daß bei einem solchen Hrn. lust u. gedult zu finden, zu den mühseligen demonstrationen der\n[[270.17]] lezten 6. bücher, welche auch bei dem Tacquet schon ekel gnung sind, geschweige im Euclide\n[[270.18]] u. Clavio. Honoratus Fabry ist vileicht leichter, wi ich aus dem Sturm merke. Doch hab ich ihn\n[[270.19]] noch nie gesehen: am liebsten aber wäre mir Sturm, wenn ich nur hinten den algebris Anhang\n[[270.20]] verstünde; ich verstünde auch vileicht, wenn ich meine tage 14 tage hätte unterricht darin\n[[270.21]] gehabt; aber wenn ich ein 6 wöchentlich collegium geom. ausnehme, so ist meine ganze übrige\n[[270.22]] mathesis, wie auch di meisten übrigen studia, eine autodidaxie. Ob sonst Renaldinus oder\n[[270.23]] Wallis, welche ich in Sturms <i>math. enucl.</i> oft finde, vor mich beßer sei, bitte gehors. zuberichten.\n[[270.24]] Dis eine könnte noch bedenken machen, wo man in <zl>^#h(+5)1<ne>2<be> oder etl. vierthel jahren, weil doch\n[[270.25]] der Graf nur eine kurze Zeit jemand verlangt, hin solte; doch weil ich hoffe, man werde so\n[[270.26]] schleünig, gegen den Winter, ohne 2, 3 monatliche ankündigung, bis sich sonst wo was\n[[271.1]] ereignete, nicht verstoßen werden: Wil also in wenig tagen, wenn ich werde bei meinen itzigen\n[[271.2]] <i>auditt.</i> einen schlus gemacht haben, hir abreisen; vileicht habe das glük innerhalb 14 tagen dem\n[[271.3]] Hrn. HofR. erfreüligst aufzuwarten, weils doch über 4, 5 meilen nicht scheint aus dem Wege\n[[271.4]] <angle bracket>zu</angle bracket> sein. Die neülig ausgeblibene einlage verhoffe künftig, <angle bracket>der ich verbl.</angle bracket> </p>\n<p> [[271.5]] HochEdler Hr. HofRaht, dero verbundnester Gabriel Wagner\n[[271.6]] <yi>Dem HochEdlen, Vest= und Hochgelehrten Herrn, Hrn. Gotfried Wilhelm Leibniz,\n[[271.7]] S. Churfürstl. Durchl. zu Braunschweig Hochbestalten Hof Raht u. a. m. Hannover. Franco. </p>\n",
  "number": "99.",
  "title": "GABRIEL WAGNER AN LEIBNIZ",
  "date": "Hamburg, 7. (17.) Februar 1697. [96.103.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:99. GABRIEL WAGNER AN LEIBNIZ Hamburg, 7. (17.) Februar 1697. [96.103.] Hamburg, 7. Februar 97 HochEdler, Vest= u. Hochgelehrter Herr, Hochgeneigter Hr. HofRaht Ihren brief vom 19. Jan. habe gestern erst bekommen von Doct. Christiani alhir, welcher damit so saümselig gewesen: ich bin hoch verpflicht...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>