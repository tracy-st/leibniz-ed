---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_629",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 629,
  "text": "[[2763.1]] <b>492₄.  De absolute licitis aut illicitis, debitis aut indebitis\n[[2763.7]] <tit2><b>De absolute licitis aut illicitis, debitis aut indebitis</b> </tit2> </p>\n<p> [[2763.8]] Nullum impossibile, seu ut vulgo enuntiant impossibilium nulla obligatio est.\n [[2763.9]] <tab/>Nam impossibile nec a prudente fieri, et nullis poenis vel praemiis procurari\n[[2763.10]] potest, adeoque (per defin.) nec debitum est. </p>\n<p> [[2763.11]] Omne necessarium est licitum, seu ut vulgo enuntiant, necessitas non habet legem.\n [[2763.12]] <tab/>Nam necessarium a nemine adeoque nec a prudente omitti potest, sive\n[[2763.13]] necessarium nullo modo, ac proinde nec praemiis et poenis impediri potest,\n[[2763.14]] ergo (per defin.) nec illicitum est. </p>\n<p> [[2763.15]] Nullum ex quo miseria agentis necessario sequitur, debitum est, seu nemo miser esse\n[[2763.16]] obligatur. </p>\n<p> [[2763.17]] Omne ex quo felicitas agentis necessario sequitur licitum est, seu nemo felix esse\n[[2763.18]] prohibetur.\n [[2763.19]] <tab/>Hae duae propositiones eodem modo demonstrantur. Debita enim aut illicita\n[[2763.20]] praemiis poenisque procurari aut impediri possunt scilicet in recte ratiocinante,\n[[2763.21]] ergo minora bona malave sunt quam ipsa praemia aut ponae. Sed\n[[2763.22]] felicitas et miseria bonorum et malorum maxima sunt (ut constat ex definitionibus),\n[[2763.23]] ergo nec miseria est debita, nec felicitas est illicita. </p>\n<p> [[2763.24]] Ex quo sequitur felicitas communis, id debitum est. </p>\n<p> [[2764.1]] Ex quo sequitur miseria communis id illicitum est.\n [[2764.2]] <tab/>Felicitas enim et miseria communis sunt maximum bonum et malum Societatis\n[[2764.3]] et continent felicitatem et miseriam singulorum. Concurrunt ergo\n[[2764.4]] bonum societatis et prudentia agentis. Hinc etiam singuli recte ratiocinantes\n[[2764.5]] ad felicitatem ferri possunt aut a miseria prohiberi praemiis poenisque neque\n[[2764.6]] enim fieri potest, ut alterius majoris boni malive spe aut metu teneantur. </p>\n",
  "number": "492₄.",
  "title": "De absolute licitis aut illicitis, debitis aut indebitis",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:492₄. De absolute licitis aut illicitis, debitis aut indebitis De absolute licitis aut illicitis, debitis aut indebitis Nullum impossibile, seu ut vulgo enuntiant impossibilium nulla obligatio est. Nam impossibile nec a prudente fieri, et nullis poenis vel praemiis procurari potest, adeoque (per def...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_vi4_629","series":"Band VI 4 (1677 - 1690)","seq":629,"text":"[[2763.1]] <b>492₄.  De absolute licitis aut illicitis, debitis aut indebitis\n[[2763.7]] <tit2><b>De absolute licitis aut illicitis, debitis aut indebitis</b> </tit2> </p>\n<p> [[2763.8]] Nullum impossibile, seu ut vulgo enuntiant impossibilium nulla obligatio est.\n [[2763.9]] <tab/>Nam impossibile nec a prudente fieri, et nullis poenis vel praemiis procurari\n[[2763.10]] potest, adeoque (per defin.) nec debitum est. </p>\n<p> [[2763.11]] Omne necessarium est licitum, seu ut vulgo enuntiant, necessitas non habet legem.\n [[2763.12]] <tab/>Nam necessarium a nemine adeoque nec a prudente omitti potest, sive\n[[2763.13]] necessarium nullo modo, ac proinde nec praemiis et poenis impediri potest,\n[[2763.14]] ergo (per defin.) nec illicitum est. </p>\n<p> [[2763.15]] Nullum ex quo miseria agentis necessario sequitur, debitum est, seu nemo miser esse\n[[2763.16]] obligatur. </p>\n<p> [[2763.17]] Omne ex quo felicitas agentis necessario sequitur licitum est, seu nemo felix esse\n[[2763.18]] prohibetur.\n [[2763.19]] <tab/>Hae duae propositiones eodem modo demonstrantur. Debita enim aut illicita\n[[2763.20]] praemiis poenisque procurari aut impediri possunt scilicet in recte ratiocinante,\n[[2763.21]] ergo minora bona malave sunt quam ipsa praemia aut ponae. Sed\n[[2763.22]] felicitas et miseria bonorum et malorum maxima sunt (ut constat ex definitionibus),\n[[2763.23]] ergo nec miseria est debita, nec felicitas est illicita. </p>\n<p> [[2763.24]] Ex quo sequitur felicitas communis, id debitum est. </p>\n<p> [[2764.1]] Ex quo sequitur miseria communis id illicitum est.\n [[2764.2]] <tab/>Felicitas enim et miseria communis sunt maximum bonum et malum Societatis\n[[2764.3]] et continent felicitatem et miseriam singulorum. Concurrunt ergo\n[[2764.4]] bonum societatis et prudentia agentis. Hinc etiam singuli recte ratiocinantes\n[[2764.5]] ad felicitatem ferri possunt aut a miseria prohiberi praemiis poenisque neque\n[[2764.6]] enim fieri potest, ut alterius majoris boni malive spe aut metu teneantur. </p>\n","number":"492₄.","title":"De absolute licitis aut illicitis, debitis aut indebitis","date":null}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>