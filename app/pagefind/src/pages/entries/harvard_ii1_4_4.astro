---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_4",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 4,
  "text": "<p> [[8.4]] <b>4. LEIBNIZ AN CHRISTIAN DAUM</p>\n<p> [[8.5]] Leipzig, 26. März (5. April) 1666. [5.]</b></p>\n<p> [[8.28]] Nobiliss^#'e et Cl^#'m^#'e Vir. </p>\n<p> [[8.29]] Cum simulac in notitiam Tuam veni, statim beneficium senserim; nolui prius scribere,\n[[8.30]] quam grati animi signum qualecunque dare liceret. Igitur quod plurimum a Te adjutus, ne\n[[8.31]] verbulo quidem, nisi per Cl^#'u^#'m Fellerum, vel gratias egi, aegre minime [Te] laturum, maxime\n[[8.32]] spero. Quamprimum autem exiit e praelo nostra <i>de Arte Combinatoria</i> dissertatiuncula, nihil\n[[8.33]] antiquius habui, quam mittere; partim ne moram excusandi jus, aut gratias agendi occasionem\n[[9.1]] perderem; partim ut recognosceres artes Tuas, et quorum pars magna es, ea ipse haberes. <i>De\n[[9.2]] Arte Combinatoria</i>, inscripsimus, magis ut satisfieret vulgi auribus, in quibus et Lullii artificium,\n[[9.3]] et Ath. Kircheri promissum increbuit, quam quod ita sentiremus. Neque enim variationem\n[[9.4]] conjunctionum tantum, sed et retenta [earundem] rerum complexione artificium situs\n[[9.5]] commutandi sumus executi. Plus tamen in Complexionibus operae posuimus, quod utiliores\n[[9.6]] hae, etsi transpositiones jucundiores. Nam et professi sumus in opusculo, et experturus credet,\n[[9.7]] hanc scientiarum omnium clavem esse, denique hujus praeceptis Universam Logicam inventivam\n[[9.8]] contineri. Dolendum quippe est hodie partem Logicam de Judicio ita prope solam\n[[9.9]] urgeri, ut negligatur inventio, aut, quae traduntur, pontes sint asinorum, distinctionum cruces,\n[[9.10]] canonum pessime intellectorum praecipitia. Sed haec apud peritissimum Virum frustra. Transpositiones\n[[9.11]] addidi, ut superiora severiora, et in fundamenta scientiarum aditum molientia,\n[[9.12]] jucunditate temperarem: Earum spectaculum commodissimum versus sunt Protei: Proteorum\n[[9.13]] Tui: Tuorum vero utinam theatrum satis editum esset hic libellus! qui si artis tuae magnitudinem\n[[9.14]] modo assecutus sit, satis se praestitisse credet. Nam tua recte expressa etiam in humili loco per\n[[9.15]] se lucent. Caeterum in nonnullis aliis haesi. Nam de Goldsteinii Proteo nihil fere compertum\n[[9.16]] habebamus praeter verba. Et Publilius Porphyrius Optatianus, Poeta vetus, aevi Constantinianaei\n[[9.17]] in manus nostras non nisi citatus venit; de quo quantum noveramus, in ipso opusculo\n[[9.18]] disseruimus. Utriusque notitiam pleniorem, si daretur vel nunc demum ex Te discere, Cl^#'m^#'e Vir,\n[[9.19]] quanti aestimaturus sim principia haec favoris in me Tui, ipse facile vides. Denique promtitudini\n[[9.20]] tuae juvandi me ignotum, aut potius per me familiarissimam tibi amicam, Rem Literariam;\n[[9.21]] gratias et nunc ago, et cum occasio erit, habiturus sum majores. Vale. Id precatur </p>\n<p> [[9.22]] Tibi quondam publico nomine, nunc privatim obstrictus </p>\n<p> [[9.23]] Lipsiae, 26. Martii 1666. M. Gottfredus Guilielmus Leibnüzius. </p>\n<p> [[9.24]] Nobiliss^#'o et Cl^#'m^#'o Christiano Daumio, Gymnasiarchae Zviccaviensi, de re Literaria meritissimo\n[[9.25]] Viro, Fautori Suo Honoratissimo. <Fn><i>Unterhalb der Anschrift von Daums Hand das Empfangsdatum</i>: 30 Martii 1666</Fn> </p>\n",
  "number": "4.",
  "title": "LEIBNIZ AN CHRISTIAN DAUM",
  "date": "Leipzig, 26. März (5. April) 1666. [5.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:4. LEIBNIZ AN CHRISTIAN DAUM Leipzig, 26. März (5. April) 1666. [5.] Nobiliss^#'e et Cl^#'m^#'e Vir. Cum simulac in notitiam Tuam veni, statim beneficium senserim; nolui prius scribere, quam grati animi signum qualecunque dare liceret. Igitur quod plurimum a Te adjutus, ne verbulo quidem, nisi per C...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii1_4","series":"Band II 1 (1663 - 1685)","seq":4,"text":"<p> [[8.4]] <b>4. LEIBNIZ AN CHRISTIAN DAUM</p>\n<p> [[8.5]] Leipzig, 26. März (5. April) 1666. [5.]</b></p>\n<p> [[8.28]] Nobiliss^#'e et Cl^#'m^#'e Vir. </p>\n<p> [[8.29]] Cum simulac in notitiam Tuam veni, statim beneficium senserim; nolui prius scribere,\n[[8.30]] quam grati animi signum qualecunque dare liceret. Igitur quod plurimum a Te adjutus, ne\n[[8.31]] verbulo quidem, nisi per Cl^#'u^#'m Fellerum, vel gratias egi, aegre minime [Te] laturum, maxime\n[[8.32]] spero. Quamprimum autem exiit e praelo nostra <i>de Arte Combinatoria</i> dissertatiuncula, nihil\n[[8.33]] antiquius habui, quam mittere; partim ne moram excusandi jus, aut gratias agendi occasionem\n[[9.1]] perderem; partim ut recognosceres artes Tuas, et quorum pars magna es, ea ipse haberes. <i>De\n[[9.2]] Arte Combinatoria</i>, inscripsimus, magis ut satisfieret vulgi auribus, in quibus et Lullii artificium,\n[[9.3]] et Ath. Kircheri promissum increbuit, quam quod ita sentiremus. Neque enim variationem\n[[9.4]] conjunctionum tantum, sed et retenta [earundem] rerum complexione artificium situs\n[[9.5]] commutandi sumus executi. Plus tamen in Complexionibus operae posuimus, quod utiliores\n[[9.6]] hae, etsi transpositiones jucundiores. Nam et professi sumus in opusculo, et experturus credet,\n[[9.7]] hanc scientiarum omnium clavem esse, denique hujus praeceptis Universam Logicam inventivam\n[[9.8]] contineri. Dolendum quippe est hodie partem Logicam de Judicio ita prope solam\n[[9.9]] urgeri, ut negligatur inventio, aut, quae traduntur, pontes sint asinorum, distinctionum cruces,\n[[9.10]] canonum pessime intellectorum praecipitia. Sed haec apud peritissimum Virum frustra. Transpositiones\n[[9.11]] addidi, ut superiora severiora, et in fundamenta scientiarum aditum molientia,\n[[9.12]] jucunditate temperarem: Earum spectaculum commodissimum versus sunt Protei: Proteorum\n[[9.13]] Tui: Tuorum vero utinam theatrum satis editum esset hic libellus! qui si artis tuae magnitudinem\n[[9.14]] modo assecutus sit, satis se praestitisse credet. Nam tua recte expressa etiam in humili loco per\n[[9.15]] se lucent. Caeterum in nonnullis aliis haesi. Nam de Goldsteinii Proteo nihil fere compertum\n[[9.16]] habebamus praeter verba. Et Publilius Porphyrius Optatianus, Poeta vetus, aevi Constantinianaei\n[[9.17]] in manus nostras non nisi citatus venit; de quo quantum noveramus, in ipso opusculo\n[[9.18]] disseruimus. Utriusque notitiam pleniorem, si daretur vel nunc demum ex Te discere, Cl^#'m^#'e Vir,\n[[9.19]] quanti aestimaturus sim principia haec favoris in me Tui, ipse facile vides. Denique promtitudini\n[[9.20]] tuae juvandi me ignotum, aut potius per me familiarissimam tibi amicam, Rem Literariam;\n[[9.21]] gratias et nunc ago, et cum occasio erit, habiturus sum majores. Vale. Id precatur </p>\n<p> [[9.22]] Tibi quondam publico nomine, nunc privatim obstrictus </p>\n<p> [[9.23]] Lipsiae, 26. Martii 1666. M. Gottfredus Guilielmus Leibnüzius. </p>\n<p> [[9.24]] Nobiliss^#'o et Cl^#'m^#'o Christiano Daumio, Gymnasiarchae Zviccaviensi, de re Literaria meritissimo\n[[9.25]] Viro, Fautori Suo Honoratissimo. <Fn><i>Unterhalb der Anschrift von Daums Hand das Empfangsdatum</i>: 30 Martii 1666</Fn> </p>\n","number":"4.","title":"LEIBNIZ AN CHRISTIAN DAUM","date":"Leipzig, 26. März (5. April) 1666. [5.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>