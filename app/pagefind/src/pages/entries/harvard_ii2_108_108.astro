a </p>\n","number":"109.","title":"MICHEL ANGELO FARDELLA AN LEIBNIZ","date":"Venedig, 27. April [1691]. [107.110.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
