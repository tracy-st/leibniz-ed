---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_223",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 223,
  "text": "<p> [[692.6]] <b>202. LEIBNIZ AN VINCENT PLACCIUS</p>\n<p> [[692.7]] [2. Hälfte] März 1679. [201.232.]</b></p>\n<p> [[692.21]] Ad Vincentium Placcium. Martii 1679 </p>\n<p> [[692.22]] Nobilissime et Consultissime Dⁿ^#'e Fautor Honoratiss^#'e </p>\n<p> [[692.23]] Quoniam ad resumendas de actionum divisione cogitationes me invitas, dicam quid\n[[692.24]] subinde de illo argumento cogitaverim; sed ita dicam, ut quicquid hoc est tuo judicio submissum\n[[692.25]] scias. </p>\n<p> [[692.26]] Itaque cum actio omnis in duobus consistat, petitione et petendi ratione, crediderim duo\n[[692.27]] quoque fundamenta esse dividendarum actionum, aliae enim varietates ab eo quod petitur, aliae\n[[692.28]] ab eo quod petendi jus facit nascuntur: sunt aliae quoque varietates, sed has velut potissimas\n[[692.29]] nunc persequi satis erit: praeterea considerandum est easdem species infimas ab uno eodemque\n[[693.1]] genere summo diversis modis posse derivari, prout per alia atque alia genera subalterna ire\n[[693.2]] constituimus. Et hinc potissimum oritur tanta varietas in autoribus idem argumentum methodice\n[[693.3]] tractare professis, quemadmodum illorum exemplo patet, qui virtutum aut affectuum species\n[[693.4]] continuatis subdivisionibus investigare voluere. </p>\n<p> [[693.5]] Unde illud sequitur si quis inter dividendum non tantum omnes species infimas enumerare,\n[[693.6]] sed et omnes species intermedias attingere velit, eum non debere una divisione esse\n[[693.7]] contentum, sed diversas methodos inter se conjungere oportere. </p>\n<p> [[693.8]] Quae ratio est cur ego methodum diaereticam utilem quidem putem, sed non perfectam.\n[[693.9]] Huic autem combinatoriam praefero, qua sola omnes species subalternae a genere summo\n[[693.10]] usque ad species infimas ordine enumerari possunt quemadmodum numeri in abaco, et cognationum\n[[693.11]] genera in arbore consanguinitatis. Est tamen diaeretica methodus praeludium combinatoriae\n[[693.12]] et si plures et diversas diversorum tabulas divisorias inter se conjungas, fieri potest ut\n[[693.13]] inde perfectam omnium specierum subalternarum enumerationem eruas. Sed hoc quidem\n[[693.14]] omisso ad divisiones nostras redeamus. </p>\n<p> [[693.15]] Ajo igitur cum in omni libello sit narratio et conclusio (nam libellus pro Enthymemate\n[[693.16]] haberi potest), actionum quae libellorum materiam faciunt divisionem vel ex narratione praeteriti\n[[693.17]] sumi vel ex petitione futuri seu conclusione. Narratio autem facti est. Facti multae sunt\n[[693.18]] varietates. Potest enim fieri aliquid casu, culpa, dolo; unde actiones in factum (id est quae\n[[693.19]] neque ex delicto neque ex contractu, et omnino non ex actione voluntaria sed ex ipsa re) item\n[[693.20]] actiones ex delicto vel quasi delicto: potest et factum aliquod esse legis instar, quod <b>dispositionem</b>\n[[693.21]] generali nomine vocare soleo, quale factum est contractus et ultima voluntas et Lex\n[[693.22]] publica. Cum contra delicta vel quasi delicta et quae casu fiunt, sint facta quae in nudis facti\n[[693.23]] finibus consistunt neque ipsa forma sed effectu tantum jus constituunt. Itaque si quis jurisprudentiam\n[[693.24]] factorum ordine persequi velit is primum de actionibus aget quae ex re potius sive\n[[693.25]] casu quam personae voluntate nascuntur, inde ad delicta perget, denique leges, nempe contractus\n[[693.26]] et ultimas voluntates tractabit. Et quae ex unoquoque facto nascuntur actiones enumerabit.\n[[693.27]] Sed alia plane ratione rem instituet, qui jus quod ex facto nascitur, et conclusiones ex\n[[693.28]] narratione libelli deductas primo spectabit. Itaque primum considerabit an id quod petitur in\n[[693.29]] praecisa quadam specie consistat, an in genere quodam aestimationem recipiente. Nam interdum\n[[693.30]] in rei arbitrio est rem an aestimationem solvere velit, interdum res ipsa praecise minis, vi,\n[[693.31]] vinculis, si opus, ei extorquenda est. Quod in praecisa quadam specie consistit, vel in actione\n[[693.32]] passioneve personae, vel in rei cujusdam traditione versatur. Quae ad praecisam actionem\n[[693.33]] passionemque personae referuntur a me vocari solent uno nomine personalissima qualia sunt\n[[693.34]] poenae corporales, reverentia obedientiaque quam subditi superioribus debent, servitia militaria\n[[693.35]] quae nunc milites sacramento adacti debent, olim etiam vasalli Ligii ita debebant ut invito\n[[693.36]] domino per substitutum praestari non possent. Huc pertinet matrimonii vinculum, servorum\n[[694.1]] nexus et omnino quicquid ita personam afficit, ut aestimationem invito actore non recipiat. Si\n[[694.2]] de praecisa rei cujusdam traditione agatur locum habet rei vindicatio aliaeque in rem actiones,\n[[694.3]] possum enim per judicem rem de qua agitur obtinere te invito et frustra aestimationem\n[[694.4]] offerente. Sequuntur ea quae ab hominibus non ita stricte exiguntur, sed aestimationem recipiunt\n[[694.5]] qualia sunt damnorum datorum repensationes, promissorum praestationes, cautiones\n[[694.6]] quaedam in futurum, aliaque id genus multa. Vides quam longe alia facies oriatur Methodicae\n[[694.7]] Jurisprudentiae si posteriorem viam sequaris. Quod si haec diversa dividendi fundamenta inter\n[[694.8]] se misceas ut fere fieri solet, aliaque adhuc plura divisionum capita conjungas, manifestum est\n[[694.9]] quanta oritura sit varietas. Quaeres quid mea sententia eligi praestet. Ego vero scopum ejus qui\n[[694.10]] jurisprudentiam tractat inspiciendum censeo. Itaque si quis artem Legislatoriam tradere velit et\n[[694.11]] elementa Jurisprudentiae ex civili doctrina repetere, ordinem factorum sequetur. Nam politici\n[[694.12]] est ostendere quo quodque loco in republica sit reponendum ne quid sit vacuum male collocatum,\n[[694.13]] otiosum, vanum, noxium. At qui Leges jam inventas ac conceptas tradere velit populo,\n[[694.14]] illi posterior enumerandi actiones ratio potior esse debet. Neque enim origines legum ac causas\n[[694.15]] tradere necesse est sed paucissimis et latissime patentibus formulis omnia definire, quod nulla\n[[694.16]] ratione compendiosius et generalius fieri potest, quam si admoneantur homines quid imposterum\n[[694.17]] petere aut praestare possint debeantve. Idem discrimen observandum est inter judicem et\n[[694.18]] advocatum. Nam judicis non est <b>invenire</b> ex facti narratione, quaenam petitio debuerit institui\n[[694.19]] sed potius <b>judicare</b> an conclusio ex narratis sequatur et an narrata sint probata. Contra\n[[694.20]] advocati aut privati est domi suae ratiocinari, quasnam actiones vel petitiones instituere debeat:\n[[694.21]] quo pertinet scientia cautelarum quae pars quaedam oeconomicae artis videri potest; nam\n[[694.22]] prudentis patrisfamilias est has artes intelligere. Itaque concludo inveniendae legis actionisque\n[[694.23]] gratia (quod politici aut oeconomi est) enumeranda esse facta quae jus pariunt; sed ut publicentur\n[[694.24]] inventae leges populo et ut actiones jam institutae dijudicentur pro tribunali, ab eo quod\n[[694.25]] petitur incipiendam esse considerationem. Sed haec ut vides festinata, judicio tuo subacto plane\n[[694.26]] summitto. A Vagetio nihil dudum vidi. </p>\n<p> [[694.27]] Celeberrimo Edzardo gratias agam quam primum. Vale faveque. </p>\n",
  "number": "202.",
  "title": "LEIBNIZ AN VINCENT PLACCIUS",
  "date": "[2. Hälfte] März 1679. [201.232.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:202. LEIBNIZ AN VINCENT PLACCIUS [2. Hälfte] März 1679. [201.232.] Ad Vincentium Placcium. Martii 1679 Nobilissime et Consultissime Dⁿ^#'e Fautor Honoratiss^#'e Quoniam ad resumendas de actionum divisione cogitationes me invitas, dicam quid subinde de illo argumento cogitaverim; sed ita dicam, ut qu...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>