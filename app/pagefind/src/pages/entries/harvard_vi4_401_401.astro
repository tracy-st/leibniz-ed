---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_401",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 401,
  "text": "[[1689.1]] <b>333.  Incerti autoris nota de metaphysica ex sententia Augustini scribenda [1677 bis 1716 (?)]</b>\n [[1689.3]] <tab/>[1677 bis 1716 (?)] </p>\n<p> [[1689.9]] Cum his diebus otium aliquod a consuetis laboribus mihi imperasset afflicta paulisper\n[[1689.10]] corporis valetudo, legere incepi D. Augustini <i>Confessionum</i> libros, antea non nisi\n[[1689.11]] nomine mihi notos, quae lectio tantum animum recreavit, ut summam quam de Augustino\n[[1689.12]] ex libris <i>de Civitate Dei</i> conceperam opinionem auxerit mirifice. Quamvis enim non\n[[1689.13]] ignorem Petrum Castellanum, Episcopum Matissonensem, Magnum Franciae Eleemosynarium,\n[[1689.14]] ita inimice insectatum esse hunc Ecclesiae Doctorem, <Fn>Notat id Petrus Gallandius, Regius Latinarum litterarum Professor, in <i>vita Petri Castellani</i>, quam Baluzius A. 1674 in 8^#'o edidit, c. 27 quod accipiens Baluzius in Praefatione monet, nemini mirum videri debere, quod Castellanus alicubi acerbe et contumeliose in Pontifices Romanos illorum temporum invehatur, etiamsi alioqui de Sedis Apostolicae dignitate magnifice sentiret, et communionem cum ea retinendam esse putavit, cum nec ab Augustino quidem Hipponensi Episcopo se abstinuerit.</Fn> ut eum <b>bonarum\n[[1689.15]] artium magis non ignorantem, quam peritum</i> dici posse praedicaret, adeoque\n[[1689.16]] <b>ejus lucubrationes citra fastidium legi vix posse ab homine liberaliter\n[[1689.17]] in litteris educato, praeterea linguarum ignoratione somniasse frequenter\n[[1689.18]] atque etiam delirasse sacra explicando</i> asseveraret; tamen opus ejus\n[[1690.1]] <i>de Civitate Dei</i> doctissimae varietatis, hos vero <i>Confessionum</i> libros profundissimae\n[[1690.2]] veritatis deprehendisse mihi videor. Et operae quidem pretium esset scribi ab aliquo\n[[1690.3]] Metaphysicam ex sententia S. Augustini; uberrimam certe materiam inveniret; neque\n[[1690.4]] enim scio utrum argumentum hoc satis pro dignitate tractaverit Benedictus a S. Jacobo\n[[1690.5]] Ferrariensis, Congregationis fratrum Eremitarum Discalceatorum, sacrae Theologiae\n[[1690.6]] Lector, cujus <i>Tomus III. Augustini Philosophiae naturalis complectens ea, quae in libris\n[[1690.7]] de anima controvertuntur, verbis et sententiis ejusdem patris contentus et scholiis\n[[1690.8]] explicatus</i> Mediolani in forma, quam XII. vocant, prodiit, sed hactenus a me frustra\n[[1690.9]] quaesitus est. </p>\n",
  "number": "333.",
  "title": "Incerti autoris nota de metaphysica ex sententia Augustini scribenda",
  "date": "[1677 bis 1716 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:333. Incerti autoris nota de metaphysica ex sententia Augustini scribenda [1677 bis 1716 (?)] [1677 bis 1716 (?)] Cum his diebus otium aliquod a consuetis laboribus mihi imperasset afflicta paulisper corporis valetudo, legere incepi D. Augustini Confessionum libros, antea non nisi nomine mihi notos,...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>