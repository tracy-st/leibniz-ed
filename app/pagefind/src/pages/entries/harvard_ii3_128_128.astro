---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_128",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 128,
  "text": "<p> [[345.1]] <b>128. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[345.2]] Venedig, 5. Juli [1697]. [126.129.]</b></p>\n\n<p> [[345.13]] Ill^#'m^#'o Sig^#'r^#'e, Sig^#'r^#'e, mio Padron Col^#'m^#'o </p>\n<p> [[345.14]] Non posso esprimere a V. S. Ill^#'m^#'a quanto viva obligato alla generosa bontà del Sig^#'r^#'e Conte\n[[345.15]] Bertolli Consultore di Stato il quale colla sua grande autorità, eruditione e diligenza m' hà\n[[345.16]] finalmente ottenuta la copia dell'incluso diploma estratto dal suo vero originale che sta registrato\n[[345.17]] nel catastico del Monastero delle carceri, scritto con caratteri gotici, e molto oscuri, per\n[[345.18]] così dire deciferati dal migliore Scrittore che qui si trova. Io ne resto consolatissimo d' havere\n[[345.19]] una volta sodisfatto il suo genio, e servito cotesto Serenissimo Principe doppo tanti impedimenti,\n[[345.20]] ed una lunghissima ricerca che hà straccato il Sig^#'r^#'e Mocenigo, ed il Sig^#'r^#'e Zannovelli\n[[345.21]] agente del Serenissimo di Zel; a quali non hò ancora confidato il felice successo del ritrovato\n[[345.22]] privileggio, per non haverli veduti. Nei diplomi delle Carceri, non <angle bracket>v</angle bracket>'altro diploma che\n[[345.23]] appartenga a Duchi di Sassonia, e sono certissimo che si[a] quello che si cerca. Domenica\n[[345.24]] mattina io, il Sig^#'r^#'e Conte Bertolli, l'Ecc^#'m^#'o Proc^#'r^#'e Giustiniani si portassimo in San Marco e doppo\n[[345.25]] essere saliti per una vecchia e laboriosa scala, trovassimo nella sommità del Tempio la camera\n[[345.26]] dell'Abbate Gioachimo, in faccia alla quale vi era una piccola stanza, e perche non si trovavano\n[[346.1]] le chiavi, si ruppero le porte, dentro vi trovassimo una grandissima quantità di scritture e\n[[346.2]] diplomi appartenenti alla Seren^#'m^#'a Republica, con un grandissimo Armario, ove si custodiscono i\n[[346.3]] manuscritti del Petrarca, mi fù permesso di ricercarli tutti, ed havendoli attentamente essaminati\n[[346.4]] non fù possibile trovare questo piccolo dittionario della lingua persico cumana. Questi manuscritti\n[[346.5]] sono tutti laceri, e consumati dal tempo. Il Sig^#'r^#'e Conte Bertolli stima che sieno stati\n[[346.6]] rubbate le scritture più cospicue, ed insigni del Petrarca, e resta molto addolorato di non haverla\n[[346.7]] potuto servire circa que<angle bracket>ll</angle bracket>o particolare, e mi creda che non è stato poco d'entrare in un luogo\n[[346.8]] così geloso coll'autorità di copiare quel che c'abbisognava a modo nostro. Io hò fatto già tutte\n[[346.9]] le diligenze, e mi dispiace che non si trovi questo manuscritto da essa tanto bramato, gradirà la\n[[346.10]] mia buona volontà. Io farò tutto per trovare il soldo necessario di mettermi in viaggio e quando\n[[346.11]] non potessi eseguire quanto hò già risolto, ne dia la colpa all'impotenza in cui mi trovo di fare\n[[346.12]] un viaggio così dispendioso havendo già consumato quasi tutto il mio soldo in piantare casa in\n[[346.13]] Padova. Del resto raccomando all'amore generoso di V. S. Ill^#'m^#'a il nostro comune amico acciò le\n[[346.14]] possa trovare qualche nuova occasione d'accommodarsi con decoro e quiete, essendo egli\n[[346.15]] risolto di eseguire quanto le scrisse, quando ella si degnarà colla sua autorità favorirle attendo\n[[346.16]] con impatienza sue risposte, e pregandola dell'onore de' suoi stimatissimi comandi, inalterabilmente\n[[346.17]] mi protesto </p>\n<p> [[346.18]] Di V. S. Ill^#'m^#'a Umil^#'m^#'o, Div^#'m^#'o, Oblig^#'m^#'o S^#'r^#'e vero Michel Angelo Fardella </p>\n<p> [[346.19]] Venetia 5 Luglio </p></p>\n",
  "number": "128.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Venedig, 5. Juli [1697]. [126.129.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:128. MICHEL ANGELO FARDELLA AN LEIBNIZ Venedig, 5. Juli [1697]. [126.129.] Ill^#'m^#'o Sig^#'r^#'e, Sig^#'r^#'e, mio Padron Col^#'m^#'o Non posso esprimere a V. S. Ill^#'m^#'a quanto viva obligato alla generosa bontà del Sig^#'r^#'e Conte Bertolli Consultore di Stato il quale colla sua grande autori...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>