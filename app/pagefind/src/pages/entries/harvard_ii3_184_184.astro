import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_184",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 184,
  "text": "<p> [[467.1]] <b>184. CLAUDE NICAISE AN LEIBNIZ</p>\n<p> [[467.2]] Dijon, 16. Oktober 1698. [181.189.]</b></p>\n\n<p> [[467.7]] Dijon le 16. 8^#'b^#'r^#'e <b>1698</b> </p>\n<p> [[467.8]] Je <Fn><i>Am Rand der Seite hat Leibniz eine Bemerkung von Nicaise, die sich wohl auf dem Umschlag befand, notiert</i>: Dispensés moy de mettre le Duc de Hanover sur vos lettres</Fn> suis surpris monsieur que dans la derniere que vous m'avés faict l'honneur de\n[[467.9]] m'ecrire, vous ne m'accusiés point la reception d'une lettre de mons^#'r le president Boisot que je\n[[467.10]] vous ay envoyée avant l'arrest du curé Quietiste; il vous promettoit dans cette lettre de faire\n[[467.11]] travailler à un nouveau memoire des pieces de la Bibliotheque de deffunct mons^#'r l'abbé son\n[[467.12]] frere, pour reparer la perte que vous avés faicte du premier. J'ay envoyé il y a long tems au\n[[467.13]] P. Bonjour la lettre de m^#'r Ludolfi, et je l'ay averti aujourdhuy d'y repondre. Mons'r Bayle m'a\n[[467.14]] mandé en m'envoyant son <i>dictionnaire</i> qu'il avoit envoyé à mons^#'r de Bauval à la Haye vostre\n[[467.15]] sentiment sur l'amour desinteressé pour le mettre dans son journal. J'ay écrit aujourdhuy à\n[[467.16]] mad^#'e^#'l^#'l^#'e de Scudery pour la remercier des agreables nouvelles qu'elle m'avoit mandé[es] dans sa\n[[468.1]] derniere et sur tout de celle qui regarde mad^#'e Guyon, qui dans la derniere foire de S^#'t Laurent à\n[[468.2]] Paris avoit esté representée par les marionnettes fort agreablement comme pleine et regorgeante\n[[468.3]] de grace, ainsy qu'un torrent qui se remplit et se desborde de tems en tems sur tout ce qui\n[[468.4]] l'environne. Je luy ay donné en eschange son amant pûr et desinteressé, mons^#'r de Cambray[,]\n[[468.5]] Comedie dont la scene est à Rome sous le Tiltre de <i>Nouvelle Babel ou les Baragoins mystiques</i>.\n[[468.6]] Voicy l'argument en vers\n [[468.7]] <i>Fenelon elevoit une orgueilleuse Tour,</i>\n [[468.8]] <i>plus superbe cent fois que la Babilonique,</i>\n [[468.9]] <i>pour guinder jusqu'au ciel sa canaille mystique;</i>\n [[468.10]] <i>qui deja s'atroupoit dans les lieux d'alentour;</i>\n [[468.11]] <i>mais l'orgueil de nouveau se trouve confondû,</i>\n [[468.12]] <i>en jargon inconnû chaque Beat jargonne;</i>\n [[468.13]] <i>Fenelon ne s'est faict entendre de personne</i>\n [[468.14]] <i>et luy même de plus ne s'est pas entendû.</i> </p>\n<p> [[468.15]] Autre sur l'amour pûr et desinteressé\n [[468.16]] <i>Fenelon succombant aux foiblesses humaines</i>\n [[468.17]] <i>a menti, ce n'est rien; mais il s'est parjuré;</i>\n [[468.18]] <i>pouvoit il mieux monstrer qu'un mystique épuré</i>\n [[468.19]] <i>n'espere, ni ne craint, ni promesses, ni peines.</i> </p>\n<p> [[468.20]] Ces mots de <i>canaille mystique</i> ont assés plû à bien des gens, et bien esté appliqués à mons^#'r\n[[468.21]] de Cambray, qui n'avoit que faire d'encanailler l'eglise, comme Il a faict de ces sortes de gens;\n[[468.22]] croit il qu'elle soit bien soutenûe, et bien eclairée par des visionnaires et des <i>alumbrados</i>, et que\n[[468.23]] les Athanases, les Chrisostomes, les Augustins et les Gregoires, ne luy suffisent pas pour cela?\n[[468.24]] Si le chevalier Bernin vivoit (luy qui s'est rendû immortel à la posterité par cet excellent\n[[468.25]] ouvrage de la chaire de S^#'t Pierre soutenûe par ces grands docteurs de l'eglise grecque, et latine)\n[[468.26]] il auroit de la peine à souffrir qu'on mit cette canaille en leur place; ce seroit jetter sur cette\n[[468.27]] chaire de la porcarie et de l'ordure, et se mocquer de ce scavant sculpteur d'une bien autre\n[[468.28]] maniere, que ne fist de mon tems à Rome un bel humeur Romanesque, qui le jour qu'on fit la\n[[468.29]] monstre et la decouverte de ce bel ouvrage à S^#'t Pierre, et que tout le monde admiroit à se\n[[469.1]] recrier, et surtout cette gloire et ces cherubins dorés qui éclairent cette chaire, fendit la presse et\n[[469.2]] dit agreablement <i>che Rimirate? una frittata attacata al muro</i>. Voilà le chevalier Bernin bien\n[[469.3]] recompensé de ses travaux: ce seroit en verité monsieur le plus grand malheur et le plus grand\n[[469.4]] scandale qui pust jamais arriver à l'eglise de Dieu que d'authoriser et d'approuver un livre si\n[[469.5]] pernicieux que celluy de mons^#'r de Cambray, comme me le mande tous les jours le 1^#'r et\n[[469.6]] incomparable abbé de la Trappe; Dieu ayme trop son eglise pour permettre un tel dereglement\n[[469.7]] et qu'on mette en la place des veritables docteurs des phantastiques, des visionaires, des\n[[469.8]] bamboches, des femmes; Il fault distinguer entre les vrays et les faux mystiques, d'une autre\n[[469.9]] maniere que ne faict mons^#'r de Cambray dans son livre; mais bien comme vous l'aurés pû voir\n[[469.10]] dans le dernier ouvrage de m^#'r de Meaux intitulé <i>Mystici in tuto, Schola in tuto, Quietismus\n[[469.11]] Redivivus</i> par où ce prelat faict voir à m^#'r de Cambray que c'est en vain qu'il se prevault des\n[[469.12]] mystiques et de l'ecole, que celle cy, ni les autres ne sont point pour luy et que quelque\n[[469.13]] semblant qu'il fasse de n'estre point du sentiment de sa bonne amye mad^#'e Guyon, et de celluy\n[[469.14]] de Molinos il ressuscite neanmoins leur erreurs. En voilà assés mons^#'r sur un chapitre, où l'on a\n[[469.15]] de la peine à se contenir et à ne pas temoigner son zele. Pardonnés le moy je vous en prie;\n[[469.16]] venons à d'autres choses. </p>\n<p> [[469.17]] M^#'r Henninius professeur des belles lettres à Duisbourg a traduit en latin le livre de Bergier\n[[469.18]] <i>des grans chemins de l'empire</i>, il y a mis plusieurs notes remplies d'erudition, tout cela est\n[[469.19]] inseré dans le 9. vol. du <i>Thesaurus Antiquitatum Romanarum</i> que mons^#'r Graevius faict imprimer\n[[469.20]] à Utrêcht. Le même mons^#'r Hennin a monstré un mss. tres curieux à mons^#'r Bayle; ce sont\n[[469.21]] <i>vasa Cumana</i> tres bien dessinés. Ils entreront peutestre dans le <i>Thesaurus Antiquitatum Graecarum</i>\n[[469.22]] que mons^#'r Gronovius faict imprimer à Leyde. Mons^#'r de Bauval me mande qu'il travaille\n[[469.23]] à un nouvau <i>dictionnaire</i> de Furetiere beaucoup augmenté, qu'on a deja achevé la\n[[470.1]] lettre <i>D</i>, qu'il paroist un livre intitulé <i>Memoire touchant le progrés du Jansenisme en Hollande</i>\n[[470.2]] par un Jesuite, qu'un Dominiquin faict imprimer à Liege une histoire de la congreg[ation] <i>de\n[[470.3]] Auxiliis</i>. Il pretend que tous les actes de cette cong[regation] qu'on a publiés jusqu'à present\n[[470.4]] sont faux sens en excepter ceux de S^#'t Amour. On me mande de Rome que le 2^#'d Tome <i>de musivis</i>\n[[470.5]] de mons^#'r Ciampini estoit imparfaict à sa mort. Mes complimens à nostre cher et bon amy mons^#'r\n[[470.6]] Morel et mes excuses si je ne luy ecris pas aujourdhuy; ce seroit pour une autre fois. Je viens de\n[[470.7]] recevoir une lettre de mons. de Spanheim auquel je feray une ample mention de luy dans ma\n[[470.8]] reponse. Je suis monsieur Tout à vous. </p></p>\n",
  "number": "184.",
  "title": "CLAUDE NICAISE AN LEIBNIZ",
  "date": "Dijon, 16. Oktober 1698. [181.189.]"
};
