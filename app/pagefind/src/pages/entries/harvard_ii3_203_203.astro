---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_203",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 203,
  "text": "<p> [[537.1]] <b>203. CLAUDE NICAISE AN LEIBNIZ</p>\n<p> [[537.2]] Dijon, 12. März 1699. [195.213.]</b></p>\n\n<p> [[537.21]] Dijon le 12. Mars <b>1699</b> </p>\n<p> [[537.22]] Voilà <Fn><i>Am Kopf der Seite von Leibniz' Hand</i>: resp.</Fn> enfin monsieur la reponse du p. Bonjour à mons^#'r Ludolfe. J'i joincts la copie de la\n[[537.23]] derniere lettre du Roy au Pape, et celle que mons^#'r l'abbé de la Charmoye autrement Dom Paul\n[[537.24]] Pezron auteur de <i>l'Antiquité des tems</i> m'a écript[e], touchant <b>l'origine des nations</b>; la\n[[537.25]] lettre du Roy au Pape luy a produit un bref du S^#'t Pere qui luy promet une prompte decision du\n[[537.26]] livre de mons^#'r de Cambray accompagné de beaucoup de compliments qui font croire aux\n[[537.27]] speculatifs que Rome ne decidera que le plus tard qu'elle pourra ce que le Roy reconnoissant\n[[538.1]] assés, et ennuyé de ce retard a convoqué à Versailles plusieurs eveques qui y doivent concerter\n[[538.2]] une reponse à ce bref, pour [qu']au cas que Rome n'y ayt pas d'egard, ils avisent à ce qu'ils\n[[538.3]] auront à faire; en verité mons^#'r de Cambray se seroit bien passé de troubler la paix de l'eglise\n[[538.4]] comme il a faict par son livre mystique et metaphysique que peu de personnes comprennent,\n[[538.5]] non pas même luy, comme l'on luy reproche. On ne voit point <i>cui Bono</i> il a produit un systeme\n[[538.6]] si bizarre et si particulier si non pour se distinguer et se faire des fastes dans le monde; il ne\n[[538.7]] laisse pas d'ecrire tous les jours aussi bien que mons^#'r de Meaux; mais l'on est si las de tout cela\n[[538.8]] qu'on ne s'avise pas de lire leurs ouvrages; on lit plutost les <i>dialogues</i> attribués à la Bruyere et\n[[538.9]] celluy de Nicodeme et de Bonnefoy son compere qu'on attribue à une demoiselle fille d'un\n[[538.10]] procureur du parlement de Paris, que je ne doubte qu'on vous aura envoyé. Ces sortes de\n[[538.11]] questions bizarres sont plus propres à estre raillées qu'à estre traitées serieusement comme ont\n[[538.12]] faict mons^#'r de Meaux et les autres; cette miserable controverse trouble non seullement la\n[[538.13]] tranquillité des fideles comme dit le Roy dans sa lettre, mais ruine entierement la rep. des lettres\n[[538.14]] car l'on n'imprime plus rien de bon en France; mons^#'r Graevius m'a envoyé le Callimaque et les\n[[538.15]] lettres de Gudius aux scavants et des scavants à Gudius et celles de mons^#'r Sarrau entieres et\n[[538.16]] parfaictes trouvées dans le cabinet de m^#'r Gudius. J'ay felicité mons^#'r de Spanheim sur son vaste\n[[538.17]] et scavant commentaire sur Callimaque; il me temoigne bien de la joye dans ses dernieres de\n[[538.18]] l'heureux retour de monseig^#'r d'Avranches à Paris. Ce scavant prelat regarde Callimaque comme\n[[538.19]] son poete favori, il me prie toujours dans les siennes de vous faire ses compliments. Il me\n[[538.20]] marque dans sa derniere qu'il ne respire que pour vostre <i>Codex Juris gentium diplomaticus</i>, et\n[[538.21]] qu'il veûst mal à vostre imprimeur de n'en avoir point envoyé en France; un de mes amis de\n[[538.22]] Paris qui en avoit veû un exemplaire chés mons^#'r Toinard à qui vous en aviés faict present\n[[538.23]] m'ecrivit qu'il s'etonnoit que vous aviés oublié ce prelat, et en rejettoit la faulte sur m^#'r Leers;\n[[538.24]] faictes part à mons^#'r Morell de la lettre de m^#'r l'abbé de la Charmoye et de celle du Roy; Je suis\n[[538.25]] Mons^#'r tout à vous </p>\n<p> [[538.26]] Nicaise </p>\n",
  "number": "203.",
  "title": "CLAUDE NICAISE AN LEIBNIZ",
  "date": "Dijon, 12. März 1699. [195.213.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:203. CLAUDE NICAISE AN LEIBNIZ Dijon, 12. März 1699. [195.213.] Dijon le 12. Mars 1699 Voilà Am Kopf der Seite von Leibniz' Hand: resp. enfin monsieur la reponse du p. Bonjour à mons^#'r Ludolfe. J'i joincts la copie de la derniere lettre du Roy au Pape, et celle que mons^#'r l'abbé de la Charmoye a...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>