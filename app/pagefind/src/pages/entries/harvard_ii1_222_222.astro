---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_222",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 222,
  "text": "<p> [[690.1]] <b>201. VINCENT PLACCIUS AN LEIBNIZ</p>\n<p> [[690.2]] Hamburg, 5. (15.) März 1679. [188.202.]</b></p>\n<p> [[690.15]] S. P. Vir Nobilissime Excellentissime, Domine Fautor et Amice honoratissime </p>\n<p> [[690.16]] Responsum ad Tuas XVII. Septembris datas jure mihi differre posse videbar, quamdiu a\n[[690.17]] Dⁿ^#'o Etzardo nihil responsi tuis adjunctis ad ipsum, pro quibus curandis unice tunc ad me\n[[690.18]] scripseras, impetravissem. Et vero hucusque virum urgere non destiti, occupatum, ut semper:\n[[690.19]] ita nunc etiam arthriticis doloribus aliquamdiu jam male vexatum. Interim tamen adjunctas quas\n[[690.20]] vides tandem ab ipso impetravi. Dⁿ^#'u^#'s Vagetius responsorias ante octiduum jam conceptas\n[[690.21]] habebat, adeoque sine dubio jam dimisit. Siverum hisce diebus non habui compellandi occasionem. </p>\n<p> [[690.23]] Meas quod Actionum divisiones una denuo meditari nolueris, in damnis reputo litterariis. </p>\n<p> [[690.25]] Nam uti prioribus Tuis monitionibus, ita sane secundis etiam ad cogitanda hactenus\n[[690.26]] incogitata me sine dubio excitavisses. Ego interim aliquoties, ubi per otii atque virium penuriam\n[[690.27]] licuit, aliquantisper ad eas meditationes reversus; observavi equidem fieri posse ut reducantur\n[[690.28]] tandem posteriores binae classes ad priorum capita. Idque ita ut praemoneatur in\n[[690.29]] generalibus (1.) Damna illa quemque per se vel per alium dare posse. (2.) Per nos ipsos alii, ac\n[[690.30]] inde damnum iterum nobis ex promanante hinc obligatione. (3.) Haec imputari debere suo\n[[690.31]] principio sicut actiones morales omnes, adeoque inde correctionis quoque petendum principium.\n[[690.32]] (4.) Novam hisce casibus intervenire corrigendi rationem in caeteris immediatis laesionibus\n[[691.1]] non aeque occurrentem. Repraesentationem videlicet sive receptionem aut susceptionem\n[[691.2]] personae alienae; sive laedentis propter ipsius culpam aut dolum, sive meae hinc obligatae, v.\n[[691.3]] gr. meas actiones passive recipiendo, aut obligationes etc. vel alterius mihi personam repraesentando,\n[[691.4]] a quo propter ipsum non poterit mihi satisfieri. Hisce ita praemonitis deinde aut\n[[691.5]] lectori foret hoc relinquendum ad singulas enumeratarum actionum subintelligere, aut singulae\n[[691.6]] actiones forent iterum subdividendae, quatenus laesio illa per alium mihi facta fuisset, aut per\n[[691.7]] me alteri data me rursus obligasset: imprimis quoties modus hinc corrigendi variandus foret.\n[[691.8]] Unde aut longe major multiplicatio divisionum, aut imperfecta doctrina resultaret, ac ob illas\n[[691.9]] lectori faciendas ubique prout oportebat subdivisiones obscura et intricata. Quamobrem omnino\n[[691.10]] tandem concludo satius esse ut hae paucae divisiones quarti atque quinti ordinis universales\n[[691.11]] retineantur, quas deinde facile ad singulas species laesionum in prioribus trinis ordinibus\n[[691.12]] recensitarum partite quilibet applicando, uniuscujusque facti correctionem citra haesitationis\n[[691.13]] aut erroris motum queat constituere, atque combinando quoties exemplum exigit determinare.\n[[691.14]] Hoc etiam ea occasione venit in mentem. Annon omnis omnino tollendae obscuritatis ergo,\n[[691.15]] expediat, singulis actionibus exemplum addere: imo generales hasce actiones per species\n[[691.16]] singulas exemplis deinde a prima usque ad ultimam illustrare. Ita vel minus attento, aut magis\n[[691.17]] etiam hebeti lectori pateret horum universalium usus, ad quae mentem alioqui abstrahere paucis\n[[691.18]] lubet, aut licet. Quin adeo non inconsultum fore crediderim etiam plusculas actiones compositas\n[[691.19]] in casibus datis exhibere, et hac ratione combinationis et ejus iterum faciendae analyse<greek>vw</greek>\n[[691.20]] modum ostendere. Sane huc spectat illud exercitium quod sub finem operis Lectori commendavimus.\n[[691.21]] Ut nempe videat quomodo Actiones juris Civilis contineantur naturalibus. Quamvis\n[[691.22]] hoc etiam magis adhuc compositum est, adeoque magis etiam intricatum illo quod in naturalibus\n[[691.23]] actionibus subsistens positiva jura nondum intermiscet; proinde ut purius et mere scientificum,\n[[691.24]] ita longe quoque facilioris est applicationis. </p>\n<p> [[691.25]] Quaeso de hisce tuam mihi sententiam nunc exponere, ac amicitiam illam Philosophicam\n[[691.26]] Aristotelis l. IX. <i>Nic.</i> c. XII. laudatam <greek>ĕn tṽ symfilosofeĩn</greek> positam strenue continuare\n[[691.27]] perge. De Lexicis Germanicis etiam quaeso respondere ne graveris. Est etiam inter libros\n[[691.28]] Fogelianos Physicos in 4^#'t^#'o Num. 500. Tractatus Franc. Verde <i>de foetus animationis et nativitatis\n[[691.29]] tempore</i>. Eum quaeso describere mihi velis qualis sit, mole, tractandi ratione ac methodo.\n[[691.30]] Imprimis an Juridica contineat et qualia praeter propter. An Lugduni Galliae vel Batavorum\n[[691.31]] impressus. De Huetii opere libens audio: sed magis illud videre gestio. Quamvis non videatur\n[[691.32]] ad illud argumentum in quo ego laboravi, nempe de suspicienda ex naturalibus notitiis Philosophicis\n[[691.33]] revelationis necessitate atque constitutione, multum posse contribuere. Sed fortassis\n[[691.34]] inspectio ipsa penitius aperiet plura. Ea facta renunciare quid sentias ne gravare. Ego quibus\n[[691.35]] potero vicissim me Tibi commodabo modis. Vale </p>\n<p> [[692.1]] Hamb. 1679 d. 5. Martii. Excell. T. N. cultor observantissimus V. Placcius </p>\n<p> [[692.2]] P. S. De mea circa <i>Judiciariam Astrologiam Epistola</i> judicium tuum adhuc desidero, quod\n[[692.3]] quaeso prima occasione impertias. Vale iterum. </p>\n<p> [[692.4]] <i>A Monsieur Monsieur Leibnütz. Conseiller de son Altesse de Braunsveig Lunebourg. à\n[[692.5]] Hanover.</i> </p>\n",
  "number": "201.",
  "title": "VINCENT PLACCIUS AN LEIBNIZ",
  "date": "Hamburg, 5. (15.) März 1679. [188.202.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:201. VINCENT PLACCIUS AN LEIBNIZ Hamburg, 5. (15.) März 1679. [188.202.] S. P. Vir Nobilissime Excellentissime, Domine Fautor et Amice honoratissime Responsum ad Tuas XVII. Septembris datas jure mihi differre posse videbar, quamdiu a Dⁿ^#'o Etzardo nihil responsi tuis adjunctis ad ipsum, pro quibus ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>