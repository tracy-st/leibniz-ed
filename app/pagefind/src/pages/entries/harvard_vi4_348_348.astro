---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_348",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 348,
  "text": "[[1490.1]] <b>292.  De natura Mentis et Corporis [Sommer 1683 bis Winter 1685/86 (?)]</b>\n [[1490.2]] <tab/>[Sommer 1683 bis Winter 1685/86 (?)]\n[[1490.7]] <tit2><b>De natura Mentis et corporis</b></tit2> </p>\n<p> [[1490.8]] Illae solae animae sunt Mentes in quas cadit cognitio sui ipsius seu conscientia. Hae\n[[1490.9]] solae praemiorum poenarumque sunt capaces, et solae habendae sunt pro civibus ejus\n[[1490.10]] Reipublicae cujus Rex est Deus. Ex mentibus autem eae solae felices sunt, quibus datur\n[[1490.11]] cognitio Dei. Aliud est percipere, aliud percipere quod perceperis, seu meminisse. In\n[[1490.12]] brutis itaque perceptionem agnosco sive sensum eorum quae fiunt, agnosco et imaginationem,\n[[1490.13]] sensu cessante manentem, et ideo recursum priorum imaginum, si qua nova\n[[1490.14]] imago uni priorum similis occasionem praebeat; sed non agnosco in illis conscientiam, ut\n[[1490.15]] scilicet oblata quadam cogitatione percipiant eam vel aliam similem, jam sibi affuisse.\n[[1490.16]] Reflexio itaque seu memoria vel conscientia, mentium propria est. Reflexio proprie est\n[[1490.17]] memoria cogitationis proxime praecedentis. In sui ipsius perceptione consistit imago\n[[1490.18]] divina nobis indita. Non puto ab ullo bruto exerceri illam vim quam in me experior cum\n[[1490.19]] volo ut cogitem me nunc cogitare, et hoc ipsum admirer, et continue in me replicem,\n[[1490.20]] nullo signi alicujus usu interveniente sed intima quadam perceptione, ubi vim simul nobis\n[[1490.21]] facimus imagines ab ea cogitatione avocantes amoliendo. <Fn><i>Am Rande</i>: Cogitatio videtur esse circa aliquam distinctam propositionem, secus perceptio.</Fn> Etiamsi fingeretur dissolutis\n[[1491.1]] membris Mentem nostram aliquandiu nova valde distincta non percipere, sed dormire, vel\n[[1491.2]] etiam nova percipere quae cum prioribus nullam habeant connexionem, ita ut illis\n[[1491.3]] durantibus non recordetur prioris status; tamen si quando post multos annorum milliones\n[[1491.4]] (nam intervallum finitum in aeternitate pro nullo est, et mille annis aut uno dormiisse\n[[1491.5]] perinde est) rediret status congruus ei qui aliquando fuit (proxime praecedenti tamen\n[[1491.6]] quippe diverso memoria non connexus), et praecedentium memoria rediret. Nullane in\n[[1491.7]] bruto cognitio distincta? </p>\n<p> [[1491.8]] Si fingamus animal aliquod instar papilionis ex verme factum, et antequam talis\n[[1491.9]] fieret vermis rursus ex alio forte adhuc minore factum, et ita porro retro, usque ad initium\n[[1491.10]] mundi, et ubi extinguitur rursus in vermiculum, vel aliquod animalculum insensibile\n[[1491.11]] redigi (neque enim de his vermibus loquor, qui per accidens ex membris oriuntur), anima\n[[1491.12]] semper in omnibus eadem manente, non erit quidem sola Metempsychosis in hoc animali,\n[[1491.13]] sed etiam Metasomatosis seu transformatio eritque non tantum eadem semper anima, sed\n[[1491.14]] et eadem semper substantia corporea. Poterit autem hoc animal post innumerabiles\n[[1491.15]] transformationes aliquando rursus redire ad prioris continuationem atque exaltationem\n[[1491.16]] seu perfectionem. Et credibile est ita esse ordinata haec omnia ut pulchrius id fieri non\n[[1491.17]] possit. In transformationibus quodammodo membra exurgentia jam affuerunt. Quaestio:\n[[1491.18]] an omnia animalia ejusdem speciei extinctione in eandem speciem transformentur. Sane\n[[1491.19]] ex erucis combustis non fierent papiliones. </p>\n",
  "number": "292.",
  "title": "De natura Mentis et Corporis",
  "date": "[Sommer 1683 bis Winter 1685/86 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:292. De natura Mentis et Corporis [Sommer 1683 bis Winter 1685/86 (?)] [Sommer 1683 bis Winter 1685/86 (?)] De natura Mentis et corporis Illae solae animae sunt Mentes in quas cadit cognitio sui ipsius seu conscientia. Hae solae praemiorum poenarumque sunt capaces, et solae habendae sunt pro civibus...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>