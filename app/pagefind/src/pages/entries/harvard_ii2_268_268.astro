---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_268",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 268,
  "text": "<p> [[816.14]] <b>271. LEIBNIZ AN JACQUES-BENIGNE BOSSUET</p>\n<p> [[816.15]] Hannover, 3. Juli 1694. [242.273.]</b></p>\n<p> [[817.1]] Monseigneur. </p>\n<p> [[817.2]] En <Fn><i>Am Kopf in L von Leibniz' Hand</i>: nicht also abgangen <i>und am Kopf in l von Leibniz' Hand</i>: A M. l'Eveque de Meaux <i>und</i> ist nicht abgangen</Fn> attendant ce que Mons. l'Abbé de Loccum m'a promis de nouveau, dont j'espere que\n[[817.3]] vous aurés quelque satisfaction; je vous envoye ces Meditations Philosophiques, que je sousmets\n[[817.4]] à Vostre jugement, qui est des plus eclairés, mais aussi des plus equitables. Si vous ne les\n[[817.5]] trouvés pas entierement rebutables, Monseigneur, je crois que M. le President Cousin les\n[[817.6]] recevant de vostre part, les mettroit bien dans son <i>Journal des Sçavans</i>. Mais je voudrois qu'on\n[[817.7]] n'y mist pas mon nom, pour sonder un peu le guay. D'autant que des Pensées de cette nature,\n[[817.8]] déplaisent pour le moins à neuf dixiêmes des Lecteurs; et leur déplairoient quand elles seroient\n[[817.9]] les plus solides du monde. Le petit nombre de ceux qui les pourra gouter et qui daignera de\n[[817.10]] s'informer de l'auteur, le connoistra aisément par les circomstances. Une partie des fondemens\n[[817.11]] de mes dynamiques y est contenue. Vous serés surpris peutestre vous même de la rehabilitation\n[[817.12]] de la philosophie reçue que j'entreprends en quelque façon. Mais vous verrés, Monseigneur,\n[[817.13]] que ce n'est pas à la legere, ny d'une maniere qui fasse tort aux nouvelles decouvertes. En\n[[817.14]] effect, je trouve que souvent il suffit de bien expliquer les anciens, sans qu'on ait besoin de\n[[817.15]] renverser les dogmes receus. Mais j'ay crû qu'il me seroit permis de bastir quelque chose de\n[[817.16]] nouveau sur leur fondemens. Et c'est ainsi que je crois avoir terminé le grand probleme de\n[[817.17]] l'origine des formes ou ames, en monstrant qu'il faut dire d'elles ce que les Gassendistes disent\n[[817.18]] de leur Atomes, sçavoir qu'elles ont esté créées avec le monde, ou du moins qu'elles ne\n[[817.19]] sçauroient commencer ny finir que par miracle, c'est à dire par creation ou annihilation. Cela se\n[[817.20]] doit dire de toute Substance qui a une veritable unité. Mais quoyqu'il me paroisse ainsi que les\n[[817.21]] ames ou formes enfoncées dans la matiere ont tousjours esté dans leur animal, qui n'est que\n[[817.22]] transformé par ce que nous appellons generation ou mort; j'ay un tout autre sentiment des\n[[817.23]] esprits et de nostre ame, qui en est un, qu'il faut exempter des revolutions de la matiere; Dieu\n[[817.24]] gouvernant les Esprits par des loix particulieres, ou plustost tout le reste de l'univers n'estant\n[[817.25]] fait que pour l'amour d'eux. Enfin je crois avoir resolu le grand probleme de l'union de l'ame et\n[[817.26]] du corps. On prendra mon explication pour une Hypothese, mais je la tiens pour demonstrée, il\n[[817.27]] auroit fallu trop remonter, pour donner cette demonstration. Je suis avec zele et attachement\n [[817.28]] / Monseigneur vostre tres humble et tres obeissant serviteur\n [[817.29]] / à Hanover 3 juillet 1694 Leibniz </p>\n<p> [[818.1]] P. S. Je demande pardon de ce que mes meditations cyjointes ne sont pas assez mises au\n[[818.2]] net. Je me suis avisé des additions, quand tout estoit déjà copié, et alors je n'avois pas à la main\n[[818.3]] un homme propre à les copier de nouveau. </p>\n",
  "number": "271.",
  "title": "LEIBNIZ AN JACQUES-BENIGNE BOSSUET",
  "date": "Hannover, 3. Juli 1694. [242.273.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:271. LEIBNIZ AN JACQUES-BENIGNE BOSSUET Hannover, 3. Juli 1694. [242.273.] Monseigneur. En Am Kopf in L von Leibniz' Hand: nicht also abgangen und am Kopf in l von Leibniz' Hand: A M. l'Eveque de Meaux und ist nicht abgangen attendant ce que Mons. l'Abbé de Loccum m'a promis de nouveau, dont j'esper...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>