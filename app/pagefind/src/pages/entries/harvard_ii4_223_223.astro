---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_223",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 223,
  "text": "<p> [[680.10]] <b>223. BARTHÉLEMY DES BOSSES AN LEIBNIZ</p>\n<p> [[680.11]] Hildesheim, 4. November 1707. [222.227.] </b></p>\n<p> [[680.16]] Illustrissime Domine, Patrone Colendissime </p>\n<p> [[680.17]] Accepi humanissimam tuam epistolam utramque inclusas ad Janningum nuper, ad Orbanum\n[[680.18]] heri destinavi. </p>\n<p> [[680.19]] Librarius noster opus mandatum strenue persequitur. Spero circa festa natalitia absolvendum,\n[[680.20]] ut si Hannoveram tunc venero, mecum deferre possim. Pater ille qui suum tibi libellum\n[[681.1]] obtulit, salutat<angle bracket>or</angle bracket>em demisse resalutat et quando opellam suam non prorsus improbas, alterum\n[[681.2]] eadem de materia opusculum quod nunc sub praelo est, expectare te jubet. De styli acerbitate\n[[681.3]] tecum fere sentio, et si unquam hujusmodi aliquid in lucem dare me contigerit aut necesse\n[[681.4]] fuerit, consilium tuum exemplumque secutus hanc, quam ais moderationis laudem affectabo.\n[[681.5]] Dudum id mihi persuasit lectio Tractatus de Satyra Gallice conscripti, ni fallor, ab Abbate\n[[681.6]] Villerio. Liceat Clazomeniis effrontes esse, uti bene Pelissonius tuus; nobis caritatis et humanitatis\n[[681.7]] leges esse sacras oportet. Quanquam acerbitatem inter et acrimoniam discrimen statuendum\n[[681.8]] arbitror. Nam Pelissonius ipse moderationem licet exactam professus, ob eamque a\n[[681.9]] multis laudatus, Juriaeum tamen acriter excepit certe; acerbe non item, aut si acerbitas haec\n[[681.10]] fuit[,] acerbis adversariis quo pacto sine acerbitate possit occurri vix video. Imo nec ab urbanis\n[[681.11]] quidem jocis abstinere semper posse videtur scriptor alioqui modestus, nam ridiculum acri\n[[681.12]] fortius ac melius magnas plerumque secat res. Adde quod si jocanti scriptori serio responderis,\n[[681.13]] nihil aegrius, uti nos responsorum Paschalis litteris provincialibus datorum sors edocuit. </p>\n<p> [[681.14]] Caeterum gaudemus et gratulamur nobis quod Beata Virgo apud vos Apologia opus non\n[[681.15]] habeat, quod de honestioribus dictum interpretor et verissimum esse scio. At apud alios certe\n[[681.16]] indigere videbitur, maxime post insertam nuper scripto publico propositionem sequentem:\n[[681.17]] <b>Scriptura sacra revelavit plurima Mariae peccata, enormia, grandia</b> quam qualicumque\n[[681.18]] explicatione temperatam protestantium omnium honestiorum auribus duram semper\n[[681.19]] visum iri nullus dubito. </p>\n<p> [[681.20]] Cum nuper Heiningam et ad vicina loca excurrissem, exhibitus est mihi vetus Codex\n[[681.21]] manuscriptus parthenonis illius privilegia complectens, ex quo raptim ea quae in adjecta carta\n[[681.22]] reperies excerpsi. Quae si alicujus usus esse tibi possint, integram plurium diplomatum descriptionem\n[[681.23]] confido impetrari posse saltem ex codice vetusto quem dixi, nam archivium ipsum ubi\n[[681.24]] Archetypa asservantur non facile recludent. Quod tamen operae pretium esset, cum plures in iis\n[[681.25]] diplomatis Anachronismos notare videar qui descriptoris imperitiae tribuendi utique sunt, cum\n[[682.1]] archetyporum caracter tam vetustus sit tamque ab hodierna scribendi ratione alienus ut\n[[682.2]] <angle bracket>aspi</angle bracket>tare necesse sit eum qui illis in rebus non sit versatus. </p>\n<p> [[682.3]] Liber quem famulo mittendum nominaveram est <i>Opus Thomae Nordtani Angli</i> de quo\n[[682.4]] saepius inter nos. </p>\n<p> [[682.5]] Recentissime ad nos perlatus est <i>Cursus Theologicus</i> Joannis Baptistae Gormaz Societatis\n[[682.6]] Jesu SS. Theologiae in pluribus Hispaniae Academiis, et in Gregoriana Collegii Romani\n[[682.7]] Professore Emerito. Tomi duo Augustae Vindelicorum Sumptibus Georgii Schluter Anno 1707. </p>\n<p> [[682.8]] Locum Perezii quem nuper inspexeras mittam proxime. Si quid ultra curatum voles, jube\n[[682.9]] et vale. Dabam Hildesiae 4 9^#'b^#'r^#'i^#'s 1707. </p>\n<p> [[682.10]] Illustrissimae dominationis tuae Humillimus et obedientissimus servus in Christo </p>\n<p> [[682.11]] Bartholomaeus des Bosses S J </p>\n",
  "number": "223.",
  "title": "BARTHÉLEMY DES BOSSES AN LEIBNIZ",
  "date": "Hildesheim, 4. November 1707. [222.227.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:223. BARTHÉLEMY DES BOSSES AN LEIBNIZ Hildesheim, 4. November 1707. [222.227.] Illustrissime Domine, Patrone Colendissime Accepi humanissimam tuam epistolam utramque inclusas ad Janningum nuper, ad Orbanum heri destinavi. Librarius noster opus mandatum strenue persequitur. Spero circa festa nataliti...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>