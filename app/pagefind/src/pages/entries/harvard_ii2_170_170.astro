---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_170",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 170,
  "text": "<p> [[580.1]] <b>172. LEIBNIZ AN MARIE DE BRINON</p>\n<p> [[580.2]] Hannover, 12./22. September 1692. [113.265.]</b></p>\n<p> [[580.9]] Hanover 12/22 Septemb. 1692. </p>\n<p> [[580.10]] La <Fn><i>Am Kopf der Seite</i> : A Madame de Brinon.</Fn> sagesse même ne pouvoit rien dire de plus vray que ce que Vous dites, Madame, à\n[[580.11]] l'occasion des Recherches Genealogiques, qu'il vaut beaucoup mieux que le nom d'un Prince\n[[580.12]] soit écrit au livre de vie, que dans quelque vieille pancartes. Le moyen d'y estre enregistré,\n[[580.13]] n'est pas tant de fonder quelque chapelle, que de faire du bien. Et le plus grand bien qu'on peut\n[[580.14]] faire c'est de rendre les hommes meilleurs tant par son exemple, que par les ordres qu'on y met.\n[[580.15]] Aimer la justice, soulager les maux, favoriser la vertu, glorifier Dieu par la connoissance de ses\n[[580.16]] merveilles, à l'egard de la nature et de la grace, ce sont les veritables titres de la Genealogie des\n[[580.17]] enfans de Dieu. Les preuves de la vraye noblesse sont dans nostre conscience. Tout prince\n[[580.18]] qu'on est, on est degradé par la mechanceté, par l'injustice, par la dureté de coeur, qui fait\n[[580.19]] mépriser les cris des miserables, par cette mollesse, qui fait qu'on ne pense qu'à ses plaisirs,\n[[580.20]] plût à Dieu que vos belles leçons fussent entendues de tout le monde, et qu'on en profitât par un\n[[580.21]] veritable soin du salut. </p>\n<p> [[580.22]] Je suis Madame etc. </p>\n",
  "number": "172.",
  "title": "LEIBNIZ AN MARIE DE BRINON",
  "date": "Hannover, 12./22. September 1692. [113.265.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:172. LEIBNIZ AN MARIE DE BRINON Hannover, 12./22. September 1692. [113.265.] Hanover 12/22 Septemb. 1692. La Am Kopf der Seite : A Madame de Brinon. sagesse même ne pouvoit rien dire de plus vray que ce que Vous dites, Madame, à l'occasion des Recherches Genealogiques, qu'il vaut beaucoup mieux que ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>