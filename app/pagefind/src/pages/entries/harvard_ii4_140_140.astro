---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_140",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 140,
  "text": "<p> [[459.8]] <b>140. BARTHÉLEMY DES BOSSES AN LEIBNIZ</p>\n<p> [[459.9]] Hildesheim, 20. August 1706. [135.141.] </b></p>\n<p> [[459.24]] Illustrissime Domine </p>\n<p> [[459.25]] Distuli responsum ad postremas I[llustrissimae] D[ominationis] T[uae] litteras, quod\n[[459.26]] Papebrochii responsorias expectarem una mittendas, quae necdum advenerunt: Significandum\n[[459.27]] interim duxi, esse hic adolescentem qui post octiduum Romam cogitet futurus ibidem Alumnus\n[[459.28]] Collegii Germanici, et Ptolomaeum magistrum auditurus. Qua occasione si quae forsan habes\n[[459.29]] quae Ptolomaeo communicata velis, poterunt commodissime transmitti. </p>\n<p> [[460.1]] Roma intelligimus proscriptas nuper e Scholis nostris esse triginta propositiones philosophicas,\n[[460.2]] e Cartesio Malebranchioque fere depromptas, quarum aliquas quia circa materiam a\n[[460.3]] te praeclare elucidatam versantur, et censura jam pridem tuo calculo comprobata est, hic a me\n[[460.4]] adduci non aegre feres. </p>\n<p> [[460.5]] 6^#'a <i>Modi vel Accidentia, in aliquo subjecto semel producta non amplius indigent actione\n[[460.6]] positiva cujusquam Causae ipsa conservantis, sed tamdiu durare debent donec positiva actione\n[[460.7]] Causae alicujus externae destruantur.</i> </p>\n<p> [[460.8]] 7^#'a <i>Ut aliquid de Quantitate Motus a Deo primum indita Materiae periisse crederetur,\n[[460.9]] Deum oporteret fingi mutabilem et inconstantem.</i> </p>\n<p> [[460.10]] 10^#'a <i>Essentia Materiae seu Corporis in Extensione consistit externa et actuali.</i> </p>\n<p> [[460.11]] 16^#'a <i>Est in Mundo certa ac definita Quantitas Motus, quae nec aucta unquam, nec\n[[460.12]] imminuta fuit. </i> </p>\n<p> [[460.13]] 19^#'a <i>Solus Deus est qui movere potest corpora; Angeli vero, Anima rationalis, ipsaque\n[[460.14]] corpora non sunt causae motus efficientes, sed occasionales tantum.</i> </p>\n<p> [[460.15]] 20^#'a <i>Creaturae non producunt Efficienter ullos Effectus, sed solus Deus illos ad praesentiam\n[[460.16]] illarum efficit: loca vero Scripturae, in quibus creaturis tribuitur actio, intelligenda sunt\n[[460.17]] sensu figurato.</i> </p>\n<p> [[460.18]] 21^#'a <i>Belluae sunt mera Automata, omni sensu et cognitione carentia.</i> </p>\n<p> [[460.19]] 22^#'a <i>Animae Rationalis unio cum corpore in eo solum consistit, quod Deus voluerit ad\n[[460.20]] certas mutationes corporis, certas in anima perceptiones aut motus excitari, et vice versa pro\n[[460.21]] certis animae cogitationibus seu voluntatibus, certos in corpore motus sequi.</i> </p>\n<p> [[460.22]] 23^#'a <i>Hanc motuum et affectionum communicationem non exigit ipsa corporis animaeque\n[[460.23]] natura sed solum decretum Dei liberum.</i> </p>\n<p> [[460.24]] 25^#'a <i>Corpora Mixta, etiam Brutorum non aliter differunt inter se, quam ex varia magnitudine,\n[[460.25]] situ, figura, textura, quiete vel motu atomorum sive particularum materiae insensibilium\n[[460.26]] quibus constant.</i> </p>\n<p> [[460.27]] 28^#'a <i>Nullae sunt formae substantiales corporeae a materia distinctae.</i> </p>\n<p> [[460.28]] Gratulor Censoribus nostris quod te conspirantem imo ducem nacti sint. Breve tuum, sed\n[[460.29]] succi plenum ad binas dubitationes meas postremas responsum, amplum meditandi campum\n[[461.1]] mihi suppeditavit. Qua de re scribam ad te prolixius ubi Papebrochii litteras accepero. Vale et\n[[461.2]] tuae mihi benevolentiae honorem conserva. Dabam Hildesii 20 Augusti 1706. </p>\n<p> [[461.3]] Illustrissimae Dominationis tuae Humillimus et obsequentissimus servus in Christo </p>\n<p> [[461.4]] Bartholomaeus Des Bosses S J </p>\n<p> [[461.5]] P. S. Inter relegendum video omissam esse a me propositionem 4^#'a^#'m quae sic habet: <i>Mens\n[[461.6]] nostra eo quod finita sit, nihil certi de infinito potest scire, proindeque a nobis disputari de illo\n[[461.7]] nunquam debet.</i> Cujus falsitatem utinam aliquando in promisso a te <b>de scientia infiniti</b> libro\n[[461.8]] demonstratam legamus. </p>\n",
  "number": "140.",
  "title": "BARTHÉLEMY DES BOSSES AN LEIBNIZ",
  "date": "Hildesheim, 20. August 1706. [135.141.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:140. BARTHÉLEMY DES BOSSES AN LEIBNIZ Hildesheim, 20. August 1706. [135.141.] Illustrissime Domine Distuli responsum ad postremas I[llustrissimae] D[ominationis] T[uae] litteras, quod Papebrochii responsorias expectarem una mittendas, quae necdum advenerunt: Significandum interim duxi, esse hic adol...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>