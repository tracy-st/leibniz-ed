---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_252",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 252,
  "text": "<p> [[728.10]] <b>252. LEIBNIZ FÜR GABRIEL WAGNER</p>\n<p> [[728.11]] [Ende März 1698.] [251.253.]</b></p>\n\n<p> [[729.1]] Vana disceptatio est, ubi vocabula diversimode accipiuntur. Si quis punctum intelligat\n[[729.2]] quod sit divisibile in infinitum, imo quod sit lineola, libens concedam ex talibus punctis lineam\n[[729.3]] componi. Sed punctum quod ego intelligo, partem habere non potest, et sic etiam ab Euclide et\n[[729.4]] aliis accipitur. </p>\n<p> [[729.5]] Hoc punctum ajo non nisi terminum esse seu rem privativam, nec (: ex linea :) <Fn>(: ex linea :): <i>Diese Passage hat Leibniz in l in eckige Klammern gesetzt, wohl um sie von der Abfertigung auszuschließen.</i></Fn> oriri nisi\n[[729.6]] per sectionem, demonstrare tamen ista in me nunc non susceperam, sed tantum objectionibus\n[[729.7]] contrariis respondere, idque sufficienter factum puto. Nam a me probationes exigere jam non\n[[729.8]] amplius opponere est. Exponere vero absurditates quae ex contrario consequuntur res est\n[[729.9]] majoris operae, studiumque postulat singulare non tantum in exponente, sed etiam in lecturo. </p>\n<p> [[729.10]] Quod elementa attinet, sciendum est non omnem magnitudinem, seu rem partibilem\n[[729.11]] componi ex elementis. Exemplo sit Unitas, cujus partes infinitis modis diversis assumi possunt,\n[[729.12]] veluti <zl>^#h(+5)^#h(+5)1<ne>2<be> et <zl>^#h(+5)^#h(+5)1<ne>2<be> , item <zl>^#h(+5)^#h(+5)1<ne>3<be> et <zl>^#h(+5)^#h(+5)2<ne>3<be> , item <zl>^#h(+5)^#h(+5)1<ne>4<be> et <zl>^#h(+5)^#h(+5)3<ne>4<be> , item <zl>^#h(+5)^#h(+5)1<ne>5<be> et <zl>^#h(+5)^#h(+5)4<ne>5<be> , item <zl>^#h(+5)^#h(+5)2<ne>5<be> et <zl>^#h(+5)^#h(+5)3<ne>5<be> etc. tot modis, quot numeri variari\n[[729.13]] possunt, imo etiam per incommensurabilia. Interim nullum vel fingi potest animo, elementum\n[[729.14]] unitatis, seu simplicissimum positivum cujus repetitione unitas constituatur, quodque adeo sit\n[[729.15]] minimum in Numeris. Eodem igitur modo se de continuo res habet, quod iisdem prorsus modis\n[[729.16]] quibus unitas secari potest; et, si daretur elementum continui, daretur et elementum unitatis seu\n[[729.17]] minimum numericum. </p>\n<p> [[729.18]] Haec ad rem illustrandam sufficere nunc arbitror, nam si omnia vellem discutere transverse\n[[729.19]] accepta in scheda transmissa, magnum laborem frustra sumerem. Si qua tamen superesse\n[[729.20]] videatur singularis difficultas, eoque proponatur animo, ut appareat subesse studium proficiendi\n[[729.21]] in cognitione veritatis, libenter et ut spero facile satisfaciam. </p>\n",
  "number": "252.",
  "title": "LEIBNIZ FÜR GABRIEL WAGNER",
  "date": "[Ende März 1698.] [251.253.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:252. LEIBNIZ FÜR GABRIEL WAGNER [Ende März 1698.] [251.253.] Vana disceptatio est, ubi vocabula diversimode accipiuntur. Si quis punctum intelligat quod sit divisibile in infinitum, imo quod sit lineola, libens concedam ex talibus punctis lineam componi. Sed punctum quod ego intelligo, partem habere...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>