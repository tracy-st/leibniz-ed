---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_219",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 219,
  "text": "<p> [[705.1]] <b>222. JACQUES-BENIGNE BOSSUET FÜR LEIBNIZ</p>\n<p> [[705.2]] [Meaux, 25. Juni 1693.] [214.228.]</b></p>\n<p> [[705.31]] [ ... ] Le <Fn><i>Am Kopf des Konzepts K von fremder Hand</i>: Lettre de M^#'r de Meaux à M^#'d^#'e de Brinon du 25 Juin 1693 <i>und am Kopf der Abschrift A von Ledieus Hand</i>: Entre juin et octobre 1693.</Fn> second doute regarde l'erreur des Monothelites. Avec la permission de M.\n[[705.32]] Leibniz, je m'etonne qu'il regarde cette question comme dependante d'une haute ­Metaphysique.\n[[706.1]] Il ne faut que sçavoir <Fn><i>Leibniz unterstreicht</i> que sçavoir <i>und merkt an</i>: Les Monothelites ne le sçavoient ils pas?</Fn> qu'il y a une ame humaine en J. C. pour sçavoir en meme temps qu'il y a\n[[706.2]] une volonté non seulement en prenant la volonté pour la faculté et le principe, mais encore en la\n[[706.3]] prenant pour l'acte, <Fn><i>Leibniz unterstreicht</i> pour l'acte <i>und merkt an</i>: Ouy. Mais la question est si alors l'acte du verbe et de l'ame, ne font qu'un seul acte. N'y a t-il pas des philosophes, qui croyent, que nous n'agissons qu'<i>actione Dei</i>?</Fn> les facult<angle bracket>ez</angle bracket> n'estant données que pour cela. </p>\n<p> [[706.4]] Ce qu'il dit que les actions sont des supposts selon l'axiome de l'ecole, ne signifie autre\n[[706.5]] chose sinon qu'elles luy sont attribuées <i><b>in concreto</b>: mais non pas que chaque partie n'exerce\n[[706.6]] pas son action propre comme en nous le corps et l'ame le font. Ainsi dans la personne de J. C.\n[[706.7]] le Verbe qui ne change point exerce toujours la mesme action: <Fn><i>Leibniz merkt am Rande an</i>: Tout cela est vray, mais la question est, s'il est tout à fait manifeste et indisputable, on trouvera bien des difficultés là dessus chez les Scholastiques mêmes.</Fn> l'Ame humaine exerce la sienne\n[[706.8]] sous la direction du verbe et cette action est attribuée au mesme verbe comme au suppost. Mais\n[[706.9]] que l'Ame demeure sans son action naturelle, c'est une chose si absurde en elle mesme qu'on\n[[706.10]] ne la comprend pas. <Fn><i>Leibniz merkt am Rande an</i>: Mais un monothelite dira que l'action de l'ame de J.C. et celle du verbe est une meme action. Si on ne le comprend pas, c'e[s]t une autre question.</Fn> Aussi paroist il clairement par les temoignages rapportez dans le concile\n[[706.11]] VI. et par une infinité d'autres qu'on a toujours cru deux volontez mesme quant à l'acte en J. C.\n[[706.12]] et si quelques uns ont cru le contraire c'est une preuve que les hommes sont capables de toute\n[[706.13]] absurdité quand ils ne prennent pas soin de demesler leurs idées: ce qui paroist à la verité dans\n[[706.14]] toutes les heresies: mais plus que dans toutes les autres dans celle des Eutyquiens dont celle des\n[[706.15]] Monothelites est une annexe. [ ... ] </p>\n",
  "number": "222.",
  "title": "JACQUES-BENIGNE BOSSUET FÜR LEIBNIZ",
  "date": "[Meaux, 25. Juni 1693.] [214.228.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:222. JACQUES-BENIGNE BOSSUET FÜR LEIBNIZ [Meaux, 25. Juni 1693.] [214.228.] [ ... ] Le Am Kopf des Konzepts K von fremder Hand: Lettre de M^#'r de Meaux à M^#'d^#'e de Brinon du 25 Juin 1693 und am Kopf der Abschrift A von Ledieus Hand: Entre juin et octobre 1693. second doute regarde l'erreur des M...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>