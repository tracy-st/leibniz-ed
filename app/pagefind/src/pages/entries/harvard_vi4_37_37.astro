import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_37",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 37,
  "text": "[[86.5]] <b>31.  Atlas universalis [Sommer bis Herbst 1678 (?)]</b>\n [[86.6]] <tab/>[Sommer bis Herbst 1678 (?)]\n[[86.15]] <tit2><b>Atlas universalis </b> </tit2> </p>\n<p> [[86.16]] Habetur hactenus Atlas Geographicus. Item Atlas Astronomicus sive coelestis. Mihi\n[[86.17]] autem in mentem venit Encyclopaediam totam Atlante quodam Universali egregie comprehendi\n[[86.18]] posse. Primum enim pleraque quae doceri discique oportet oculis subjici possunt.\n[[86.19]] Jam <i>segnius</i> <i>irritant animos immissa per aures, quam quae sunt oculis subjecta\n[[86.20]] fidelibus</i>. Nec dubitandum est opus hujusmodi fore omnium Bibliothecarum, et inprimis a\n[[86.21]] viris illustribus quaesitum iri, quibus simul oculos animamque pascet, ut juventutem\n[[86.22]] taceam generosam, et compendio docendam, et a verbis ad res mature traducendam. Hic\n[[86.23]] autem Atlas ita instituetur: </p>\n<p> [[87.1]] Habeantur inprimis libri, qui dogmata sua figuris illustrant; item collectanea figurarum\n[[87.2]] quae extant apud curiosos, ut Marollium aliosque. Libri autem alicujus figurae\n[[87.3]] dispersae in unam facile colligi poterunt, evitatis repetitionibus diversarum figurarum\n[[87.4]] satis compendiosam. Addantur denique rerum ipsarum icones, ab egregio artifice delineatae\n[[87.5]] atque aeri insculptae. </p>\n<p> [[87.6]] <b>Topographia coeli</b> sex Tabulis a P. Pardies comprehensa. Schickardi <i>concavum\n[[87.7]] coeli</i>. </p>\n<p> [[87.8]] Cassini aliorumque novae figurae pro Astronomicis illustrandis. </p>\n<p> [[87.9]] Ephemerides in figuris Dalencaei. </p>\n<p> [[87.10]] Sumtae figurae utiliores ex opere magno Ducis Northumbriae. </p>\n<p> [[87.11]] Figurae utiles ex opere magno planisphaerii Octavii Pisani. </p>\n<p> [[87.12]] Topographia terrae, seu pleraeque urbes celebres una, duabus vel pluribus tabulis\n[[87.13]] exhibitae. Item aliae tabulae pro munimentis. </p>\n<p> [[87.14]] Tabula Heraldica compendiosa. Variae Tabulae Heraldicae illustriorum per varias\n[[87.15]] Europae regiones familiarum. </p>\n<p> [[87.16]] Tabulae Genealogicae familiarum principum Europae, cum nonnullis quae veterem\n[[87.17]] historiam illustrant. </p>\n<p> [[87.18]] Omnia Alphabeta linguarum. Item varii characteres Typographici, reapse expressi,\n[[87.19]] vide librum characterum Vaticanae. </p>\n<p> [[87.20]] Vestitus, habitus, cultusque hominum variarum nationum et professionum. </p>\n<p> [[88.1]] Icones virorum illustrium veterum et recentiorum. </p>\n<p> [[88.2]] Selecta Numismata veterum et recentiorum. </p>\n<p> [[88.3]] Aedificia insignia antiqua aut nova, adhuc extantia aut alias explorata. </p>\n<p> [[88.4]] Variae Antiquitatis reliquiae ex numismati[bu]s, inscriptionibus, annulis et ipsis\n[[88.5]] rebus superstitibus expressae. </p>\n<p> [[88.6]] Divinorum officiorum caeremoniae. Ordinum vestitus. </p>\n<p> [[88.7]] <i>Hyeroglyphica</i> Aegyptiorum ex Horapolline et aliis. </p>\n<p> [[88.8]] Ripae <i>Iconologia</i>. </p>\n<p> [[88.9]] Arithmetica in figura. Item Algebra. <i>Elementa</i> Euclidis duabus tabulis comprehensa.\n[[88.10]] Tabula unica Geometriae practicae. Tabula Conica, Tabula Sphaerica, Tabula pro quadraturis,\n[[88.11]] et quae his sunt connexa. </p>\n<p> [[88.12]] Tabula Graphices seu perspectivae. </p>\n<p> [[88.13]] Tabula Catoptrica. Tabula dioptrica. Nucleus Cherubini. </p>\n<p> [[88.14]] Tabulae novae pro scientia Musica universa, variisque organis. Adde opus Praetorii\n[[88.15]] et Kircheri. </p>\n<p> [[88.16]] Tabulae Architecturae civilis, et columnarum. </p>\n<p> [[88.17]] Tabulae ornamentorum exquisitorum. </p>\n<p> [[88.18]] Tabulae poliorceticae, seu de re fortificatoria urbiumque defensione et insultu. </p>\n<p> [[88.19]] Tactica seu de ordine et exercitiis militaribus, quo pertinet et castrametatoria. </p>\n<p> [[88.20]] Belopoetica seu de armis eminus agentibus, ubi et de aliis armis. </p>\n<p> [[88.21]] Obsidiones et praelia celebriora. </p>\n<p> [[88.22]] Mechanica, ubi omnis generis Machinae et moduli. Hydraulica. </p>\n<p> [[88.23]] Marina sive Nautica. </p>\n<p> [[88.24]] Oeconomica et omne genus supellectilis, et domesticae curae. </p>\n<p> [[88.25]] Agricultoria, ubi omnis generis instrumenta et opera rustica. </p>\n<p> [[89.1]] Textoria omnimoda, qua cujuscunque generis vestimenta aut corporis tegumenta\n[[89.2]] parantur. Ubi tota ratio tractandi serici, lanae, gossypii, lini, cannabis, viminum. Tinctoria. </p>\n<p> [[89.4]] Res muraria, ubi tract[at]io lapidum, terrarum, calcium. Huc stratores pavimentorum\n[[89.5]] regularii. </p>\n<p> [[89.6]] Res lignaria, ubi tigna, trabes, aliaque id genus, et quicquid lignei in aedificando\n[[89.7]] adhibetur. </p>\n<p> [[89.8]] Addantur alia quae aedificantibus serviunt, ut vitriariorum ars, item tessellata et\n[[89.9]] musaica opera. Scriniarii. Tornatores. </p>\n<p> [[89.10]] Pictoria, Sculptoria, Statuaria. Huc scriptoria ars. </p>\n<p> [[89.11]] Ferri et plumbi tractatio, per varias artes mechanicas. Metalli fusoria. Docimastica.\n[[89.12]] Tota res fodinarum. </p>\n<p> [[89.13]] Coctoria. Huc coctiones vitrioli, salis petrae, salis communis, aluminis, saccari,\n[[89.14]] indigo. </p>\n<p> [[89.15]] Vini, cerevisiae, Hydromelis, pomacei parationes, et tota res culinaria. </p>\n<p> [[89.16]] Omnes chymicae operationes et chymicorum instrumenta. </p>\n<p> [[89.17]] Reliqua res pharmacopoetica, et Materialistarum labores. </p>\n<p> [[89.18]] Opus Botanicum; <i>hortus Eichstetensis</i>, etiam variationes quae in plantis confingunt,\n[[89.19]] et modus colendi. </p>\n<p> [[89.20]] <i>Anatomia</i> opus per se magnum. Rumelini tabulae perficiendae. </p>\n<p> [[89.21]] Chirurgica instrumenta et exercitia. Anatomia comparativa et animalium variorum\n[[89.22]] icones. </p>\n<p> [[89.23]] Rariora naturae et artis in Exoticophylaciis contenta. </p>\n<p> [[89.24]] Mundus insensibilis, seu de his quae solo microscopio videntur. </p>\n<p> [[90.1]] Analogica, seu de rebus incorporeis, quae corporum similitudine pinguntur, ubi de\n[[90.2]] virtutibus, vitiis, rebus divinis, huc referuntur Hieroglyphica. Sinensium characteres.\n[[90.3]] <i>Sphaera moralis</i>. Syllogismometrum. <i>La</i> <i>carte du Tendre. Devises choisies.</i> Emblemata\n[[90.4]] selecta. </p>\n<p> [[90.5]] Hae Tabulae tum in unum collectae in Atlante, tum et separatim a multis quaerentur,\n[[90.6]] ut in cartis geographicis fieri solet, concinnabitur et [<i>bricht ab</i>] </p>\n",
  "number": "31.",
  "title": "Atlas universalis",
  "date": "[Sommer bis Herbst 1678 (?)]"
};
