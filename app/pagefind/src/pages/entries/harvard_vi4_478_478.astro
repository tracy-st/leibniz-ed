---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_478",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 478,
  "text": "[[2118.1]] <b>384₂.  Aus und zur Rezension im Journal des Sçavans 1689, XXIII <tab/><tab/>AUS UND ZUR REZENSION IM JOURNAL DES SÇAVANS 1689, XXIII </p>\n<p> [[2118.4]] In <i>diario eruditorum Gallico</i>; 20 Junio 1689 ex Huetii <i>Censura philosophiae\n[[2118.5]] Cartesianae</i>, exhibentur, et non obscure approbantur acerrimae Cartesianae philosophiae\n[[2118.6]] accusationes. Improperatur ipsi sententias introducere fidei contrarias, et quo satisfacere\n[[2118.7]] videatur; asseverare contradictoria non sua natura sed voluntate Dei esse impossibilia qui\n[[2118.8]] facere possit, quae ratio impossibilia doceat, ut bis duo esse tria, et totum esse aequale\n[[2118.9]] parti. Cartesianos passim statuere: aeque fidei ac evidentiae submittendam mentem.\n[[2118.10]] Libros sacros pro Judaeis tantum non pro theologis nostri temporis esse scriptos. Fidei\n[[2118.11]] dictata de poenis aeternis ad terrorem simplicium esse inventa; Dogmata fidei non nisi\n[[2118.12]] per viam verisimilitudinis ad nos venire. Nihil posse creari. Fidem non debere probabilitatibus\n[[2118.13]] stabiliri (+ hoc priori contradictorium +). Cum Christus bonum pro malo reddi\n[[2118.14]] jubet, tantum velle nos a vindicta removere, ut baculum curvam in contrarium flectamus.\n[[2118.15]] Vetant causas finales quaeri, negant Deum creare, annihilare, penetrationem corporum\n[[2118.16]] efficere posse. Mundum infinitum facere et materiam Deo aequare. Philosophiam Machinalem\n[[2118.17]] quae per se ad impietatem inclinet animos, ita a Cartesianis exaggeratam esse, ut\n[[2118.18]] jam et effectus Gratiae, et peccati ad leges mechanicas reducere moliantur. Cartesium\n[[2118.19]] candore paruisse ostentationi et tempori sua accommodasse. Specie modestiae gloriam\n[[2118.20]] ambitiose quaesisse, et simulasse ignorantiam opinionum alienarum, maluisseque\n[[2118.21]] inventorem quam doctum haberi, sed alicui ipsi non cogitanti elapsam esse confessionem,\n[[2118.22]] omne genus librorum ab ipso lectum. Idque ex lectione librorum ejus apparere. Sed\n[[2118.23]] sectatores ejus revera ignorantiam quam ille affectabat retinuisse. Quorundam ea fuit\n[[2118.24]] impudentia, ut non dubitarent scribere non magnam jacturam fore, si veteres philosophi et\n[[2118.25]] poetae perirent, digna barbaro voce. Vetare doctrinam linguarum orientalium, ignorantiae\n[[2118.26]] usus in interpretandis libris sacris; Astronomiam spernere. At Telescopia atque micro\n[[2119.1]] scopia irridere, quibus physica ampliata est. Criticam contemnere, quae alias scientias\n[[2119.2]] velut munit, Historiam et Geographiam etiam vituperare, quasi quisque primum vicina et\n[[2119.3]] sua discere debeat, et Lutetiam mensurare, antequam ad Sinas animo excurrat. Denique\n[[2119.4]] eruditionem pro vitio habere, et cum S. Paulus questus sit scientiam inflare, hodie\n[[2119.5]] ignorantiam inflare videri. Cartesium nihil fere novi invenisse. Cum Academicis et\n[[2119.6]] Aristotele ipso a dubitatione incepisse. Illud <i>cogito ergo sum</i>, habuisse ex S. Augustino.\n[[2119.7]] Cum Platone, Aristippo, Epicuro, regulam veritatis in perceptione clara et distincta\n[[2119.8]] collocasse, exemplo Baconi Causas finales rejecisse. S. Augustinum imo jam Proclum\n[[2119.9]] autores esse probationis quod anima a corpore distinguatur. Existentiae Dei argumentum\n[[2119.10]] totum esse S. Anselmi. Jamblichum ante ipsum dixisse; ideam Dei ab aliis ideis naturae\n[[2119.11]] esse differentis. Protagoram, Cyrenaicos, Arnobium nihil esse certum affirmasse praeter\n[[2119.12]] perceptiones interiores, Platoni res incorporales ante alias cognosci et esse [in] nobis\n[[2119.13]] ideas a sensibus non acceptas. Ab Augustino male intellecto didicisse animam sentire,\n[[2119.14]] non corpus, Galenum jam attulisse et refutasse opinionem eorum qui spiritus animales in\n[[2119.15]] glandula pineali collocabant. Rationem hujus opinionis, quod sensuum sedes sit in parte\n[[2119.16]] aliqua non geminata a Platone et Stoicis sumtam. Philosophos istos Arabes qui Locutores\n[[2119.17]] dicebantur (<i>parleurs</i>) dixisse quicquid intelligi potest esse posse. Multorum antiquorum\n[[2119.18]] fuisse sententiam, quod notiones externorum per sensus venientes, sint animae modificationes.\n[[2119.19]] Platonem rationes affectuum machinales reddidisse, Ciceroni, Diogeni, Proclo,\n[[2119.20]] ipsi Platoni bestias alicubi machinas videri, et novissime Gometium Pereiram Hispanum\n[[2119.21]] libro singulari, dicta quaedam Ambrosii et Augustini efficere potuisse, ut Cartesius\n[[2119.22]] dixerit res sine sua essentia subsistere posse, et esse simul et non esse. Thales et omnis\n[[2119.23]] usque ad Platonem schola jonica, Aristoteles et Stoici vacuum exclusere. Guilielmus\n[[2119.24]] Parisiensis jam dicebat annihilato [contento] latera vasis se tactura. Plotinus ut Cartesius\n[[2120.1]] putabat, non posse creare Deum quam quod creavit. Anaxagoras materiam infinitam\n[[2120.2]] supposuit divina mente ordinatam. Partes illae exiguae etiam Empedocli, Heraclito,\n[[2120.3]] Leucippo, Democrito placuere. Thaleti, Pythagorae, Academicis, Aristoteli, materia divisibilis\n[[2120.4]] in infinitum. Anaximandro, Anaximeni, Anaxagorae, Democrito, mundi infiniti,\n[[2120.5]] Anaximandro, Diogeni Apolloniatae, Melisso et nasci et interire videbantur. Melissus\n[[2120.6]] vacuum rejiciebat. Leucippo et sectatoribus motu circulari formatus est mundus ex\n[[2120.7]] exiguis corporibus. Heraclito et Pythagoricis tot mundi quot stellae. Vortices a Democrito\n[[2120.8]] et Epicuro, et re et nomine simile quid ab Anaximene a Diogene Apolloniata dictum.\n[[2120.9]] Rudimentum hujus doctrinae apud Plutarchum <i>de facie lunae</i>; sed clare exposita et\n[[2120.10]] formata apud Jordanum Brunum libro <i>de immenso et innumerabilibus</i>. Aristoteli palpitatio\n[[2120.11]] cordis ab effervescentia sanguinis. Gilbertus, Galilaeus, Keplerus plurima suggessere.\n[[2120.12]] A postremo vortex circa solem. A Fracastorio opinio Cartesiana de cometis quam\n[[2120.13]] juvit Keplerus. Empedocli ignis materia astrorum. Et Parmenidi ignis terrae inclusus\n[[2120.14]] causa motus telluris. Quae de attractione Magnetis Platonici, Cartesianis accedunt, Seleucus\n[[2120.15]] habet fluxum et refluxum a compressione venti inter terram et Lunam. Cartesiana\n[[2120.16]] tonitru[i] et fulminis causa ab Anaxagora et Stoicis, Aristarcho, Democrito, Epicuro,\n[[2120.17]] colores lumen modificatum.\n[[2121.1]] D 1. THEOLOGIA </p>\n",
  "number": "384₂.",
  "title": "Aus und zur Rezension im Journal des Sçavans 1689, XXIII",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:384₂. Aus und zur Rezension im Journal des Sçavans 1689, XXIII AUS UND ZUR REZENSION IM JOURNAL DES SÇAVANS 1689, XXIII In diario eruditorum Gallico; 20 Junio 1689 ex Huetii Censura philosophiae Cartesianae, exhibentur, et non obscure approbantur acerrimae Cartesianae philosophiae accusationes. Impr...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>