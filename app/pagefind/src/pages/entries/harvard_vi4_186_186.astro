---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_186",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 186,
  "text": "[[644.16]] <b>154.  Omnes praepositiones proprie significant relationem loci [Herbst 1685 (?)]</b>\n [[644.17]] <tab/>[Herbst 1685 (?)] </p>\n<p> [[645.1]] Omnes praepositiones proprie significant relationem Loci, translate aliam relationem\n[[645.2]] quamcunque. Relatio Loci vel simplex est, vel motum continet; Motum scilicet vel\n[[645.3]] rei quam afficit praepositio, vel aliarum. </p>\n<p> [[645.4]] Simplex relatio est in praepositionibus: Cum, Sine, Apud, In. Circa. Inter. Intra.\n[[645.5]] Extra. Ex quibus simplicissimum est, <i>A</i> esse <i>cum</i> <i>B</i> vel <i>sine</i> <i>B</i>, seu <i>A</i> et <i>B</i> esse vel non\n[[645.6]] esse in eodem loco communi. Proximum est <i>A</i> esse <i>apud</i> <i>B</i>, quod significat loca ipsorum\n[[645.7]] <i>A</i> et <i>B</i> esse contigua. <i>A</i> est <i>in</i> <i>B</i>, si locus ipsius <i>A</i>, sit pars loci ipsius <i>B</i>; et quidem si\n[[645.8]] reliqua pars loci ipsius <i>B</i>, demto loco ipsius <i>A</i>, vocetur <i>C</i>, dicitur <i>C</i> esse <i>circa</i> <i>A</i> et <i>A</i> <i>intra</i>\n[[645.9]] <i>C.</i> Unde patet differentia inter <i>in</i> et <i>intra.</i> Dicimus enim Iliacos intra muros, non in muris,\n[[645.10]] quod neque in muris, neque intra muros est, dicitur esse <i>extra.</i> Si <i>D</i> et <i>E</i> possint intelligi\n[[645.11]] partes ipsius <i>C</i>, dicetur <i>A</i> esse <i>inter</i> <i>D</i> et <i>E.</i> Et hae definitiones satis\n[[645.12]] sunt exactae. Nam locum ipsius <i>A</i> intelligo non minimum, sed\n[[645.13]] quemcunque etiam ipso <i>A</i> majorem, alioqui locus minimus puncti <i>A</i>\n[[645.14]] existentis in linea <i>B</i>, non foret pars ipsius <i>B.</i> Praeterea si <i>A</i> est inter\n[[645.15]] <i>D</i> et <i>E</i> semper intelligi potest locus aliquis communis ipsorum <i>A, D,\n[[645.16]] E</i>, qui sit <i>B</i>, a quo si adimas locum aliquem (satis magnum) ipsius <i>A</i>, restet <i>C</i>, qui nihil\n[[645.17]] aliud contineat quam locum ipsorum <i>D</i> et <i>E.</i> </p>\n<p> [[645.18]] Relatio loci cum respectu ad Motum est in praepositionibus: Ab, Per, Ad; Ex, In,\n[[645.19]] Ante, post, prae, pro, secundum, juxta; supra, super, infra, sub, praeter; trans, ultra, citra,\n[[645.20]] tenus. </p>\n<p> [[645.21]] Movetur <i>a C</i>, <i>per C</i>, <i>ad C</i>, cujus locus initio, medio, fine motus est <i>C</i> utcunque haec\n[[645.22]] moventur. Si <i>A</i> videt ad <i>B</i>, <angle bracket>tunc</angle bracket> <i>B</i> est <i>ante</i> <i>A.</i> Si per <i>A</i> ad <i>B</i>; <i>A</i> est <i>ante</i> <i>B</i> et <i>B</i> <i>post</i> <i>A.</i> </p>\n",
  "number": "154.",
  "title": "Omnes praepositiones proprie significant relationem loci",
  "date": "[Herbst 1685 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:154. Omnes praepositiones proprie significant relationem loci [Herbst 1685 (?)] [Herbst 1685 (?)] Omnes praepositiones proprie significant relationem Loci, translate aliam relationem quamcunque. Relatio Loci vel simplex est, vel motum continet; Motum scilicet vel rei quam afficit praepositio, vel al...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>