---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_441",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 441,
  "text": "[[1981.1]] <b>363.  Physica scientia attributorum corporis [Sommer 1678 bis Winter 1680/81 (?)]</b>\n [[1981.2]] <tab/>[Sommer 1678 bis Winter 1680/81 (?)] </p>\n<p> [[1981.8]] <p><k>Physica</k> est scientia attributorum corporis. </p>\n<p> [[1981.9]] <k>Attributa</k> autem quae de corpore cognoscuntur sunt vel <b>Distincta</b> vel <b>Confusa.</b> </p>\n<p> [[1981.11]] <k>Distincta</k> sunt de quibus intelligimus in quae resolvantur. Exempli gratia:\n[[1981.12]] Extensum, id est habens partes, easque inter se situm habentes. Itaque extensi notio\n[[1981.13]] resolvitur in duas alias magnitudinis et situs. Magnitudinis autem consideratio petenda est\n[[1981.14]] ex Algebra vel Arithmetica, situs autem ex Geometria. Mobile, id est quod mutare situm\n[[1981.15]] potest. Itaque notio Motus resolvitur in notionem situs et mutationis. Et situs quidem\n[[1981.16]] consideratio sumitur ex Geometria, mutationis ex metaphysica. </p>\n<p> [[1981.17]] <k>Confusa</k> sunt de quibus non intelligimus in quae resolvantur. Ut rubrum, calidum.\n[[1981.18]] Etsi enim discernamus rubrum a non rubro, non tamen ideo possumus explicare quid sit\n[[1981.19]] rubrum, sive quomodo rubedo producatur. Itaque caeco nullis descriptionibus explicare\n[[1982.1]] possum, quid sit lux vel rubedo. Circulus autem quid sit explicare illi possum, etsi\n[[1982.2]] nunquam vel visu vel tactu circulum percepisset. Itaque notiones distinctae definitione, at\n[[1982.3]] confusae sola ostensione sive sensu aliis traduntur. </p>\n<p> [[1982.4]] Attributa distincta tractantur in Metaphysica et Mathematica, et eatenus Physica his\n[[1982.5]] duabus scientiis subordinata est. Confusa vero physicae propria sunt, et in his consistit\n[[1982.6]] historia naturalis, ad scientiam vero acquirendam non conferunt, nisi quatenus distincta\n[[1982.7]] illis applicantur; nam alioqui nullam intellectualem resolutionem sive analysin instituere\n[[1982.8]] possemus. Exempli causa quia sensu visus deprehendimus angulum incidentiae et reflexionis\n[[1982.9]] radii lucidi esse aequales; ex hac hypothesi in physica ratiocinari possumus\n[[1982.10]] geometrica certitudine. Resolutio autem quae sensu deprehenditur, etsi utilissima sit ad\n[[1982.11]] resolutionem intellectualem reddendam faciliorem, non tamen eam statim exhibet, neque\n[[1982.12]] efficit, ut notio cesset esse confusa. Exempli gratia saepe deprehensum est ex flavo et\n[[1982.13]] caeruleo mixtis existere viride; sed non ideo demonstratum est hoc de omni viridi nam\n[[1982.14]] quoties propositio aliqua sola inductione constituitur, nunquam certi sumus eam esse\n[[1982.15]] plane universalem; et licet verum esse constanter deprehenderetur, non ideo menti\n[[1982.16]] nostrae apparet quomodo ex juncta apparentia caerulei et flavi diversa adeo ab ambabus\n[[1982.17]] existat, nempe apparentia coloris viridis. In his vero quae distincte percipimus longe\n[[1982.18]] secus est, exempli causa quomodo ex duobus motibus oppositis fiat quies; facile enim\n[[1982.19]] patet demonstrarique potest si corpus aliquod in tabula procedat versus orientem, et\n[[1982.20]] tabula corpus secum ferens eadem celeritate contrario plane motu, tendat versus occidentem,\n[[1982.21]] corpus esse quieturum, sive eandem a circumstantibus omnibus quiescentibus\n[[1982.22]] distantiam servaturum. Talia quae distincte cognoscuntur etiam ante experimentum\n[[1982.23]] infallibiliter praedici possunt; priora vero per experientiam discere debemus. </p>\n",
  "number": "363.",
  "title": "Physica scientia attributorum corporis",
  "date": "[Sommer 1678 bis Winter 1680/81 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:363. Physica scientia attributorum corporis [Sommer 1678 bis Winter 1680/81 (?)] [Sommer 1678 bis Winter 1680/81 (?)] Physica est scientia attributorum corporis. Attributa autem quae de corpore cognoscuntur sunt vel Distincta vel Confusa. Distincta sunt de quibus intelligimus in quae resolvantur. Ex...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>