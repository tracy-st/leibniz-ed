---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_212",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 212,
  "text": "<p> [[656.5]] <b>212. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[656.6]] Venedig, 26. August 1707. [211.215.] </b></p>\n<p> [[656.20]] Venetia 26 Agosto 1707\n [[656.21]] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o </p>\n<p> [[656.22]] Il <Fn><i>Am Kopf der Seite vermerkt Fardella</i>: Il Sig^#'r^#'e Herman le fà umil^#'m^#'a riverenza  <i>Am Kopf von Bl. 135 v^#'o vermerkt Fardella</i>: I semi che attendo a momenti da Vicenza saranno nella ventura settimana consegnati al Sig^#'r^#'e Zanovelli, ed al suo ritorno da Bologna parterò circa l'affare consaputo con il Sig^#'r^#'e Guglielmini.</Fn> Signore Zanovelli m'ha oggi consegnato l'umani^#'m^#'o foglio di V. S. Ill^#'m^#'a, che m'hà\n[[656.23]] riempito di sommo rossore e confusione, nel vedermi dalla di lei somma beneficenza così\n[[657.1]] cortesemente e generosamente favorito, avendomi voluto prevenire colla così calda ed efficace\n[[657.2]] sue raccomandatione al Sig^#'r^#'e Barone Inviato estraordinario del Sereni^#'m^#'o Duca Ulrico, impegnandosi\n[[657.3]] ora con incomparabile bontà di guadagnarmi l'alta protettione dell'istesso Sereni^#'m^#'o\n[[657.4]] Duca per indurre la Regina Sposa a beneficarmi in tutto ciò che hò con amichevole libertà\n[[657.5]] proposto a V. S. Ill^#'m^#'a tanto mio singolarissimo Benefattore. I mezzi che prende V. S. Ill^#'m^#'a per\n[[657.6]] onorare la mia persona e sollevare la mia abbattuta famiglia in Sicilia non possono essere piu\n[[657.7]] potenti ed efficaci, e non dubito punto sia per ottenere con piena felicità l'intento, quando ne\n[[657.8]] prendesse un vero impegno la nuova Regina, il che lo devo vivamente sperare mercè l'autorevole\n[[657.9]] e benefico patrocinio di V. S. Ill^#'m^#'a che oltre l'essere nel Mondo letterato la piu elevata e\n[[657.10]] vasta mente che abbia il Secolo presente, possiede in oltre la rara e tanto insigne prerogativa di\n[[657.11]] proteggere e beneficare in tutte l'occasioni con una costantissima passione i suoi Amici, e\n[[657.12]] fedeli Servitori, come io n'hò fatta l'esperienza in tante congiunture. Il venerato foglio di V. S.\n[[657.13]] Ill^#'m^#'a l'ha anche letto il nostro dottissimo Sig^#'r^#'e Herman, il quale ammira sempre piu la finezza\n[[657.14]] del suo generoso amore, e la forza dell'eroica sua amicitia, da cui esso principalmente riconosce\n[[657.15]] il riguardevole posto che occupa in Padova. Esso hà qui incontrato così bene, e con il suo\n[[657.16]] purgatissimo sapere, soavissimo ed incorrotto costume s'è in guisa conciliata la stima e\n[[657.17]] benevolenza di questi piu eruditi Signori, che il Sig^#'r^#'e Abbate Poleni de piu ricchi e dotti\n[[657.18]] cittadini di questa Patria l'hà voluto in tutte le maniere in casa sua, ove è servito ed assistito\n[[657.19]] come se fosse il Padrone medesimo, e questa riguardevole casa sarà il suo perpetuo alloggio\n[[657.20]] ogni volta che si portera da Padova in Venetia, ove ora concorrono i migliori Matematici per\n[[657.21]] apprendere dal Sig^#'r^#'e Herman il tanto da loro ricercato Calcolo differentiale da V. S. Ill^#'m^#'a\n[[657.22]] inventato con tanto profitto ed ammiratione di tutta la Republica letterata, che io apprenderò\n[[657.23]] anche con tutto il mio commodo in mia casa che sarà comune con il Sig^#'r^#'e Herman, da cui non\n[[657.24]] mi separarò giamai. Ho nuovamente letto con mia somma sodisfattione il cotanto ingegnoso ed\n[[657.25]] elegante suo Epigramma in lode di questa Seren^#'m^#'a Republica, che farò leggere a molti Senatori\n[[657.26]] miei Padroni. Hò letto all'Eccell^#'m^#'o Trevisano il suo periodo ove ella fa onorata mentione delle\n[[657.27]] sue <i>Meditationi filosofiche</i>, che infinitamente la ringratia e riverisce, e profondamente inchinandola\n[[657.28]] mi resto </p>\n<p> [[657.29]] Di V. S. Ill^#'m^#'a Obl^#'m^#'o <angle bracket>Div^#'m^#'o S^#'r^#'e vero</angle bracket> Fardella </p>\n",
  "number": "212.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Venedig, 26. August 1707. [211.215.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:212. MICHEL ANGELO FARDELLA AN LEIBNIZ Venedig, 26. August 1707. [211.215.] Venetia 26 Agosto 1707 Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o Il Am Kopf der Seite vermerkt Fardella: Il Sig^#'r^#'e Herman le fà umil^#'m^#'a riverenza Am Kopf von Bl. 135 v^#'o vermerkt Fardella: I semi che...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
