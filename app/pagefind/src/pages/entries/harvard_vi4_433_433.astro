---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_433",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 433,
  "text": "[[1963.1]] <b>355.  De aequipollentia causae et effectus [1677 bis 1678 (?)]</b>\n [[1963.2]] <tab/>[1677 bis 1678 (?)]\n[[1963.10]] <tit2><b>De aequipollentia causae et effectus </b></tit2> </p>\n<p> [[1963.11]] Quia effectus totus involvit causam integram, et vicissim causa integra involvit\n[[1963.12]] effectum totum; id est ut ex sola cognitione effectus possit aliquis venire in cognitionem\n[[1963.13]] causae, et ex sola cognitione causae in cognitionem effectus, hinc sequitur Causam\n[[1963.14]] aliquam non posse producere effectum per omnia similem et sola magnitudine differentem.\n[[1963.15]] Itaque effectus ut <i>a</i> non potest producere causam ut <i>b</i>, posito <i>a</i> et <i>b</i> differre sola\n[[1963.16]] magnitudine, quia duo sola magnitudine differentia non possunt se mutuo\n[[1963.17]] involvere. Eo ipso enim quod similia sunt, non potest magnitudinis defectus\n[[1963.18]] aliunde compensari, nec <i>b</i> potest involvere nisi partem ipsius <i>a.</i> <Fn>Nam ratiocinatio non nisi ex forma qua non differunt aut ex quantitate, sumi potest.</Fn> </p>\n<p> [[1963.19]] Idem aliter probari potest ex eo, quod reddi ratio nulla potest cur <i>a</i>\n[[1963.20]] producat <i>b</i> potius quam <i>c</i>, omnia enim similia sunt, et magnitudine differunt,\n[[1963.21]] itaque aut nihil producet <i>a</i> aut infinitum, quae duo maxime ab ipso\n[[1963.22]] magnitudine differunt, aut id potius quod minime differt magnitudine ab\n[[1963.23]] ipso, id est quod sit aequale. </p>\n<p> [[1964.1]] Hinc jam porro demonstratur causam et effectum omnino aequipollere. Nam potentia\n[[1964.2]] seu quantitas effectus in quodam homogeneo aestimanda est, exempli causa in elevatione\n[[1964.3]] corporis gravis ad certam altitudinem. Et eadem causa diversos effectus homogeneos\n[[1964.4]] seu similes sed inaequales producere non potest; quod ex eo patet, quia si effectus\n[[1964.5]] involvit causam, et causa effectum, sequitur effectus ejusdem causae se involvere mutuo.\n[[1964.6]] Nam sit <i>a</i> causa, et <i>b</i> et <i>c</i> sint effectus. <i>b</i> involvit <i>a</i> (effectus causam), <i>a</i> involvit <i>c</i> (causa\n[[1964.7]] effectum). Ergo <i>b</i> involvit <i>c.</i> Eodem modo diversae causae ejusdem effectus se mutuo\n[[1964.8]] involvunt. Imo amplius diversi effectus diversarum causarum vel diversae causae eorundem\n[[1964.9]] effectuum, si earum fuit vel esse potest effectus vel causa communis. </p>\n<p> [[1964.10]] Si potentia quaedam est certa, id est si aestimari potest quantitas effectus in aliquo\n[[1964.11]] homogeneo, utique necesse est eam in iisdem semper eandem manere. Certam autem in\n[[1964.12]] re quaque esse potentiam non vagam sequitur ex natura Dei; et alioqui nulla erit ratiocinatio\n[[1964.13]] de his. </p>\n",
  "number": "355.",
  "title": "De aequipollentia causae et effectus",
  "date": "[1677 bis 1678 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:355. De aequipollentia causae et effectus [1677 bis 1678 (?)] [1677 bis 1678 (?)] De aequipollentia causae et effectus Quia effectus totus involvit causam integram, et vicissim causa integra involvit effectum totum; id est ut ex sola cognitione effectus possit aliquis venire in cognitionem causae, e...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>