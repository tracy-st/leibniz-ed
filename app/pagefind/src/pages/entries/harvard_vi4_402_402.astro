import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_402",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 402,
  "text": "[[1690.10]] <b>334.  Randbemerkungen und Unterstreichungen zu Arnold Geulincx, Methodus inveniendi argumenta [1677 bis 1716 (?)]</b>\n [[1690.12]] <tab/>[1677 bis 1716 (?)] </p>\n<p> [[1690.19]] Arnoldi Geulincx Antverpiensis, <i>Methodus Inveniendi Argumenta Quae Solertia\n[[1690.20]] Quibusdam dicitur. Nunc novis rursum Typis descripta, et aliquot objectionibus ac\n[[1690.21]] responsionibus adversus Ethicam ejusdem authoris, adaucta.</i> Lugd. Batav. Apud Adrianum\n[[1690.22]] Severini. MDCLXXV. <Fn><i>Auf dem Vorsatzblatt</i>: p. 2. p. 5. p. 13. p. 25. p. 43. p. 46. p. 64. p. 76. p. 99. p. 100. p. 20. p. 27. p. 49.</Fn> </p>\n<p> [[1691.1]] [p. 1-3 / 5 sq.] Cap. I. De Vero et Falso. </p>\n<p> [[1691.2]] Principia seu communes notiones. Commentarius. ... ^#.[Quaedam etiam inter hasce\n[[1691.3]] Communes Notiones, vulgo <i>fatua</i> <Fn><i>Am Rande</i>: p. 6.</Fn> vocantur: solent enim imperiti pro fatuis habere ea\n[[1691.4]] omnia, quae valde clara et simplicia sunt: gaudent nempe cogitationibus obscuris et\n[[1691.5]] perplexis:^#.] in quibus cum jugiter periculum errandi subsit, merito dictum est, <i>Populus\n[[1691.6]] vult decipi</i>. </p>\n<p> [[1691.7]] Quamvis autem Principiis omnibus hoc commune sit, quod ratione, qua probentur,\n[[1691.8]] non indigeant; saepe tamen alia quaedam ^#.[<b>adminicula</b>,^#.] quibus in animum illabantur,\n[[1691.9]] non respuunt: velut ^#.[<b>expositionem</b>^#.] (sunt enim quasi Oracula quaedam, quae abrupta\n[[1691.10]] sua brevitate subinde sunt obscura), exemplum (sunt enim saepe nimis abstracta, adeoque\n[[1691.11]] exempli alicujus apta incorporatione, familiaria nobis, qui et ipsi incorporati sumus, ac\n[[1691.12]] velut analoga redduntur) ^#.[<b>Rationem indirectam</b>^#.] (haec enim militat, et Intellectum\n[[1691.13]] oscitantem alias, ac velut indormiscentem ferit et excitat: vide sis <i>Logicam</i> meam part.\n[[1691.14]] ult. sect. ult. cap. 11.) ^#.[<b>Praejudiciorum refutationem</b>^#.] (haec enim velut nebulae\n[[1691.15]] quaedam atrae, coelum illud splendidae veritatis Intellectui tegunt et obducunt) ^#.[<b>Inculcationem</b>^#.]\n[[1691.16]] denique, et sub alia forma verborum, Repetitionem (sic enim Intellectus, qui\n[[1691.17]] volubili sua levitate, Principia transmitteret, detinetur, et altius in eorum contemplatione\n[[1691.18]] defigitur.) ... </p>\n<p> [[1691.19]] [p. 4 / 6] Principium Generale 1. <i>Aliquid <b>est</i>. </p>\n<p> [[1691.20]] [p. 5 / 7] Principium Generale 2. <i>Multa sunt, et sine fine</i>. </p>\n<p> [[1691.21]] ... <b>Est</b> etiam <b>hoc Principium ordine prius</b> iis, quae passim a Metaphysicis\n[[1691.22]] circumferuntur, quaeque mox subjiciemus, <i>Quidlibet est vel non est</i>: <i>Impossibile est\n[[1691.23]] idem, etc</i>. <b>cum illa Principia supponant multa</b> <Fn><i>Am Rande</i>: ^&.!! <Leibniz special character: distilletur></Fn> seu res multas: ... </p>\n<p> [[1691.24]] [p. 6 / 7] Principium Generale 3. <i>Quidlibet est, quod est</i>. </p>\n<p> [[1691.25]] Commentarius. Hoc Principium <b>clare supponit</b> <Fn><i>Am Rande</i>: ^&.!! <Leibniz special character: distilletur></Fn> secundum: Cum enim res multae\n[[1691.26]] sint, profecto unaquaeque earum est quod est. Hoc etiam est unum ex iis quae ^#.[<b>ab\n[[1691.27]] imperitis <i>fatua</i> <Fn><i>Am Rande</i>: p. 2.</Fn> <b>vocantur</b>^#.]: et sane omnia, quae hoc Principio nituntur, fatua\n[[1692.1]] vocant, ut <i>A. est A. lapis est lapis, etc</i>. cum tamen in sacris legatur ^#.[<b>Deus ipse sibi\n[[1692.2]] tale aliquod nomen fecisse</i>, dicens <Fn>dicens ... sum <i>am Rande mit Tinte angestrichen</i>.</Fn> <i>ego sum, qui sum</i>; <b>sed nempe sapientia\n[[1692.3]] Dei est stultitia coram hominibus.</i>^#.] </p>\n<p> [[1692.4]] [p. 7 sq. / 8] Principium Generale 5. <i>Quidlibet est vel non est</i>. </p>\n<p> [[1692.5]] Commentarius. Vulgus tales phrases et loquendi formulas circumfert, quibus huic\n[[1692.6]] Principio derogent, nisi benigne interpreteris, et in meliorem partem dicta eorum accipias\n[[1692.7]] ... Alioqui satis noverunt illi ipsi, phrasim suam in rigore non subsistere; sed <b>hoc <Fn>hoc ... creditur <i>erst mit Bleistift, dann mit Tinte unterstrichen</b></Fn> ipso\n[[1692.8]] elegantiam aliquam spirare vulgo creditur</i>: cum enim falsum et absurdum prae\n[[1692.9]] se ferat; intus tamen et velut in recessu veritatem aliquam continet, quo ceu lusu quodam\n[[1692.10]] et fallacia, populus admodum delectatur. </p>\n<p> [[1692.11]] [p. 10 sq. / 10] Definitiones. </p>\n<p> [[1692.12]] Commentarius. ... Ex dictis patet quod Definitio etiam nitatur isto Postulato: <i>Detur\n[[1692.13]] cuicumque rei nomen imponere <b>quodcumque</b>: quod Postulatum aequissimum est, et\n[[1692.14]] <b>concedendum</b> <Fn><i>Am Rande</i>: ^&.!! <Leibniz special character: distilletur></Fn> omnino iis qui scientificos tractatus instituunt ... </p>\n<p> [[1692.15]] [p. 13 sq. / 10 sq.] Definitio 2. <i>Verum est dictio, quae dicit esse, quod est: seu est\n[[1692.16]] dictio quae dicit esse, et totum id est, quod esse dicit.</i> </p>\n<p> [[1692.17]] Commentarius. ... Et generatim <b>in iis quae positiva sunt, idem est simpliciter\n[[1692.18]] esse, et purum esse</i>: sic esse aurum, et esse purum aurum, idem sunt (nam\n[[1692.19]] impurum aurum non est aurum, sed aurum et scoria) esse vinum, et esse purum vinum,\n[[1692.20]] idem sunt (nam vinum impurum non est vinum; sed vinum et aqua, aut alia quaedam\n[[1692.21]] miscella) esse rectum, et esse pure rectum, idem sunt (nam <b>rectum cum curvo\n[[1692.22]] mixtum, non est rectum sed curvum</i>) et sic Verum, ac pure Verum, idem sunt:\n[[1692.23]] nam si vel tantilla falsitas admixta fuerit, non erit verum, sed falsum. </p>\n<p> [[1692.24]] [p. 16 / 12] Principium speciale 2. <i>Dicens, id dicit, quod dicit</i>. </p>\n<p> [[1692.25]] Commentarius. ... Nobis interim haec et similia Principia serviunt ad demonstrandum\n[[1692.26]] Propositiones utilissimas: et nominatim hoc Principium speciale secundum concurrit\n[[1692.27]] ad demonstrandum Effatum duodecimum hoc capite: <b>Effatum, et mirum, et in\n[[1692.28]] rebus Logicis utilitatis oppido magnae</i>. </p>\n<p> [[1693.1]] Principium speciale 3. <i>Quae, vel <b>aliud</i>, <i>vel <b>de aliis</i> <i>dicunt, aliae dictiones sunt</i>. </p>\n<p> [[1693.2]] [p. 20 / 14] Principium speciale 7. <i>Cum alterum horum duorum esse debet: et si hoc\n[[1693.3]] horum duorum est, tunc hoc istorum duorum sit; et si illud horum duorum est, tunc illud\n[[1693.4]] istorum duorum sit, etiam alterum istorum duorum esse debebit</i>. </p>\n<p> [[1693.5]] Commentarius. Principium in se clarissimum est; adhaeret tamen ei velut extrinsecus\n[[1693.6]] obscuritas aliqua ex verborum recursu et ambage; quae ab illo, quatenus Axioma\n[[1693.7]] quoddam est, certa verborum formula circumscriptum, tolli nec debet, nec potest;\n[[1693.8]] Absolute tamen loquendo, facile detergetur illa obscuritas; non quidem Demonstratione\n[[1693.9]] (<b>demonstrari</b> <Fn><i>Am Rande</i>: ^&.!! <Leibniz special character: distilletur></Fn> enim <b>non potest</b>, nec ullam rationem se priorem agnoscit) sed\n[[1693.10]] expositione et Exemplo, quae sensum ejus declarent modo: qua declaratione facta, nulla\n[[1693.11]] prorsus indigere probatione comperitur. </p>\n<p> [[1693.12]] [p. 21 sq. / 15] Postulata. </p>\n<p> [[1693.13]] Commentarius. ... Cur ergo Postulata a Principiis sejunguntur? Respond. <b>quia\n[[1693.14]] humanitatis est</i>, <Fn><i>Am Rande</i>: alia ratio. Postulata respondent problematibus</Fn> cum jure tuo Principia posueris, et velut Dictaturam exercueris,\n[[1693.15]] aliquid remittere de forma rigoris, non omnia extorquere, aliquid Legenti arbitrandum\n[[1693.16]] relinquere, aliquid petere, quod impetrabis. </p>\n<p> [[1693.17]] Postulatum 1. <i>Detur cuicumque rei inventae, nomen imponere <b>quodcumque</i>: <Fn><i>Am Rande</i>: ^&.!! <Leibniz special character: distilletur></Fn>\n[[1693.18]] <i>Atque nomen illud inter loquendum pro re illa usurpare.</i> </p>\n<p> [[1693.19]] [p. 23-25 / 16] Postulatum 2. <i>Da quidlibet supponam.</i> 3. <i>Dicam esse</i> 4. <i>Dicam non\n[[1693.20]] esse</i> </p>\n<p> [[1693.21]] Commentarius. ... Qui igitur negaverit <i>Deum esse crudelem</i>, is in ipso actu negationis,\n[[1693.22]] seu potius praevie ad illum actum posuit <i>Deus est crudelis</i>, atque hoc pie negando\n[[1693.23]] evertit: unde <b>in ipso actu negandi</b> expresse <b>Affirmatio illa reperitur</b> (consule\n[[1693.24]] quae dixi cap. 1. in <i>Logica</i> mea) non id valens quidem, quod alibi et seorsim posita\n[[1693.25]] valeret, sed saltem supposita. </p>\n<p> [[1693.26]] [p. 26 sq. / 17 sq.] Effata Logica. </p>\n<p> [[1693.27]] Commentarius. ... Quod nos in Logica Effatum, id in Mathesi solent vocare <i>Propositionem</i>;\n[[1693.28]] Nos vero nomine <i><b>Propositionis</b></i> <b>certam partem Demonstrationis</b>\n[[1693.29]] malumus intelligere, ut mox patebit. ... Problema igitur est Propositio, quae continet\n[[1693.30]] Potentiam, demonstratur autem a posteriori per unum ejus Actum: v.g. <i>super data recta\n[[1694.1]] linea triangulum equilaterum constituere</i>, quod est Problema Geometriae primum apud\n[[1694.2]] Euclidem, hunc sensum habet, <i>Potest super data, etc. constitui triang. aequilat</i>: Atque\n[[1694.3]] illud <i><b>Posse</b></i> <b>per unum Actum demonstratur</b>, <Fn><i>Am Rande</i>: desiderantur constructiones generales v. p. 49</Fn> seu per unum triangulum aequilaterum,\n[[1694.4]] qui sic constitutus sit; ... </p>\n<p> [[1694.5]] [p. 29 / 18] Eorumque Demonstrationes. </p>\n<p> [[1694.6]] Commentarius. ... Demonstratio Effati alicujus, quatuor complectitur: <b>Suppositionem,\n[[1694.7]] Propositionem, Rationem</i>, et <b>Conclusionem</b>: ... </p>\n<p> [[1694.8]] [p. 42 / 25] <b>Effatum 12</b>. <Fn><i>Am Rande</i>: v. p. 16</Fn> quod et Theor. <i>Omnis enunciatio dicit se esse veram</i>. </p>\n<p> [[1694.9]] [p. 43 sq. / 25] Effatum 13. quod et Theor. <i><b>Enunciatio, si se falsam esse\n[[1694.10]] dicit, falsa est</i>. ... </p>\n<p> [[1694.11]] Commentarius. Hinc patet <b>Falsificantes</b> omnes, quibus se, tamquam abstrusissimis\n[[1694.12]] argutiis jactant et fatigant Scholastici, falsas et impossibiles esse: ut <i>ego loquor\n[[1694.13]] falsum</i>, hoc ipsum nempe dicendo, ... </p>\n<p> [[1694.14]] [p. 45 sq. / 26 sq.] Cap. II. De Antecedente et Consequente. </p>\n<p> [[1694.15]] Definitio. 2. <i>Consequens est enunciatio, cujus totum quod esse dicit, esse dicitur ab\n[[1694.16]] alia enunciatione</i>, <i>Diciturque Consequens alius illius enunciationis</i>: <i>Atque ex illa alia\n[[1694.17]] enunciatione inferri</i>: <i>Itemque ex illa, vel ad illam sequi dicitur.</i> </p>\n<p> [[1694.18]] Commentarius. Obiter monendum hic, <i><b>A. est A. vel B.</b></i>, <Fn><i>Am Rande</i>: haec semper vera</Fn> non inferre, <i>A. est B.</i> ... </p>\n<p> [[1694.19]] [p. 48 sq. / 28] Effatum 1. quod et Problema. <i>Dare Antecedens et Consequens ejus.</i> </p>\n<p> [[1694.20]] Demonst. pars prior. <i>Supp.</i> Sit enunciatio <i>c. 1. e. i.</i> quaecumque, <i>c. 1. e. 1. a.</i>, nempe\n[[1694.21]] <i>A. c. 1. b. 1.</i>, et dicamus de <i>A.</i>, quod sit vera <i>c. 1. b. 3.</i> et dictionem, qua hoc nude\n[[1694.22]] dixerimus, <i>b.</i>, vocemus <i>B.</i>, <i>c. 1. b. 1.</i> <i>Prop.</i> Dico quod <i>A.</i>, sit Antecedens, ipsius <i>B.</i>,\n[[1694.23]] <i>c. 1. b. 1. a.</i> <Fn><i>Am Rande</i>: Haec constructio est nimis specialis add. p. 27</Fn> <i>Rat.</i> Quia <i>A.</i> dicit <i>A.</i> (id est se ipsam) esse veram, <i>c. 1. e. 12.</i>, Atqui <i>B.</i> non\n[[1694.24]] aliud dicit, quam <i>A.</i> esse veram, <i>juxta supp.</i> <i>Concl.</i> Igitur. <i>A.</i> dicit totum quod dicit <i>B.</i>, seu\n[[1694.25]] <i>A.</i> est antecedens, ipsius <i>B. d. 1.</i> </p>\n<p> [[1694.26]] [p. 57-59 / 33] Effatum 6. quod et Theo. <i>Si enunciatione aliqua existente vera,\n[[1694.27]] necessum fuerit aliam aliquam enunciationem esse veram, prior inferet posteriorem.</i> ... </p>\n<p> [[1694.28]] Commentarius. ... Ex quo hoc liquet dignum notatu, quod effatum secundum se\n[[1694.29]] spectatum, et idem effatum, pro ut demonstrationi subjicitur, possit habere aliud atque\n[[1695.1]] aliud Conversum: Quibus et tertium Conversum addo, quod voco <i><b>Soritice Conversum</b></i>.\n[[1695.2]] De quo dicam infra cap. 3. </p>\n<p> [[1695.3]] [p. 86 sq. / 46] Cap. III. De Negante et Negato. </p>\n<p> [[1695.4]] Effatum 19. quod et Theor. <i>Ex contradictione Consequentis sequitur Contradictio\n[[1695.5]] Antecedentis.</i> ... </p>\n<p> [[1695.6]] Commentarius. Atque hic jactum est fundamentum <b>Conversionis Soriticae</b> (ut\n[[1695.7]] eam ego voco) quam in quolibet Theoremate exercere licet: et in eo sita est, quod ex\n[[1695.8]] Contradictione Consequentis inferatur Contradictio Antecedentis; adeoque novum Theorema\n[[1695.9]] condatur, constans Contradictione Consequentis, ut Antecedente, et Contradictione\n[[1695.10]] Antecedentis, ut Consequente: ... </p>\n<p> [[1695.11]] [p. 99 / 50] Cap. IV. <i>De Alternis et Subalternis.</i> </p>\n<p> [[1695.12]] ... Effatum 2. quod et Theo. <i><b>Contradictiones Alternarum</b></i>, <i>Alternae sunt</i>. </p>\n<p> [[1695.13]] [p. 100 / 52] Effatum 3. quod et Theo. <i>Si ex certa aliqua enunciatione sequatur alia\n[[1695.14]] enunciatio, et ex contradictione prioris enunciationis etiam sequatur Contradictio\n[[1695.15]] posterioris enunciationis, <b>Alternae erunt istae enunciationes</b>. </p>\n",
  "number": "334.",
  "title": "Randbemerkungen und Unterstreichungen zu Arnold Geulincx, Methodus inveniendi argumenta",
  "date": "[1677 bis 1716 (?)]"
};
