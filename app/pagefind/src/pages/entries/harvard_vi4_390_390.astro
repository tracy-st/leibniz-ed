---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_390",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 390,
  "text": "[[1672.1]] <b>329₂.  De corpore et substantia vere una </p>\n<p> [[1672.5]] Corpus non est substantia, sed aggregatum substantiarum. Constat enim ex pluribus\n[[1672.6]] realiter distinctis, quemadmodum strues lignorum, congeries lapidum, grex, exercitus,\n[[1672.7]] piscina in qua multi natant pisces; et unumquodque corpus actu divisum est in plura\n[[1672.8]] corpora contenta. </p>\n<p> [[1672.9]] Jam non dantur substantiae, ubi non datur substantia, nec dantur numeri, nisi sint\n[[1672.10]] unitates, itaque necesse est praeter corpora dari substantias quasdam vere unas seu\n[[1672.11]] indivisibiles quarum aggregatis corpora constituantur. </p>\n<p> [[1672.12]] Error philosophorum materialium in eo est, quod agnita necessitate unitatis, substantiam\n[[1672.13]] in materia quaesivere, quasi corpus ullum dari posset, quod revera esset una\n[[1672.14]] substantia. Itaque ad atomos confugere tanquam terminos analyseos. Cum tamen omne\n[[1672.15]] corpus constet ex diversis substantiis, nec referat utrum partes cohaereant an non. Praeterquam\n[[1672.16]] quod ratio indivisibilitatis in atomis reddi non potest. </p>\n<p> [[1672.17]] Itaque cum omne corpus sit massa seu aggregatum plurium corporum; nullum\n[[1672.18]] corpus est substantia; et proinde substantia extra corpoream naturam quaerenda est. </p>\n<p> [[1672.19]] Est autem substantia aliquid vere unum, indivisibile, adeoque ingenerabile et\n[[1672.20]] incorruptibile, quod est subjectum Actionis et passionis; et ut verbo dicam, id ipsum quod\n[[1672.21]] intelligo cum dico <i>Ego</i> (<i>moy</i>), quod subsistit, etsi corpore meo per partes sublato, uti certe\n[[1672.22]] corpus meum in perpetuo fluxu est, superstite me. Nulla assignari potest pars corporis\n[[1672.23]] mei quae ad subsistentiam mei necessaria sit, nunquam tamen ego sum sine aliqua\n[[1672.24]] materiae parte unita. </p>\n<p> [[1672.25]] Interim ego corpore organico opus habeo, quanquam nihil in eo sit, quod sit necessarium\n[[1672.26]] ad subsistentiam mei. </p>\n<p> [[1673.1]] Analogum aliquid in omni intelligo animali, et ut verbo dicam in omni substantia\n[[1673.2]] vera vereque una. </p>\n<p> [[1673.3]] Infinitae autem sunt substantiae simplices seu creaturae in qualibet materiae particula;\n[[1673.4]] et componitur ex illis materia, non tanquam ex partibus, sed tanquam ex principiis\n[[1673.5]] constitutivis, seu requisitis immediatis, prorsus ut puncta continui essentiam ingrediuntur\n[[1673.6]] non tamen ut partes; neque enim pars est, nisi quod toti homogeneum est, sed substantia\n[[1673.7]] materiae seu corpori homogenea non est; non magis quam lineae punctum. </p>\n<p> [[1673.8]] In omni substantia nihil aliud est quam natura illa seu vis primitiva, ex qua sequitur\n[[1673.9]] series operationum ejus internarum. </p>\n<p> [[1673.10]] Ex quolibet statu substantiae seu natura ejus cognosci potest series, seu omnes ejus\n[[1673.11]] status praeteriti et futuri. </p>\n<p> [[1673.12]] Praeterea quaevis substantia involvit totum universum, et cognosci potest ex statu\n[[1673.13]] ejus etiam status aliarum. </p>\n<p> [[1673.14]] Diversarum substantiarum series perfecte consentiunt inter se, et unaquaeque\n[[1673.15]] exprimit totum universum secundum modum suum. Et in hoc consensu consistit unio\n[[1673.16]] animae et corporis, itemque id quod operationem substantiarum extra se appellamus. </p>\n<p> [[1673.17]] Quo perfectior substantia est, eo distinctius exprimit universum. </p>\n",
  "number": "329₂.",
  "title": "De corpore et substantia vere una",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:329₂. De corpore et substantia vere una Corpus non est substantia, sed aggregatum substantiarum. Constat enim ex pluribus realiter distinctis, quemadmodum strues lignorum, congeries lapidum, grex, exercitus, piscina in qua multi natant pisces; et unumquodque corpus actu divisum est in plura corpora ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>