---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_142",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 142,
  "text": "<p> [[378.7]] /  <b>142. VINCENT PLACCIUS AN LEIBNIZ</p>\n<p> [[378.8]] Hamburg, 7. (17.) September 1697. [136.144.]</b></p>\n\n<p> [[379.1]] I. N. J. C. </p>\n<p> [[379.2]] Viro Amplissimo, Nobilissimo et Excellentissimo G. G. Leibnitio S. P. D. </p>\n<p> [[379.3]] V. Placcius. </p>\n<p> [[379.4]] Equidem credebam peregre Te, vel quod abhorrebat animus, in morbo esse; quia nil\n[[379.5]] respondebatur. Et ni fallor etiam peregrinaris. Nam Hanoverae antea semper Te puto egisse.\n[[379.6]] Neque scio an Guelpherbytum nunc et imposterum debeam meas destinare. Praesentes sane\n[[379.7]] adhuc Hanoveram misi, sperans etiam inde a[d] te perventuras si absis. Weigelius spem Viros\n[[379.8]] executores suae institutionis dandi plane omnem ademit. Francianae Scholae ad me descriptio\n[[379.9]] etiam pervenit. Sed generalia magis quam specialia delineans. Spenerus edere illam molitur ut\n[[379.10]] audio. Faxit Deus feliciter! De Scepperi altero libro amicus meus spem deponit. Nec ego de\n[[379.11]] Carniolanae linguae Boxhornii libello audivi unquam, aut audire aliunde confido. <Fn><i>Dazu von Leibniz' Hand ergänzt</i>: An me de eo somniasse putat?</Fn> </p>\n<p> [[379.12]] Par illud Anglorum mihi ex suis scriptis, non aliunde notum est, et mirifice commendatum.\n[[379.13]] Nullis lubentius exemplar <i>Accessionum</i> mearum dono mitterem, si scirem occasionem\n[[379.14]] certo ad manus eorum perferendi. Nec enim puto ad eos etiamnum pervenisse; licet jam sesqui\n[[379.15]] anno in bibliopoliis sint. Quaeso si potes hac in re pararium te praestare, id facias; ut eorum\n[[379.16]] mentem de hisce meis accipiam. <i>Pseudonymis</i> jam jam finitis ultra dimidium, et <i>Anonymis</i> fere\n[[379.17]] in totum, quietem ab hoc labore anhelo; ut solis posthac sacris vacem: quorum tamen dum\n[[379.18]] vivam vix aliquid edetur. O si possem eruditam et vere Philosophicam Theologiam eam meae\n[[379.19]] philosophiae superstruere, quae ab imbecillitatibus conceptum de divinis liberet ita; ut intelligant\n[[379.20]] Theologi se hactenus populariter nimis de rebus illis disputasse. Neque ullam nisi\n[[380.1]] vulgarem ideam concepisse, adeoque rejectis omnibus istis hactenus habitis controversiis frustra\n[[380.2]] fuisse. Sane, ni fallor, intelligunt Deum proprie sumtis philosophice vocibus et sensibus, non\n[[380.3]] irasci, non opus habere satisfactione et vindicta. Quid ergo substituent eruditae notioni ut a\n[[380.4]] Socianismo immunes et orthodoxi maneant? Sane aliquid altioris notionis et Deo dignioris in\n[[380.5]] hac sapientia est, quae parvulis ut parvulis non ad disputandum, sed credendum proponitur. In\n[[380.6]] qua quia subsistere nolunt: utinam saltim aliquid Majestate divina dignum substituant notionibus\n[[380.7]] adeo plebejis; ne inter sacrum et saxum positi, nec erudite nec plebeje credant. Sed\n[[380.8]] manum de Tabula. Vale. Hamb. 1697. d. 7. Septembr. </p>\n<p> [[380.9]] Jam nunc Epistolam accipio Helmstadio, in qua haec verba: <i>Placcianam soliditatem (cui\n[[380.10]] Anglorum eruditos, quos et innatum ingenii acumen, et diligens exercitatio idoneos maxime\n[[380.11]] harum rerum aestimatores facit, cum tempore ubique assurgere accepi)</i> etc. </p>\n",
  "number": "142.",
  "title": "VINCENT PLACCIUS AN LEIBNIZ",
  "date": "Hamburg, 7. (17.) September 1697. [136.144.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:/ 142. VINCENT PLACCIUS AN LEIBNIZ Hamburg, 7. (17.) September 1697. [136.144.] I. N. J. C. Viro Amplissimo, Nobilissimo et Excellentissimo G. G. Leibnitio S. P. D. V. Placcius. Equidem credebam peregre Te, vel quod abhorrebat animus, in morbo esse; quia nil respondebatur. Et ni fallor etiam peregri...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>