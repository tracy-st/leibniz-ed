---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_299",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 299,
  "text": "[[1333.12]] <b>245.  Ad grammaticam linguae universalis Philippi Labbii [1689 (?)]</b>\n [[1333.13]] <tab/>[1689 (?)] </p>\n<p> [[1333.18]] <i>Grammatica linguae universalis Missionum et Commerciorum simplicissimae, brevissimae\n[[1333.19]] facillimae, ut ejus beneficio multa dicantur et audiantur paucis, multa scribantur\n[[1333.20]] et legantur paucis; terra fiat Labii unius accessere Lexici et Tirocinii specimina\n[[1333.21]] autore Phil. Labbe S. J.</i> </p>\n<p> [[1333.22]] Meminit in praefatione conferendum hoc suum opus cum cognatis quibusdam,\n[[1334.1]] nempe cum <i>Intelligentiis</i> Johannis de Villiers Parisiis 1587 excusis, et cum libello <i>De\n[[1334.2]] Charactere Universali</i> Johannis Douet in eadem urbe 1627 publicato; et duobus libris ab\n[[1334.3]] H. Justello communicatis, Londini excusis, uno 1657, altero 1661. Addit haec sibi decreta\n[[1334.4]] arrisisse: 1) ablegandos esse casus a nominibus, a verbis personas, quae illos per particulas,\n[[1334.5]] has per pronomina suppleri posse. 2) ablegandum superlativa comparativa, Tum\n[[1334.6]] genera nisi cum discernitur sexus. 3) Plurales a singulari adjuncti sibilo <i>S</i> distinguendos.\n[[1334.7]] 4) modos verborum mutatione vocalis finalis tempora inserta consonante characteristica,\n[[1334.8]] vocem passivam addito <i>R</i> posse formari. 5) Pronomina quae saepissime occurrunt, et\n[[1334.9]] personas in verbis agunt brevissimo unius vocalis signo exprimenda. 6) Maximam derivatorum\n[[1334.10]] compositorumque rationem habendam, ut quam minimo sumtu fiat, eodemque\n[[1334.11]] tenore; nec negligenda esse numeralia, quibus omnis illuminatur oratio. 7) Particularum\n[[1334.12]] hoc est praepositionum conjunctionum adverbiorumque sylvam certis limitibus, iisque\n[[1334.13]] arctissimis concludendam. 8) Fundanda haec in cognitissimae Europaeis omnibus Latinae\n[[1334.14]] linguae radicibus, in flexione quam minima servato naturae ipsius ductu atque ordine in\n[[1334.15]] syntaxi et pronuntiatione. 9) Exhibendum specimen Grammaticae et Januae. 10) Subjungendum\n[[1334.16]] Lexicon, in quo verba ad suas radices atque origines revocentur. </p>\n<p> [[1334.17]] Interim noto autorem in cap. de syntaxi (contra propria decreta exceptiones excludentia)\n[[1334.18]] dicere <b>pleraque</b> substantiva debere adjectivis praeponi; item plerasque conjunctiones\n[[1334.19]] et quaedam adverbia, quae aliis optativum vel subjunctivum, hic regere infinitivum. </p>\n",
  "number": "245.",
  "title": "Ad grammaticam linguae universalis Philippi Labbii",
  "date": "[1689 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:245. Ad grammaticam linguae universalis Philippi Labbii [1689 (?)] [1689 (?)] Grammatica linguae universalis Missionum et Commerciorum simplicissimae, brevissimae facillimae, ut ejus beneficio multa dicantur et audiantur paucis, multa scribantur et legantur paucis; terra fiat Labii unius accessere L...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_vi4_299","series":"Band VI 4 (1677 - 1690)","seq":299,"text":"[[1333.12]] <b>245.  Ad grammaticam linguae universalis Philippi Labbii [1689 (?)]</b>\n [[1333.13]] <tab/>[1689 (?)] </p>\n<p> [[1333.18]] <i>Grammatica linguae universalis Missionum et Commerciorum simplicissimae, brevissimae\n[[1333.19]] facillimae, ut ejus beneficio multa dicantur et audiantur paucis, multa scribantur\n[[1333.20]] et legantur paucis; terra fiat Labii unius accessere Lexici et Tirocinii specimina\n[[1333.21]] autore Phil. Labbe S. J.</i> </p>\n<p> [[1333.22]] Meminit in praefatione conferendum hoc suum opus cum cognatis quibusdam,\n[[1334.1]] nempe cum <i>Intelligentiis</i> Johannis de Villiers Parisiis 1587 excusis, et cum libello <i>De\n[[1334.2]] Charactere Universali</i> Johannis Douet in eadem urbe 1627 publicato; et duobus libris ab\n[[1334.3]] H. Justello communicatis, Londini excusis, uno 1657, altero 1661. Addit haec sibi decreta\n[[1334.4]] arrisisse: 1) ablegandos esse casus a nominibus, a verbis personas, quae illos per particulas,\n[[1334.5]] has per pronomina suppleri posse. 2) ablegandum superlativa comparativa, Tum\n[[1334.6]] genera nisi cum discernitur sexus. 3) Plurales a singulari adjuncti sibilo <i>S</i> distinguendos.\n[[1334.7]] 4) modos verborum mutatione vocalis finalis tempora inserta consonante characteristica,\n[[1334.8]] vocem passivam addito <i>R</i> posse formari. 5) Pronomina quae saepissime occurrunt, et\n[[1334.9]] personas in verbis agunt brevissimo unius vocalis signo exprimenda. 6) Maximam derivatorum\n[[1334.10]] compositorumque rationem habendam, ut quam minimo sumtu fiat, eodemque\n[[1334.11]] tenore; nec negligenda esse numeralia, quibus omnis illuminatur oratio. 7) Particularum\n[[1334.12]] hoc est praepositionum conjunctionum adverbiorumque sylvam certis limitibus, iisque\n[[1334.13]] arctissimis concludendam. 8) Fundanda haec in cognitissimae Europaeis omnibus Latinae\n[[1334.14]] linguae radicibus, in flexione quam minima servato naturae ipsius ductu atque ordine in\n[[1334.15]] syntaxi et pronuntiatione. 9) Exhibendum specimen Grammaticae et Januae. 10) Subjungendum\n[[1334.16]] Lexicon, in quo verba ad suas radices atque origines revocentur. </p>\n<p> [[1334.17]] Interim noto autorem in cap. de syntaxi (contra propria decreta exceptiones excludentia)\n[[1334.18]] dicere <b>pleraque</b> substantiva debere adjectivis praeponi; item plerasque conjunctiones\n[[1334.19]] et quaedam adverbia, quae aliis optativum vel subjunctivum, hic regere infinitivum. </p>\n","number":"245.","title":"Ad grammaticam linguae universalis Philippi Labbii","date":"[1689 (?)]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>