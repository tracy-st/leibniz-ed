---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_299",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 299,
  "text": "[[1333.12]] <b>245.  Ad grammaticam linguae universalis Philippi Labbii [1689 (?)]</b>\n [[1333.13]] <tab/>[1689 (?)] </p>\n<p> [[1333.18]] <i>Grammatica linguae universalis Missionum et Commerciorum simplicissimae, brevissimae\n[[1333.19]] facillimae, ut ejus beneficio multa dicantur et audiantur paucis, multa scribantur\n[[1333.20]] et legantur paucis; terra fiat Labii unius accessere Lexici et Tirocinii specimina\n[[1333.21]] autore Phil. Labbe S. J.</i> </p>\n<p> [[1333.22]] Meminit in praefatione conferendum hoc suum opus cum cognatis quibusdam,\n[[1334.1]] nempe cum <i>Intelligentiis</i> Johannis de Villiers Parisiis 1587 excusis, et cum libello <i>De\n[[1334.2]] Charactere Universali</i> Johannis Douet in eadem urbe 1627 publicato; et duobus libris ab\n[[1334.3]] H. Justello communicatis, Londini excusis, uno 1657, altero 1661. Addit haec sibi decreta\n[[1334.4]] arrisisse: 1) ablegandos esse casus a nominibus, a verbis personas, quae illos per particulas,\n[[1334.5]] has per pronomina suppleri posse. 2) ablegandum superlativa comparativa, Tum\n[[1334.6]] genera nisi cum discernitur sexus. 3) Plurales a singulari adjuncti sibilo <i>S</i> distinguendos.\n[[1334.7]] 4) modos verborum mutatione vocalis finalis tempora inserta consonante characteristica,\n[[1334.8]] vocem passivam addito <i>R</i> posse formari. 5) Pronomina quae saepissime occurrunt, et\n[[1334.9]] personas in verbis agunt brevissimo unius vocalis signo exprimenda. 6) Maximam derivatorum\n[[1334.10]] compositorumque rationem habendam, ut quam minimo sumtu fiat, eodemque\n[[1334.11]] tenore; nec negligenda esse numeralia, quibus omnis illuminatur oratio. 7) Particularum\n[[1334.12]] hoc est praepositionum conjunctionum adverbiorumque sylvam certis limitibus, iisque\n[[1334.13]] arctissimis concludendam. 8) Fundanda haec in cognitissimae Europaeis omnibus Latinae\n[[1334.14]] linguae radicibus, in flexione quam minima servato naturae ipsius ductu atque ordine in\n[[1334.15]] syntaxi et pronuntiatione. 9) Exhibendum specimen Grammaticae et Januae. 10) Subjungendum\n[[1334.16]] Lexicon, in quo verba ad suas radices atque origines revocentur. </p>\n<p> [[1334.17]] Interim noto autorem in cap. de syntaxi (contra propria decreta exceptiones excludentia)\n[[1334.18]] dicere <b>pleraque</b> substantiva debere adjectivis praeponi; item plerasque conjunctiones\n[[1334.19]] et quaedam adverbia, quae aliis optativum vel subjunctivum, hic regere infinitivum. </p>\n",
  "number": "245.",
  "title": "Ad grammaticam linguae universalis Philippi Labbii",
  "date": "[1689 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:245. Ad grammaticam linguae universalis Philippi Labbii [1689 (?)] [1689 (?)] Grammatica linguae universalis Missionum et Commerciorum simplicissimae, brevissimae facillimae, ut ejus beneficio multa dicantur et audiantur paucis, multa scribantur et legantur paucis; terra fiat Labii unius accessere L...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>