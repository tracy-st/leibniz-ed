---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_35",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 35,
  "text": "<p> [[94.1]] <b>35. MENTET KETTWIG AN LEIBNIZ</p>\n<p> [[94.2]] Emden, 26. Oktober (5. November) 1695. [38.]</b></p>\n\n<p> [[94.9]] Illustri et Magnifico Viro Godef. Guilielmo Leibnitzio Ment. Kettwig S.D.P. </p>\n<p> [[94.10]] Has Vir illustris ad Te curare litteras, hasque pagellas offerre perlegendas, non una causa\n[[94.11]] fuit. Tum Amplissimi Feltmanni singulare profundioris tuae eruditionis testimonium, Te videlicet\n[[94.12]] omnium optime, hac de quaestione judicaturum, futurumque Censorem ut earum rerum\n[[94.13]] callentissimum, ita et aequissimum; Cum illustria tua scripta, et incomparabilis foetus <i>Codicis\n[[94.14]] juris gentium Diplomatici</i>, cujus ad Lectorem praemissa praefatio certiorem me reddidit, Te\n[[94.15]] haudquaquam cum plebe Philosophorum Hobbesium judicare brutum, sed (: qualis revera est :)\n[[94.16]] acutissimum. Sisto itaque pagellas has illustri tuo judicio, non, ut materia suadet, eas exasciatas\n[[94.17]] quidem, sed ut ab homine juvene et forensibus negotiis occupatissimo profectas, cui tamen, si\n[[94.18]] bonis avibus otium concederetur tutius, et a strepitu fori magis remotum, curae cordique semper\n[[94.19]] foret, id studiorum genus excolere, et juris privati principia, ad veram solidamque juris naturae\n[[94.20]] normam revocare, equidem oppido multa sunt, quae satis jejune IC^#'t^#'i adstruunt, nec ultra, quam\n[[94.21]] Papinianus dixit, inquirunt. Ast nolo esse longior, sed voto finire; Velit Te Deus, in emolumentum\n[[94.22]] Serenissimae Domus Electoralis, Reipublicae litterariae, Tuaequae gentis, diu sospitem.\n[[94.23]] Embdae in Frisiis orientalibus d. XXVI. Octobris MDCXCV. </p>\n",
  "number": "35.",
  "title": "MENTET KETTWIG AN LEIBNIZ",
  "date": "Emden, 26. Oktober (5. November) 1695. [38.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:35. MENTET KETTWIG AN LEIBNIZ Emden, 26. Oktober (5. November) 1695. [38.] Illustri et Magnifico Viro Godef. Guilielmo Leibnitzio Ment. Kettwig S.D.P. Has Vir illustris ad Te curare litteras, hasque pagellas offerre perlegendas, non una causa fuit. Tum Amplissimi Feltmanni singulare profundioris tua...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>