---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_235",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 235,
  "text": "<p> [[733.13]] <b>208. NICOLAS MALEBRANCHE AN LEIBNIZ</p>\n<p> [[733.14]] Paris, 31. Juli [1679]. [207.210.]</b></p>\n<p> [[734.2]] Monsieur </p>\n<p> [[734.3]] L'Auteur des <i>Meditations Metaphysiques</i> est Monsieur l'Abbé de Lanion. Quoiqu'il\n[[734.4]] n'ait point mis son nom il ne s'en cache point, je le sçai parce qu'il me l'a dit et à plusieurs\n[[734.5]] autres personnes que je connois. Ainsi Monsieur ne m'attribuez point s'il vous plaist cet\n[[734.6]] ouvrage. </p>\n<p> [[734.7]] Un gentilhomme Allemand est passé ici et qui je croi doit vous aller voir, lequel à ce que\n[[734.8]] l'on dit et que je ne croi pas possible, a trouvé le moyen de faire evanouir tous les termes d'une\n[[734.9]] Equation hormis le l^#'e^#'r et le dernier. Quoique je ne m'applique nullement depuis bien du tems à\n[[734.10]] ces sortes d'etudes je serois pourtant bien aise de sçavoir si cela est possible et je ne doute pas\n[[734.11]] que vous ne vous donniez la peine de l'examiner lorsque ce gentilhomme vous le communiquera. </p>\n<p> [[734.13]] L'Auteur des <i>Elemens</i> est persuadé qu'il y a bien des decouvertes à faire sur l'analyse\n[[734.14]] mais il a peine à s'appliquer à ces sortes d'etudes, je l'ai pourtant porté à revoir son ouvrage\n[[734.15]] pour le faire plus exact. Il y a long tems Monsieur que vous nous faites esperer quelque chose\n[[734.16]] sur cette matiere et sans doute vous pouvez tout. </p>\n<p> [[734.17]] Monsieur des Billetes a toujours la fievre quarte, il pensa mourir il y a environ deux mois.\n[[734.18]] Je pense que vous sçavez que M^#'r^#'s Arnaud et Nicole ne paroissent plus, ils se sont cachez, je\n[[734.19]] n'en sçai pas les raisons particulieres. Il y a des gens qui disent qu'ils sont allez à Rome mais je\n[[734.20]] ne croi pas que cela soit vrai. </p>\n<p> [[734.21]] Je ne sçai point d'ouvrage ni de nouvelle decouverte dont je puisse allonger ma lettre.\n[[734.22]] Ainsi permettez de me dire </p>\n<p> [[734.23]] Monsieur Votre tres humble et tres obeissant serviteur Malebranche P. D. L'O. </p>\n<p> [[734.24]] A Paris ce dernier Juillet. </p>\n<p> [[734.25]] A Monsieur Monsieur Leibniz Conseiller de Son Altesse Monseigneur le Duc de Hanovre\n[[734.26]] Prince de l'Empire. À Hanovre. </p>\n",
  "number": "208.",
  "title": "NICOLAS MALEBRANCHE AN LEIBNIZ",
  "date": "Paris, 31. Juli [1679]. [207.210.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:208. NICOLAS MALEBRANCHE AN LEIBNIZ Paris, 31. Juli [1679]. [207.210.] Monsieur L'Auteur des Meditations Metaphysiques est Monsieur l'Abbé de Lanion. Quoiqu'il n'ait point mis son nom il ne s'en cache point, je le sçai parce qu'il me l'a dit et à plusieurs autres personnes que je connois. Ainsi Mons...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii1_235","series":"Band II 1 (1663 - 1685)","seq":235,"text":"<p> [[733.13]] <b>208. NICOLAS MALEBRANCHE AN LEIBNIZ</p>\n<p> [[733.14]] Paris, 31. Juli [1679]. [207.210.]</b></p>\n<p> [[734.2]] Monsieur </p>\n<p> [[734.3]] L'Auteur des <i>Meditations Metaphysiques</i> est Monsieur l'Abbé de Lanion. Quoiqu'il\n[[734.4]] n'ait point mis son nom il ne s'en cache point, je le sçai parce qu'il me l'a dit et à plusieurs\n[[734.5]] autres personnes que je connois. Ainsi Monsieur ne m'attribuez point s'il vous plaist cet\n[[734.6]] ouvrage. </p>\n<p> [[734.7]] Un gentilhomme Allemand est passé ici et qui je croi doit vous aller voir, lequel à ce que\n[[734.8]] l'on dit et que je ne croi pas possible, a trouvé le moyen de faire evanouir tous les termes d'une\n[[734.9]] Equation hormis le l^#'e^#'r et le dernier. Quoique je ne m'applique nullement depuis bien du tems à\n[[734.10]] ces sortes d'etudes je serois pourtant bien aise de sçavoir si cela est possible et je ne doute pas\n[[734.11]] que vous ne vous donniez la peine de l'examiner lorsque ce gentilhomme vous le communiquera. </p>\n<p> [[734.13]] L'Auteur des <i>Elemens</i> est persuadé qu'il y a bien des decouvertes à faire sur l'analyse\n[[734.14]] mais il a peine à s'appliquer à ces sortes d'etudes, je l'ai pourtant porté à revoir son ouvrage\n[[734.15]] pour le faire plus exact. Il y a long tems Monsieur que vous nous faites esperer quelque chose\n[[734.16]] sur cette matiere et sans doute vous pouvez tout. </p>\n<p> [[734.17]] Monsieur des Billetes a toujours la fievre quarte, il pensa mourir il y a environ deux mois.\n[[734.18]] Je pense que vous sçavez que M^#'r^#'s Arnaud et Nicole ne paroissent plus, ils se sont cachez, je\n[[734.19]] n'en sçai pas les raisons particulieres. Il y a des gens qui disent qu'ils sont allez à Rome mais je\n[[734.20]] ne croi pas que cela soit vrai. </p>\n<p> [[734.21]] Je ne sçai point d'ouvrage ni de nouvelle decouverte dont je puisse allonger ma lettre.\n[[734.22]] Ainsi permettez de me dire </p>\n<p> [[734.23]] Monsieur Votre tres humble et tres obeissant serviteur Malebranche P. D. L'O. </p>\n<p> [[734.24]] A Paris ce dernier Juillet. </p>\n<p> [[734.25]] A Monsieur Monsieur Leibniz Conseiller de Son Altesse Monseigneur le Duc de Hanovre\n[[734.26]] Prince de l'Empire. À Hanovre. </p>\n","number":"208.","title":"NICOLAS MALEBRANCHE AN LEIBNIZ","date":"Paris, 31. Juli [1679]. [207.210.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>