        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:82. LEIBNIZ AN DANIEL GEORG MORHOF [August 1690.] Nobilissime et Ampl^#'m^#'e Vir Ignotam mihi atque utinam diu adhuc omnibus ignoratam mortem incomparabilis Viri Marquardi Gudii didici nuper ex Menstruis dialogis Tenzelianis, simulque ipsi aliquo modo a Te esse parentatum; id quod pie factum judica...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
