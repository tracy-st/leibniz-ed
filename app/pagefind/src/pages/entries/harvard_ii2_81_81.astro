import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_81",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 81,
  "text": "<p> [[334.1]] <b>82. LEIBNIZ AN DANIEL GEORG MORHOF</p>\n<p> [[334.2]] [August 1690.]</b></p>\n<p> [[334.14]] Nobilissime et Ampl^#'m^#'e Vir </p>\n<p> [[334.15]] Ignotam mihi atque utinam diu adhuc omnibus ignoratam mortem incomparabilis Viri\n[[334.16]] Marquardi Gudii didici nuper ex Menstruis dialogis Tenzelianis, simulque ipsi aliquo modo a\n[[334.17]] Te esse parentatum; id quod pie factum judicavi, et ipsius et patriae causa. Fuit enim profecto\n[[334.18]] ornamentum Germaniae, quod utinam modestia ejus, aut potius nimia quaedam abundantia\n[[334.19]] doctrinae quae delectum edendi aliquid prope abstulerat, non velut sub modio positum lumen\n[[334.20]] occuluisset. Ego vero cum saepe Tecum colloqui optassem dudum, hinc impetum scribendi, et\n[[334.21]] ex parte argumentum sumsi, ut beneficio tuo discam, quid affecerit absolveritve, et quid de\n[[334.22]] relictis sit sperandum nobis. Sed magis adhuc intelligere desidero, quod universam literarum\n[[334.23]] Rempublicam tangit, progressum <i>Polyhistoris</i> scilicet tui, quo neque utilius quicquam, neque\n[[334.24]] ad famam illustrius aggredi poteras. </p>\n<p> [[334.25]] Ego qui cum rerum meditatione aliquam historiae literariae curam libenter junxi, mirifice\n[[334.26]] lectione eorum me captum profiteor, quae jam edidisti in prima parte; et moram necessariam\n[[334.27]] caeteris interpositam vix possum ferre prae desiderio. Ipse ex quo adolescens duos libellos\n[[334.28]] immaturos solita aetati audacia protrusi in publicum, unum <i>artis combinatoriae</i>, alterum\n[[335.1]] <i>Methodi juridicae</i> titulo, multa quidem meditatus sum, circa emendationem rei literariae studiorumque\n[[335.2]] incrementa, altiusque paulo in abdita descendi, sed plura cogitavi quam scripsi. In\n[[335.3]] summa autem cognitionem nostram in duo genera dispesco; alia enim magis facti sunt, alia\n[[335.4]] juris seu potius rationis. Illa ex historia et ductis inde observationibus colligi debent; haec\n[[335.5]] ratiocinando cognoscuntur. Notitias universales inductionibus, experimentis, observationibus,\n[[335.6]] stabilitas, possis fortasse communi nomine appellare <b>Aphorismos</b>, Hippocrateorum exemplo;\n[[335.7]] nam quorum certa ratio est, ut praeconstitui potuerint ante observationem, ea hinc ablego;\n[[335.8]] tantique Aphorismos facio, ut vellem praemia ex publico Medicis statui novos cudentibus, qui\n[[335.9]] successu comprobentur. Quae vero ante experimentum sciri possunt, <b>Theoremata</b> appellare\n[[335.10]] malo cum Geometris. </p>\n<p> [[335.11]] Duo autem magna desideria sive vota concipi posse video, quibus caetera comprehendantur,\n[[335.12]] unum Inventarii, alterum Augmenti. <b>Inventarii</b> nomine designo corpus humanae\n[[335.13]] omnis notitiae jam repertae; <b>Augmenti</b> vero quicquid pertinet ad novas notitias humano\n[[335.14]] generi parandas. Notitiae jam repertae, vel extant in libris, vel sparsae sunt per homines, varia\n[[335.15]] vitae genera colentes, nec dum in penum librariam relatae. Illas colligi oporteret conspirantibus\n[[335.16]] eruditorum studiis, has annotari publico jussu, ne pereant non sine detrimento generis humani,\n[[335.17]] quod inofficiose exhaeredare videntur, quicunque comperta sibi quaedam insignioris utilitatis\n[[335.18]] sepeliri secum patiuntur. Novae porro notitae, sive demonstrationibus sive experimentis parandae\n[[335.19]] mirifice quidem crescunt hodie, si nostra cum veteribus conferas, non tamen satis, si\n[[335.20]] cogites, quid sit in potestate nostra. Ita enim prorsus sentio in universum, si vellemus homines\n[[335.21]] datis viribus ac divino munere uti, posse intra viginti annos effici ad communem felicitatem,\n[[335.22]] quod nobis solutius agentibus ut hactenus, totidem secula vix praestabunt. </p>\n<p> [[335.23]] Caeterum agnosco lubens, quod optare hic fas est sperare non licere, donec Deus eam qua\n[[335.24]] opus est det mentem his qui rerum per orbem patiuntur. <i>Humanum paucis vivit genus</i>, ut ait\n[[335.25]] poëta; sufficeretque eos a quibus in omnia regimen, intelligere, quanti sit ad augendam Dei\n[[335.26]] gloriam, ad virtutis studium, ad conservandam sanitatem, ad vitae commoditates, ad summam\n[[335.27]] ipsorummet voluptatem, coli ut oportet, hoc pretiosissimum Humani generis patrimonium,\n[[336.1]] quod in Mentis opibus consistit. Interea tamen, dum publicarum rerum facies majora intercipit,\n[[336.2]] ipsorum est eruditorum curiosorumque hominum, quibus amor est publici, et temporis aliquid\n[[336.3]] superabundat; et concessae divinitus vires sunt praesto, non tantum laborare strenue quod multi\n[[336.4]] faciunt, sed laborare ordine et consulto, et operis bene partitis. Maximum esse numerum\n[[336.5]] scribentium eruditorum Nundinales Catalogi loquuntur; quantum effecturos putas, si non agerent\n[[336.6]] acta, si agerent agenda, si non perstringerent materias, sed elaborarent, si denique ita\n[[336.7]] ducerent omnia ex fontibus constituerentque, ut suppleri potius quam retractari eadem opus\n[[336.8]] esset. In tanta librorum multitudine neque Geographiam habemus limatam et ex itinerariis\n[[336.9]] suppletam (Atlantibus potius historiam tractantibus loco non suo), neque Historiam vel universalem\n[[336.10]] vel in plerisque particularem ex bonis autoribus (ne dicam diplomatibus quae omnes\n[[336.11]] habere non possunt) demonstratam (quotusquisque enim ad contemporaneos recurrit), neque\n[[336.12]] Genealogias Principum plerorumque expurgatas Henningesiumque emendatum, neque res\n[[336.13]] nostri temporis pro dignitate tractatas, dum plerumque nemo avidius scribit quam qui ultra\n[[336.14]] novellas non sapit; porro neque radices habemus proprietatesque linguarum orbis quales Skyttius\n[[336.15]] promittebat, neque dictionarium absolutum ullius linguae viventis, plerarumque ne quidem\n[[336.16]] affectum, utinam enim in Germania haberemus saltem quod Fureterius Gallis dedit. </p>\n<p> [[336.17]] Desideratur adhuc Opus generale quale Vossius in Historicis coepit; universalisque praeterea\n[[336.18]] librorum catalogus inde ab inventa Typographia suis instructus indicibus, qualem Hanisius\n[[336.19]] Guelferbyti, Hendreichius Berolini moliri se significabant. Quis desertam a Lambecio literariae\n[[337.1]] Historiae provinciam in se suscipiet, quis ipsam dogmatum Historiam candide lucideque\n[[337.2]] tractabit; involvuntur enim philosophica controversiis religionum, in quibus diu expectavimus\n[[337.3]] Seckendorfios et Burnetos. Nunc expectamus qui Petavium absolvat. Vel solum Gratiae argumentum\n[[337.4]] sibi proprium Historicum postularet, qui Vossii Pelagiana prosequeretur usque ad\n[[337.5]] nostrum tempus. </p>\n<p> [[337.6]] Quam multa in Jurisprudentia desunt, quae tamen libris Repertoriis luxuriare videbatur?\n[[337.7]] Ne dicam de eo quod rei caput est, incertitudine juris qua pudendum in modum laboramus,\n[[337.8]] quam multa ignorantur circa Historiam juris? Per Europam quanta varietas circa feuda, et\n[[337.9]] colonos cujus causae a bellis et populorum mutationibus repetendae, et partem facerent Historiae\n[[337.10]] provincialis. Et saepe erratur a jurisconsultis localium consuetudinum neglectu, quarum\n[[337.11]] Harmoniam velim esset qui porro tractaret post vestrum Gisebertum optimum virum. Utilioris\n[[337.12]] adhuc operae foret, ex variis gentium legibus excerpere, quae imitari prosit. De re militari, qua\n[[337.13]] stant regna, quid habemus pro dignitate argumenti scriptum? quam vastus hic campus est, in\n[[337.14]] quo Mathesis et politica totis viribus concurrunt, ut mobilis Respublica, hoc est exercitus bene\n[[337.15]] regatur. Pleraque vitae genera adhuc doctum et expertum descriptorem desiderant. Habemus\n[[337.16]] aliqua in Georgicis non contemnenda, et circa rem venatoriam, piscatoriam, sed quam multa\n[[337.17]] pulchra adhuc latent. Nautica, Mercatoria, Metallica, Monetaria, quantae molis? Qui rem\n[[337.18]] textoriam aut tinctoriam, aut fabrilem recte tractare vellet ad usum reipublicae, quam late\n[[337.19]] patentem inveniret tractum, occupanti cessurum. Adeo maxime utilia nondum satis scripta\n[[337.20]] habentur. Memini me loqui eruditis, qui talia in juventute didicerant, et poterant augere\n[[337.21]] thesaurum doctrinae, si suas notitias chartis commendavissent [,] neque ego hortari desinebam[,]\n[[337.22]] sed illi malebant nescio quas alias nugas scribere, aut describere. Quam multos putas\n[[337.23]] tales esse, quibus passim occasiones offeruntur ditandi rem literariam, habent in vicinis, amicis,\n[[337.24]] cognatis, varias artes nondum satis scriptas exercentibus, unde petant, quae praestaret annotare\n[[337.25]] in usus hominum, quam onerare officinas inutilibus chartis: sed non minima nugacium ­librorum\n[[338.1]] causa sunt Bibliopolae, qui non curant quid melius sed quid vendi promtius, horum opinioni\n[[338.2]] servire eruditos ridiculum est. </p>\n",
  "number": "82.",
  "title": "LEIBNIZ AN DANIEL GEORG MORHOF",
  "date": "[August 1690.]"
};
