---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_236",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 236,
  "text": "<p> [[637.1]] <b>236. CLAUDE NICAISE AN LEIBNIZ </p>\n<p> [[637.2]] Dijon, 6. Mai 1700. [228.237.]</b></p>\n\n<p> [[637.9]] Dijon le 6 may <b>1700</b> </p>\n<p> [[637.10]] Il y a long tems monsieur que je n'ay reçu de vos Nouvelles; J'attribue ce silence à vos\n[[637.11]] grandes occupations et surtout à celle que vous donne presentement vostre <i>Codex diplomaticus</i>.\n[[637.12]] Je croy que vous devés avoir recû il y a long tems le pacquet de mons. le president Boisoit que\n[[637.13]] je donnay icy à l'abbé Maumenêt allant à Paris pour le remettre es mains de mons^#'r de Brosseau\n[[637.14]] qui m'en a remercié; Je luy en espargnay le port ce que mons^#'r le president ne fit pas à mon\n[[637.15]] egard me l'ayant envoyé par la poste; il vouloit même à ce qu'il me mandoit vous l'envoyer par\n[[637.16]] la même voye à Hanovre; Je serois faché qu'il fûst ancor arrivé quelque disgrace à ce pacquet.\n[[637.17]] J'ay enfin busqué avec assés de peine le plan du traicté <i>de fide veterum instrumentorum</i> dont je\n[[637.18]] vous ay parlé autrefois et que vous m'avés temoigné desirer; je vous l'envoye dans cette lettre.\n[[637.19]] Le dessein en paroist beau; mais je ne sçay si l'autheur l'avoit pû accomplir; Il y a dix ans qu'il\n[[637.20]] est mort. Les lettres des scavants à mons^#'r de Peiresk s'achevent d'imprimer à Geneve chés\n[[637.21]] mons. de Tournes qui a faict jusqu'à present un grand mystere de cette impression, crainte\n[[637.22]] qu'on ne luy allast à la traverse; J'ay veû celles de Vargas traduites par le pere Le Vassor qui y a\n[[637.23]] mis une preface fort outrée et qui luy a faict tort et ancor plus que cela l'histoire abominable de\n[[637.24]] Louis 13. Il porte maintenant la peine de sa temerité, vous scavés que le Roy d'Angleterre\n[[638.1]] Guillaume l'a mis entre les mains de nostre Ambassadeur qui l'a faict conduire au mont\n[[638.2]] S^#'t Michel où il est pour le reste de ses jours; <i>discere justitiam Moniti et non spernere Divos</i>.\n[[638.3]] J'ay veû celles d'Hubert Languet en 2 vol. 4^#'o. sens preface sens Augmentation aux epitres\n[[638.4]] longues et prolixes et sens aucun Index. Vous m'avés osté de la peine où j'estois avec beaucoup\n[[638.5]] d'autres gens, qu'on eut oublié la vie de l'auteur par m^#'r de la Mare qu'on a imprimé separement.\n[[638.6]] Je ne scay pourquoy on ne l'a pas mis à la liste de ces epitres; elle auroit pû servir en\n[[638.7]] quelque facon de preface; le tiltre d'<i>Arcanum saeculi decimi sexti</i> ne luy est pas mal mis; car en\n[[638.8]] verité l'on n'a guere eu de soin de rendre cette edition agreable et intelligible. Je croy qu'on\n[[638.9]] nous la donnera bientost meilleure en Hollande. Mons^#'r Thiers a donné depuis peû l'histoire de\n[[638.10]] la <i>S^#'t^#'e Larme de Vandosme</i> qui a beaucoup irrité les benedictins qui ont employé dom Mabillon à\n[[638.11]] y repondre par une dissertation qu'il dedie à mons^#'r l'eveque de Blois; le scavant prelat mons^#'r\n[[638.12]] d'Avranches me faict toujours mention de vous dans ses lettres, où vous avés toujours les\n[[638.13]] eloges que vous merités; les imprimeurs les plus considerés de Geneve ont faict une societé\n[[638.14]] ensemble; ils vont r'imprimer le <i>dictionnaire universel</i> d'Hofman en six vol. fol; jamais on n'a\n[[638.15]] tant veu de dictionnaire; le p. Simon promet de nous donner quelques lettres sur ce chapitre et\n[[638.16]] sur celluy des journaux qui ruinent tout[,] car on se contente de lire ces sortes de livres et l'on\n[[638.17]] ne recourt plus aux originaux; je ne scay mons^#'r si vous avés veû ces lettres postumes attribuées\n[[638.18]] au p. Simon contre le p. Marcianay; on nous en promet des suittes où l'on verra des traictés ou\n[[638.19]] plustost quelques fragments de ce pere contre les benedictins; et entr'autres un qui portera\n[[638.20]] celluy de dom Faussaire, et l'autre dom Titriet. L'auteur dont je vous envoye le plan auroit esté\n[[638.21]] ravi de voir ces ouvrages; car il n'aymoit pas les Benedictins; Je suis monsieur Tout à vous </p>\n<p> [[638.22]] Nicaise\n[[638.23]] <yi>Pour Monsieur de Leibniz prés de monseig^#'r le Duc d'Hanovre. <b>Hanovre</b> </p>\n",
  "number": "236.",
  "title": "CLAUDE NICAISE AN LEIBNIZ",
  "date": "Dijon, 6. Mai 1700. [228.237.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:236. CLAUDE NICAISE AN LEIBNIZ Dijon, 6. Mai 1700. [228.237.] Dijon le 6 may 1700 Il y a long tems monsieur que je n'ay reçu de vos Nouvelles; J'attribue ce silence à vos grandes occupations et surtout à celle que vous donne presentement vostre Codex diplomaticus. Je croy que vous devés avoir recû i...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>