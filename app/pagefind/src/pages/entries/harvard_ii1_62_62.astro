---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_62",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 62,
  "text": "<p> [[160.1]] <b>55. LEIBNIZ AN OTTO TACHENIUS</p>\n<p> [[160.2]] Frankfurt, 4. Mai 1671.</b></p>\n<p> [[160.14]] Vir Experientissime et Celeberrime </p>\n<p> [[160.15]] Nolui praetermittere occasionem gratulandi Tibi patriaeque nostr<angle bracket>ae</angle bracket> de fama quam egregiis\n[[160.16]] inventis scriptisque es consecutus. Mirifice placent omn<angle bracket>ia</angle bracket> quae de primis illis pugilibus\n[[160.17]] acido et alcali disseris: ego in his quae mitto Schediasmatibus non probavi tantum, sed et\n[[160.18]] provexi, et hoc occultum naturae mysterium ad causas manifestas reduxi. Miraberis congruentiam\n[[160.19]] diversarum, et ex diversis principiis petitarum speculationum, insigni veritatis argumento.\n[[160.20]] Videbis ex unico motu aetheris cum luce circa terram non tantum reactionem inter\n[[160.21]] acidum et alcali, sed et pene omnia naturae phaenomena, et quod mirabilissimum est, ipsam\n[[160.22]] <b>naturam</b> et directionem <b>magnetis</b> derivatam. Et ex occultis qualitatibus factas manifestas.\n[[160.23]] Spero aliquando frui me posse colloquio Tuo, distinctiusque et discere Tua et explicare mea.\n[[160.24]] Nunc quaeso judicium mihi Tuum, et si ita videtur, amicorum ne denega. Ecce praeterea quid\n[[160.25]] quaerere in mentem venerit, <b>nonne putas rationem iniri posse capiendi subtilissimum\n[[160.26]] illud quod in reactionibus acidi et alcali fermentationibusque exhalat</b>.\n[[160.27]] Scis Basilium Valentinum commendare spiritum album Vitrioli, ut vocat, qui inter\n[[160.28]] reagendum cum Tartaro, exhalat: nec commendare tantum, sed et capi posse supponere. Idem\n[[161.1]] Basilius putavit, aut certe tradidit, spiritum album sola lenta digestione a rubro separari posse.\n[[161.2]] Tu in hoc negotio exercitatissimus unus omnium optime judicare potes quid de his rebus sit\n[[161.3]] sperandum. Quid sentis de <i>Physica subterranea</i> ingeniosi certe Viri Joh. Joach. Becheri? quid\n[[161.4]] de novo ejus experimento ex solo limo communi, et oleo lini faciendi ferrum. Quo experimento\n[[161.5]] illi refutantur, qui negant naturam perinde ut artem transitus facere posse de regno in regnum.\n[[161.6]] Quod superest vale faveque </p>\n<p> [[161.7]] Vir Nobiliss^#'e Cultori Tuo Gottfredo Guilielmo Leibnitio J.U.D. </p>\n<p> [[161.8]] Francofurti 4 Maii styl. novi 1671 et Consil. Mog. </p>\n<p> [[161.9]] P. S. Si rescribis, literis ad me directis aliud circumda operculum, ita inscriptum: <i>à\n[[161.10]] Monsieur Monsieur Lasser Conseiller de Son Altesse Electorale de Mayence, à Mayence.</i> </p>\n<p> [[161.11]] Nobilissimo Viro Dⁿ^#'o Ottoni Tachenio Medico Celeberrimo. Venetiis. </p>\n",
  "number": "55.",
  "title": "LEIBNIZ AN OTTO TACHENIUS",
  "date": "Frankfurt, 4. Mai 1671."
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:55. LEIBNIZ AN OTTO TACHENIUS Frankfurt, 4. Mai 1671. Vir Experientissime et Celeberrime Nolui praetermittere occasionem gratulandi Tibi patriaeque nostrae de fama quam egregiis inventis scriptisque es consecutus. Mirifice placent omnia quae de primis illis pugilibus acido et alcali disseris: ego in...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii1_62","series":"Band II 1 (1663 - 1685)","seq":62,"text":"<p> [[160.1]] <b>55. LEIBNIZ AN OTTO TACHENIUS</p>\n<p> [[160.2]] Frankfurt, 4. Mai 1671.</b></p>\n<p> [[160.14]] Vir Experientissime et Celeberrime </p>\n<p> [[160.15]] Nolui praetermittere occasionem gratulandi Tibi patriaeque nostr<angle bracket>ae</angle bracket> de fama quam egregiis\n[[160.16]] inventis scriptisque es consecutus. Mirifice placent omn<angle bracket>ia</angle bracket> quae de primis illis pugilibus\n[[160.17]] acido et alcali disseris: ego in his quae mitto Schediasmatibus non probavi tantum, sed et\n[[160.18]] provexi, et hoc occultum naturae mysterium ad causas manifestas reduxi. Miraberis congruentiam\n[[160.19]] diversarum, et ex diversis principiis petitarum speculationum, insigni veritatis argumento.\n[[160.20]] Videbis ex unico motu aetheris cum luce circa terram non tantum reactionem inter\n[[160.21]] acidum et alcali, sed et pene omnia naturae phaenomena, et quod mirabilissimum est, ipsam\n[[160.22]] <b>naturam</b> et directionem <b>magnetis</b> derivatam. Et ex occultis qualitatibus factas manifestas.\n[[160.23]] Spero aliquando frui me posse colloquio Tuo, distinctiusque et discere Tua et explicare mea.\n[[160.24]] Nunc quaeso judicium mihi Tuum, et si ita videtur, amicorum ne denega. Ecce praeterea quid\n[[160.25]] quaerere in mentem venerit, <b>nonne putas rationem iniri posse capiendi subtilissimum\n[[160.26]] illud quod in reactionibus acidi et alcali fermentationibusque exhalat</b>.\n[[160.27]] Scis Basilium Valentinum commendare spiritum album Vitrioli, ut vocat, qui inter\n[[160.28]] reagendum cum Tartaro, exhalat: nec commendare tantum, sed et capi posse supponere. Idem\n[[161.1]] Basilius putavit, aut certe tradidit, spiritum album sola lenta digestione a rubro separari posse.\n[[161.2]] Tu in hoc negotio exercitatissimus unus omnium optime judicare potes quid de his rebus sit\n[[161.3]] sperandum. Quid sentis de <i>Physica subterranea</i> ingeniosi certe Viri Joh. Joach. Becheri? quid\n[[161.4]] de novo ejus experimento ex solo limo communi, et oleo lini faciendi ferrum. Quo experimento\n[[161.5]] illi refutantur, qui negant naturam perinde ut artem transitus facere posse de regno in regnum.\n[[161.6]] Quod superest vale faveque </p>\n<p> [[161.7]] Vir Nobiliss^#'e Cultori Tuo Gottfredo Guilielmo Leibnitio J.U.D. </p>\n<p> [[161.8]] Francofurti 4 Maii styl. novi 1671 et Consil. Mog. </p>\n<p> [[161.9]] P. S. Si rescribis, literis ad me directis aliud circumda operculum, ita inscriptum: <i>à\n[[161.10]] Monsieur Monsieur Lasser Conseiller de Son Altesse Electorale de Mayence, à Mayence.</i> </p>\n<p> [[161.11]] Nobilissimo Viro Dⁿ^#'o Ottoni Tachenio Medico Celeberrimo. Venetiis. </p>\n","number":"55.","title":"LEIBNIZ AN OTTO TACHENIUS","date":"Frankfurt, 4. Mai 1671."}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>