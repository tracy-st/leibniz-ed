---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi2_23",
  "series": "Band VI 2 (1663-1672); durchgesehener Nachdruck 1990",
  "seq": 23,
  "text": "[[476.0]] <b>55. De reductione hypothesium ad demonstrationes ac phaenomenorum ad\ntheoremata </b> <span>476.0;0:62:055:6909-7012:L:l^</span>.\n[[476.1]] Petrus Ramus in Mathematicis omnia problemata reduxit ad theoremata. Et merito.\n[[476.2]] Quia modo tantum applicandi differunt. Solutio enim problematis est theorema, verbis\n[[476.3]] tantum operativis mutatis. V.g. problema: datum Circulum mutare. Solutio seu\n[[476.4]] Canon: multiplicetur quadratum diametri, seu circumscriptum, producto\n[[476.5]] circumscribatur Circulus, is erit multiplex dati. Theorema: Circuli sunt ut quadrata diametrorum\n[[476.6]] seu circumscripta. Similiter mihi venit in mentem omnes Hypotheses ad demonstrationes,\n[[476.7]] omniave phaenomena ad theoremata reduci posse. V. g. Phaenomenon est: Lumen\n[[476.8]] quoad sensum instanti movetur, seu minore celeritate, quam est quaelibet sensibilis.\n[[476.9]] Hypothesis: Supponatur nullam esse sensibilem in pleno lineam, quae non contineat\n[[476.10]] lineam aliquam insensibilem contigui sibi corporis subtilissimi, quod aetherium vocant.\n[[476.11]] Solutio: Luce igitur orta, seu corpore lucido emissis ex se radiis impellere lineas luminis\n[[476.12]] incipiente, quo primum momento initium lineae impellit, eo et impellet finem eius ad\n[[477.1]] quantamcunque distantiam. Uti qui baculum impellit totum simul impellit, etsi\n[[477.2]] protendantur in infinitum. Ergo quo primum momento lux orietur lumen sentietur. Theorema\n[[477.3]] fieri potest: Si ad certam distantiam a lucido nulla sit linea recta sensibilis quae non\n[[477.4]] contineat luminosam; orta lux ad distantiam eandem momento videbitur.  Quod\n[[477.5]] theorema est prorsus necessarium, et reddit causam possibilem Luminis instantanei. Si esset\n[[477.6]] convertibile seu si hypothesis demonstrabilis esset vel sensu certa, redderet causam\n[[477.7]] prorsus necessariam, seu ostenderet nullam aliam esse posse, quod fit in hoc exemplo:\n[[477.8]] Phaenomenon: Grave projectum aliquamdiu impetum retinet. Hypothesis: 1.) Gravi\n[[477.9]] projecto nihil statim occurit aeque validum. 2.) Cui nihil occurit aeque validum, id\n[[477.10]] impetum semel acquisitum retinet. Solutio: Igitur grave projectum impetum retinet.\n[[477.11]] (Theorema: Quicquid semel movetur, id eadem via et celeritate semper movebitur nisi\n[[477.12]] sit quod impediat; et, si quid sit quod impediat, sed non aeque validum, minuetur\n[[477.13]] impetus; si id continue obstet, minuetur continue impetus, donec desinat.) Theorema: Si\n[[477.14]] gravi projecto nihil statim occurrit aeque validum, et motus omnis durat nisi impediatur;\n[[477.15]] impetus gravis projecti aliquamdiu durabit. Ita causa reddita est possibilis. Sed cum\n[[477.16]] Hypothesis non solum sit possibilis, sed et certa, altera sensu, altera demonstratione;\n[[477.17]] et converti possit Theorema hoc modo, atque et sic demonstrari: Si gravis projecti\n[[477.18]] impetus durat; nisi impediatur, sequitur nihil statim occurrere aeque validum, et omnem\n[[477.19]] motum durare nisi impediatur. Cum ergo et hoc conversum verum sit, erit causa reddita\n[[477.20]] non solum possibilis, sed et necessaria.\n",
  "number": "55.",
  "title": null,
  "date": ""
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:55. De reductione hypothesium ad demonstrationes ac phaenomenorum ad theoremata 476.0;0:62:055:6909-7012:L:l^. Petrus Ramus in Mathematicis omnia problemata reduxit ad theoremata. Et merito. Quia modo tantum applicandi differunt. Solutio enim problematis est theorema, verbis tantum operativis mutati...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>