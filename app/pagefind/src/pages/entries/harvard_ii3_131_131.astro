---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_131",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 131,
  "text": "<p> [[350.1]] <b>131. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[350.2]] Venedig, 25. Juli [1697]. [130.134.]</b></p>\n\n<p> [[350.6]] Ill^#'m^#'o Sig^#'r^#'e, Sig^#'r^#'e, mio Padron Col^#'m^#'o </p>\n<p> [[350.7]] Col passato Ordinario diedi parte a V. S. Ill^#'m^#'a di quanto s'era operato col Sig^#'r^#'e Conte\n[[350.8]] Bertolli per ottenere il bramato diploma sotto Enrico non già Duca di Sassonia, ma di Baviera, e\n[[350.9]] che non v'era speranza di riuscirvi, però in questa settimana m'è pervenuta all'orecchio una\n[[350.10]] nuova notitia, che mi fà nuovamente sperare di poterla servire. M'è stato detto che nell'archivio\n[[350.11]] d'un Gentiluomo, che comprò la magiore parte de' beni del Monastero delle carceri, si trovi un\n[[350.12]] grosso manuscritto di lettere gotiche, ove stanno registrate tutte le donationi e diplomi fatti al\n[[350.13]] Monastero delle Carceri dal principio della sua fondatione, potrebbe essere che in esso si\n[[350.14]] trovasse quel che desideriamo. Per mezo d'un gran Senatore spero ben presto havere nelle mani\n[[350.15]] il sudetto manuscritto e coll'aiuto d'un bravo Scrittore unico, che intenda qui il carattere gotico,\n[[350.16]] farò cavare tutto quello che riguarda la Serenissima Casa Estense, e le ne saranno subito\n[[350.17]] trasmesse le copie, e priego Dio che habbia la fortuna di trovare il diploma ricercato. Il Sig^#'r^#'e\n[[350.18]] Conte Bertolli hà saputo che in casa dell'Ecc^#'m^#'o Pisani Moretta si trovi la Camerlengaria\n[[350.19]] de' Principi Estensi, comprata molto tempo fà, ove ci sono molte antiche scritture appartenenti\n[[350.20]] al nostro interesse, perciò supplico V. S. Ill^#'m^#'a scrivermi quel che in particolare si desidera, acciò\n[[350.21]] sappia quel che devo domandare, mentre che haverò mezo potente d'ottenere tutto. In Casa\n[[350.22]] dell'Ecc^#'m^#'o Proc^#'r^#'e Foscarini, ove io qui alloggio si copia presentemente un antico manuscritto\n[[350.23]] gotico che contiene molte cose passate fra questa Serenissima Republica, ed i Principi Estensi\n[[350.24]] allora Padroni di Ferrara. Per la settimana vegnente farò estrarre quanto vi si contiene di più\n[[351.1]] riguardevole, e le ne mandarò una copia. Hò letto il suo dotto e sottile Opuscoletto, e l' hò\n[[351.2]] trovato molto giuditioso e ricco di rare, e nobili notitie. Coll'Ordinario venturo l'accennarò\n[[351.3]] alcuni miei dubii, affine di maggiormente illuminarmi, non permettendomelo oggi la gran folla\n[[351.4]] d'affari, che mi rubbano tutto il tempo. Le mandarò ancora la mia seconda lettera stampata\n[[351.5]] sopra gl'abusi e corruttione dell'Arte di parlare. La prego della continuatione del suo pretiosissimo\n[[351.6]] amore, e dell'onore stimatissimo de' suoi comandi, e strettamente abbracciandola mi\n[[351.7]] resto </p>\n<p> [[351.8]] Di V. S. Ill^#'m^#'a Umil^#'m^#'o, Obg^#'m^#'o, Cord^#'m^#'o S^#'r^#'e Michel Angelo Fardella </p>\n<p> [[351.9]] Venetia 25 Luglio </p>\n",
  "number": "131.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Venedig, 25. Juli [1697]. [130.134.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:131. MICHEL ANGELO FARDELLA AN LEIBNIZ Venedig, 25. Juli [1697]. [130.134.] Ill^#'m^#'o Sig^#'r^#'e, Sig^#'r^#'e, mio Padron Col^#'m^#'o Col passato Ordinario diedi parte a V. S. Ill^#'m^#'a di quanto s'era operato col Sig^#'r^#'e Conte Bertolli per ottenere il bramato diploma sotto Enrico non già D...">

