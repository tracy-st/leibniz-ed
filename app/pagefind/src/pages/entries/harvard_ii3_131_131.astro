      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii3_131","series":"Band II 3 (1695 - 1700)","seq":131,"text":"<p> [[350.1]] <b>131. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[350.2]] Venedig, 25. Juli [1697]. [130.134.]</b></p>\n\n<p> [[350.6]] Ill^#'m^#'o Sig^#'r^#'e, Sig^#'r^#'e, mio Padron Col^#'m^#'o </p>\n<p> [[350.7]] Col passato Ordinario diedi parte a V. S. Ill^#'m^#'a di quanto s'era operato col Sig^#'r^#'e Conte\n[[350.8]] Bertolli per ottenere il bramato diploma sotto Enrico non già Duca di Sassonia, ma di Baviera, e\n[[350.9]] che non v'era speranza di riuscirvi, però in questa settimana m'è pervenuta all'orecchio una\n[[350.10]] nuova notitia, che mi fà nuovamente sperare di poterla servire. M'è stato detto che nell'archivio\n[[350.11]] d'un Gentiluomo, che comprò la magiore parte de' beni del Monastero delle carceri, si trovi un\n[[350.12]] grosso manuscritto di lettere gotiche, ove stanno registrate tutte le donationi e diplomi fatti al\n[[350.13]] Monastero delle Carceri dal principio della sua fondatione, potrebbe essere che in esso si\n[[350.14]] trovasse quel che desideriamo. Per mezo d'un gran Senatore spero ben presto havere nelle mani\n[[350.15]] il sudetto manuscritto e coll'aiuto d'un bravo Scrittore unico, che intenda qui il carattere gotico,\n[[350.16]] farò cavare tutto quello che riguarda la Serenissima Casa Estense, e le ne saranno subito\n[[350.17]] trasmesse le copie, e priego Dio che habbia la fortuna di trovare il diploma ricercato. Il Sig^#'r^#'e\n[[350.18]] Conte Bertolli hà saputo che in casa dell'Ecc^#'m^#'o Pisani Moretta si trovi la Camerlengaria\n[[350.19]] de' Principi Estensi, comprata molto tempo fà, ove ci sono molte antiche scritture appartenenti\n[[350.20]] al nostro interesse, perciò supplico V. S. Ill^#'m^#'a scrivermi quel che in particolare si desidera, acciò\n[[350.21]] sappia quel che devo domandare, mentre che haverò mezo potente d'ottenere tutto. In Casa\n[[350.22]] dell'Ecc^#'m^#'o Proc^#'r^#'e Foscarini, ove io qui alloggio si copia presentemente un antico manuscritto\n[[350.23]] gotico che contiene molte cose passate fra questa Serenissima Republica, ed i Principi Estensi\n[[350.24]] allora Padroni di Ferrara. Per la settimana vegnente farò estrarre quanto vi si contiene di più\n[[351.1]] riguardevole, e le ne mandarò una copia. Hò letto il suo dotto e sottile Opuscoletto, e l' hò\n[[351.2]] trovato molto giuditioso e ricco di rare, e nobili notitie. Coll'Ordinario venturo l'accennarò\n[[351.3]] alcuni miei dubii, affine di maggiormente illuminarmi, non permettendomelo oggi la gran folla\n[[351.4]] d'affari, che mi rubbano tutto il tempo. Le mandarò ancora la mia seconda lettera stampata\n[[351.5]] sopra gl'abusi e corruttione dell'Arte di parlare. La prego della continuatione del suo pretiosissimo\n[[351.6]] amore, e dell'onore stimatissimo de' suoi comandi, e strettamente abbracciandola mi\n[[351.7]] resto </p>\n<p> [[351.8]] Di V. S. Ill^#'m^#'a Umil^#'m^#'o, Obg^#'m^#'o, Cord^#'m^#'o S^#'r^#'e Michel Angelo Fardella </p>\n<p> [[351.9]] Venetia 25 Luglio </p>\n","number":"131.","title":"MICHEL ANGELO FARDELLA AN LEIBNIZ","date":"Venedig, 25. Juli [1697]. [130.134.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>