---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_257",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 257,
  "text": "<p> [[799.7]] <b>227a. LEIBNIZ AN DETLEV CLÜVER</p>\n<p> [[799.8]] Hannover, 18./28. Mai 1680. [227c.]</b></p>\n<p> [[800.1]] [<i>L</i>] </p>\n<p> [[800.2]] [ ... ] Unum tamen notare mihi videor: nos non habere optimos Arithmeticos characteres,\n[[800.3]] aliisque plane ad perfectionem scientiae indigere, ita nimirum ut <i>5</i> + <i>3</i> facere <i>8</i> et <i>2</i> in <i>8</i> facere\n[[800.4]] <i>16</i> non ex memoria vel tabula quadam depromere opus sit, sed ex ipsis characteribus sequatur. </p>\n<p> [[800.5]] Resolutio numerorum in factores primitivos, et horum discrimen a derivativis, idque sine\n[[800.6]] tabulis aut longa calculi molestia; res est a nemine hactenus satis tractata, in qua si operae\n[[800.7]] pretium facere potes, mirifice tibi hujus scientiae cultores obstringes. Multa ego in hoc quoque\n[[800.8]] genere notavi, et quaesivi analyticum primitivos exprimendi modum, et nonnihil accessi. </p>\n<p> [[800.9]] [<i>A</i>] </p>\n<p> [[800.10]] [ ... ] Circa serierum summas multa inveni quae magni usus esse expertus sum. Illud\n[[800.11]] tamen in universum notavi, nos non habere characteres numerorum quales oportet, aliisque ad\n[[800.12]] scientiae perfectionem indigere, ita nimirum ut <i>5</i> + <i>3</i> facere <i>8</i> et <i>2</i> in <i>8</i> facere <i>16</i>, non ex\n[[800.13]] memoria vel tabula depromere opus sit, sed ex ipsis characteribus sequatur. Tale quid jam\n[[800.14]] dudum animo concepi, unde maxima scientiae incrementa secutura video. </p>\n<p> [[800.15]] Resolutio numerorum in factores primitivos, et inventio certae notae reciprocae qua\n[[800.16]] [primitivi] a derivativis sine tabulis et calculi molestia discerni possint, res est nondum satis a\n[[800.17]] quoquam tractata: Ergo etsi aliquam in hoc argumento analyseos viam esse videam, nondum\n[[800.18]] tamen quod volo absolvi. Quod si quid circa hoc problema praestare potes arithmeticae\n[[800.19]] scientiae nobilissimae studiosos plurimum tibi obstringas. Algebram quam miraris a me non\n[[800.20]] satis aestimari excolui quantum fortasse quisquam, nec opus est dicere quam multa in eo genere\n[[800.21]] praestiterim. Sed eadem opera deprehendi quid ipsi desit. Certum est enim ad ipsam algebram\n[[800.22]] perficiendam artibus quibusdam, ex combinatoria scientia ductis opus esse, quam ego alio\n[[800.23]] quam tu sensu accipio, mihi etenim nihil minus est quam empirica et tabularis. Unde fit ut\n[[800.24]] etiam pro Algebraicis characteribus utar aliquando non Literis sed numeris, qui si apte assignentur\n[[800.25]] (nam et characteristicae scientiae praeceptis Algebra utitur perficique potest) mirum\n[[800.26]] quam pulchra statim nascantur quibus calculus omnis mirifice contrahi potest. In ipsa Geometria\n[[800.27]] sciendum est problemata innumera occurrere quae quia supra algebram assurgunt a me\n[[800.28]] <b>Transcendentia</b> appellantur, neque enim ad Algebraicas aequationes revocari possunt cum\n[[800.29]] sint nullius Gradus (id est neque plana neque solida etc.) aut certe omnium simul. [ ... ] </p>\n",
  "number": "227a.",
  "title": "LEIBNIZ AN DETLEV CLÜVER",
  "date": "Hannover, 18./28. Mai 1680. [227c.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:227a. LEIBNIZ AN DETLEV CLÜVER Hannover, 18./28. Mai 1680. [227c.] [L] [ ... ] Unum tamen notare mihi videor: nos non habere optimos Arithmeticos characteres, aliisque plane ad perfectionem scientiae indigere, ita nimirum ut 5 + 3 facere 8 et 2 in 8 facere 16 non ex memoria vel tabula quadam deprome...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>