---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_180",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 180,
  "text": "<p> [[605.12]] <b>182. CLAUDE NICAISE FÜR LEIBNIZ</p>\n<p> [[605.13]] [Dijon, 25. Oktober 1692.] [181.204.]</b></p>\n [[605.14]] <p><tab/>Pierre Daniel Huet an Claude Nicaise (Paris, 12. September 1692) </p>\n<p> [[606.1]] Monsieur </p>\n<p> [[606.2]] Vous <Fn><i>Leibniz hat am Kopf des Briefes bemerkt</i>: C'est la main de Mons. Huetius connu par ses ouvrages, maintenant Evéque d'Avranches.</Fn> m'avez sensiblement obligé en m'envoyant un extrait de la lettre de M^#'r Leibnitz sur\n[[606.3]] le sujet de la Philosophie Cartesienne. J'avois déja leu quelques unes des choses qu'il vous a\n[[606.4]] ecrites, dans les lettres qu'il a ecrites à M^#'r de Pellisson. Ce ne m'est pas un petit sujet de joye et\n[[606.5]] de gloire, de voir le jugement que j'ay fait de M^#'r des Cartes et de sa doctrine, confirmé par\n[[606.6]] celuy d'un aussi excellent homme que M^#'r Leibnitz. Car je ne l'ay pas moins loüé, et je ne\n[[606.7]] l'estime pas moins, que M^#'r Leibnitz le loüe et l'estime. Mais toute cette estime ne m'a pas si\n[[606.8]] fort aveuglé que je n'aye reconnu plusieurs defauts de sa Methode et de sa Philosophie. Si des\n[[606.9]] employs plus importants ne me detournoient pas de ces estudes, je prendrois plaisir à faire voir\n[[606.10]] la pauvreté et la foiblesse des reponses que l'on a opposées à ma <i>Censure</i>. M^#'r Leibnitz le fera\n[[606.11]] mieux que moy, et vous rendrez un grand service à la Rep. des lettres, si vous pouvez l'y\n[[606.12]] engager. Je vous supplie, Monsieur, de le saluer de ma part, et de l'assurer que ny l'eloignement\n[[606.13]] ny le tems ne changent rien aux sentimens d'estime, n'y au desir d'avoir part à sa\n[[606.14]] bienveillance, que je luy ay fait paroistre autrefois. Je crois enfin que les exemplaires de mon\n[[606.15]] livre <i>du Paradis terrestre</i> sont arrivez en Hollande. Une des personnes qui avoit part à la\n[[606.16]] distribution m'a mandé qu'elle a receu le sien. Je vous demande en grace de savoir de M^#'r\n[[606.17]] Leibnitz s'il a receu l'exemplaire qui luy estoit destiné. Je vous felicite sur l'agrement de vostre\n[[606.18]] demeure, et de vos estudes. Je suis sur mon depart pour aller en un pays, où je trouveray des\n[[606.19]] occupations bien differentes des vostres, et qui me rendent le secours de vos prieres bien\n[[606.20]] necessaire. Ne me les refusez pas, ny la grace de me croire </p>\n<p> [[606.21]] Monsieur Vostre très humble et très obeissant serviteur </p>\n<p> [[606.22]] P. Daniel Ev. d'Avranches </p>\n<p> [[606.23]] A Paris le 12. 7^#'b^#'r^#'e 1692 </p>\n",
  "number": "182.",
  "title": "CLAUDE NICAISE FÜR LEIBNIZ",
  "date": "[Dijon, 25. Oktober 1692.] [181.204.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:182. CLAUDE NICAISE FÜR LEIBNIZ [Dijon, 25. Oktober 1692.] [181.204.] Pierre Daniel Huet an Claude Nicaise (Paris, 12. September 1692) Monsieur Vous Leibniz hat am Kopf des Briefes bemerkt: C'est la main de Mons. Huetius connu par ses ouvrages, maintenant Evéque d'Avranches. m'avez sensiblement obli...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii2_180","series":"Band II 2 (1686 - 1694)","seq":180,"text":"<p> [[605.12]] <b>182. CLAUDE NICAISE FÜR LEIBNIZ</p>\n<p> [[605.13]] [Dijon, 25. Oktober 1692.] [181.204.]</b></p>\n [[605.14]] <p><tab/>Pierre Daniel Huet an Claude Nicaise (Paris, 12. September 1692) </p>\n<p> [[606.1]] Monsieur </p>\n<p> [[606.2]] Vous <Fn><i>Leibniz hat am Kopf des Briefes bemerkt</i>: C'est la main de Mons. Huetius connu par ses ouvrages, maintenant Evéque d'Avranches.</Fn> m'avez sensiblement obligé en m'envoyant un extrait de la lettre de M^#'r Leibnitz sur\n[[606.3]] le sujet de la Philosophie Cartesienne. J'avois déja leu quelques unes des choses qu'il vous a\n[[606.4]] ecrites, dans les lettres qu'il a ecrites à M^#'r de Pellisson. Ce ne m'est pas un petit sujet de joye et\n[[606.5]] de gloire, de voir le jugement que j'ay fait de M^#'r des Cartes et de sa doctrine, confirmé par\n[[606.6]] celuy d'un aussi excellent homme que M^#'r Leibnitz. Car je ne l'ay pas moins loüé, et je ne\n[[606.7]] l'estime pas moins, que M^#'r Leibnitz le loüe et l'estime. Mais toute cette estime ne m'a pas si\n[[606.8]] fort aveuglé que je n'aye reconnu plusieurs defauts de sa Methode et de sa Philosophie. Si des\n[[606.9]] employs plus importants ne me detournoient pas de ces estudes, je prendrois plaisir à faire voir\n[[606.10]] la pauvreté et la foiblesse des reponses que l'on a opposées à ma <i>Censure</i>. M^#'r Leibnitz le fera\n[[606.11]] mieux que moy, et vous rendrez un grand service à la Rep. des lettres, si vous pouvez l'y\n[[606.12]] engager. Je vous supplie, Monsieur, de le saluer de ma part, et de l'assurer que ny l'eloignement\n[[606.13]] ny le tems ne changent rien aux sentimens d'estime, n'y au desir d'avoir part à sa\n[[606.14]] bienveillance, que je luy ay fait paroistre autrefois. Je crois enfin que les exemplaires de mon\n[[606.15]] livre <i>du Paradis terrestre</i> sont arrivez en Hollande. Une des personnes qui avoit part à la\n[[606.16]] distribution m'a mandé qu'elle a receu le sien. Je vous demande en grace de savoir de M^#'r\n[[606.17]] Leibnitz s'il a receu l'exemplaire qui luy estoit destiné. Je vous felicite sur l'agrement de vostre\n[[606.18]] demeure, et de vos estudes. Je suis sur mon depart pour aller en un pays, où je trouveray des\n[[606.19]] occupations bien differentes des vostres, et qui me rendent le secours de vos prieres bien\n[[606.20]] necessaire. Ne me les refusez pas, ny la grace de me croire </p>\n<p> [[606.21]] Monsieur Vostre très humble et très obeissant serviteur </p>\n<p> [[606.22]] P. Daniel Ev. d'Avranches </p>\n<p> [[606.23]] A Paris le 12. 7^#'b^#'r^#'e 1692 </p>\n","number":"182.","title":"CLAUDE NICAISE FÜR LEIBNIZ","date":"[Dijon, 25. Oktober 1692.] [181.204.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>