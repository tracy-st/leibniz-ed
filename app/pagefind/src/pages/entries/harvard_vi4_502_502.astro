---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_502",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 502,
  "text": "[[2202.6]] <b>394.  De hostia Oktober 1677</b>\n [[2202.7]] <tab/>Oktober 1677 </p>\n<p> [[2202.11]] Octobr. 1677 </p>\n<p> [[2202.12]] Hostia Romanae Ecclesiae est aut creator aut creatura. Si est creator, tunc sequitur\n[[2202.13]] creatorem sive Deum esse rem albam ac rotundam; nam negari non potest hostiam esse\n[[2202.14]] rem albam, rotundam, etc. et Theologi enim defendunt, albedinem quam videmus non\n[[2202.15]] esse apparentem, sed veram. Quare si hostia est Deus, etiam Deus talis res erit. </p>\n<p> [[2202.16]] Item: hostia quae est Romae non est hostia quae est Parisiis: sive plures sunt hostiae,\n[[2202.17]] quoniam vero non sunt plures dii, ideo Deus non est hostia, vel hostia non est Deus. </p>\n<p> [[2202.18]] Ponamus jam hostiam esse Creaturam, tunc aut erit creatura a Deo assumta, veluti\n[[2202.19]] corpus Christi; aut erit simplex creatura. Non est corpus Christi, quod probatur eodem\n[[2202.20]] argumento quo probatum est hostiam non esse Deum. Nam corpus Christi non est\n[[2202.21]] rotundum, hostia est rotunda; et unum est corpus Christi, hostiae sunt plures. </p>\n<p> [[2203.1]] Necesse est ergo, hostiam esse simplicem creaturam; sed hinc jam manifeste sequitur\n[[2203.2]] hostiam non posse adorari, seu non esse objectum cultus latriae.\n[[2203.3]] <b>Suppositiones</b>: </p>\n<p> [[2203.4]] 1) Ita late fusum est institutum missae Romanae, ut multa millia hostiarum consecratarum\n[[2203.5]] non in nostra tantum Europa, sed et aliis terrarum orbis partibus sumantur. </p>\n<p> [[2203.6]] 2) Creatura simplex (id est a Deo non assumta), non debet per se ac proprie adorari\n[[2203.7]] cultu Latriae.\n[[2203.8]] <b>Propositio I.</b> </p>\n<p> [[2203.9]] Hostia non est Deus. </p>\n<p> [[2203.10]] Hostiae consecratae sunt plures <i>per</i> <i>suppos. 1.</i> Deus est unicus. Ergo hostia non est\n[[2203.11]] Deus.\n[[2203.12]] <b>Propositio II.</b> </p>\n<p> [[2203.13]] Hostia non est corpus Christi. </p>\n<p> [[2203.14]] Hostiae consecratae sunt plures, <i>per suppos. 1.</i> Corpus Christi est unicum. Ergo\n[[2203.15]] hostia non est corpus Christi.\n[[2203.16]] <b>Propositio III.</b> </p>\n<p> [[2203.17]] <b>Hostia non debet adorari sive cultu latriae honorari.</b> </p>\n<p> [[2203.18]] Hostia non est Deus (<i>per prop. 1.</i>). Ergo est creatura. Si est creatura, erit aut creatura\n[[2203.19]] a Deo assumta, aut creatura simplex. Non est creatura a Deo assumta, quia non est corpus\n[[2203.20]] Christi (<i>per prop. 2.</i>), animam autem Christi non esse confessum est. Ergo est creatura\n[[2203.21]] simplex. Sed (<i>per</i> <i>suppos. 2.</i>) creatura simplex non debet adorari cultu latriae, Ergo nec\n[[2203.22]] hostia. Q. E. D. </p>\n<p> [[2203.23]] Suppono cum Theologis in Sacramento Eucharistiae nullam esse sensuum deceptionem,\n[[2203.24]] sed albedinem, rotunditatem, caeteraque accidentia non minus esse realia in\n[[2203.25]] hostia, quam in rebus aliis. </p>\n<p> [[2204.1]] Datur hoc loco albedo, datur et rotunditas vera. </p>\n<p> [[2204.2]] Id quod est album, est etiam rotundum. </p>\n<p> [[2204.3]] Datur ergo subjectum albedinis et rotunditatis. </p>\n<p> [[2204.4]] Demonstratum est ergo Hostiam non adorari; sed adorationem terminari in Christum. </p>\n",
  "number": "394.",
  "title": "De hostia",
  "date": "Oktober 1677"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:394. De hostia Oktober 1677 Oktober 1677 Octobr. 1677 Hostia Romanae Ecclesiae est aut creator aut creatura. Si est creator, tunc sequitur creatorem sive Deum esse rem albam ac rotundam; nam negari non potest hostiam esse rem albam, rotundam, etc. et Theologi enim defendunt, albedinem quam videmus n...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>