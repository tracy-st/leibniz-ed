---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi3_67",
  "series": "Band VI 3 (1672-1676); durchgesehener Nachdruck 1980",
  "seq": 67,
  "text": "[[490.3]] <b>67. Meditatio de principio individui </b> <span>490.3;0:63:067:76!      :L:l^</span>.\n[[490.14]] Meditatio de principio individui. Dicimus effectum involvere causam\n[[490.15]] suam; id est ita ut qui perfecte intelligat effectum aliquem, etiam ad causae eius\n[[490.16]] cognitionem perveniat. Utique enim necessaria quaedam inter causam integram et\n[[490.17]] effectum connexio est. Sed contra obstat, quod diversae causae producere possunt\n[[490.18]] eundem perfecte effectum, exempli causa, sive duo parallelogramma, sive duo (triangula),\n[[490.19]] uti oportet, et hic apparet, componantur, semper idem plane\n[[490.20]] quadratum prodibit; quorum alterum ab altero nullo poterit discerni\n[[490.21]] modo; ne a sapientissimo quidem; ita ut in nullius ne sapientissimi\n[[490.22]] quidem potestate futurum sit, ex dato quadrato ejusmodi invenire eius\n[[490.23]] causam, quoniam problema non est determinatum. Videtur ergo effectus non involvere\n[[490.24]] suam causam. Quare si aliunde nobis certum sit, effectum involvere suam causam,\n[[490.25]] necesse est in productis quadratis modum productionis semper discerni posse.\n[[490.26]] Adeoque impossibile esse, ut duo quadrata eiusmodi sint perfecte similia, quia ex\n[[491.1]] materia constabunt, ea autem mentem habebit, et mens retinebit effectum status\n[[491.2]] prioris. Et vero nisi fateamur, impossibile esse ut duo sint perfecte similia, sequetur,\n[[491.3]] principium individuationis, esse extra rem in eius causa. Et effectum non involvere\n[[491.4]] causam, secundum suam rationem specificam, sed secundum rationem individualem.\n[[491.5]] Adeoque unum ab alio non differre in se. Sin fatemur semper duas res differentes,\n[[491.6]] etiam in aliquo differre in se; sequitur materiae cuilibet adesse aliquid quod priorum\n[[491.7]] effectum retineat, nempe mentem. Et hinc etiam probatur, effectum involvere causam.\n[[491.8]] Verum enim de eo, eum productum a tali causa. Ergo adhuc impraesentiarum,\n[[491.9]] eiusmodi in eo est qualitas, quae id ferat, quae etsi relativa, habet tamen aliquid a\n[[491.10]] parte rei. Patet ex quantulis, quanta sequantur.\n[[491.11]] Pulcherrima ratiocinatio est, probatque, materiam non esse homogeneam, nec\n[[491.12]] vero cogitari a nobis potest, quo differat, nisi mente. Cum Mens nostra intima adsit,\n[[491.13]] sibi et materiae, sequitur nihil in iis introduci posse, quod non a nobis possit intelligi\n[[491.14]] quodammodo. Principium magni momenti.\n",
  "number": "67.",
  "title": "Meditatio de principio individui",
  "date": ""
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:67. Meditatio de principio individui 490.3;0:63:067:76! :L:l^. Meditatio de principio individui. Dicimus effectum involvere causam suam; id est ita ut qui perfecte intelligat effectum aliquem, etiam ad causae eius cognitionem perveniat. Utique enim necessaria quaedam inter causam integram et effectu...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_vi3_67","series":"Band VI 3 (1672-1676); durchgesehener Nachdruck 1980","seq":67,"text":"[[490.3]] <b>67. Meditatio de principio individui </b> <span>490.3;0:63:067:76!      :L:l^</span>.\n[[490.14]] Meditatio de principio individui. Dicimus effectum involvere causam\n[[490.15]] suam; id est ita ut qui perfecte intelligat effectum aliquem, etiam ad causae eius\n[[490.16]] cognitionem perveniat. Utique enim necessaria quaedam inter causam integram et\n[[490.17]] effectum connexio est. Sed contra obstat, quod diversae causae producere possunt\n[[490.18]] eundem perfecte effectum, exempli causa, sive duo parallelogramma, sive duo (triangula),\n[[490.19]] uti oportet, et hic apparet, componantur, semper idem plane\n[[490.20]] quadratum prodibit; quorum alterum ab altero nullo poterit discerni\n[[490.21]] modo; ne a sapientissimo quidem; ita ut in nullius ne sapientissimi\n[[490.22]] quidem potestate futurum sit, ex dato quadrato ejusmodi invenire eius\n[[490.23]] causam, quoniam problema non est determinatum. Videtur ergo effectus non involvere\n[[490.24]] suam causam. Quare si aliunde nobis certum sit, effectum involvere suam causam,\n[[490.25]] necesse est in productis quadratis modum productionis semper discerni posse.\n[[490.26]] Adeoque impossibile esse, ut duo quadrata eiusmodi sint perfecte similia, quia ex\n[[491.1]] materia constabunt, ea autem mentem habebit, et mens retinebit effectum status\n[[491.2]] prioris. Et vero nisi fateamur, impossibile esse ut duo sint perfecte similia, sequetur,\n[[491.3]] principium individuationis, esse extra rem in eius causa. Et effectum non involvere\n[[491.4]] causam, secundum suam rationem specificam, sed secundum rationem individualem.\n[[491.5]] Adeoque unum ab alio non differre in se. Sin fatemur semper duas res differentes,\n[[491.6]] etiam in aliquo differre in se; sequitur materiae cuilibet adesse aliquid quod priorum\n[[491.7]] effectum retineat, nempe mentem. Et hinc etiam probatur, effectum involvere causam.\n[[491.8]] Verum enim de eo, eum productum a tali causa. Ergo adhuc impraesentiarum,\n[[491.9]] eiusmodi in eo est qualitas, quae id ferat, quae etsi relativa, habet tamen aliquid a\n[[491.10]] parte rei. Patet ex quantulis, quanta sequantur.\n[[491.11]] Pulcherrima ratiocinatio est, probatque, materiam non esse homogeneam, nec\n[[491.12]] vero cogitari a nobis potest, quo differat, nisi mente. Cum Mens nostra intima adsit,\n[[491.13]] sibi et materiae, sequitur nihil in iis introduci posse, quod non a nobis possit intelligi\n[[491.14]] quodammodo. Principium magni momenti.\n","number":"67.","title":"Meditatio de principio individui","date":""}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>