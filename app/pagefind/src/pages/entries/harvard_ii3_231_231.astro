---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_231",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 231,
  "text": "<p> [[628.1]] <b>231. ERNST SALOMON CYPRIAN AN LEIBNIZ</p>\n<p> [[628.2]] Helmstedt, 4. April 1700. [226.233.]</b></p>\n\n<p> [[628.8]] Illustris Domine, </p>\n<p> [[628.9]] Publicum munus, Serenissimorum Nutritorum auspiciis Tuoque beneficio in me collatum,\n[[628.10]] ea, qua par est, fide sustinebo. Edidi hanc in rem, quod Tuae censurae submitto, programma,\n[[628.11]] olim, si conatum probaveris, exasciandum, ac sub titulo dissertationis <i>de vita et philosophia\n[[628.12]] Thomae Campanellae</i> edendum. Laudavi aliquot libros, non omnibus visos, qui heic philosophiam\n[[628.13]] interpretantur, idque ea potissimum ratione factum est, ut mihi servem amorem Tuum,\n[[628.14]] quo res admodum tritae indignae sunt. Thomasius societatem literariam instituit, quae singulis\n[[628.15]] mensibus vetustos ac fere neglectos libros recensebit, integrasve dissertationes varii argumenti\n[[628.16]] adjiciet. Insunt coetui mentes quaedam bene literatae, quibus nihil commercii erit cum cavillis\n[[628.17]] Thomasii, in nupera de fide historica dissertatione summum quendam virum aliosque minorum\n[[628.18]] gentium deos impugnantis. Haesi aliquandiu in patria, Principum Gothani et Römhildensis\n[[628.19]] colloquio dignatus ac mensae aliquoties admotus. Uterque me suffectum vult Doctori Sauerbrey,\n[[628.20]] qui hactenus Gymnasio Academico Coburgensi directoris nomine praefuit, ac spes est, me\n[[628.21]] propediem vocatum iri. Testor Deum, Illustris Here, nunquam me id muneris ambiisse: nec\n[[628.22]] video tamen rationem sat idoneam, cur subterfugere debeam onus illud. Est quidem mens mea\n[[629.1]] ad <greek>paideían</greek> academicam, ipsaque forte lingua, satis accommodata, nec est, cur Deo nullas\n[[629.2]] gratias agam pro plausu literatorum pectorum, qui mihi aliorum illo nunquam minor contigit.\n[[629.3]] At sunt tamen, quae vitam nonnihil molestam reddant. Primo certum est, susurrones quosdam\n[[629.4]] me Guelpherbyti invidia onerare ob modestissimas illas ac luculentissimis rationibus superstructas\n[[629.5]] in Arnoldi historiam animadversiones, quae nunc typographos fatigant. Deinde procul\n[[629.6]] dubio munus, historiam publice docendi, Dn. Cörberus sibi vindicabit: quo quidem ego indignus\n[[629.7]] sum; sed poteram forte industria et judicio dignus censeri olim. Neque enim ante hos\n[[629.8]] XV annos is fuit Cörberus, qui nunc est, et tamen eloquentiae professione ornabatur: ac video\n[[629.9]] sane frequenti usu comprobatum esse, ut muneribus, cum susciperent primum, impares essent\n[[629.10]] quidam ex nostris. Tandem D. Niemeierus cotidie protestatur contra lectiones meas metaphysicas\n[[629.11]] et logicas, nihilque harum deliciarum sibi eripi passurus est: Bohmeri autem Professionem\n[[629.12]] alii iam decretam esse, constat. Ignoscas autem, Illustris Domine, Here parente propensior,\n[[629.13]] meae dicacitati, qua in sinum Tuum effundo, quae ad fortunam meam spectare videntur. Scio\n[[629.14]] enim Dei ope factum esse, ut me diligeres, Tuoque adeo judicio cadam et stabo. Literatissimus\n[[629.15]] Struvius ut Tibi innotescat, his literis conatus est efficere. Vale, Domine Illustris, Numen Te\n[[629.16]] servet. Scrib. Helmstadii in Acad. Jul. MDCC d. IV. April. </p>\n<p> [[629.17]] Illustr. Nom. T. subiectissimus E. S. Cyprianus, Prof. Publ. </p>\n<p> [[629.18]] P.S. Perillustri Dn. Vicecancellario alterutrum programmatis exemplum exhiberi rogo et\n[[629.19]] obtestor. </p>\n<p> [[629.20]] P.S. De Professione historiarum penes neminem verba feci, nisi apud Deum et Te, Vir\n[[629.21]] perillustris, ut me consilio Tuo regas. </p>\n",
  "number": "231.",
  "title": "ERNST SALOMON CYPRIAN AN LEIBNIZ",
  "date": "Helmstedt, 4. April 1700. [226.233.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:231. ERNST SALOMON CYPRIAN AN LEIBNIZ Helmstedt, 4. April 1700. [226.233.] Illustris Domine, Publicum munus, Serenissimorum Nutritorum auspiciis Tuoque beneficio in me collatum, ea, qua par est, fide sustinebo. Edidi hanc in rem, quod Tuae censurae submitto, programma, olim, si conatum probaveris, e...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>