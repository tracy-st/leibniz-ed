          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:219. Aus und zu einem Brief von Descartes an Mersenne [1678 bis 1682 (?)] [1678 bis 1682 (?)] Il y a moyen d'inventer une langue ou écriture au moins, dont les caracteres et mots primitifs seroient faits en sorte, qu'elle pouroit estre enseignée en fort peu de tems, et ce par le moyen de l'ordre, c'...">

