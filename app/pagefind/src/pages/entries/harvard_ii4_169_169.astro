---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_169",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 169,
  "text": "<p> [[526.15]] <b>169. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[526.16]] Padua, 15. Januar 1707. [150.188.] </b></p>\n<p> [[527.1]] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o </p>\n<p> [[527.2]] Supplico <Fn><i>Am Kopf der Seite von Leibniz' Hand</i>: resp</Fn> umilmente V. S. Ill^#'m^#'a di benigno compatimento, se sono ormai passati quattro\n[[527.3]] mesi, che non la vengo con miei caratteri a riverire, e ricordarle secondo il mio debito l'antica e\n[[527.4]] fedelissima mia servitù, mentre che fin dal settembre caduto sono stato sempre ammalato, e\n[[527.5]] perciò inabile a qualsisia applicatione. La cagione del mio male è stato un calcolo, che nel suo\n[[527.6]] passaggio per il canale dell'orina, avendomi rotta un piccola arteria di notte tempo, se ne usci\n[[527.7]] da essa una gran copia di sangue, cinque libre in circa, e se non occorreva presto il Medico, era\n[[527.8]] necessario, che morissi. Il che poi mi cagionò una languidezza così estrema, e vertigini così\n[[527.9]] frequenti, che hò durato fatica a rimettermi, ne hò potuto ancora portarmi alla catedra per le\n[[527.10]] publiche lettioni, mi vò nondimeno sempre piu corroborando, e spero a Dio piacendo ben presto\n[[527.11]] restituirmi al primo mio vigore. La presente dunque servirà per assicurarla dell'inalterabile mia\n[[527.12]] gratitudine e viva memoria che conservo dell'adoratissime gratie di V. S. Ill^#'m^#'a, a cui mi protesto\n[[527.13]] infinitamente obligato, con pregare incessantemente Dio la feliciti, e lungamente conservi a\n[[527.14]] beneficio della Republica delle lettere in cui V. S. Ill^#'m^#'a ora con somma giustitia gode il primo\n[[527.15]] luogo per l'eminenza, e vastità del purgatissimo ed incomparabile suo sapere. Scrissi nella\n[[527.16]] settimana caduta al nostro Dott^#'m^#'o Sig^#'r^#'e Herman, pregandolo a patientare ancora, che per quanto\n[[527.17]] mi viene scritto da Venetia, si crede che nel presente mese sarà portata in Senato la sua parte di\n[[527.18]] Matematico dagli Ecc^#'m^#'i Riformatori, che io non hò mai cessato di battere per vedere presto\n[[527.19]] perfettionato l'incominciato, ed averei ottenuto tutto, se la guerra presente non avesse rotte tutte\n[[527.20]] le misure mie e di questo Studio. Hò qui avuto l'onore di riverire molte volte il Sig^#'r^#'e Sprecher,\n[[527.21]] gran veneratore dell'altissimo merito di V. S. Ill^#'m^#'a, e l'hò trovato d'un ottimo intendimento, e\n[[527.22]] religiosissimo costume. In gratia si degni V. S. Ill^#'m^#'a consolarmi con quattro sue stimati^#'m^#'e righe,\n[[527.23]] che contengano al solito qualche bellissimo lume per le discipline matematiche, molto bramoso\n[[527.24]] di sapere se sia per publicare presto alcune sue altre inventioni analitiche, come s'è sparsa qui la\n[[527.25]] voce. Per la ventura Primavera raccoglierò quanto seme di Celsi bianchi potrò per servirla; e\n[[527.26]] rivenderola mi resto </p>\n<p> [[527.27]] di V. S. Ill^#'m^#'a Umil^#'m^#'o Div^#'m^#'o S^#'r^#'e vero M. A. Fardella </p>\n<p> [[527.28]] Padova 15 Gennaio 1707. </p>\n<p> [[527.29]] All'Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o Il Sig^#'r^#'e Leibniz Consigliere di Stato di S. A. E. <b>Hannover</b> </p>\n",
  "number": "169.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Padua, 15. Januar 1707. [150.188.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:169. MICHEL ANGELO FARDELLA AN LEIBNIZ Padua, 15. Januar 1707. [150.188.] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o Supplico Am Kopf der Seite von Leibniz' Hand: resp umilmente V. S. Ill^#'m^#'a di benigno compatimento, se sono ormai passati quattro mesi, che non la vengo con miei carat...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

