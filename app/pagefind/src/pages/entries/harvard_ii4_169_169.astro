---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_169",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 169,
  "text": "<p> [[526.15]] <b>169. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[526.16]] Padua, 15. Januar 1707. [150.188.] </b></p>\n<p> [[527.1]] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o </p>\n<p> [[527.2]] Supplico <Fn><i>Am Kopf der Seite von Leibniz' Hand</i>: resp</Fn> umilmente V. S. Ill^#'m^#'a di benigno compatimento, se sono ormai passati quattro\n[[527.3]] mesi, che non la vengo con miei caratteri a riverire, e ricordarle secondo il mio debito l'antica e\n[[527.4]] fedelissima mia servitù, mentre che fin dal settembre caduto sono stato sempre ammalato, e\n[[527.5]] perciò inabile a qualsisia applicatione. La cagione del mio male è stato un calcolo, che nel suo\n[[527.6]] passaggio per il canale dell'orina, avendomi rotta un piccola arteria di notte tempo, se ne usci\n[[527.7]] da essa una gran copia di sangue, cinque libre in circa, e se non occorreva presto il Medico, era\n[[527.8]] necessario, che morissi. Il che poi mi cagionò una languidezza così estrema, e vertigini così\n[[527.9]] frequenti, che hò durato fatica a rimettermi, ne hò potuto ancora portarmi alla catedra per le\n[[527.10]] publiche lettioni, mi vò nondimeno sempre piu corroborando, e spero a Dio piacendo ben presto\n[[527.11]] restituirmi al primo mio vigore. La presente dunque servirà per assicurarla dell'inalterabile mia\n[[527.12]] gratitudine e viva memoria che conservo dell'adoratissime gratie di V. S. Ill^#'m^#'a, a cui mi protesto\n[[527.13]] infinitamente obligato, con pregare incessantemente Dio la feliciti, e lungamente conservi a\n[[527.14]] beneficio della Republica delle lettere in cui V. S. Ill^#'m^#'a ora con somma giustitia gode il primo\n[[527.15]] luogo per l'eminenza, e vastità del purgatissimo ed incomparabile suo sapere. Scrissi nella\n[[527.16]] settimana caduta al nostro Dott^#'m^#'o Sig^#'r^#'e Herman, pregandolo a patientare ancora, che per quanto\n[[527.17]] mi viene scritto da Venetia, si crede che nel presente mese sarà portata in Senato la sua parte di\n[[527.18]] Matematico dagli Ecc^#'m^#'i Riformatori, che io non hò mai cessato di battere per vedere presto\n[[527.19]] perfettionato l'incominciato, ed averei ottenuto tutto, se la guerra presente non avesse rotte tutte\n[[527.20]] le misure mie e di questo Studio. Hò qui avuto l'onore di riverire molte volte il Sig^#'r^#'e Sprecher,\n[[527.21]] gran veneratore dell'altissimo merito di V. S. Ill^#'m^#'a, e l'hò trovato d'un ottimo intendimento, e\n[[527.22]] religiosissimo costume. In gratia si degni V. S. Ill^#'m^#'a consolarmi con quattro sue stimati^#'m^#'e righe,\n[[527.23]] che contengano al solito qualche bellissimo lume per le discipline matematiche, molto bramoso\n[[527.24]] di sapere se sia per publicare presto alcune sue altre inventioni analitiche, come s'è sparsa qui la\n[[527.25]] voce. Per la ventura Primavera raccoglierò quanto seme di Celsi bianchi potrò per servirla; e\n[[527.26]] rivenderola mi resto </p>\n<p> [[527.27]] di V. S. Ill^#'m^#'a Umil^#'m^#'o Div^#'m^#'o S^#'r^#'e vero M. A. Fardella </p>\n<p> [[527.28]] Padova 15 Gennaio 1707. </p>\n<p> [[527.29]] All'Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o Il Sig^#'r^#'e Leibniz Consigliere di Stato di S. A. E. <b>Hannover</b> </p>\n",
  "number": "169.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Padua, 15. Januar 1707. [150.188.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:169. MICHEL ANGELO FARDELLA AN LEIBNIZ Padua, 15. Januar 1707. [150.188.] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o Supplico Am Kopf der Seite von Leibniz' Hand: resp umilmente V. S. Ill^#'m^#'a di benigno compatimento, se sono ormai passati quattro mesi, che non la vengo con miei carat...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>