          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:341. Aus und zu Descartes [Sommer 1678 bis Winter 1680/81 (?)] [Sommer 1678 bis Winter 1680/81 (?)] Dotes quibus ingenium praestantius redditur, non alias novi, quam cogitandi celeritatem, distincte imaginandi facilitatem, memoriae capacitatem atque usum. Cartes. method. artic. 1. Nihil expetimus ni...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

