---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_105",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 105,
  "text": "<p> [[281.14]] <b>105. GABRIEL WAGNER AN LEIBNIZ</p>\n<p> [[281.15]] Hamburg, 6. (16.) März 1697. [103.107.]</b></p>\n\n<p> [[282.1]] HochEdler, Vest= und Hochgelehrter Herr, Hochgeneigter Hr. HofRaht </p>\n<p> [[282.2]] Das glük hindert mich ziemlich, di bedienung bei dem Hrn. Grafen anzutreten, u. welches\n[[282.3]] das meiste, dem Hrn. HofRaht aufzuwarten: di flüße haben mich von neüen so hart überfallen,\n[[282.4]] daß si nicht nur durch zähe schmerzen, von denen ich doch <angle bracket>(die</angle bracket> erste jugend ausgenommen)\n[[282.5]] jeder Zeit frei gewesen, den bakken sondern auch das eine auge so stark aufgetriben, daß ich\n[[282.6]] einer misgeburt ähnlicher als einem menschen gesehen, nun 5 tage: alle andere Zufälle zuerzehlen,\n[[282.7]] ist unnöthig. Hibei befürchte nun, dass der Hr. Graf ungedultig worden, u. eine ungnade auf\n[[282.8]] mich werfen möchte ehe ich einmal zu ihm komme: bitte derowegen gehorsamst, bei gelegenh.\n[[282.9]] alles gut zumachen, u. unbeschwert zuberichten, wi er gesinnet sei. Indem ich aber zum\n[[282.10]] schreiben wenig ruhe habe, schließe ich, u. befehle mich Ihrer hohen gewogenheit, </p>\n<p> [[282.11]] als M. Hochgeneigten Hn. HofRahts unterdienstl. G. Wagner </p>\n<p> [[282.12]] Hamb. 6. Merz 97. </p>\n<p> [[282.13]] P.S. Solte ich wieder gesund werden, ehe ich von Ihnen antw. bekähme, wil ich mich doch\n[[282.14]] auf di reise machen, in hofnung, der Hr. Graf werde noch vorigen sinnes sein u. di Verzögerung,\n[[282.15]] di von mir nicht herrührt, mir nicht zurechnen. Dise ungelegenheit ist mir auch verdrieslich,\n[[282.16]] daß bei disem Zustande, di reisegelder ziemlich drauf gehen u. di itzigen Zuhörer, nach\n[[282.17]] ankündigung des abzuges mich nicht bezahlen wollen, mich dadurch zwingen bei ihnen\n[[282.18]] zubleiben; weswegen si mir auch noch 100 Thl. jährl. zulegen wollen, u. auf allerlei art\n[[282.19]] Bükenburg zu verleiden suchen; doch hab ich mich bei ihnen auf keine Zeit verbunden, bleib\n[[282.20]] also frei, u. des sinnes, zureisen, so schier ich gesundh. wegen geschikt bin. </p>\n<p> [[282.21]] Mein Brief ist abzugeben, auf dem H. Geist Kirchhofe, bei Hrn. Putensen.\n[[282.22]] <yi>Dem HochEdlen, Vest= und Hochgelehrten Herrn, Hrn. Gotfried Wilhelm Leibniz, Ihr.\n[[282.23]] Churf. Durchl. zu Braunschw. HochVerordneten HofRaht, u.a. m. etc. Hannover. Franco. </p>\n",
  "number": "105.",
  "title": "GABRIEL WAGNER AN LEIBNIZ",
  "date": "Hamburg, 6. (16.) März 1697. [103.107.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:105. GABRIEL WAGNER AN LEIBNIZ Hamburg, 6. (16.) März 1697. [103.107.] HochEdler, Vest= und Hochgelehrter Herr, Hochgeneigter Hr. HofRaht Das glük hindert mich ziemlich, di bedienung bei dem Hrn. Grafen anzutreten, u. welches das meiste, dem Hrn. HofRaht aufzuwarten: di flüße haben mich von neüen so...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>