---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_130",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 130,
  "text": "<p> [[433.1]] <b>130. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[433.2]] Padua, 8. April 1706. [107.136.] </b></p>\n<p> [[433.15]] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o </p>\n<p> [[433.16]] Credo che V. S. Ill^#'m^#'a averà già ricevuta una mia in risposta ad una sua in cui mi\n[[433.17]] comandava che facessi diligenza per raccorre almeno una libra di semi di Celso o sia moro\n[[433.18]] bianco e mandarlele a suo tempo, sopra di che gia hò fatte tutte le preventioni, e spero\n[[433.19]] pienamente servirla, subito che si sia maturato il frutto di questa Pianta, che bisognerà prima\n[[433.20]] siccarlo al Sole per poi raccorne il seme. Intorno a questo particolare V. S. Ill^#'m^#'a ne lasci tutta la\n[[433.21]] cura a me, che sarà obbedita e le trasmetterò tutto per mezzo del Sig^#'r^#'e Zanovelli. In quanto\n[[433.22]] all'interesse della Catedra per il nostro Sig^#'r^#'e Herman si persuada V. S. Ill^#'m^#'a che hò fatto\n[[433.23]] l'impossibile per colpire al segno e terminarlo. M'è convenuto operare fra molte difficoltà ed\n[[433.24]] acerbe oppositioni di Concorrenti alla Catedra che si valevano del pretesto della Religione per\n[[433.25]] rompere le mie misure, ma gratie a Dio colla patienza e destrezza hò superato ogn'impedimento\n[[433.26]] ed hò operato con tanto coraggio che hò finalmente indotto l'Ecc^#'m^#'o Magistrato de SS. Riformatori\n[[433.27]] a nominarlo ed elegerlo gia solennemente e con i voti segreti secondo il costume, hò\n[[434.1]] mandato l'invito decoroso colla lettera dell'Ill^#'m^#'o Segretario Gadaldini al Sig^#'r^#'e Herman, di cui\n[[434.2]] oggi mi capito il nuovo suo consenso con una lettera diretta all'Ecc^#'m^#'o Magistrato, che era\n[[434.3]] necessaria per potersi subito mettere la parte in Senato per la conferma, e per estrarne la Ducale\n[[434.4]] da trasmetterla poi subito al Sig^#'r^#'e Herman. Per l'annuo suo stipendio hò fatto quanto hò potuto,\n[[434.5]] e per facilitare le cose nelle funeste ed infelici circonstanze in cui per questi eserciti esteri si\n[[434.6]] trova questa Seren^#'m^#'a Republica, mi sono contentato coll'arbitrio ottenutone prima dal Sig^#'r^#'e\n[[434.7]] Herman di ducati annui 600 di prima condotta, colla promessa di vantaggiosi accrescimenti\n[[434.8]] nelle ricondotte a suoi tempi determinati. Oggi a Dio piacendo presenterò la lettera del Sig^#'r^#'e\n[[434.9]] Herman agli Eccellent^#'m^#'i Riformatori, e li sollecitarò affinché mettano il piu presto che si potrà\n[[434.10]] la loro nomina in Senato, di che non se ne dubita punto[,] qui l'ordine richiede così, e mai quasi\n[[434.11]] accade che l'Ecc^#'m^#'o Senato non approvi le deliberationi degli Ecc^#'m^#'i Riformatori, e massimamente\n[[434.12]] nel nostro caso, che si tratta di condurre un così dotto e celebre Matematico di cui qui\n[[434.13]] n'abbiamo sommo bisogno. Il Sig^#'r^#'e Herman informerà forse V. S. Ill^#'m^#'a di quanto io hò fatto per\n[[434.14]] ridurre alla sua perfettione questo affare difficile a maneggiarsi in questi tempi infelici. V. S.\n[[434.15]] Ill^#'m^#'a è supplicata conservarmi il suo amore, e stimati^#'m^#'o patrocinio, e divotamente riverendola mi\n[[434.16]] protesto </p>\n<p> [[434.17]] Di V. S. Ill^#'m^#'a Obl^#'m^#'o Div^#'m^#'o S^#'r^#'e vero M. A. Fardella </p>\n<p> [[434.18]] Padova 8 Aprile 1706. </p>\n",
  "number": "130.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Padua, 8. April 1706. [107.136.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:130. MICHEL ANGELO FARDELLA AN LEIBNIZ Padua, 8. April 1706. [107.136.] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o Credo che V. S. Ill^#'m^#'a averà già ricevuta una mia in risposta ad una sua in cui mi comandava che facessi diligenza per raccorre almeno una libra di semi di Celso o sia ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>