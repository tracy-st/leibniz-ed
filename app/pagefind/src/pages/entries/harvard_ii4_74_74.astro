---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_74",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 74,
  "text": "<p> [[245.15]] <b>74. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[245.16]] Venedig, 21. Juni 1704. [73.77.] </b></p>\n<p> [[245.23]] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o </p>\n<p> [[245.24]] Nel <Fn><i>Am Kopf der Seite von Leibniz' Hand</i>: resp.</Fn> tempo delle publiche lettioni in Padova ricevei una lettera di V. S. Ill^#'m^#'a che mi fù\n[[245.25]] consegnata dal Sig^#'r^#'e Guglielmini, alla quale subito risposi, e poi ne replicai un'altra, ma non\n[[246.1]] avendone ancora ricevuta risposta, temo che le mie si sieno smarrite percio le trasmetto ora\n[[246.2]] quest'altro foglio che io oggi per maggiore sicurezza consegnarò a mani proprie del Sig^#'r^#'e\n[[246.3]] Zanovelli, trovandomi ora in Venetia, ove mi tratterrò per qualche mese. L'altro giorno le\n[[246.4]] scrissi un altro foglio che le sarà consegnato dal Sig^#'r^#'e Gio. Filippo Brienio di Dansica Giovane\n[[246.5]] non meno erudito, che ben costumato, avidissimo di sapere, e molto bramoso di conoscerla, s'è\n[[246.6]] partito mercordi per Vienna per poi portarsi in Olanda. Io fin ora non hò potuto publicare cosa\n[[246.7]] niuna di tante che hò meditate e già preparate per l'uso delle publiche lettioni di molto\n[[246.8]] accresciute che quasi ci rubano tutto il tempo, e v'aggiongo la mia debole e malsana complessione\n[[246.9]] che non può molto resistere allo studio. Ora che è tempo di vacanze, e che godo una\n[[246.10]] somma calma in casa dell'Ecc^#'m^#'o Sig^#'r^#'e Procu^#'r^#'e Foscarini m'apparecchio a perfettionare qualche\n[[246.11]] cosa, e spero dare alla luce un'operetta che non sarà inutile alla Gioventù studiosa e nella quale\n[[246.12]] mi prenderò la libertà di riferire l'inventioni piu alte e sublimi insieme coll'elogio di V. S.\n[[246.13]] Ill^#'m^#'a, il di cui celebre ed immortale nome darà gran lustro, ed ornamento al mio libro. Hò letto\n[[246.14]] nell'opera del Sig^#'r^#'e Marchese dell'Opital il veramente divino calcolo differentiale trovato\n[[246.15]] dalla felicissima e profonda mente di V. S. Ill^#'m^#'a, e molto ora per comprendere tutto il\n[[246.16]] maraviglioso artificio della sua Analisi bramarei vedere l'altro suo calcolo detto integrale\n[[246.17]] percio prego l'incomparabile bonta di V. S. Ill^#'m^#'a avvisarmi, se è stato publicato, e soggerirmi\n[[246.18]] la maniera d'averlo. Qui in Italia pochissimi travagliano intorno all'Analisi, e solamente\n[[246.19]] n'anno scritto qualche cosa i dottissimi Napolitani Antonio Gianforte, e Giacinto di Cristoforo.\n[[246.20]] Il Sig^#'r^#'e Guglielmini pensa di publicare presto la nuova sua idea della febre, come anche un\n[[246.21]] altro suo pensiero il Sig^#'r^#'e Ramazzini, ed il Sig^#'r^#'e Valsinieri nostro Professore di Medicina\n[[246.22]] s'apparecchia a dare alla luce le sue nuove osservationi sopra gl'Insetti. Essendo il Sig^#'r^#'e\n[[247.1]] Guglielmini passato alla prima catedra di Medicina teorica, vaca ora quella della Matematica,\n[[247.2]] prego percio V. S. Ill^#'m^#'a ricordarmi qualche dotto Matematico di coteste parti che potesse, e\n[[247.3]] volesse applicare a questo posto per io poi poterlo proponere agli Ecc^#'m^#'i Riformatori dello\n[[247.4]] Studio di Padova. Supplico in fine V. S. Ill^#'m^#'a onorarmi con questo suo stimatissimo comandamento,\n[[247.5]] consolarmi con suoi caratteri, e persuadersi, che mentre viverò mai mi scordarò di\n[[247.6]] tante sue gratie che hò ricevute. Prego Dio la conservi lungamente a beneficio delle buone\n[[247.7]] lettere, e divotamente riverendola mi rassegno </p>\n<p> [[247.8]] Di V. S. Ill^#'m^#'a Umil^#'m^#'o Obl^#'m^#'o Div^#'m^#'o S^#'r^#'e Michel Angelo Fardella </p>\n<p> [[247.9]] Venetia 21 Giugno 1704 </p>\n<p> [[247.10]] Se V. S. Ill^#'m^#'a si degnarà scrivermi potrà indirizzare la sua al Sig^#'r^#'e Zanovelli in Venetia, che\n[[247.11]] mi farà subito avere la lettera. </p>\n",
  "number": "74.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Venedig, 21. Juni 1704. [73.77.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:74. MICHEL ANGELO FARDELLA AN LEIBNIZ Venedig, 21. Juni 1704. [73.77.] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o Nel Am Kopf der Seite von Leibniz' Hand: resp. tempo delle publiche lettioni in Padova ricevei una lettera di V. S. Ill^#'m^#'a che mi fù consegnata dal Sig^#'r^#'e Guglielmi...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>