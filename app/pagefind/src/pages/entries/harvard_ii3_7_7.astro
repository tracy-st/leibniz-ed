          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:7. LEIBNIZ AN HENRI BASNAGE DE BAUVAL [Hannover,] 28. Januar (7. Februar) 1695. [2.14.] [L^#'1 ] Extrait de ma reponse Je vous envoye icy une lettre sur une contestation militaire. Elle a esté ecrite depuis peu par un Officier du premier rang, et des plus experimentés; qui sert à un grand prince et ...">

