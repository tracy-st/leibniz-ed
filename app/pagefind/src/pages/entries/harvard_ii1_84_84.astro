---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_84",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 84,
  "text": "<p> [[230.4]] <b>71. JOHANN OTT AN LEIBNIZ</p>\n<p> [[230.5]] Schaffhausen, 6. (16.) Juli 1671.</b></p>\n<p> [[230.13]] Nobilissime, Excellentissime ac Consultissime Domine. </p>\n<p> [[230.14]] Ad manus meas, curante celeberrimo D.D. Fabritio, literae tuae eruditissimae pervenerunt,\n[[230.15]] illaeque eodem temporis articulo oblatae mihi fuerunt, quo [nugacia], id est, ex statuto Academiae\n[[230.16]] Basileensis, vocabula illa, famosa, an infamia dicam nescio? in <i>trix</i>, <i>fica</i> et <i>alis</i>,\n[[230.17]] videlicet <i>nutrix</i>, <i>auctrix</i>, <i>generatrix</i>, <i>attractrix</i>, <i>expultrix</i>: <i>pulsifica</i>, <i>offifica</i>: <i>naturalis</i>, <i>vitalis</i>,\n[[230.18]] <i>animalis</i> etc. ad nauseam usque memoriae erant inprimenda. Non enim te latet, vir consultissime,\n[[230.19]] qua ratione Medicina nostra vulgaris ineptis, inutilibus, nihilque significantibus verbis\n[[230.20]] onerata et penitus fere obpressa sit, estque ars illa, si qua ulla alia, conjecturis et densa\n[[230.21]] incertitudine plenissima. Sed etiam pariter absconditae eruditionis binos tractatus junctos literis\n[[230.22]] accepi, pro quo egregio munere, non solum ego, sed et Cl. Dⁿ^#'u^#'s Spleissius et D.D. Screta gratias\n[[230.23]] rependimus maximas, quas possum[us], prae primis etiam ideo, quod obscura nostra nomina\n[[231.1]] illustribus tuis lucubrationibus inserere voluisti. Utinam pares fuissemus, aut labor noster isto\n[[231.2]] titulo dignus! Dabimus ideo operam, ut inposterum meliora de nobis cogitare vel tu, vir\n[[231.3]] consultissime, vel alii amici queatis. Egregie sane in bino isto scripto, quantus et qualis in\n[[231.4]] universa humana sapientia excellas, luculenter ostendis. Unum hoc dolui, quod ob Medica\n[[231.5]] negotia ea diligentius perlustrare, et ob quarundam figurarum defectum mentem tuam minus\n[[231.6]] feliciter assequi potuerim. Repetita igitur in sequentibus diebus lectione, ut penetrem geminum\n[[231.7]] istum et pulcerrimum ingenii tui foetum, operam dabo. Manca quidem specialior pars ad me\n[[231.8]] pervenit, per bibliopolam facile emendanda. Curiosam de reflexione per lineas curvas tuis\n[[231.9]] inseruisti doctrinam, quam tamen hactenus me, ob memoratam absentiam figurarum, penitus\n[[231.10]] intelligere nequivisse fateor. Viro consultissimo forte occasio et ansa dabitur rem istam specialius\n[[231.11]] declarandi, aliisque de sententia ista judicandi. Nomen tuum nobilissimum, quod thesibus\n[[231.12]] meis praefixerim, aequo animo credo feres. Factum id solum propterea, quod hac vice\n[[231.13]] melius aut praestantius nihil habeam. Etenim si modo eo, quo praefationem instruxi, universam\n[[231.14]] visionis rectae et morbosae oeconomiam delineare adgressus fuissem, quin elaboratius et\n[[231.15]] perfectius quidpiam viro consultissimo me exhibere potuissem non dubito; verum ea in aliud\n[[231.16]] tempus differenda esse plurima, et praesertim loci importunitas, effecerunt: coeptam tamen\n[[231.17]] telam inposterum elaborare non desistam. Totus jam in eo sum, ut novum illud genus tuborum\n[[231.18]] opticorum Heidelbergae inventum effectui dem. Ipsius namque operis facilitas, et Geometricae\n[[231.19]] demonstrationes egregium valde usum mihi persuadent. Sed quid et quousque rem perficere\n[[231.20]] permissum erit, suo tempore viro consultissimo patefacere non dedignabor. Illustrissimum\n[[231.21]] Dominum Baronem a Boinenburg, virum, cujus subactum ingenium secula nulla tacebunt,\n[[231.22]] admiratione prosequi semper studebunt, si Patronum effeceris, vir consultissime, me tibi adeo\n[[231.23]] devincies, ut nihil non intentatum in tui gratiam relinquere aut omittere gestiam. Analysi alia\n[[231.24]] non utor, quam ea, quam Cartesius in <i>Geometria</i>, libro prae omnibus aliis caro, tradidit,\n[[231.25]] quaeque adeo est universalis et usus admirandi, ut meliorem aut generaliorem nullam adhuc\n[[231.26]] videre contigerit. In ea enim, ut in corollario quodam disputationis Heidelbergae habitae, tam\n[[231.27]] methodus Cavallerii, quam Hobbii ars computandi per motus compositionem, tam veterum\n[[231.28]] synthesis, quam Analysis et ipsamet ars combinatoria, et si quid aliud, continetur. Neque\n[[231.29]] etiam viribus diffido in solutione problematis mihi propositi. Illa enim in promptu foret, si\n[[231.30]] modo diagrammate quodam mentem tuam clarius exposuisses. Ita enim propositum, uti jacet,\n[[231.31]] infinitis solutionibus capax est. Quamobrem si viro consultissimo placuerit adjicere ulteriorem\n[[231.32]] explicationem et schematismo etiam rudiori declarationem; solutionem proxime a me exspectabis.\n[[231.33]] Sed finiendum. Vale itaque, vir consultissime, cum Illustrissimo tuo Maecenate, et eum,\n[[231.34]] qui te amat, redama. Nunquam enim non ero </p>\n<p> [[232.1]] Consultissimae tuae Excellentiae addictissimus Joh. Ott. D. </p>\n<p> [[232.2]] Schafhusii d. 6. Julii 1671. </p>\n<p> [[232.3]] D.D. Screta ob negotia a scribendo desistit. Amicissime tuam Excellentiam salutat, cum\n[[232.4]] celeberrimo Dⁿ^#'o Spleissio, qui se totum tibi devovet. </p>\n",
  "number": "71.",
  "title": "JOHANN OTT AN LEIBNIZ",
  "date": "Schaffhausen, 6. (16.) Juli 1671."
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:71. JOHANN OTT AN LEIBNIZ Schaffhausen, 6. (16.) Juli 1671. Nobilissime, Excellentissime ac Consultissime Domine. Ad manus meas, curante celeberrimo D.D. Fabritio, literae tuae eruditissimae pervenerunt, illaeque eodem temporis articulo oblatae mihi fuerunt, quo [nugacia], id est, ex statuto Academi...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>