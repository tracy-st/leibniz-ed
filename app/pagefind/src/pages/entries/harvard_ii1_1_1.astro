---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_1",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 1,
  "text": "<p> [[3.1]] <b>1. LEIBNIZ AN JAKOB THOMASIUS </p>\n<p> [[3.2]] Jena, 2. (12.) September 1663. [3.]</b></p>\n<p> [[4.3]] Unica, quam tibi transmitto, disputatio sua novitate id meruisse visa est. <Fn><i>Anmerkung von Kortholt unter dem Text in E^#'2</i> nach <i>visa est</i>: Titulus ejus: Q. D. B. V. Dissertatio academica, cujus prima pars de ratione status: altera de nobilitate: tertia de ministrissimo: quam pro more consueto, praeside Dn. Severo Christophoro Olpio, Prof. publ. et h. t. academiae rectore magnifico, publicae eruditorum disquisitioni exponet auctor Wilhelm Schröter, illustriss. regiae societatis Britann. assessor. d. 25 Jul. Jenae, literis Sengenwaldianis, anno 1663, in fol.</Fn> Respondens\n[[4.4]] filius est D. Wilhelmi Schroeteri, Cancellarii Gothani, qui celeberrimo illi Franskio successit. Is\n[[4.5]] Jenae prius studiosus, mox peregrinandi amore in Bataviam, inde [in] Angliam delatus est,\n[[4.6]] inde, si ipsi credimus, in parlamentum irrepsit. Nuper, cum patriam suam reviseret, noluit\n[[4.7]] inglorius tacitusque abire, sed monimentum sui hanc disputationem relinquere constituit. Sed\n[[4.8]] eo eventu, ut multo fuerit consultius, siluisse. Nam et in conflictu vox, et in conversatione\n[[4.9]] morum elegantia defuit, sic, ut pro gloria, quam sibi promiserat, cumulatam ex hac urbe\n[[4.10]] infamiam asportaret. Quin et princeps Gothanus, re comperta, ac cognito, quam in hac disputatione\n[[4.11]] periculosa spargerentur, primus ursit, effecitque, ut publice confiscaretur. Ipsam sane\n[[4.12]] disputationem judicio peritiorum accepi ingeniosam esse: sed sic, ut tanto minus hic auctor\n[[4.13]] videatur. Immo non defuere, qui dudum cusam, et inde usque ab Anglia allatam suspicarentur,\n[[4.14]] quod disputatione [de] Ministrissimo, thesi una, Don Louis de Haro, tamquam adhuc florentis\n[[4.15]] viventisque mentio fieret, qui tamen et obiit dudum, et familia, postquam filii insidiae in Regem\n[[4.16]] detectae sunt, jacet proculcata. Sane corollaria novam quandam sapiunt philosophiam, qualibus\n[[4.17]] plena Anglia est, et ipse, ni fallor, Kenelmus Digbaeus, cui ille hanc disputationem dicavit, <Fn><i>Anmerkung von Kortholt unter dem Text in E^#'2</i> : Dedicavit 1) Friderico, Saxoniae Duci, 2) Digbaeo. Digbaeo hunc titulum tribuit: Illustrissimo heroi, Britanniae comiti ac domino, <k>Dn. Kenelmo Digby</k>, equiti Britanno exlegato, et summo rei navalis expraefecto, ac sacrae regiae majestatis reginae matris in Anglia cancellario magnifico, et illustrissimae regiae societatis ibidem assessori excellentissimo, domino, Maecenati atque amico meo sincero et pie colendo.</Fn>\n[[5.1]] ingenti opere <i>de immortalitate animae</i> simile quid delineavit. Reliqua disputatio Machiavellismum\n[[5.2]] spirat, et videbatur in hoc uno eam respondens intellexisse. Nam quoties jus naturae\n[[5.3]] divinaeque leges objiciebantur, eas ad privatorum pacta limitandas contendebat, totum jus\n[[5.4]] gentium, bellique ac pacis immani hac audacia subversurus. </p>\n<p> [[5.5]] Demum vivus undique aut Hobbes aut Hobbesianus elucet. Cum enim utilitatem aequi\n[[5.6]] matrem habeat, igitur prout illi velificabitur jus omne, stabit cadetque: cum cuilibet principum\n[[5.7]] absolutum det imperium, sola suspicio principi ad supplicia jus dabit: demum quia a civili lege\n[[5.8]] omnis justitia propullulat, necessario obligatio omnis ac foederum servandorum necessitas ruet\n[[5.9]] inter civitates. Haec in Hobbesio saepe reprehendentem V.E. audivi. Quare cepit me quaedam\n[[5.10]] de Hobbesio a V.E. quod ejus pace fiat, sciscitandi cupiditas, quis ille, an adhuc superstes, an\n[[5.11]] Antagonistam na[c]tus, an habuerit, qui in jure naturae illustrando paria fecerint, meliora aut\n[[5.12]] aequalia, si subtilitatem spectes. Unus mihi Dominus Pufendorfius notus est, qui tamen sua\n[[5.13]] <i>elementa jurisprudentia</i>[<i>e</i>] ex Weigelii nostri Ethica Euclidea manuscripta dicitur fere tota\n[[5.14]] efformasse. Jenae 2 Septemb. 1663. </p>\n",
  "number": "1.",
  "title": "LEIBNIZ AN JAKOB THOMASIUS",
  "date": "Jena, 2. (12.) September 1663. [3.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:1. LEIBNIZ AN JAKOB THOMASIUS Jena, 2. (12.) September 1663. [3.] Unica, quam tibi transmitto, disputatio sua novitate id meruisse visa est. Anmerkung von Kortholt unter dem Text in E^#'2 nach visa est: Titulus ejus: Q. D. B. V. Dissertatio academica, cujus prima pars de ratione status: altera de no...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>