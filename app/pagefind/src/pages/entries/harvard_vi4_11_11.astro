---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_11",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 11,
  "text": "[[27.18]] <b>10₁.  Definitiones notionum ex Wilkinsio. Genera et species, Causae et effectus </p>\n<p> [[27.23]] [p. 26] <b>Genera et Species</b> </p>\n<p> [[27.24]] <b>Aliquid</b> est quicquid cogitari potest. </p>\n<p> [[27.25]] <b>Nihil</b> est quicquid cogitari non potest. </p>\n<p> [[27.26]] <b>Res</b> est quae distincte cogitari potest. </p>\n<p> [[28.1]] <b>Existit</b> quicquid distincte percipi potest, alioqui erit <b>apparens</b> tantum. </p>\n<p> [[28.2]] (<b>Essentia</b>) est quod in re distincte cogitari potest. <Fn><i>Am Rande Ansätze zu einer Charakteristik</i>: Aliquid <tab/>A <tab/> Nihil <tab/>... <tab/> <tab/>qne2 quod <tab/> <tab/>q non <tab/> <tab/>n est <tab/>e Definitio debet substitui posse in locum definiti: Res <tab/>A aequ. <tab/>BC ^&.SE <Leibniz special character> D Essentia <tab/>bc</Fn> </p>\n<p> [[28.3]] (<b>Existentia</b>) est distincta rei perceptibilitas seu sensibilitas distincta. </p>\n<p> [[28.4]] <b>Notio</b> est conceptus distinctus, aliquando dicitur verus. </p>\n<p> [[28.5]] <b>Fictio</b> conceptus indistinctus, aliquando dicitur falsus. </p>\n<p> [[28.6]] <b>Substantia</b> cujus individuum de alio dici non potest. </p>\n<p> [[28.7]] <b>Accidens</b> cujus individuum de alio praedicari potest. </p>\n<p> [[28.8]] <b>Quantitas</b> est discrimen quod per se memoria retineri non potest, sed solo sensu\n[[28.9]] distinguitur. Seu discrimen in perceptione. </p>\n<p> [[28.10]] <b>Qualitas</b> est discrimen in conceptione. </p>\n<p> [[28.11]] <b>Actio</b> est status rei ex qua sequitur mutatio alterius rei. </p>\n<p> [[28.12]] <b>Passio</b> est mutatio quae ex alterius rei statu sequitur. </p>\n<p> [[28.13]] <b>Relatio</b> est secundum quod duae res simul cogitantur.\n [[28.14]] Uti relatio dicit res simul cogitari, ita actio et passio res simul existere. Hoc tamen et\n[[28.15]] quaedam faciunt relationes, nempe commercii. </p>\n<p> [[28.16]] <b>Absolutum</b> est quod non dicit relationem. </p>\n<p> [[29.1]] [p. 27] <b>Causae, effectus</b> </p>\n<p> [[29.2]] <b>Causa</b> est praerequisitum existentiae alterius quod dicitur Effectus. </p>\n<p> [[29.3]] <b>Efficiens</b> est quod actione sua praerequisitum est. </p>\n<p> [[29.4]] <b>Instrumentum</b> est causa efficiens ab alia inter agendum acta, seu cujus tota actio\n[[29.5]] simul passio est. </p>\n<p> [[29.6]] <b>Impulsivum</b> causa ut actio incipiat seu cum agens impellentis instrumentum est\n [[29.7]] in initio actionis, etsi non sit in progressu. Proprie locum habent talia in mentibus tantum.\n[[29.8]] Imo videamus, si quis saxum in alium injiciat, dicaturne causa impulsiva caedis. </p>\n<p> [[29.9]] <b>Cohibitivum</b> est causa ut actio desinat vel minuatur. </p>\n<p> [[29.10]] <b>Exemplar</b>, Typus: est res cui quis aliam similem facere voluit, seu simile destinato.\n[[29.11]] Seu cui aliud destinatur simile. <b>Destinatum</b> est volitum cum opinione potestatis\n[[29.12]] efficiendi. </p>\n<p> [[29.13]] <b>Ectypus</b>, Antitypus seu exemplum est simile destinatum. </p>\n<p> [[29.14]] <b>Conditio</b> est quo posito aliud ponitur. </p>\n<p> [[29.15]] <b>Requisitum</b> quo non posito tollitur. </p>\n<p> [[29.16]] <b>Occasio</b> est status rerum casu congruus. </p>\n<p> [[29.17]] <b>Adjuvare</b> est opus alicui facilius facere. </p>\n<p> [[29.18]] <b>Impedire</b> est facere difficilius. </p>\n<p> [[29.19]] <b>Facile</b> est cujus pauca sunt praerequisita sufficientia. </p>\n<p> [[29.20]] <b>Finis</b> est cujus appetitus est causa efficiens appetitus rei alterius quae dicitur\n[[29.21]] <b>medium</b>. </p>\n<p> [[29.22]] <b>Materia</b> est <i>A</i> cujus manentis mutatione aliquid producitur <i>B</i> ita ut <i>A</i> pertineat ad\n[[29.23]] essentiam ipsius <i>B</i>. </p>\n<p> [[29.24]] <b>Forma</b> est principium internum qualitatum primariarum rem ab alia omni discernentium. </p>\n",
  "number": "10₁.",
  "title": "Definitiones notionum ex Wilkinsio. Genera et species, Causae et effectus",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:10₁. Definitiones notionum ex Wilkinsio. Genera et species, Causae et effectus [p. 26] Genera et Species Aliquid est quicquid cogitari potest. Nihil est quicquid cogitari non potest. Res est quae distincte cogitari potest. Existit quicquid distincte percipi potest, alioqui erit apparens tantum. (Ess...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>