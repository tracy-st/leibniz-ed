---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_192",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 192,
  "text": "<p> [[615.12]] <b>174. VINCENT PLACCIUS AN LEIBNIZ</p>\n<p> [[615.13]] Hamburg, 13. (23.) April 1678. [171.175.]</b></p>\n<p> [[615.24]] S. P. Amplissime, Excellentissime Dⁿ^#'e Fautor honoratissime </p>\n<p> [[615.25]] Feldenianos libros Mss^#'t^#'o^#'s tandem imperialibus illis X, quamvis aegre, feci ut impetrares.\n[[615.26]] Itaque cui tradi velis tantum indicatu opus est. <i>Sylloge</i> Speidelii non continetur Langebeciano\n[[615.27]] inventario, a me ipso propterea perlecto denuo. Jungianorum aliquid imprimetur propediem,\n[[615.28]] et jam cum typographo agitur de conditionibus. Etiam Fogelianae Bibliothecae auctione publica\n[[616.1]] vendendae catalogus jam sub prelo est. Sed lenti sunt nostri homines nisi compelluntur. Itaque\n[[616.2]] vix ante Pentecostes festum, credo, ea impressio finietur, praeter propter XII foliis prodituris.\n[[616.3]] Sane rarissimorum in ea librorum adest copia. Quae de auctoribus indicas, grata sunt, sed de\n[[616.4]] Modrevio et Tesauro videris oblitus. Nunc ad demonstrationem nostram examinatam a Te\n[[616.5]] venio: quae neque mihi adhuc satisfacit, quamvis putem probari posse, animam naturaliter vel\n[[616.6]] quatenus ratiocinatur et vult, in bonam immortalitatem ferri, nec nisi aeterno summo bono\n[[616.7]] posse satiari, adeoque aut miseriae merae temporali, aut aeternitati bonae naturaliter esse\n[[616.8]] destinatam. Aequivocationes etiam fateor distinguendas fore accuratius, et adeo definiendum\n[[616.9]] <greek>tò</greek> naturale, <greek>tò</greek> necessario, <greek>tò</greek> desiderium praecipue. Desiderium autem non frustraneum\n[[616.10]] impleri posse debere puto licet actu forte id non fiat, quoniam alias, licet per accidens aliquem\n[[616.11]] sortiatur finem, attamen per se non sit nisi frustraneum futurum, scil. quatenus est desiderium:\n[[616.12]] sicut calceus quatenus calceus, est frustraneus, nisi pedi applicetur, etsi forte possit quatenus\n[[616.13]] corium vel aliud quid aliis usibus inservire. Taliter autem illud <i>frustra</i> est accipiendum ex\n[[616.14]] definitione auctoris propos. prima, quae deberet inde porro demonstrari, quod imperfectionis sit\n[[616.15]] rem creare quae non possit ad suum quo tendit finem perduci. Sed quid si hoc demonstretur, aut\n[[616.16]] demonstrari posse concedatur, Naturam vel providentiam divinam frustra eo sensu nil facere,\n[[616.17]] adeoque ut bona hypothesis admittatur, ac voces illae, fortasse difficilius externa oratione\n[[616.18]] sufficienter definiendae, quam citra errorem eodem utrinque conceptu interno accipiendae,\n[[616.19]] congruo sensu capiantur: haud tamen inde sequetur animam mori non posse vel immortalem\n[[616.20]] esse, sed posse non mori vel non necessario esse mortalem. Quod longe minus est, quam\n[[616.21]] necessario esse immortalem. Etenim fieri possit ut homo sua culpa cum posset non mori,\n[[616.22]] moriatur, qui si non posset mori, nec sua culpa moreretur. Verum haec quidem de hac demonstratione,\n[[616.23]] nunc an ullam habeas perfectiorem, scire pervelim, vel si speres eam dare de illa ut\n[[616.24]] serio cogites oro. Vix enim video quid in rebus humanis meditari dignius queamus. </p>\n<p> [[616.25]] De statu meorum ineditorum adhuc plene perscribere non vacat. Arrhae interim loco de\n[[616.26]] <i>Astrologia</i> non contemnenda rationes hasce cape. Quia corpora nostra mirifice ab astris affici\n[[616.27]] plane indubitatum est, ac de temperie, morbis ac sanitate praedictiones admodum certas dari\n[[616.28]] sum expertus. Jam naturae sequitur semina quisque suae. Ac eatenus de illis etiam quae sunt\n[[616.29]] liberi arbitrii probabiliter praedicetur. Fortuita vero nulla sunt apud Deum, aut ergo quae talia\n[[616.30]] nobis videntur intermedias habent suas caussas, aut immediate a Deo proficiscentur. Posterius\n[[616.31]] qui probaverit, huic largiar, nil posse super iis praedici. Caeteroqui cum tot habeam exempla\n[[616.32]] praedictionum super hisce, non video cur nihil horum astris debeat tribui. Sane Feldeniana\n[[617.1]] principia secutos, non puto in generalibus de corpore ac fortuna praedicendis unquam plane\n[[617.2]] fuisse falsos, ita ut firmam v. gr. valetudinem morboso, miseriam fortunato, etc. praedixerint.\n[[617.3]] Quin imo in ipsius et aliorum ab ipso vel ipsius ductu eruditis, curiose elaborata genesi nulla\n[[617.4]] non, admirandas praedictiones specialissimas depraehendi, quas hic recensere nunc non vacat.\n[[617.5]] Quin ipsam epistolam non adeo prolixam imperialis dimidii sumptibus vel forsitan minoris\n[[617.6]] describendam curare possem, si tanti ea res foret. Sed est quod a Te quoque vicissim petam.\n[[617.7]] Nimirum indiculum editorum, a Te, ac edendorum, communicari mecum. Etenim praeter\n[[617.8]] anonyma bina, et dissertationem <i>de Bibliotheca</i> <i>Norimbergensi</i>, <i>de combinatione</i>, ac praefationem\n[[617.9]] Nizolii <i>Antibarbaro</i> praefixam nunc non recordor aliquid me vidisse. Quaeso itaque hac\n[[617.10]] in re morem geras Tibi se ad omnia commodaturo. </p>\n<p> [[617.11]] Vale Excell^#'m^#'i T. N. observatiss^#'m^#'u^#'s V. Placcius </p>\n<p> [[617.12]] Hamb. 1678 d. 13. Aprilis. </p>\n<p> [[617.13]] A Monsieur Monsieur Leibnitius Conseiller de Son Altesse de Hanover, à Hannover. </p>\n",
  "number": "174.",
  "title": "VINCENT PLACCIUS AN LEIBNIZ",
  "date": "Hamburg, 13. (23.) April 1678. [171.175.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:174. VINCENT PLACCIUS AN LEIBNIZ Hamburg, 13. (23.) April 1678. [171.175.] S. P. Amplissime, Excellentissime Dⁿ^#'e Fautor honoratissime Feldenianos libros Mss^#'t^#'o^#'s tandem imperialibus illis X, quamvis aegre, feci ut impetrares. Itaque cui tradi velis tantum indicatu opus est. Sylloge Speidel...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>