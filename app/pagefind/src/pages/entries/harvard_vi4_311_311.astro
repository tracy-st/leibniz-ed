---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_311",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 311,
  "text": "[[1357.9]] <b>256₁.  Hauptstück HAUPTSTÜCK\n[[1357.10]] <tit2><b>Elementa Verae Pietatis, sive de Amore Dei super omnia</b></tit2>\n [[1357.11]] <b>Elementa</b> voco, quia certis demonstrationibus nituntur.\n [[1357.12]] <tab/><b>Pietatis</b> dico, non moralium tantum virtutum. Quia potest aliquis bene vivere humanas\n[[1357.13]] tantum ob causas, quales sunt educatio, consuetudo, pax publica, securitas propria,\n[[1357.14]] bona fama. Hic vero agitur de iis quae propter Deum agimus aut patimur.\n [[1357.15]] <tab/><b>Amare</b> est felicitate alicujus delectari, seu voluptatem capere ex alterius felicitate.\n [[1357.16]] Amorem hic definio verum, qui ab affectu simplici, aut etiam amicitia utilitatis\n[[1357.17]] causa suscepta differt. Hujus definitionis usum insignem aliquando deprehendi in\n[[1357.18]] colloquio cum amicis nonnullis, qui non satis capiebant, quomodo amans amati\n[[1357.19]] bonum quaerat nulla consideratione lucri in se redundantis, videtur enim quicquid\n[[1357.20]] agimus propter bonum nostrum nos facere, non propter alienum, quomodo ergo\n[[1357.21]] possibile est, ut bonum amati per se expetamus? Difficultas praeclare solvitur ope\n[[1357.22]] hujus definitionis, quae ostendit felicitatem amati esse partem nostrae. Quemadmodum\n[[1357.23]] enim Picturam excellentem non ob usum aliquem sed ob ipsam suam\n[[1357.24]] pulchritudinem habemus; ita felicitatem amati non aliam ob causam quaerimus,\n[[1358.1]] quam ut ejus notitia nos voluptate perfundat. Quemadmodum patet ex hoc ­Corollario:\n[[1358.3]] Corollarium Definitionis\n[[1358.4]] Bonum amati propter se expetitur.\n[[1358.5]] Demonstratio\n[[1358.6]] · Bonum amati delectat amantem,\n [[1358.7]] ex hypothesi in definitione amoris facta, definivimus enim amare, alterius felicitate\n[[1358.8]] delectari.\n [[1358.9]] · Quicquid delectat eatenus per se expetitur.\n [[1358.10]] Haec propositio patet nam quae delectant, etsi nullum usum habeant, nihilominus\n[[1358.11]] expetuntur. Et quaecunque expetimus, ea ideo expetimus, ut voluptatem faciant, aut\n[[1358.12]] dolorem aliquem tollant, quod si immediate producunt voluptatem, eatenus per se\n[[1358.13]] peti dicuntur, si vero tantum ad aliud obtinendum inserviant, quod revera voluptatem\n[[1358.14]] producit, tunc alterius tantum causa quaeruntur. Patet ergo jucunda per se expeti,\n[[1358.15]] utilia propter jucunda.\n [[1358.16]] · Ergo bonum amati per se expetitur ab amante.\n[[1358.17]] <b>Pulchrum</b> est cujus contemplatio jucunda.\n [[1358.18]] <b>Bonum</b> est quod ad jucunditatem confert.\n [[1358.19]] <b>Felicitas</b> est gaudium duraturum.\n [[1358.20]] <b>Gaudium seu Delectatio</b> est sensus perfectionis.\n [[1358.21]] <b>Deus</b> est Ens perfectissimum.\n [[1358.22]] <b>Perfectio</b> est gradus seu quantitas realitatis.\n [[1358.23]] Unde <b>perfectissimum</b> est quod summum habet realitatis gradum. Sive illud Ens,\n[[1358.24]] quod tantum continet realitatis, qualitatum, et potentiarum, quantum in unum subjectum\n[[1358.25]] simul cadere possibile est. Unde Deus nullos praesentiae, durationis, potentiae,\n[[1358.26]] scientiae, operationis, limites, habere intelligitur, et tantum possidet, quantum\n[[1358.27]] ab uno possideri possibile est.\n [[1358.28]] <b>Harmonia</b> est unitas in varietate.\n[[1359.1]] Corollaria ex his definitionibus:\n[[1359.2]] Ex pluribus modis possibilibus ille est perfectior, secundum quem efficitur, ut plus\n[[1359.3]] realitatis existat in dato volumine sive receptaculo.\n [[1359.4]] Nempe plus corporum in dato spatio, plus motuum in dato tempore, plus formarum\n[[1359.5]] in data materia, plus qualitatum in dato subjecto. Quare perfectioni adversum est\n[[1359.6]] <b>Vacuum</b> in loco, in tempore, in materia, in formis. <b>Redundans</b> etiam sive\n[[1359.7]] superfluum perfectioni adversum est, quia vacuum denique per consequentiam\n[[1359.8]] introducit, locum enim utilioribus tollit, et ipsummet loco suo deest, ubi utilius\n[[1359.9]] collocaretur. Quemadmodum qui merces cista condit, dat operam ut omnia ita\n[[1359.10]] ordinet, quo minimum loci perdat; et natura ipsa liquidum ab inimica siccitate aut\n[[1359.11]] diverso liquore pressum in guttam rotundam colligit, ubi minus exponitur hosti, quia\n[[1359.12]] plus materiae intra eundem ambitum includit. Ambitus enim solus, non vero quod\n[[1359.13]] intra est, hosti exponitur. Et sphaera est capacissima figurarum eundem ambitum\n[[1359.14]] habentium.\n [[1359.15]] Harmonia est perfectio cogitabilium quatenus cogitabilia sunt.\n [[1359.16]] Harmonia est cum multa ad quandam unitatem revocantur. Nam ubi nulla est\n[[1359.17]] varietas, nulla est harmonia, et <i>Citharoedus</i> <i>ridetur chorda</i>: nostis caetera. Vicissim\n[[1359.18]] ubi varietas est sine ordine, sine proportione, sine concordia, nulla est harmonia.\n[[1359.19]] Hinc patet quanto major sit et varietas et in varietate unitas, hoc majorem esse\n[[1359.20]] harmoniam. Hinc ipsae dissonantiae gratiam augent, si subito in concordiam aliis\n[[1359.21]] dissonantiis revocentur. Idem est in Symmetria. Hinc jam facile patet Harmoniam\n[[1359.22]] esse perfectionem cogitabilitatis. Nam praecedenti corollario dictum est, perfectius\n[[1359.23]] esse in quo plus est realitatis. Est autem et cogitatio quaedam realitas, tantoque\n[[1359.24]] major quod res quodammodo multiplicantur cogitando, nam Mentes singulae quan-\n[[1360.1]] dam totius mundi repraesentationem continent. Hinc jam perfectior ille est cogitandi\n[[1360.2]] modus, per quem fit ut unus cogitandi actus ad plura simul objecta porrigatur, ita\n[[1360.3]] enim plus est realitatis in illa cogitatione. Hoc autem fit ope Relationum, est enim\n[[1360.4]] relatio quaedam unitas in multis. Et relationum species sunt, nexus et rationes rerum\n[[1360.5]] inter se, proportiones, proportionalitates. Ex quibus omnibus in dato objecto simul\n[[1360.6]] sumtis, resultat harmonia. Quoniam ergo quo plus relationum (quarum aggregatum\n[[1360.7]] harmonia est) in objecto cogitabili est, hoc plus realitatis sive quod idem est perfectionis\n[[1360.8]] est in cogitatione; ideo sequitur Harmoniam esse cogitabilium quatenus\n[[1360.9]] scilicet cogitabilia sunt, perfectionem.\n[[1360.10]] Axioma Magnum\n[[1360.11]] Nihil est sine ratione.\n [[1360.12]] Sive quod idem est, nihil existit, quin ratio reddi possit (saltem ab omniscio) cur sit\n[[1360.13]] potius quam non sit, et cur sic sit potius quam aliter. Unde sequitur nihil per se et\n[[1360.14]] absolute loquendo indifferens esse, indifferentiam rerum nostrae tantum ignorantiae\n[[1360.15]] figmentum esse, quemadmodum et id quod Ethnici fortunam vocabant. At vero,\n[[1360.16]] inquiet aliquis, si nihil sine ratione est, tunc nulla erit prima causa, nullusque ultimus\n[[1360.17]] finis. Respondendum est, nihil quidem esse sine ratione, sed non ideo nihil esse sine\n[[1360.18]] causa. Nam causa est ratio rei extra rem, seu ratio productionis rei: potest vero ratio\n[[1360.19]] rei esse intra rem ipsam. Idque locum habet in illis omnibus quae sunt necessaria,\n[[1360.20]] quemadmodum Veritates mathematicae quae rationem in se ipsis continent; item\n[[1360.21]] Deus, qui solus rerum actualium sibi ipsi ratio est existendi.\n[[1360.22]] Definitiones\n[[1360.23]] <b>Voluntas</b> est sententia de bono et malo.\n [[1360.24]] Hanc ab hominibus Voluntatis nomine intelligi, patet ex loquendi formulis, in quibus\n[[1360.25]] si definitio pro definito substituatur, sensus sibi constabit. Hinc dicimus omnia\n[[1360.26]] appetere bonum, fugere malum. Neminem velle malum sub ratione mali. Volumus\n[[1360.27]] quae bona putamus, et contra quae bona putamus, ea volumus. Si quis autem hanc\n[[1361.1]] notionem voluntatis rejicit, is aliter voce utitur quam homines solent, et fortasse ne\n[[1361.2]] dicere quidem poterit, quid sit velle.\n [[1361.3]] <b>Sententia</b> est cogitatio practica, seu cogitatio cum agendi conatu.\n [[1361.4]] Hoc scilicet discrimen est inter simplicem cogitationem seu considerationem, imaginationem,\n[[1361.5]] repraesentationem, et inter sententiam, quod is qui aliquam sententiam\n[[1361.6]] habet paratus est ad agendum modo aliquo qui sit huic sententiae conformis. Quicunque\n[[1361.7]] persuasus est ignem esse in fornace, non utique manum immittet, quamdiu\n[[1361.8]] mentis atque actionum suarum est compos. Qui credit esse potentissimum atque\n[[1361.9]] sapientissimum actionum suarum censorem, is quamdiu hanc sententiam habet\n[[1361.10]] animo penitus persuaso obversantem certe non peccabit. Unde manifestum est fidem\n[[1361.11]] id est sententiam, sine operibus, id est caritate, sive benefaciendi conatu esse non\n[[1361.12]] posse.\n [[1361.13]] Si quis jam Definitionem Sententiae substituat in definitione Voluntatis, is videbit,\n[[1361.14]] Voluntatem esse cogitationem de bono et malo cum agendi conatu conjunctam, quod\n[[1361.15]] cum illorum expressione consentit, qui dicunt Voluntatem esse ultimum deliberationis.\n[[1361.16]] Est enim deliberatio dubitatio cum inquisitione conjuncta, de bonis et malis\n[[1361.17]] actionis alicujus aut omissionis instantis. Quamdiu deliberamus nondum sumus\n[[1361.18]] parati ad agendum, finita vero inquisitione pariter ac dubitatione, tum demum serio\n[[1361.19]] statuimus quid sit agendum ac eo ipso momento conamur nos ipsos omniaque extra\n[[1361.20]] nos disponere ad actionem.\n [[1361.21]] Si quis vero malit dicere Voluntatem non esse sententiam de bono et malo, sed\n[[1361.22]] ipsum conatum agendi qui ex sententia statim consequitur, cum eo non pugnabo,\n[[1361.23]] modo agnoscat, eum conatum ex sententia oriri. Nam conatus agendi qui non oritur\n[[1361.24]] ex cognitione, brutus est. Qualis est conatus ille descendendi, quem in nobis sentimus,\n[[1361.25]] non ex animi sententia sed ex corporis natura quod grave est.\n[[1361.26]] <tab/>Etiam Deus aliqua bona esse deprehendit; aut aliis meliora.\n [[1361.27]] Nam Deus praeditus est voluntate, voluntas est sub ratione boni.\n [[1361.28]] Aliter: Omnis Dei actio est ex cognitione, omnis actio ex cognitione est voluntaria,\n[[1361.29]] omnis actio voluntaria est alicujus boni vel mali causa.\n [[1361.30]] Aliter: alia aliis perfectiora sunt ut ostendimus supra, ergo scienti (qualis Deus est)\n[[1362.1]] jucundiora <b>per definitionem delectationis.</b> Ergo meliora, nam bonum est\n[[1362.2]] jucundum aut confert ad jucundum. </p>\n<p> [[1362.3]] Dicet aliquis\n [[1362.4]] Deum esse causam rerum, ergo et bonitatis quae est in ipsis. Ergo voluntatem ejus\n[[1362.5]] esse priorem rerum bonitate. - Responsio est facilis. Deum esse causam existentiae\n[[1362.6]] rerum, non vero essentiae, adeoque etiam causa erit existentiae bonorum, non vero\n[[1362.7]] bonitatis quae in ipsa essentia cogitatione deprehenditur. Quemadmodum Deus\n[[1362.8]] causa est ut aliquod triangulum existat, non vero causa est naturae trianguli, neque\n[[1362.9]] proprietatum ejus. Exempli causa absurdum est dicere, Deum circulo (id est figurae\n[[1362.10]] omnia extrema ab uno puncto medio aequidistantia habenti) hoc privilegium\n[[1362.11]] dedisse, ut sit omnium figurarum planarum ejusdem peripheriae (sive quae filo\n[[1362.12]] eodem circumligato comprehendi possunt) capacissima. Habet enim hoc ex natura\n[[1362.13]] sua, et contrarium implicat contradictionem. Si quis vero dicat Deum ipsi circulo\n[[1362.14]] dedisse suam naturam, is profecto nescit quid dicat. Cui enim obsecro? ipsi Circulo,\n[[1362.15]] necesse est ergo Circulum jam esse aliquid et natura quadam praeditum, antequam ei\n[[1362.16]] aliquid detur. Talia ergo dici possunt, sensum autem habent omnino nullum.\n [[1362.17]] Si quis porro insistat hinc sequi Deum non esse causam omnium, respondebo Deum\n[[1362.18]] esse causam omnium quae existunt extra ipsum, non vero esse causam sui intellectus,\n[[1362.19]] nec proinde idearum essentias rerum exhibentium, quae in eo reperiuntur.\n [[1362.20]] Ex omnibus modis possibilibus quibus existere posset Universum seu series rerum, unus\n[[1362.21]] modus perfectissimus est; is nimirum qui reapse existit.\n [[1362.22]] Datur Ens perfectissimum, scilicet Deus (ut nunc pono), perfectissimi autem Entis\n[[1362.23]] perfectissima operatio est, Mundus est opus Dei, perfectissimus ergo Mundus est,\n[[1362.24]] nec proinde alia series rerum fingi potest, quae hac sit perfectior.\n [[1362.25]] Aliter: res tantum habent possibilitatis, quantum realitatis (est enim essentia rosae in\n[[1362.26]] hyeme, idem quod existendi possibilitas), ergo quae plurimum habent possibilitatis,\n[[1363.1]] ea nimirum quae actu existunt, plurimum habent realitatis, id est ex definitione\n[[1363.2]] perfectionis, perfectissima sunt.\n [[1363.3]] Aliter: si non ita est, nec ratio reddi poterit, cur haec potius rerum series existat\n[[1363.4]] quam alia quaevis. Utique enim plures series fingi possunt, neque putandum est\n[[1363.5]] omnia possibilia existere. Quis enim credat nullam fabulam fingi posse quae non\n[[1363.6]] reapse alicubi extiterit aut extitura sit. Ex pluribus autem seriebus unam prae alia\n[[1363.7]] eminere necesse est, alioquin cur ipsa potius existeret quam alia quaevis? Eminebit\n[[1363.8]] autem perfectione; et perfectior eligetur, quia autor rerum Deus utique perfectissimus\n[[1363.9]] est.\n [[1363.10]] Aliter: quoniam aliquid potius existit quam nihil, necesse est in ipsa Essentia, sive\n[[1363.11]] possibilitate aliquid contineri unde existentia actualis sequatur, ac proinde realitatem\n[[1363.12]] sive possibilitatem quandam ad existendum propensionem inferre. Unde quando\n[[1363.13]] plura possibilia sibi obstant, seu quando coexistere non possunt, illud existet quod\n[[1363.14]] plus habet realitatis, sive quod est perfectissimum.\n [[1363.15]] Hae demonstrationes omnes, si quis attentius introspiciat eodem recidunt: ostendunt\n[[1363.16]] enim hanc totam seriem rerum in universo praeteritarum, praesentium et futurarum,\n[[1363.17]] prae aliis possibilibus electam a Deo quoniam perfectissimum sapientissimo non\n[[1363.18]] potuit non placere, et quod placuit potentissimo non potuit non existere.\n [[1363.19]] Quia possibilia quaedam existunt, cum aeque possent non existere, sequitur possibilitatem\n[[1363.20]] esse quandam ad existendum potius quam non existendum dispositionem.\n [[1363.21]] Sic potius: possibilia existentia a non existentibus differre aliquo debent, quod sit\n[[1363.22]] ratio cur ipsa potius quam alia existant. Hoc discrimen debet consistere in aliquo\n[[1363.23]] generalissimo; generalissimum autem possibilium discrimen, est ipse gradus realitatis,\n[[1363.24]] seu quantitas essentiae. Imo duo videntur fingi posse discrimina generalia,\n[[1363.25]] unum quantitas realitatis, alterum quantitas possibilitatis; verum videtur quantitas\n[[1363.26]] realitatis et possibilitatis tantum differre ut aliquod reciprocum, unumquodque enim\n[[1363.27]] quo minus habet realitatis, hoc est facilius. Verum rectius sic ratiocinabimur. Cum\n[[1364.1]] sit aliquid potius quam nihil, necesse est rationem esse majorem existendi potius\n[[1364.2]] quam non existendi. Hoc semel posito reddenda est ratio cur non existant omnia.\n[[1364.3]] Quod cum fieri nequeat, sequitur existere quanta plurima possunt. </p>\n",
  "number": "256₁.",
  "title": "Hauptstück",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:256₁. Hauptstück HAUPTSTÜCK Elementa Verae Pietatis, sive de Amore Dei super omnia Elementa voco, quia certis demonstrationibus nituntur. Pietatis dico, non moralium tantum virtutum. Quia potest aliquis bene vivere humanas tantum ob causas, quales sunt educatio, consuetudo, pax publica, securitas pr...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>