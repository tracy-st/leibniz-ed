---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_169",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 169,
  "text": "<p> [[554.14]] <b>153. VINCENT PLACCIUS AN LEIBNIZ</p>\n<p> [[554.15]] Hamburg, 17. (27.) Juli 1677. [126.166.]</b></p>\n<p> [[554.26]] S. P. Vir Nobilissime et Amplissime, Domine Fautor honoratissime. </p>\n<p> [[555.1]] Communicavit mecum pro familiaritate nostra Tuas ad se scriptas d. 7. Julii litteras,\n[[555.2]] Collega meus longe charissimus Dⁿ^#'u^#'s Henr. Siverus. Ex quibus uti cum gaudio cognovi summo,\n[[555.3]] non esse me parvo apud Te in pretio: ita indolui aliquid a me proficisci potuisse, quod non\n[[555.4]] usque Tibi placere intelligam. Nimirum ingratiis tuis assertum esse Tibi librum tuum scribis: id\n[[555.5]] quod ego minime futurum arbitrabar, quandoquidem et initialibus litteris nominis Tui praefixis,\n[[555.6]] et aliis indiciis, non admodum anxie tibi ut lateres quaesitum esse testabaris, et caussa nulla cur\n[[555.7]] citra noxam non assereretur tibi quod tuum erat apparebat. Absque hoc fuisset, una cum aliis\n[[555.8]] multis ex alterutra caussarum harum, in abdito mihi, quamvis probari possent eruti, relictis,\n[[555.9]] etiam tuos hosce libros recondidissem. Quod vero nugacem libellum eum appellas, eam, mihi\n[[555.10]] crede, modestiam Tuam nimiam, eruditorum haud ulli satis unquam approbabis, utrumvis etiam\n[[555.11]] sive n. 123. sive 131. detectum ex scriptis tuis velis intellectum. Ego sane quo minus doctrinam\n[[555.12]] tuam atque judicii facultatem insignem, aliunde licet magis adhuc conspicuam, vel inde quoque\n[[555.13]] praedicem, atque doctissimum ingeniosissimumque scriptum utrumque, ceu feci, commendem,\n[[555.14]] a me nunquam impetrabo. Quod vero minari me nescio quid insuper scribis, eas si modo minae\n[[555.15]] sint, ex pelvi crede profectas, si lubet. Neque sane unquam refutandi Te nominatim consilium\n[[555.16]] mihi fuit. Aliqua Tuis insistenti humeris latius, ni fallor, clariusque conspecta, publicare in\n[[555.17]] communem usum, et modeste cum aliquibus tuis conferre propositum mihi me habuisse non\n[[555.18]] dissimulabo. Quod tamen ipsum an exequi labores alii magis necessarii, moramque minus\n[[555.19]] ferentes, sint passuri, corpusque valetudinarium valde sit permissurum, vehementer ambigo.\n[[555.20]] Quidquid ejus sit, hoc, postquam adeo vicinum Te nobis atque litterarii commercii non impatientem,\n[[555.21]] intelligo, ultro nunc promitto: nihil me publicaturum ejus argumenti, quod ad Te\n[[555.22]] tuaque pertineat imposterum, nisi per litteras prius id tibi sit indicatum, ut si velis mentem tuam\n[[555.23]] cum mea collatam aperire mihi possis, adeoque privatis ejuscemodi monitionibus mutuis\n[[555.24]] publicae disputationis invidia facile queat evitari. Tu si quid in meis maxime moralibus\n[[555.25]] opusculis emendandum, augendumve notaveris, gratius mihi facere nihil potes, quam si de\n[[555.26]] plurimis commonefacias auditurum Te tanto lubentius, quanto planius pleniusque, in quibus tibi\n[[555.27]] non satisfecerim dederis indicatum. Sane jam olim ego Amicum mihi talem optavi, qualem in\n[[555.28]] Tacito Plinius lib. 7. <i>Ep.</i> 20. se habuisse testatur. Eum hucusque non repertum in Te si possem\n[[555.29]] invenire, profecto mihi serio gratularer. Quamvis enim in Mathematicis ego parum prae tua illa,\n[[556.1]] uti video, accurata scientia cognoverim, attamen in practica philosophia tanto minus desperem\n[[556.2]] tuae curiositati aliquatenus respondere. De Logicis accessionibus quid animo conceperim, ex\n[[556.3]] edito postremis nundinis <i>commentario in Verulamium</i> p. 198 et seqq. conjicies. Quamvis et hac\n[[556.4]] in parte longe plura Tibi ab honoratissimo Collega meo Joh. Vagetio, discipulo Jungiano,\n[[556.5]] Fogeliique successore dignissimo, ac ad ipsius moribundi commendationem nostri collegii\n[[556.6]] totius unanimi voto, precibusque ad superiores devolutis suffecto, promittere possim, ad cujus\n[[556.7]] amicitiam me pararium offero, si prius ad tuam intromittere me non fueris dedignatus. Denique\n[[556.8]] si quid in litterariis rebus Te juvare vel oblectare possim, aut alioquin hac in urbe gratum quid\n[[556.9]] Tibi sit efficere, scito me vehementer ea felicitate gavisurum. Vale. </p>\n<p> [[556.10]] Clariss^#'i et Ampliss^#'i T. Nomin. cultor observantiss^#'u^#'s </p>\n<p> [[556.11]] Hamb. 1677. d. 17. Julii. Vincentius Placcius. </p>\n<p> [[556.12]] Nobilissimo et Amplissimo Dⁿ^#'o Gottfrido Guilielmo Leibnitzio, Seren. Principis Hanoverani\n[[556.13]] Consiliario, Domino et Patrono meo honoratissimo. Hanoverae. </p>\n",
  "number": "153.",
  "title": "VINCENT PLACCIUS AN LEIBNIZ",
  "date": "Hamburg, 17. (27.) Juli 1677. [126.166.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:153. VINCENT PLACCIUS AN LEIBNIZ Hamburg, 17. (27.) Juli 1677. [126.166.] S. P. Vir Nobilissime et Amplissime, Domine Fautor honoratissime. Communicavit mecum pro familiaritate nostra Tuas ad se scriptas d. 7. Julii litteras, Collega meus longe charissimus Dⁿ^#'u^#'s Henr. Siverus. Ex quibus uti cum...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>