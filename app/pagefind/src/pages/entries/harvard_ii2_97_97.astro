          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii2_97","series":"Band II 2 (1686 - 1694)","seq":97,"text":"<p> [[372.9]] <b>98. VINCENT PLACCIUS AN LEIBNIZ</p>\n<p> [[372.10]] Hamburg, 3. (13.) Januar 1691. [85.115.]</b></p>\n<p> [[372.17]] I. N. J. C. </p>\n<p> [[372.18]] Nobilissimo et Amplissimo Dⁿ^#'o G. G. Leibnutzio </p>\n<p> [[372.19]] S. P. D. V. Placcius. </p>\n<p> [[372.20]] Dum <Fn><i>Am Fuß der Seite von Leibniz' Hand</i>: <i>Le Sieur des Essars auteur de l'Amadis françois. Memoire</i> <i>des dames de Brantome.</i> <angle bracket><i>Ch.</i></angle bracket> <i>de la reine Marguerite.</i></Fn> sub anni hujus ineuntis auspicium, quod auspicatissimum plane tibi ex animo precor\n[[372.21]] augurorque, rationes meas, qua domesticas, qua litterarias subduco, video me in aere tuo inde a\n[[372.22]] Septembri mense adhuc esse. Ne malum plane nomen sim itaque, tandem reddo quod debeo\n[[373.1]] responsum, veniam morae a sola tua benevolentia petens. Neque tamen interim in mandatis tuis\n[[373.2]] exequendis aeque ac in rescribendi officio segnis fui. Quamvis enim Meisneri compellandi\n[[373.3]] occasionem hucusque frustra quaesitam necdum invenerim: cum Dⁿ^#'o Zimmermanno tamen\n[[373.4]] illius Collegii membro facile praecipuo et de pertinentibus ad ipsum aliis, et de iis quae super\n[[373.5]] Collegio Arithmetico scribis, ita communicavi, ut non frustra id factum putem. Siquidem laetari\n[[373.6]] mihi visus est, occasione commercium litterarium, et hisce et aliis de rebus Tecum ineundi.\n[[373.7]] Quod an coeptum sit, scire aveam. Ni factum etiam, promoturus, ut quamprimum ineatur. Id\n[[373.8]] quod sine reipublicae litterariae insigni emolumento non fore spero augurorque. Tschirnhausiana\n[[373.9]] legi, et haberem circa illa quae percontarer, siquidem otii hoc tui esse intelligam, ut\n[[373.10]] cognoscas, et sententiam aperias tuam de quaesitis, Logicis quidem potissimum. Nam Physica\n[[373.11]] et Mathematica superant meas vires. Ad Philosophiam practicam vero facientia ex meis facile\n[[373.12]] principiis expedio. Quae uti experior indies magis sufficere magisque resolvendis omnibus in\n[[373.13]] hoc argumento difficultatibus, ita ut perpoliantur, et ad specialissima quaeque, descensu facto,\n[[373.14]] magis porrigantur, assidue laboro. Nec aliud est impedimentum aeque obstans <i>Anonymorum et\n[[373.15]] Pseudonymorum</i> editioni. De quibus apud Bailletum quid fiat, an scias, vel scire possis, oppido\n[[373.16]] percupiam resciscere. Nam anno jam et quod excurrit ab eo litterarum nihil habui, neque novi\n[[373.17]] per internuntios. Et bellorum hae necdum finem ostendentes turbae, parum in propinquo\n[[373.18]] repositum spei sinunt. Nisi tuo itaque auxilio quid comperiam, desperatum hoc est desiderium.\n[[373.19]] Quod tamen antequam expleatur, ad publicandos meos auctores non accedam. Enimvero\n[[373.20]] praeire ipsum mallem me, quam sequi. Caussae multae sunt: quarum praecipuam facile divinas.\n[[373.21]] Vale, et an hac de re certiorem me facere queas, quaeso vide. </p>\n<p> [[373.22]] Hamb 1691. d. 3 Januarii. </p>\n<p> [[373.23]] <i>A Monsieur Monsieur Leibnutz. Conseiller de Son Altesse à Hannover.</i> </p>\n","number":"98.","title":"VINCENT PLACCIUS AN LEIBNIZ","date":"Hamburg, 3. (13.) Januar 1691. [85.115.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>