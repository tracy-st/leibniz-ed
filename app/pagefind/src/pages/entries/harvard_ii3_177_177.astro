---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_177",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 177,
  "text": "<p> [[455.6]] <b>177. LEIBNIZ AN CLAUDE NICAISE</p>\n<p> [[455.7]] Hannover, 24. Juni (4. Juli) 1698. [172.180.]</b></p>\n\n<p> [[456.1]] Hanover ce 24 juin 1698 </p>\n<p> [[456.2]] Monsieur </p>\n<p> [[456.3]] Vous <Fn><i>Am Kopf der Seite</i>: Mons. l'Abbé Nicaise</Fn> aurés receu ma derniere à la quelle je me rapporte et vous diray cependant que j'ay\n[[456.4]] publié ce printemps la Chronique d'<i>Albericus Monachus Trium Fontium</i>, citée si souvent par\n[[456.5]] Messieurs Du Chêne, Le Mire, Blondel, Chiflet, et qui contient tant de belles notices Genealogiques.\n[[456.6]] Comme j'en ay eu un vieux exemplaire Manuscrit, en parchemin, assez bon, et un\n[[456.7]] autre moderne de la Bibliotheque de Wolfenbutel quoyque imparfait; j'en ay pû donner une\n[[456.8]] edition passable; et j'espere que les curieux m'en sçauront quelque gré, parce qu'autrement cet\n[[456.9]] ouvrage seroit peutestre encor demeuré enseveli assez long temps. Il y en avoit un exemplaire\n[[456.10]] dans la Bibliotheque des jesuites du College de Clermont; mais il estoit aussi imparfait que\n[[456.11]] celuy de Wolfenbutel, à ce que le R.P. Hardouin me fit dire. </p>\n<p> [[456.12]] Ce qui m'engage, Monsieur, à vous écrire presentement, est la lettre de Monsieur Ludolphi\n[[456.13]] par laquelle il repond à celle du R.P. Bonjour, que je vous envoye icy jointe vous suppliant\n[[456.14]] de [la luy] faire tenir. </p>\n<p> [[456.15]] On feroit fort bien de faire envoyer à Mons. Ludolphi l'exemplaire Aethiopique qu'il\n[[456.16]] demande, car il n'y a personne qui en puisse faire un meilleur usage que luy; et j'ose joindre\n[[456.17]] mes prieres aux siennes; ayant eu autrefois l'honneur de faire la reverence à l'Eminentissime\n[[456.18]] Cardinal Casanata; et l'ayant trouvé extremement porté à favoriser les connoissances utiles. </p>\n<p> [[456.19]] Nostre sçavant ami, Monsieur Morel a fait une cheute en revenant de la foire de Leipzig,\n[[456.20]] qui l'empeche de se servir de sa main, pour écrire. On espere pourtant à ce qu'il m'a fait écrire,\n[[456.21]] que ce sera sans suite. Je suis avec zele </p>\n<p> [[456.22]] Monsieur vostre tres humble et tres obeissant serviteur Leibniz </p>\n",
  "number": "177.",
  "title": "LEIBNIZ AN CLAUDE NICAISE",
  "date": "Hannover, 24. Juni (4. Juli) 1698. [172.180.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:177. LEIBNIZ AN CLAUDE NICAISE Hannover, 24. Juni (4. Juli) 1698. [172.180.] Hanover ce 24 juin 1698 Monsieur Vous Am Kopf der Seite: Mons. l'Abbé Nicaise aurés receu ma derniere à la quelle je me rapporte et vous diray cependant que j'ay publié ce printemps la Chronique d'Albericus Monachus Trium F...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii3_177","series":"Band II 3 (1695 - 1700)","seq":177,"text":"<p> [[455.6]] <b>177. LEIBNIZ AN CLAUDE NICAISE</p>\n<p> [[455.7]] Hannover, 24. Juni (4. Juli) 1698. [172.180.]</b></p>\n\n<p> [[456.1]] Hanover ce 24 juin 1698 </p>\n<p> [[456.2]] Monsieur </p>\n<p> [[456.3]] Vous <Fn><i>Am Kopf der Seite</i>: Mons. l'Abbé Nicaise</Fn> aurés receu ma derniere à la quelle je me rapporte et vous diray cependant que j'ay\n[[456.4]] publié ce printemps la Chronique d'<i>Albericus Monachus Trium Fontium</i>, citée si souvent par\n[[456.5]] Messieurs Du Chêne, Le Mire, Blondel, Chiflet, et qui contient tant de belles notices Genealogiques.\n[[456.6]] Comme j'en ay eu un vieux exemplaire Manuscrit, en parchemin, assez bon, et un\n[[456.7]] autre moderne de la Bibliotheque de Wolfenbutel quoyque imparfait; j'en ay pû donner une\n[[456.8]] edition passable; et j'espere que les curieux m'en sçauront quelque gré, parce qu'autrement cet\n[[456.9]] ouvrage seroit peutestre encor demeuré enseveli assez long temps. Il y en avoit un exemplaire\n[[456.10]] dans la Bibliotheque des jesuites du College de Clermont; mais il estoit aussi imparfait que\n[[456.11]] celuy de Wolfenbutel, à ce que le R.P. Hardouin me fit dire. </p>\n<p> [[456.12]] Ce qui m'engage, Monsieur, à vous écrire presentement, est la lettre de Monsieur Ludolphi\n[[456.13]] par laquelle il repond à celle du R.P. Bonjour, que je vous envoye icy jointe vous suppliant\n[[456.14]] de [la luy] faire tenir. </p>\n<p> [[456.15]] On feroit fort bien de faire envoyer à Mons. Ludolphi l'exemplaire Aethiopique qu'il\n[[456.16]] demande, car il n'y a personne qui en puisse faire un meilleur usage que luy; et j'ose joindre\n[[456.17]] mes prieres aux siennes; ayant eu autrefois l'honneur de faire la reverence à l'Eminentissime\n[[456.18]] Cardinal Casanata; et l'ayant trouvé extremement porté à favoriser les connoissances utiles. </p>\n<p> [[456.19]] Nostre sçavant ami, Monsieur Morel a fait une cheute en revenant de la foire de Leipzig,\n[[456.20]] qui l'empeche de se servir de sa main, pour écrire. On espere pourtant à ce qu'il m'a fait écrire,\n[[456.21]] que ce sera sans suite. Je suis avec zele </p>\n<p> [[456.22]] Monsieur vostre tres humble et tres obeissant serviteur Leibniz </p>\n","number":"177.","title":"LEIBNIZ AN CLAUDE NICAISE","date":"Hannover, 24. Juni (4. Juli) 1698. [172.180.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>