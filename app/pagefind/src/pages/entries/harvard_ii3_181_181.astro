---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_181",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 181,
  "text": "<p> [[462.8]] <b>181. LEIBNIZ AN CLAUDE NICAISE</p>\n<p> [[462.9]] Hannover, 16./26. September 1698. [180.184.]</b></p>\n\n<p> [[462.17]] Hanover ce 16/26 Septembr. 1698 </p>\n<p> [[462.18]] Pour marquer que je ne suis pas entierement oublié, vous avés eu la bonté, Monsieur, de\n[[462.19]] m'envoyer par Monsieur le Resident Brosseau un petit imprimé d'un arrest rendu contre un\n[[462.20]] certain Curé Quietiste dont je vous remercie. Il est vray qu'à mon avis ces sortes d'Historiettes\n[[462.21]] ne doivent point faire du tort, qu'aux personnes qui y sont interessées, et que ce seroit une\n[[462.22]] grande injustice, si on s'en vouloit servir pour noircir ou decrier Mons. Archeveque de\n[[462.23]] Cambray. Les meilleures choses sont les plus sujettes aux abus; et, c'est l'artifice dont le diable\n[[462.24]] se sert ordinairement pour en eloigner les hommes. Je vous parle sur ce ton, après avoir lû la\n[[462.25]] lettre cyjointe de Mons. Morel, qui parle de tres bon sens là dessus. </p>\n<p> [[463.1]] Mais laissons là les Quietistes et ceux qu'on veut ranger parmi eux; et voyons ce que font\n[[463.2]] les sçavans de France après la paix faite. </p>\n<p> [[463.3]] Il me semble qu'ils se devroient remuer un peu et que la presence de Mons. de Spanhem\n[[463.4]] devroit contribuer à les mettre en humeur. </p>\n<p> [[463.5]] Les lettres de feu Mons. Peiresk ne paroistront elles pas bien tost? </p>\n<p> [[463.6]] Celles de Vargas Espagnol, qui decrient tant le Concile de Trente paroissent maintenant en\n[[463.7]] Hollande traduites en françois avec une preface de Mons. le Vassor autrement le pere le Vassor. </p>\n<p> [[463.8]] On y imprime aussi le <i>dictionnaire</i> de Furetiere augmenté de la moitié. </p>\n<p> [[463.9]] Le Comte de Marsili qui est un des plenipotentiaires pour le traité entre l'Empereur et la\n[[463.10]] porte travaille et fait travailler à une nouvelle Topographie du Danube. </p>\n<p> [[463.11]] J'attends une Replique de vostre pere Bonjour à la reponse de Mons. Ludolphi et je vous\n[[463.12]] supplie de me la faire tenir quand elle arrivera. </p>\n<p> [[463.13]] J'espere au moins que Vous aurés receu cette reponse de Mons. Ludolphi, que je vous ay\n[[463.14]] fait tenir, aussi bien que ma lettre pour Mons. le President Boisot, [dont] je n'ay point appris\n[[463.15]] l'effect. Je vous demande pardon, de vous avoir importuné de ces choses. </p>\n<p> [[463.16]] Au reste je suis avec zele </p>\n<p> [[463.17]] Monsieur vostre tres humble et tres obeissant serviteur Leibniz </p>\n<p> [[463.18]] J'ay esté terriblement embarassé cette année, autrement je n'aurois pas tant tardé de vous\n[[463.19]] importuner de nouveau. </p>\n",
  "number": "181.",
  "title": "LEIBNIZ AN CLAUDE NICAISE",
  "date": "Hannover, 16./26. September 1698. [180.184.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:181. LEIBNIZ AN CLAUDE NICAISE Hannover, 16./26. September 1698. [180.184.] Hanover ce 16/26 Septembr. 1698 Pour marquer que je ne suis pas entierement oublié, vous avés eu la bonté, Monsieur, de m'envoyer par Monsieur le Resident Brosseau un petit imprimé d'un arrest rendu contre un certain Curé Qu...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii3_181","series":"Band II 3 (1695 - 1700)","seq":181,"text":"<p> [[462.8]] <b>181. LEIBNIZ AN CLAUDE NICAISE</p>\n<p> [[462.9]] Hannover, 16./26. September 1698. [180.184.]</b></p>\n\n<p> [[462.17]] Hanover ce 16/26 Septembr. 1698 </p>\n<p> [[462.18]] Pour marquer que je ne suis pas entierement oublié, vous avés eu la bonté, Monsieur, de\n[[462.19]] m'envoyer par Monsieur le Resident Brosseau un petit imprimé d'un arrest rendu contre un\n[[462.20]] certain Curé Quietiste dont je vous remercie. Il est vray qu'à mon avis ces sortes d'Historiettes\n[[462.21]] ne doivent point faire du tort, qu'aux personnes qui y sont interessées, et que ce seroit une\n[[462.22]] grande injustice, si on s'en vouloit servir pour noircir ou decrier Mons. Archeveque de\n[[462.23]] Cambray. Les meilleures choses sont les plus sujettes aux abus; et, c'est l'artifice dont le diable\n[[462.24]] se sert ordinairement pour en eloigner les hommes. Je vous parle sur ce ton, après avoir lû la\n[[462.25]] lettre cyjointe de Mons. Morel, qui parle de tres bon sens là dessus. </p>\n<p> [[463.1]] Mais laissons là les Quietistes et ceux qu'on veut ranger parmi eux; et voyons ce que font\n[[463.2]] les sçavans de France après la paix faite. </p>\n<p> [[463.3]] Il me semble qu'ils se devroient remuer un peu et que la presence de Mons. de Spanhem\n[[463.4]] devroit contribuer à les mettre en humeur. </p>\n<p> [[463.5]] Les lettres de feu Mons. Peiresk ne paroistront elles pas bien tost? </p>\n<p> [[463.6]] Celles de Vargas Espagnol, qui decrient tant le Concile de Trente paroissent maintenant en\n[[463.7]] Hollande traduites en françois avec une preface de Mons. le Vassor autrement le pere le Vassor. </p>\n<p> [[463.8]] On y imprime aussi le <i>dictionnaire</i> de Furetiere augmenté de la moitié. </p>\n<p> [[463.9]] Le Comte de Marsili qui est un des plenipotentiaires pour le traité entre l'Empereur et la\n[[463.10]] porte travaille et fait travailler à une nouvelle Topographie du Danube. </p>\n<p> [[463.11]] J'attends une Replique de vostre pere Bonjour à la reponse de Mons. Ludolphi et je vous\n[[463.12]] supplie de me la faire tenir quand elle arrivera. </p>\n<p> [[463.13]] J'espere au moins que Vous aurés receu cette reponse de Mons. Ludolphi, que je vous ay\n[[463.14]] fait tenir, aussi bien que ma lettre pour Mons. le President Boisot, [dont] je n'ay point appris\n[[463.15]] l'effect. Je vous demande pardon, de vous avoir importuné de ces choses. </p>\n<p> [[463.16]] Au reste je suis avec zele </p>\n<p> [[463.17]] Monsieur vostre tres humble et tres obeissant serviteur Leibniz </p>\n<p> [[463.18]] J'ay esté terriblement embarassé cette année, autrement je n'aurois pas tant tardé de vous\n[[463.19]] importuner de nouveau. </p>\n","number":"181.","title":"LEIBNIZ AN CLAUDE NICAISE","date":"Hannover, 16./26. September 1698. [180.184.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>