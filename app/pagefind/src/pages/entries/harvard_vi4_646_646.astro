---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_646",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 646,
  "text": "[[2802.12]] <b>496₄.  Endgültige Fassung ENDGÜLTIGE FASSUNG\n[[2803.1]] <b>Definitiones</b> <Fn><i>Auf Bl. 33 v^#'o quer</i>: Aphorismi De Felicitate, Sapientia, Caritate, Justitia.</Fn>\n [[2803.2]] <tab/>a <tab/>b </p>\n<p> [[2803.3]] <b>Justitia</b> est <b>charitas sapientis</b>.\n [[2803.4]] <tab/>c\n [[2803.5]] a <b>Charitas</b> est <b>benevolentia</b> generalis.\n [[2803.6]] <tab/>d\n [[2803.7]] c <b>Benevolentia</b> est habitus <b>amoris.</b>\n [[2803.8]] <tab/>e <tab/>f\n [[2803.9]] d <b>Amare</b> aliquem est ejus <b>felicitate delectari</b>.\n [[2803.10]] <tab/>e\n [[2803.11]] b <b>Sapientia</b> est scientia <b>felicitatis</b>.\n [[2803.12]] <tab/>g\n [[2803.13]] e <b>Felicitas</b> est <b>laetitia</b> durabilis.\n [[2803.14]] <tab/>f\n [[2803.15]] g <b>Laetitia</b> est status voluptatum, in quo sensus voluptatis tantus est, ut sensus\n[[2803.16]] doloris prae eo non sit notabilis.\n [[2803.17]] <tab/>h\n [[2803.18]] f <b>Voluptas</b> seu Delectatio est sensus <b>perfectionis</b>, id est sensus cujusdam rei\n[[2803.19]] quae juvat seu quae potentiam aliquam adjuvat.\n [[2803.20]] h <b>Perficitur</b> cujus potentia augetur seu juvatur. <Fn><i>Am Rande</i>: <b>Gloria</b> est <b>fama</b> perfectionis cujusdam. <b>Fama</b> est opinio publica. <b>Amicus</b> est quem prae aliis plerisque amamus seu quem amando distinguimus.</Fn>\n[[2804.1]] <b>Hypothesis</b> alibi demonstrata </p>\n<p> [[2804.2]] <b>Mundus a sapientissimo et potentissimo Monarcha gubernatur</b>,\n[[2804.3]] quem vocamus <b>Deum</b>.\n[[2804.4]] Propositiones </p>\n<p> [[2804.5]] Dei finis sive scopus est laetitia propria seu amor sui. </p>\n<p> [[2804.6]] Deus creaturas et maxime mente praeditas creavit propter gloriam suam, seu amore\n[[2804.7]] sui. </p>\n<p> [[2804.8]] Deus omnia creavit secundum maximam harmoniam sive pulchritudinem possibilem. </p>\n<p> [[2804.10]] Deus amat omnes. </p>\n<p> [[2804.11]] Deus omnibus prodest quantum possibile est. </p>\n<p> [[2804.12]] Neque odium neque ira, neque tristitia, neque invidia in Deum cadit. </p>\n<p> [[2804.13]] Deus amat amari seu amantes sui. </p>\n<p> [[2804.14]] Deus amat mentes pro portione perfectionis quam cuique earum dedit. </p>\n<p> [[2804.15]] Perfectio universi seu Harmonia rerum non patitur omnes mentes esse aeque perfectas. </p>\n<p> [[2804.17]] Quaestio cur Deus huic menti plus quam alteri perfectionis dederit, est ex numero\n[[2804.18]] quaestionum inanium, ut si quaeras utrum pes sit justo major, an calceus pedem urgens\n[[2804.19]] justo minor. </p>\n<p> [[2804.20]] Atque hoc est arcanum cujus ignoratio totam doctrinam de praedestinatione et\n[[2804.21]] justitia Dei obscuravit. </p>\n<p> [[2804.22]] Qui Deo non obedit non est amicus Dei. </p>\n<p> [[2804.23]] Qui Deo obedit metu nondum est amicus Dei. </p>\n<p> [[2804.24]] Qui Deum amat super omnia, is demum amicus Dei est. </p>\n<p> [[2804.25]] Qui non quaerit commune bonum is Deo non obedit. </p>\n<p> [[2804.26]] Qui non quaerit Dei gloriam Deo non obedit. </p>\n<p> [[2805.1]] Qui Dei gloriam simul et commune bonum quaerit Deo obedit. </p>\n<p> [[2805.2]] Qui Deum non agnoscit perfectum, is Deum non satis amat. </p>\n<p> [[2805.3]] Cui aliqua displicent in actis Dei, is Deum non putat perfectum. </p>\n<p> [[2805.4]] Qui putat Deum quaedam facere ex beneplacito absoluto, nullam rationem habente\n[[2805.5]] seu libertate aloga sive indifferente, is Deum non putat perfectum. </p>\n<p> [[2805.6]] Qui putat Deum agere optimo modo possibili, is Deum agnoscit perfectum. </p>\n<p> [[2805.7]] Quisquis contemplatione perfectionis Divinae non delectatur, is Deum non amat. </p>\n<p> [[2805.8]] Omnes creaturae serviunt felicitati seu gloriae Dei pro gradu perfectionis suae. </p>\n<p> [[2805.9]] Quisquis felicitati Dei servit praeter suam voluntatem, is Deum non amat. </p>\n<p> [[2805.10]] Quisquis felicitatem suam collocat in relatione Divinae felicitatis ad se, is demum\n[[2805.11]] Deum amat. </p>\n<p> [[2805.12]] Qui Deum amat, discere conatur ejus voluntatem. </p>\n<p> [[2805.13]] Qui Deum amat, ejus voluntati obedit. </p>\n<p> [[2805.14]] Qui Deum amat, amat omnes. </p>\n<p> [[2805.15]] Quisquis est sapiens amat omnes. </p>\n<p> [[2805.16]] Quisquis est sapiens amat omnes. </p>\n<p> [[2805.17]] Omnis sapiens omnibus prodesse conatur. </p>\n<p> [[2805.18]] Omnis sapiens multis prodest. </p>\n<p> [[2805.19]] Omnis sapiens Deo amicus est. </p>\n<p> [[2805.20]] Omnis Dei amicus est felix. </p>\n<p> [[2805.21]] Quo quis sapientior hoc felicior in potentia pari. </p>\n<p> [[2805.22]] Quo quis potentior hoc felicior in sapientia pari. </p>\n<p> [[2805.23]] Omnis sapiens est justus. </p>\n<p> [[2805.24]] Omnis justus est felix. </p>\n",
  "number": "496₄.",
  "title": "Endgültige Fassung",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:496₄. Endgültige Fassung ENDGÜLTIGE FASSUNG Definitiones Auf Bl. 33 v^#'o quer: Aphorismi De Felicitate, Sapientia, Caritate, Justitia. a b Justitia est charitas sapientis. c a Charitas est benevolentia generalis. d c Benevolentia est habitus amoris. e f d Amare aliquem est ejus felicitate delectari...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>