---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_219",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 219,
  "text": "<p> [[673.4]] <b>219. MICHAEL GOTTLIEB HANSCH AN LEIBNIZ</p>\n<p> [[673.5]] Leipzig, 14. Oktober 1707. [216.220.] </b></p>\n<p> [[673.9]] Vir Illustris et Excellentissime, Patrone gratiosissime! </p>\n<p> [[673.10]] Responsionem Excellentiae Tuae ad binas meas hactenus expectavi, sed frustra; non\n[[673.11]] tamen dubito quin illae recte fuerint traditae, de itinere jam ante aliquot hebdomadas ab\n[[673.12]] Excellentia Tua suscepto a Dno Forstero certior factus, indeque Excellentiam Tuam reducem\n[[673.13]] demum litteras meas accepisse suspicor. Librum interim et quod erat pecuniae residuum a\n[[673.14]] Forstero accepi, eoque nomine hoc majores mihi agendae sunt gratiae, quo certiora inde\n[[673.15]] singularis benevolentiae erga tenuitatem meam tale nihil merentem ducere mihi licet argumenta.\n[[673.16]] Donum enim ipsum etsi in se magni sit aestimandum, ejus tamen apud me valor longe\n[[673.17]] maximus est, cum a TE (at quanto viro!) id proficisci cogito. In qua cogitatione defixus non\n[[673.18]] possum non infirmitatem meam agnoscere, idque tantum relictum mihi esse judicare, ut Tuam,\n[[673.19]] Vir Excellentissime, prae aliis mortalibus eminentiam tacito semper cultu venerer, DEUMque\n[[673.20]] immortalem, ut Orbis Eruditus Leibnitium diu habeat, precibus meis fatigare nunquam intermittam. </p>\n<p> [[674.1]] Novi hic parum in Re Literaria: plura aliunde expectamus. Bibliotheca Schambergiana\n[[674.2]] Libris Medicis quam maxime instructa finitis nundinis distrahetur. </p>\n<p> [[674.3]] Ex Anglia Fritschius noster Novi Testamenti accuratam cum variis Lectionibus et Observationibus\n[[674.4]] criticis editionem Andreae Mills, cujus specimen aliquod apud Boernerum meum\n[[674.5]] vidi, nec non Tomum Primum <angle bracket>librorum</angle bracket> LXX jam ad finem perductum, itemque Jamblichum\n[[674.6]] <i>de vita Pythagorae</i> a Ludolpho Kustero (qui nuper in Angliam secessit) notis illustratum\n[[674.7]] propediem se accepturum esse sperat. </p>\n<p> [[674.8]] In vicina Academia Halensi Versio Bibliorum Esthonica hactenus nondum visa typis\n[[674.9]] mandatur, curantibus studiosis quibusdam hunc in finem ab Augustissimo Suecorum Rege eo\n[[674.10]] ablegatis. </p>\n<p> [[674.11]] In Academia Jenensi Morhofii <i>Polyhistor</i> altero fere tanto auctior sub praelo sudat, et in\n[[674.12]] emendando Baylii dictionario toti sunt Celeb. Buddeus et Struvius ad litteram H jam progressi.\n[[674.13]] Hambergerus vero selectas suas disputationes ex. gr. <i>de Opticis oculorum vitiis</i>, <i>de Iride diluvii</i>,\n[[674.14]] <i>de Barometris</i>, <i>de Epochis</i>, <i>de Meritis Germanorum in mathesin</i> etc. conjunctim publicandas\n[[674.15]] curat. </p>\n<p> [[674.16]] Ex Italia etiam novi quid in Anatomicis allatum est. Bononiensium enim medicus quidam\n[[674.17]] Moragni in <i>Adversariis</i> suis <i>Anatomicis</i> Ovarium novum in cervice uteri detexisse dicitur, quod\n[[675.1]] tamen apud nos jam dudum observavit Anatomicus felicissimus mihique amicissimus Dominus\n[[675.2]] D. Naboth Professor Chymiae Extraordinarius. Ut taceam novos musculos in Oesophago et\n[[675.3]] Uvula a Valsalva nuper detectos. Quod superest me et mea studia Excellentiae Tuae quam\n[[675.4]] maxime cupio commendata, qui sum eroque semper </p>\n<p> [[675.5]] Illustris et Excellentissimi Nominis Tui Cultor perpetuus </p>\n<p> [[675.6]] Mich. Gottl. Hanschius </p>\n<p> [[675.7]] Lipsiae d. 14. Octobr. 1707. </p>\n<p> [[675.8]] P. S. B. Carpzovii spartam Avenarium Superintendentem Plaviensem alii, alii Schwertnerum\n[[675.9]] Super. Pirnensem nactum esse ex fama tamen adhuc dubia referunt. Marsiglianum Opus\n[[675.10]] ab Excellentia T[ua] desideratum utut imperfectum a Dn. Menckenio pro 13 gr. denuo impetravi,\n[[675.11]] et una cum reliquis libris Forstero tradidi, a quo pecuniam etiam recte accepi. Vale! </p>\n<p> [[675.12]] A Son Excellence Monseigneur de Leibnitz Conseiller privé de Son Altesse Electorale de\n[[675.13]] Brounswic et Lunebourg etc etc. à Hannover. Par ami que Dieu conduise! </p>\n",
  "number": "219.",
  "title": "MICHAEL GOTTLIEB HANSCH AN LEIBNIZ",
  "date": "Leipzig, 14. Oktober 1707. [216.220.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:219. MICHAEL GOTTLIEB HANSCH AN LEIBNIZ Leipzig, 14. Oktober 1707. [216.220.] Vir Illustris et Excellentissime, Patrone gratiosissime! Responsionem Excellentiae Tuae ad binas meas hactenus expectavi, sed frustra; non tamen dubito quin illae recte fuerint traditae, de itinere jam ante aliquot hebdoma...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>