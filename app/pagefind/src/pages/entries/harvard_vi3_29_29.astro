---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi3_29",
  "series": "Band VI 3 (1672-1676); durchgesehener Nachdruck 1980",
  "seq": 29,
  "text": "[[376.9]] <b>29 Maximes </b> <span>376.9;0:63:029:72       :L:f^</span>.\n[[376.16]] Des Maximes les plus ordinaires du monde, donnent des applications à la morale,\n[[376.17]] assez considerables. Par exemple: c'est une maxime ordinaire, lorsque vous\n[[376.18]] voyez qu'un homme a besoin de vous n'attendez pas qu'il vous prie. Consequence,\n[[377.1]] quand vous entendez qu'un homme conte une histoire, qui est arrivée en vostre\n[[377.2]] presence, n'attendez pas qu'il vous cite, et allez au devant du besoin qu'il peut avoir\n[[377.3]] de vostre témoignage. Item Maxime: il faut jamais se servir des raisons ou la mauvaise\n[[377.4]] consequence est apparente. Consequence: il ne faut pas qu'on cite ses valets\n[[377.5]] pour témoigns, car suspectus est testis domesticus, et cui imperari potest. Pour la\n[[377.6]] precedente j'adjoute une raison pour quoy, il ne faut pas attendre que vostre amy\n[[377.7]] vous cite. Parceque vostre témoignage ne luy sera plus si utile, quand il vous aura cité;\n[[377.8]] car il sera un peu suspect; à cause que vous ne voudriez pas luy donner ny dementi\n[[377.9]] facilement, ny le délaisser au besoin.\n[[377.14]] Il faut tousjours regarder les gens par leur bon costé, excepté, quand on est obligé\n[[377.15]] de s'embarquer avec eux dans quelqu'affaire, car alors il est raisonnable de prendre\n[[377.16]] ses precautions.\n[[377.22]] Il est quelques fois utile que nous souffrions qu'on nous fasse quelque tort dans\n[[377.23]] une matiere de peu de consequence, car si quelque grand y a trempé, cela luy donnera\n[[377.24]] quelque penchant (s'il est d'un bon naturel) à nous faire du bien dans quelque autre\n[[377.25]] rencontre; et on peut menager la chose en sorte, que la seconde soit plus importante à\n[[377.26]] nous, que la premiere.\n[[378.3]] Cavendum est ne his quibus imperamus inutilia ac superflua mandata demus,\n[[378.4]] aut ea minute nimis explicemus, quae ipsi per se judicare debent. Ita enim relaxatur\n",
  "number": "29",
  "title": "Maximes",
  "date": ""
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:29 Maximes 376.9;0:63:029:72 :L:f^. Des Maximes les plus ordinaires du monde, donnent des applications à la morale, assez considerables. Par exemple: c'est une maxime ordinaire, lorsque vous voyez qu'un homme a besoin de vous n'attendez pas qu'il vous prie. Consequence, quand vous entendez qu'un hom...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_vi3_29","series":"Band VI 3 (1672-1676); durchgesehener Nachdruck 1980","seq":29,"text":"[[376.9]] <b>29 Maximes </b> <span>376.9;0:63:029:72       :L:f^</span>.\n[[376.16]] Des Maximes les plus ordinaires du monde, donnent des applications à la morale,\n[[376.17]] assez considerables. Par exemple: c'est une maxime ordinaire, lorsque vous\n[[376.18]] voyez qu'un homme a besoin de vous n'attendez pas qu'il vous prie. Consequence,\n[[377.1]] quand vous entendez qu'un homme conte une histoire, qui est arrivée en vostre\n[[377.2]] presence, n'attendez pas qu'il vous cite, et allez au devant du besoin qu'il peut avoir\n[[377.3]] de vostre témoignage. Item Maxime: il faut jamais se servir des raisons ou la mauvaise\n[[377.4]] consequence est apparente. Consequence: il ne faut pas qu'on cite ses valets\n[[377.5]] pour témoigns, car suspectus est testis domesticus, et cui imperari potest. Pour la\n[[377.6]] precedente j'adjoute une raison pour quoy, il ne faut pas attendre que vostre amy\n[[377.7]] vous cite. Parceque vostre témoignage ne luy sera plus si utile, quand il vous aura cité;\n[[377.8]] car il sera un peu suspect; à cause que vous ne voudriez pas luy donner ny dementi\n[[377.9]] facilement, ny le délaisser au besoin.\n[[377.14]] Il faut tousjours regarder les gens par leur bon costé, excepté, quand on est obligé\n[[377.15]] de s'embarquer avec eux dans quelqu'affaire, car alors il est raisonnable de prendre\n[[377.16]] ses precautions.\n[[377.22]] Il est quelques fois utile que nous souffrions qu'on nous fasse quelque tort dans\n[[377.23]] une matiere de peu de consequence, car si quelque grand y a trempé, cela luy donnera\n[[377.24]] quelque penchant (s'il est d'un bon naturel) à nous faire du bien dans quelque autre\n[[377.25]] rencontre; et on peut menager la chose en sorte, que la seconde soit plus importante à\n[[377.26]] nous, que la premiere.\n[[378.3]] Cavendum est ne his quibus imperamus inutilia ac superflua mandata demus,\n[[378.4]] aut ea minute nimis explicemus, quae ipsi per se judicare debent. Ita enim relaxatur\n","number":"29","title":"Maximes","date":""}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>