---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_631",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 631,
  "text": "[[2765.12]] <b>492₆.  De gradibus debitorum et illicitorum\n[[2765.18]] <petit> <p><i>Der in Kleindruck folgende Text wurde von Leibniz wieder gestrichen</i>:\n[[2765.19]] (De his quae per variarum circumstantiarum concursus debita vel illicita sunt.) </p>\n<p> [[2765.20]] Quicquid est majus malum unius quam bonum alterius id illicitum est.\n [[2765.21]] <tab/>Est enim majus malum societatis per def. ... Ergo per prop. ... per se illicitum est. </p>\n<p> [[2765.22]] Quicquid est majus bonum unius quam malum alterius id debitum est.\n [[2765.23]] <tab/>Est enim majus bonum societatis per def. ... Ergo per prop. ... per se debitum est.</petit>\n[[2766.1]] <tit2><b>De Gradibus Debitorum et Illicitorum</b> </tit2> </p>\n<p> [[2766.2]] Debita (illicita) sunt inter se in ratione bonorum (malorum) quae ex ipsis sequuntur:\n[[2766.3]] caeteris paribus. Debita (illicita) sunt inter se in ratione probabilitatis qua bona (malave)\n[[2766.4]] ex ipsis sequi ponuntur; caeteris paribus. Debita (illicita) sunt inter se in composita\n[[2766.5]] ratione magnitudinis et verisimilitudinis bonorum (malorum) quae ex illis sequuntur. </p>\n<p> [[2766.6]] Si sit ut bonum ad bonum vel malum ad malum ita reciproce verisimilitudo ad\n[[2766.7]] verisimilitudinem, facta ex quibus secutura ponuntur, aeque debita vel aeque illicita sunt.\n [[2766.8]] <tab/> Bona malave aestimanda sunt separatim tum ex magnitudine sua; tum ex\n[[2766.9]] probabilitate. Per praeced. Et, si aequalia sint erunt in ratione probabilitatis,\n[[2766.10]] si aeque probabilia, in ratione magnitudinis. Et si inaequalia et inaequaliter\n[[2766.11]] probabilia sint, erunt in\n[[2766.12]] ratione composita magnitudinis\n[[2766.13]] et probabilitatis.\n[[2766.14]] Ratio autem ex rationibus\n[[2766.15]] reciproce aequalibus composita,\n[[2766.16]] est ratio aequalitatis,\n[[2766.17]] sive si sit <i>a</i> ad <i>b</i> ut <i>c</i> ad <i>d</i> erit productum ex <i>a</i> in <i>d</i> aequale producto ex <i>b</i>\n[[2766.18]] in <i>c</i>. Ut si areae prioris longitudo <i>a</i> verbi gratia <i>6</i> pedum sit dupla ipsius <i>b</i>\n[[2766.19]] longitudinis areae posterioris, 3 pedum. Et <i>c</i> latitudo areae posterioris, 4\n[[2766.20]] pedum, sit dupla ipsius <i>d</i> latitudinis areae prioris, 2 pedum, erit tam areae\n[[2766.21]] prioris quam areae posterioris spatium 12 pedum quadratorum. </p>\n",
  "number": "492₆.",
  "title": "De gradibus debitorum et illicitorum",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:492₆. De gradibus debitorum et illicitorum Der in Kleindruck folgende Text wurde von Leibniz wieder gestrichen: (De his quae per variarum circumstantiarum concursus debita vel illicita sunt.) Quicquid est majus malum unius quam bonum alterius id illicitum est. Est enim majus malum societatis per def...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>