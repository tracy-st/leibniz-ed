---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_631",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 631,
  "text": "[[2765.12]] <b>492₆.  De gradibus debitorum et illicitorum\n[[2765.18]] <petit> <p><i>Der in Kleindruck folgende Text wurde von Leibniz wieder gestrichen</i>:\n[[2765.19]] (De his quae per variarum circumstantiarum concursus debita vel illicita sunt.) </p>\n<p> [[2765.20]] Quicquid est majus malum unius quam bonum alterius id illicitum est.\n [[2765.21]] <tab/>Est enim majus malum societatis per def. ... Ergo per prop. ... per se illicitum est. </p>\n<p> [[2765.22]] Quicquid est majus bonum unius quam malum alterius id debitum est.\n [[2765.23]] <tab/>Est enim majus bonum societatis per def. ... Ergo per prop. ... per se debitum est.</petit>\n[[2766.1]] <tit2><b>De Gradibus Debitorum et Illicitorum</b> </tit2> </p>\n<p> [[2766.2]] Debita (illicita) sunt inter se in ratione bonorum (malorum) quae ex ipsis sequuntur:\n[[2766.3]] caeteris paribus. Debita (illicita) sunt inter se in ratione probabilitatis qua bona (malave)\n[[2766.4]] ex ipsis sequi ponuntur; caeteris paribus. Debita (illicita) sunt inter se in composita\n[[2766.5]] ratione magnitudinis et verisimilitudinis bonorum (malorum) quae ex illis sequuntur. </p>\n<p> [[2766.6]] Si sit ut bonum ad bonum vel malum ad malum ita reciproce verisimilitudo ad\n[[2766.7]] verisimilitudinem, facta ex quibus secutura ponuntur, aeque debita vel aeque illicita sunt.\n [[2766.8]] <tab/> Bona malave aestimanda sunt separatim tum ex magnitudine sua; tum ex\n[[2766.9]] probabilitate. Per praeced. Et, si aequalia sint erunt in ratione probabilitatis,\n[[2766.10]] si aeque probabilia, in ratione magnitudinis. Et si inaequalia et inaequaliter\n[[2766.11]] probabilia sint, erunt in\n[[2766.12]] ratione composita magnitudinis\n[[2766.13]] et probabilitatis.\n[[2766.14]] Ratio autem ex rationibus\n[[2766.15]] reciproce aequalibus composita,\n[[2766.16]] est ratio aequalitatis,\n[[2766.17]] sive si sit <i>a</i> ad <i>b</i> ut <i>c</i> ad <i>d</i> erit productum ex <i>a</i> in <i>d</i> aequale producto ex <i>b</i>\n[[2766.18]] in <i>c</i>. Ut si areae prioris longitudo <i>a</i> verbi gratia <i>6</i> pedum sit dupla ipsius <i>b</i>\n[[2766.19]] longitudinis areae posterioris, 3 pedum. Et <i>c</i> latitudo areae posterioris, 4\n[[2766.20]] pedum, sit dupla ipsius <i>d</i> latitudinis areae prioris, 2 pedum, erit tam areae\n[[2766.21]] prioris quam areae posterioris spatium 12 pedum quadratorum. </p>\n",
  "number": "492₆.",
  "title": "De gradibus debitorum et illicitorum",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:492₆. De gradibus debitorum et illicitorum Der in Kleindruck folgende Text wurde von Leibniz wieder gestrichen: (De his quae per variarum circumstantiarum concursus debita vel illicita sunt.) Quicquid est majus malum unius quam bonum alterius id illicitum est. Est enim majus malum societatis per def...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_vi4_631","series":"Band VI 4 (1677 - 1690)","seq":631,"text":"[[2765.12]] <b>492₆.  De gradibus debitorum et illicitorum\n[[2765.18]] <petit> <p><i>Der in Kleindruck folgende Text wurde von Leibniz wieder gestrichen</i>:\n[[2765.19]] (De his quae per variarum circumstantiarum concursus debita vel illicita sunt.) </p>\n<p> [[2765.20]] Quicquid est majus malum unius quam bonum alterius id illicitum est.\n [[2765.21]] <tab/>Est enim majus malum societatis per def. ... Ergo per prop. ... per se illicitum est. </p>\n<p> [[2765.22]] Quicquid est majus bonum unius quam malum alterius id debitum est.\n [[2765.23]] <tab/>Est enim majus bonum societatis per def. ... Ergo per prop. ... per se debitum est.</petit>\n[[2766.1]] <tit2><b>De Gradibus Debitorum et Illicitorum</b> </tit2> </p>\n<p> [[2766.2]] Debita (illicita) sunt inter se in ratione bonorum (malorum) quae ex ipsis sequuntur:\n[[2766.3]] caeteris paribus. Debita (illicita) sunt inter se in ratione probabilitatis qua bona (malave)\n[[2766.4]] ex ipsis sequi ponuntur; caeteris paribus. Debita (illicita) sunt inter se in composita\n[[2766.5]] ratione magnitudinis et verisimilitudinis bonorum (malorum) quae ex illis sequuntur. </p>\n<p> [[2766.6]] Si sit ut bonum ad bonum vel malum ad malum ita reciproce verisimilitudo ad\n[[2766.7]] verisimilitudinem, facta ex quibus secutura ponuntur, aeque debita vel aeque illicita sunt.\n [[2766.8]] <tab/> Bona malave aestimanda sunt separatim tum ex magnitudine sua; tum ex\n[[2766.9]] probabilitate. Per praeced. Et, si aequalia sint erunt in ratione probabilitatis,\n[[2766.10]] si aeque probabilia, in ratione magnitudinis. Et si inaequalia et inaequaliter\n[[2766.11]] probabilia sint, erunt in\n[[2766.12]] ratione composita magnitudinis\n[[2766.13]] et probabilitatis.\n[[2766.14]] Ratio autem ex rationibus\n[[2766.15]] reciproce aequalibus composita,\n[[2766.16]] est ratio aequalitatis,\n[[2766.17]] sive si sit <i>a</i> ad <i>b</i> ut <i>c</i> ad <i>d</i> erit productum ex <i>a</i> in <i>d</i> aequale producto ex <i>b</i>\n[[2766.18]] in <i>c</i>. Ut si areae prioris longitudo <i>a</i> verbi gratia <i>6</i> pedum sit dupla ipsius <i>b</i>\n[[2766.19]] longitudinis areae posterioris, 3 pedum. Et <i>c</i> latitudo areae posterioris, 4\n[[2766.20]] pedum, sit dupla ipsius <i>d</i> latitudinis areae prioris, 2 pedum, erit tam areae\n[[2766.21]] prioris quam areae posterioris spatium 12 pedum quadratorum. </p>\n","number":"492₆.","title":"De gradibus debitorum et illicitorum","date":null}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>