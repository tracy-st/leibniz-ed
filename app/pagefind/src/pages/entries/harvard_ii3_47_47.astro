---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_47",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 47,
  "text": "<p> [[135.6]] <b>47. GERHARD MEIER (HAMBURG) AN LEIBNIZ</p>\n<p> [[135.7]] Hamburg, 14. (24.) Februar 1696. [41.]</b></p>\n\n<p> [[135.12]] Illustris Excellentissimeque Vir, Patrone plurimum colende. </p>\n<p> [[135.13]] Qui <Fn><i>Am Rand oben links wohl von Leibniz' Hand</i>: Mejeri</Fn> proximas reddidit commendatitias, eum consilio juvi, quantum potui. Honesta saltim\n[[135.14]] ac liberali videbatur facie. <i>Specimen historiae</i> anecdotae desiderium apud me concitavit maximum,\n[[135.15]] quippe qui sic me totum dedi Theoreticis, ut historica tamen habere in deliciis non\n[[135.16]] desinam. Epistolam quoque Historicam, ceu indicium benevolentiae luculentissimum, fui exosculatus.\n[[135.17]] <i>Consequentiae</i> <i>a rectis ad obliqua</i> demonstrandi rationem abs Tua Excellentia excogitatam\n[[135.18]] memini me oculis quondam usurpasse, verum tunc temporis nescio quibus negotiis\n[[135.19]] districtus eam in meos referre codicillos neglexi, quae nunc una cum ceteris Vagetianis Vulcano\n[[135.20]] cesserit. Weigelius Mathematum Professor Jenensis haud adeo pridem nos invisit, atque suis de\n[[136.1]] Schola Virtutis consiliis Nob. Dn. Placcium in suam pertraxit sententiam, quippe qui perpetuum\n[[136.2]] inter Weigelii <i>tugendschul</i> suamque Semeioticam parallelismum, adeo ut singulae paragraphi\n[[136.3]] hujus ex illa possint illustrari, depraehendisse sibi videtur. Nunc Havniae degit brevi ad\n[[136.4]] nos reversurus Weigelius. Eodem Nob. Placcio auctore ac instigatore novum in me suscepi onus\n[[136.5]] conscribendae Hamburgensis Gymnasii Historiae. Obrutus collegiis ante Paschatos festum ne\n[[136.6]] minimam quidem huic instituto dicare possum cogitatiunculam, dein manum admoturus operi,\n[[136.7]] modo licuerit subsidia conquirere suffectura. Bibliotheca nostra nunc demum justis exornabitur\n[[136.8]] indicibus, quos iri impressum non doleo, quandoquidem thesaurus alioquin absconditus foret,\n[[136.9]] etiamsi selectioribus libris non esse instructam nobilissimi emporii Bibliothecam exteri sint\n[[136.10]] demiraturi. D. Mayerus bina luci exponet scripta. Alterum de Pietistis Veteris Ecclesiae:\n[[136.11]] Alterum de [Bellarmino] malae fidei postulato a fidei sociis. Deus Te servet, Vir illustris, in Rei\n[[136.12]] Literariae emolumentum. Quae votorum summa est </p>\n<p> [[136.13]] Tuae illustri Excellentiae deditissimi Gerh. Mejeri.\n [[136.14]] L. P.P. </p>\n<p> [[136.15]] Hamburgi A. XCVI. XIV. Febr. </p>\n<p> [[136.16]] Illustri Summoque Viro Dn. Godofrido Guilielmo Leibnitio Potentissimi Electoris Consiliario\n[[136.17]] etc. Patrono meo plurimum colendo. <b>Hanoveram</b>. Francò. </p>\n",
  "number": "47.",
  "title": "GERHARD MEIER (HAMBURG) AN LEIBNIZ",
  "date": "Hamburg, 14. (24.) Februar 1696. [41.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:47. GERHARD MEIER (HAMBURG) AN LEIBNIZ Hamburg, 14. (24.) Februar 1696. [41.] Illustris Excellentissimeque Vir, Patrone plurimum colende. Qui Am Rand oben links wohl von Leibniz' Hand: Mejeri proximas reddidit commendatitias, eum consilio juvi, quantum potui. Honesta saltim ac liberali videbatur fac...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>