---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_106",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 106,
  "text": "<p> [[302.10]] <b>92. ALBERT VON HOLTEN AN LEIBNIZ</p>\n<p> [[302.11]] Tübingen, 18. (28.) November 1671. [102.]</b></p>\n<p> [[302.20]] Vir Excellentiss. Amice Colende S. </p>\n<p> [[302.21]] Ut scriberem ad Te aliquid literarum duplicem causam habui, altera est, quod nonnemo\n[[302.22]] Professorum Tubingensium a me postulavit, ut si mihi intercederet cum aliquo Londinensium\n[[302.23]] literarum quoddam commercium, ab illo peterem, ut Londini inquireret, an libri quos inclusa\n[[302.24]] scheda exhibet, ibi prostent venales. Jam cum mihi quidem nulla, nisi per Te, detur copia, petito\n[[302.25]] huic Doctissimi viri satisfaciendi, ideoque rogo obnixissime, ut velis hanc schedam ad aliquem\n[[302.26]] tuorum amicorum ablegare, quo is eorum librorum, quotquot istic reperientur, pretium percontetur,\n[[302.27]] quod ad te perscriptum cum fuerit, spero te pro nostra amicitia me de ea re sine mora\n[[303.1]] certiorem facturum. Altera causa scriptionis mihi fuit, ut deliberarem tecum, an consultum\n[[303.2]] putes, me, cum Grammaticam meam Hebraicam in cylindris exhibitam edere parem, inventum\n[[303.3]] hoc Societati Regiae Anglicanae dedicare. Ut id cupiam plures habeo rationes, praecipue ut hoc\n[[303.4]] pacto et Regi, et multis Doctissimis ac Illustribus viris innotescam. Quod si tibi videbitur, velim\n[[303.5]] quam proxime ad me perscribas, quo titulo compellandi sint tum Rex, tum ipsum illud Societatis\n[[303.6]] Collegium Eminentissimum. Puto inventum novitate sua et concinnitate non indignum fore\n[[303.7]] tantis patronis. Forma externa oper[is] non parum habebit splendoris, quando convenienter\n[[303.8]] emblemati exhibebitur arca cui incumbunt duo cherubini inaurati; intus vero apparebunt\n[[303.9]] cylindri illi versatiles, et in operculo Decalogus punctationis Hebraicae, respondens numero,\n[[303.10]] praeceptorum Mosaicorum, in ventre arcae addito libello, cui titulum feci <i>lex Linguae Sanctae</i>,\n[[303.11]] ubi omnia Emblemati, quod de arca foederis sumptum est, exacte respondent. Mitto hic\n[[303.12]] lapidarium quoddam quod, quia arbitrabar nondum ad tuas manus pervenisse, communicare\n[[303.13]] volui: tu contra vide sis, ut mihi catalogum manuscriptorum Aethiopicorum Wanslebii dudum\n[[303.14]] promissum transmittas. Rogo etiam, ut amplius cum Zunnero agas, de editione Commentarii\n[[303.15]] Abarbenelis in Jonam a me versi. Wanslebii Relationem de Aegypto videre gestio, proximis\n[[303.16]] nundinis Francofurtensibus dabitur forsitan illius potiundae copia. Spinos[a] Judaeus, ut mali\n[[303.17]] ominis nomen gerit, ita pessimi exempli rem ausus est, et merito suo vapulabit a doctis.\n[[303.18]] Pfeiffero eum prima quavis occasione propinabo excarnificandum, si ille non renuit. Interim\n[[303.19]] vale, et rescribe si molestum non est, ad ea, quae a te scire percupio. </p>\n<p> [[303.20]] Tubingae Anno 1671. d. 18. Novembris. T. T. Albertus ab Holten. </p>\n<p> [[303.21]] Viro Nobilissimo, Excellentissimo, Doctissimoque Dn. Gothofredo Guilielmo Leibnizio\n[[303.22]] J.U.D. amico ac Patrono Colendo pateant. Mogunziae. </p>\n",
  "number": "92.",
  "title": "ALBERT VON HOLTEN AN LEIBNIZ",
  "date": "Tübingen, 18. (28.) November 1671. [102.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:92. ALBERT VON HOLTEN AN LEIBNIZ Tübingen, 18. (28.) November 1671. [102.] Vir Excellentiss. Amice Colende S. Ut scriberem ad Te aliquid literarum duplicem causam habui, altera est, quod nonnemo Professorum Tubingensium a me postulavit, ut si mihi intercederet cum aliquo Londinensium literarum quodd...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>