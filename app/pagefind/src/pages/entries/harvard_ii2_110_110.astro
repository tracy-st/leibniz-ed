---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_110",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 110,
  "text": "<p> [[411.8]] <b>111. LEIBNIZ AN GERHARD MEIER (BREMEN)</p>\n<p> [[411.9]] [Hannover, Ende April 1691.] [108.175.]</b></p>\n<p> [[411.17]] Ex responso: </p>\n<p> [[411.18]] Miror a quoquam posse quaeri utrum Cartesii philosophia a rei mathematicae imperito\n[[411.19]] intelligi possit, cum ipse Cartesius aliquoties sit professus suam physicam nihil aliud esse quam\n[[411.20]] ipsissimam Geometriam, id est scientiam de magnitudine, figura et motu rebus applicatam. Est\n[[411.21]] autem physica utique potissima et utilissima philosophiae Cartesianae pars, cum in Metaphysicis,\n[[411.22]] Ethicis et Logicis nihil magnopere novum mihi quidem praestitisse videatur. </p>\n<p> [[411.23]] Systemata in usum scholarum propterea comparata esse debent, ut juvenes ad rerum\n[[411.24]] pariter et bonorum autorum notitiam manu ducantur, et cum Theologi, IC^#'t^#'i et Medici receptam\n[[411.25]] philosophiam in usum suum transtulerint, eam velut basin esse debere censeo, nec veteris\n[[411.26]] doctrinae arcem demoliendam aut a fundamentis disjiciendam, sed potius ornandam novis\n[[411.27]] structuris, pavimentis, tabulatis, picturis, signis, hortis, fontibus. Qui secus faciet ille et veteribus\n[[411.28]] carebit, et nova non satis assequetur. Ipse certe Cartesius quantus quantus est ex veterum\n[[411.29]] lectione factus est, quamvis id callide dissimularit, sed prodit id ipse stylus, ut Huetius recte\n[[411.30]] animadvertit. Multis quoque annis Flexiae apud Jesuitas literis operam dedisse, et omnino\n[[412.1]] multae lectionis hominem fuisse scimus. Et vero ut quod res est dicam, mihi ridiculum videtur\n[[412.2]] novam quandam philosophiam aut sectam animo concipere quae Cartesiana appelletur. Praestat\n[[412.3]] potissimas quasque veritates ordine tradere undecunque excerptas laudatis tamen primis autoribus.\n[[412.4]] Cum Cartesius ipse sua pleraque ex veteribus sublegerit, utique juventus ad fontes\n[[412.5]] ducenda est. Recentiores quoque alii praeclara habent, quae a Cartesio frustra quaeras. Denique\n[[412.6]] duo sunt genera hominum qui discliplinis dant operam. Alii superficiariam quandam cognitionem\n[[412.7]] quaerunt, fere notitia vocabulorum technicorum sunt contenti et vetera ac recepta magis\n[[412.8]] quam nova et paucis cognita requirent, alii ad intima veritatis penetrare contendunt, hos uni\n[[412.9]] autori mancipari servile est, et profectibus inimicum. Unde etiam factum est, ut puri puti\n[[412.10]] Cartesiani nihil novi invenerint merosque egerint magistri paraphrastas exemplo Scholasticorum\n[[412.11]] etc. </p>\n<p> [[412.12]] P. S. Si quis pergeret philosophiam Cartesianam Methodo Mathematica tradere, quemadmodum\n[[412.13]] coepit Spinosa, is operae pretium faceret; eo scilicet modo quo peculiari libello coepit\n[[412.14]] Spinosa. Ita enim velut veste sermonis detracta apparet ubinam doctrina adhuc laboret, ac\n[[412.15]] stabilimento, atque etiam emendatione indigeat. </p>\n",
  "number": "111.",
  "title": "LEIBNIZ AN GERHARD MEIER (BREMEN)",
  "date": "[Hannover, Ende April 1691.] [108.175.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:111. LEIBNIZ AN GERHARD MEIER (BREMEN) [Hannover, Ende April 1691.] [108.175.] Ex responso: Miror a quoquam posse quaeri utrum Cartesii philosophia a rei mathematicae imperito intelligi possit, cum ipse Cartesius aliquoties sit professus suam physicam nihil aliud esse quam ipsissimam Geometriam, id ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>