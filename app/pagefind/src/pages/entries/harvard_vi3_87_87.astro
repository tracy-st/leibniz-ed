---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi3_87",
  "series": "Band VI 3 (1672-1676); durchgesehener Nachdruck 1980",
  "seq": 87,
  "text": "[[587.15]] <b>87. De existentia </b> <span>587.15;0:63:087:76?      :L:l^</span>.\n[[587.16]] quam aliter non intelliges. Aggregatum omnium Requisitorum corporis cuiuslibet\n[[587.17]] dati, extra corpora est. Aggregatum omnium requisitorum unius corporis, et aggregatum\n[[587.18]] omnium requisitorum alterius est in uno eodemque. Illud unicum quodcunque\n[[587.19]] sit est ultima ratio rerum. Nam quod de corporibus, idem de aliis quibuscunque\n[[587.20]] verum est, quae non existunt necessario, seu in quibus ipsis non est ratio existendi.\n[[587.21]] Ens necessarium non nisi unicum est. Ens necessarium in se omnium rerum requisita\n[[587.22]] continere. Ens necessarium agere in se ipsum, sive cogitare. Nihil aliud enim cogitare\n[[587.23]] quam se sentire. Ens necessarium agere per simplicissima. Nam ex infinitis possibilibus\n[[587.24]] sunt quaedam simplicissima, sed simplicissima quae plurimum praestant. Cuius\n[[588.1]] rei ratio est, quia nulla est ratio quae caetera determinet. Harmonia hoc ipsum est,\n[[588.2]] simplicitas quaedam in multitudine. Et in eo consistit pulchritudo et voluptas. Itaque\n[[588.3]] res existere idem est, quod a Deo intelligi optimas, sive maxime harmonikas. Existentiae\n[[588.4]] ideam nullam habemus, quam ut res intelligamus sentiri. Nec alia esse potest,\n[[588.5]] quia existentia in ipsa (essentia) nisi necessariorum non includitur. Sine sentientibus\n[[588.6]] nihil existeret. Sine uno primo sentiente, quod idem et causa rerum est nihil sentiretur.\n[[588.7]] Exigit harmonia rerum, ut essent in corporibus quae agerent in se ipsa. De\n[[588.8]] natura entis in se ipsum agentis. Agit per simplicissima; in eo enim est harmonia, ubi\n[[588.9]] semel coepit, aeternum est. Eorum quae sensit egitque in eo ideae sunt, ut in Deo, nisi\n[[588.10]] quod in Deo omnium et simul. Mens nullius unquam rei obliviscitur, quia ideae in\n[[588.11]] ipsa mente sunt indelebiles. Motus semel datus necessario continuatur. Cogitatio seu\n[[588.12]] sensus sui, seu actio in seipsum necessario continuatur sed agentis in seipsum actionem\n[[588.13]] in corpus nondum video necessario continuari; quod autem continuatur, oritur\n[[588.14]] ex harmonia rerum; id est a Dei voluntate. Miracula agi ope Mentium quarundam.\n[[588.15]] Mentes quasdam singulariter uniri posse Deo, quibus scilicet detur actio perfecta\n[[588.16]] secundum rationem: Et corporibus earum tanta motus vis, ut a circumfusis separari\n[[588.17]] non possunt.\n",
  "number": "87.",
  "title": "De existentia",
  "date": ""
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:87. De existentia 587.15;0:63:087:76? :L:l^. quam aliter non intelliges. Aggregatum omnium Requisitorum corporis cuiuslibet dati, extra corpora est. Aggregatum omnium requisitorum unius corporis, et aggregatum omnium requisitorum alterius est in uno eodemque. Illud unicum quodcunque sit est ultima r...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_vi3_87","series":"Band VI 3 (1672-1676); durchgesehener Nachdruck 1980","seq":87,"text":"[[587.15]] <b>87. De existentia </b> <span>587.15;0:63:087:76?      :L:l^</span>.\n[[587.16]] quam aliter non intelliges. Aggregatum omnium Requisitorum corporis cuiuslibet\n[[587.17]] dati, extra corpora est. Aggregatum omnium requisitorum unius corporis, et aggregatum\n[[587.18]] omnium requisitorum alterius est in uno eodemque. Illud unicum quodcunque\n[[587.19]] sit est ultima ratio rerum. Nam quod de corporibus, idem de aliis quibuscunque\n[[587.20]] verum est, quae non existunt necessario, seu in quibus ipsis non est ratio existendi.\n[[587.21]] Ens necessarium non nisi unicum est. Ens necessarium in se omnium rerum requisita\n[[587.22]] continere. Ens necessarium agere in se ipsum, sive cogitare. Nihil aliud enim cogitare\n[[587.23]] quam se sentire. Ens necessarium agere per simplicissima. Nam ex infinitis possibilibus\n[[587.24]] sunt quaedam simplicissima, sed simplicissima quae plurimum praestant. Cuius\n[[588.1]] rei ratio est, quia nulla est ratio quae caetera determinet. Harmonia hoc ipsum est,\n[[588.2]] simplicitas quaedam in multitudine. Et in eo consistit pulchritudo et voluptas. Itaque\n[[588.3]] res existere idem est, quod a Deo intelligi optimas, sive maxime harmonikas. Existentiae\n[[588.4]] ideam nullam habemus, quam ut res intelligamus sentiri. Nec alia esse potest,\n[[588.5]] quia existentia in ipsa (essentia) nisi necessariorum non includitur. Sine sentientibus\n[[588.6]] nihil existeret. Sine uno primo sentiente, quod idem et causa rerum est nihil sentiretur.\n[[588.7]] Exigit harmonia rerum, ut essent in corporibus quae agerent in se ipsa. De\n[[588.8]] natura entis in se ipsum agentis. Agit per simplicissima; in eo enim est harmonia, ubi\n[[588.9]] semel coepit, aeternum est. Eorum quae sensit egitque in eo ideae sunt, ut in Deo, nisi\n[[588.10]] quod in Deo omnium et simul. Mens nullius unquam rei obliviscitur, quia ideae in\n[[588.11]] ipsa mente sunt indelebiles. Motus semel datus necessario continuatur. Cogitatio seu\n[[588.12]] sensus sui, seu actio in seipsum necessario continuatur sed agentis in seipsum actionem\n[[588.13]] in corpus nondum video necessario continuari; quod autem continuatur, oritur\n[[588.14]] ex harmonia rerum; id est a Dei voluntate. Miracula agi ope Mentium quarundam.\n[[588.15]] Mentes quasdam singulariter uniri posse Deo, quibus scilicet detur actio perfecta\n[[588.16]] secundum rationem: Et corporibus earum tanta motus vis, ut a circumfusis separari\n[[588.17]] non possunt.\n","number":"87.","title":"De existentia","date":""}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>