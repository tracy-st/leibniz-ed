    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:139. ARNOLD ECKHARD AN GERHARD WOLTER MOLANUS FÜR LEIBNIZ Rinteln, 29. März (8. April) 1677. [138.140.] Reverendissime et Magnifice Dⁿ^#'e Abbas et Director, Domine et Patrone aeternum venerande. Quod tam doctum tamque amicum (ita enim scribis) mihi adversarium excitare voluisti, gratias eo nomine e...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii1_155","series":"Band II 1 (1663 - 1685)","seq":155,"text":"<p> [[484.7]] <b>139. ARNOLD ECKHARD AN GERHARD WOLTER MOLANUS FÜR LEIBNIZ</p>\n<p> [[484.8]] Rinteln, 29. März (8. April) 1677. [138.140.]</b></p>\n<p> [[484.22]] Reverendissime et Magnifice Dⁿ^#'e Abbas et Director, </p>\n<p> [[484.23]] Domine et Patrone aeternum venerande. </p>\n<p> [[484.24]] Quod tam doctum tamque amicum (ita enim scribis) mihi adversarium excitare voluisti,\n[[484.25]] gratias eo nomine et ago et habeo Tibi ingentes. Ego non putaveram esse in vicinia Virum\n[[484.26]] Mathematum tam peritum, atque hunc esse video. Ideoque in magna felicitatis meae parte\n[[484.27]] putabo, si Viri tam Eruditi amicitiam mihi conciliaveris. Inter alia, quae de rebus Mathematicis\n[[484.28]] praeclare disserit, illud egregium est, quod methodum invenisse se scribit, cujus ope valor\n[[484.29]] radicis incognitae cujusque aequationis in quocunque gradu analytice exprimi possit. Quod\n[[484.30]] inventum vel solum Auctoris memoriam aeternitati consecrabit. Ceterum de rebus Mathematicis\n[[484.31]] facile inter nos conventurum esse video. Neque enim Cartesius omnia, quae potuit, tradere\n[[485.1]] voluit, neque si voluisset, ita tamen tradidisset, ut nihil amplius inveniendum restaret. Illud\n[[485.2]] tamen assentiri Viro Clarissimo nondum possum, quod aut methodum, qua usus fuit Cartesius,\n[[485.3]] imperfectam, aut Archimedem Cartesio praeponendum existimat. Voluit enim Cartesius\n[[485.4]] methodi suae praestantiam unico tantum exemplo declarare, ideoque famosum illud problema,\n[[485.5]] quod <i>Geometriae</i> suae lib. 1. Pappi verbis proponit, cujusque solutionem magno studio Veteres\n[[485.6]] frustra quaesiverant, expediendum sibi sumit. Quod quidem admirabili prorsus via modoque\n[[485.7]] perfecit. Quod si ille in alia quadam Matheseos parte, et ea quidem, quam Archimedes excoluit,\n[[485.8]] ingenii sui specimen aliquod edere voluisset, non dubito quin id aeque egregie fecisset in\n[[485.9]] Archimedea, atque in Apolloniana Mathesi. Ad ea, quae de reliqu<angle bracket>is Philo</angle bracket>sophiae partibus\n[[485.10]] disserit Vir Clarissimus, m<angle bracket>ulta mo</angle bracket>nenda essent. Sed de his propediem, spero, col<angle bracket>loquemur.\n[[485.11]] Et</angle bracket>enim, si Deus volet, futuro die lunae ad vos exc<angle bracket>urrere</angle bracket> constitui. Interim vale, Reverendissime\n[[485.12]] Dⁿ^#'e A<angle bracket>bbas,</angle bracket> et si grave non est, Virum Amplissimum qua<angle bracket>m -</angle bracket>issime meo nomine\n[[485.13]] saluta, faveque </p>\n<p> [[485.14]] Reverendissimae Magnific^#'a^#'e T. Obsequentissimo </p>\n<p> [[485.15]] Rintel. d. 29. Mart. 1677. A. Eckhardo. </p>\n","number":"139.","title":"ARNOLD ECKHARD AN GERHARD WOLTER MOLANUS FÜR LEIBNIZ","date":"Rinteln, 29. März (8. April) 1677. [138.140.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>