---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_107",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 107,
  "text": "<p> [[328.6]] <b>107. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[328.7]] Venedig, 20. September 1705. [106.130.] </b></p>\n<p> [[328.15]] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o </p>\n<p> [[328.16]] L'umanissimo foglio di V. S. Ill^#'m^#'a mi riempie d'un'eccessiva consolatione, per la sicurezza\n[[328.17]] che mi dà nello istesso tempo dell'ottima sua salute, e continuatione del suo stimat^#'m^#'o\n[[328.18]] amore e patrocinio. Non so capire come si sieno smarrite tre altre mie lettere che io per mezo\n[[328.19]] del Sig^#'r^#'e Zanovelli hò trasmesse in varii tempi a V. S. Ill^#'m^#'a. Per il Sig^#'r^#'e Herman io hò fatto\n[[328.20]] quanto hò potuto, e testimonii ne sono questi Eccell^#'m^#'i Riformatori, a quali è nota la mia\n[[328.21]] vigilanza per questo affare, e benche la mutatione de Magistrati abbia molto alterate e sconcertate\n[[328.22]] le cose nondimeno spero che finalmente il Sig^#'r^#'e Herman sara condotto e chiamato alla\n[[328.23]] catedra di Padova col decoro ed utile dovuto al suo singolarissimo merito, ed io lo desidero\n[[328.24]] meco per le sue incomparabili virtù, e perche è strettissimo suo Amico, e ben informato di\n[[328.25]] quella sublime ed ora tanto rinomata Analisi, degnissimo parto della profonda e vasta mente di\n[[328.26]] V. S. Ill^#'m^#'a, quando le cose saranno perfettionate, allora ragguaglierò V. S. Ill^#'m^#'a di quanto hò\n[[328.27]] operato per il Sig^#'r^#'e Herman, il quale è la cagione principale che io ora mi trattengo in Venetia,\n[[329.1]] ove ci vuole una grand^#'m^#'a toleranza per condurre a fine un negotio. La Lettera che ieri ricevei di\n[[329.2]] V. S. Ill^#'m^#'a mi fù consegnata dal Sig^#'r^#'e Cristoforo Antonio Specht, da me non gia amato ma\n[[329.3]] adorato per le sue rarissime qualità, che benche Giovane, mi serve pure d'esemplare e norma\n[[329.4]] per il vivere savio e prudente, dotato egualmente d'un ludicidissimo intendimento ed un\n[[329.5]] incorrotto e soavissimo costume, a questo erudito, e religiosissimo Giovane hò con piena libertà\n[[329.6]] confidato i miei piu intimi e segreti pensieri, per manifestarli a suo tempo a V. S. Ill^#'m^#'a ad\n[[329.7]] oggetto di restituirmi finalmente a quella quiete e tranquillita d'animo, che tanto sospiro, e che\n[[329.8]] mi potrebbe anche molto conferire a coltivare il suo meraviglioso Metodo di geometrizare, e\n[[329.9]] publicare alcune mie operette filosofiche che hanno per principale fondamento la dottrina che\n[[329.10]] V. S. Ill^#'m^#'a un tempo qui mi comunicò. </p>\n<p> [[329.11]] Prego V. S. Ill^#'m^#'a dell'onore de' suoi riveritissimi comandamenti e mi resto </p>\n<p> [[329.12]] Di V. S. Ill^#'m^#'a Oblig^#'m^#'o Div^#'m^#'o S^#'r^#'e vero M. A. Fardella </p>\n<p> [[329.13]] Venetia, 20 Settembre 1705. </p>\n",
  "number": "107.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Venedig, 20. September 1705. [106.130.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:107. MICHEL ANGELO FARDELLA AN LEIBNIZ Venedig, 20. September 1705. [106.130.] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o L'umanissimo foglio di V. S. Ill^#'m^#'a mi riempie d'un'eccessiva consolatione, per la sicurezza che mi dà nello istesso tempo dell'ottima sua salute, e continuation...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>