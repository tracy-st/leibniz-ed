---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_9",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 9,
  "text": "[[25.11]] <b>9.  De iis quae per se concipiuntur September 1677</b>\n [[25.12]] <tab/> September 1677\n[[25.17]] <tit2><b>De iis quae per se concipiuntur</b></tit2>\n [[25.18]] Septembr. 1677 </p>\n<p> [[25.19]] Ipsum <b>esse</b> videtur per se concipi. Ponamus enim concipi per alia, ut <i>a</i> et <i>b</i>, videtur\n[[25.20]] de his ipsum quoque esse posse concipi; quod absurdum est. Existentia ergo est notio\n[[25.21]] incomposita, sive irresolubilis. </p>\n<p> [[26.1]] Quemadmodum existentia per se concipitur, ita videtur etiam per se concipi essentia\n[[26.2]] seu realitas in genere sive possibilitas (vel intelligibilitas). </p>\n<p> [[26.3]] Omnes res habent aliquid commune, ipsam scilicet Essentiam seu realitatem. </p>\n<p> [[26.4]] Omnes res homogeneae sunt quoad essentiam seu realitatem, uti omnia corpora sunt\n[[26.5]] homogenea quoad molem. </p>\n<p> [[26.6]] Discrimen realitatis et essentiae. Eadem est in omnibus realitas, non vero eadem in\n[[26.7]] omnibus rebus essentia. </p>\n<p> [[26.8]] Quoniam realitas in omnibus una, essentia diversa, ideo id in quo distinguuntur non\n[[26.9]] debet continere realitatem, si quidem positivum est. Nam differentia ipsorum <i>A</i> et <i>B</i>\n[[26.10]] contineat, iterum realitatem, ideo non erit differentia mera. Ergo pura seu mera duarum\n[[26.11]] rerum differentia, in qua scilicet nihil sit amplius commune, nullam continebit realitatem\n[[26.12]] absolutam. </p>\n<p> [[26.13]] Brevius et clarius. Sint duae res <i>A, B</i> utique distinctae, assignetur ergo tum quod est\n[[26.14]] in ipsis commune, tum quod est in singulis; seu differentia pura, nihil amplius commune\n[[26.15]] continens. Aio differentiam puram non continere realitatem, quia realitas est aliquid\n[[26.16]] commune quod in differentia pura contineri non debet. Re tamen accurate expensa\n[[26.17]] videtur inesse sophisma ratiocinationi, et postulatum esse impossibile, nam cum omnia\n[[26.18]] quae concipiuntur a nobis sint realia cogitabilia (nihil aliud enim realitas quam cogitabilitas),\n[[26.19]] ideo non debemus postulare ultimam quandam differentiam, in qua nulla insit\n[[26.20]] realitas seu cogitabilitas, nam supposuimus omnibus inesse. Sed hinc porro sequetur nihil\n[[26.21]] a nobis cogitari simplicissimum, saltem enim duo habet, cogitabilitatem, et speciem\n[[26.22]] cogitabilitatis, aliquid scilicet commune et aliquid proprium. Sed in hoc proprio rursus est\n[[26.23]] cogitabilitas. Alioqui non cogitaretur. Ergo hinc sequetur illa duo non esse separanda, nec\n[[26.24]] a nobis cogitari nisi uno actu. </p>\n<p> [[26.25]] Circa subjectum et adjunctum etiam magna est subtilitas. Nos subjectum seu substantiam\n[[26.26]] cogitamus dum dicimus: <i>Ego, ille, hoc</i>, in his enim aliquid commune cogitamus,\n[[26.27]] id est subjectum in corporibus ipsis quoque quasi per prosopopoeiam. Omnis qualitas\n[[26.28]] cogitabilis componitur ex cogitabilitate et subjecto cogitabilitatis. Huic subjecto inest\n[[26.29]] cogitabilitas, sed aliud est cogitabilitas aliud subjectio. Ergo haec subjectio cogitari non\n[[26.30]] potest. </p>\n",
  "number": "9.",
  "title": "De iis quae per se concipiuntur",
  "date": "September 1677"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:9. De iis quae per se concipiuntur September 1677 September 1677 De iis quae per se concipiuntur Septembr. 1677 Ipsum esse videtur per se concipi. Ponamus enim concipi per alia, ut a et b, videtur de his ipsum quoque esse posse concipi; quod absurdum est. Existentia ergo est notio incomposita, sive ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>