---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_226",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 226,
  "text": "[[879.11]] <b>185.  Grammatica [Ende 1687 bis Ende 1688 (?)]</b>\n [[879.12]] <tab/>[Ende 1687 bis Ende 1688 (?)]\n[[880.1]] <tit2><b>Grammatica</b></tit2> </p>\n<p> [[880.2]] Videtur <b>pluralis</b> inutilis in Lingua rationali. </p>\n<p> [[880.3]] <b>Persona</b> accidit etiam nominibus ex sententia Vossii. Nam <i>Titius</i> significat vel <i>ego\n[[880.4]] Titius</i> vel <i>ille Titius.</i> Vocativi semper personae secundae. </p>\n<p> [[880.5]] Variae <b>declinationes</b> inutiles. </p>\n<p> [[880.6]] <b>Comparatio</b> etiam pronominis, ut: <i>ipsissimus.</i> Posset et verbis tribui, ut <i>summe\n[[880.7]] currere, currissimare</i>; si jocari libet. </p>\n<p> [[880.8]] <b>Verbum</b> <i>nota rei sub tempore</i>. Revera: verbum est quod involvit affirmationem aut\n[[880.9]] negationem. Omnia verba activa vel passiva, quae involvunt mutationem, at quae statum\n[[880.10]] significant neutra. Ad activa vel passiva videntur et referri posse, quae negant actionem\n[[880.11]] vel passionem, ut <i>abstineo.</i> </p>\n<p> [[880.12]] Gerundium, <i>studio adeundi patrem</i>, id est <greek>toỹ</greek>: <i>adire patrem.</i> Virgil: <i>pacem Trojano\n[[880.13]] a rege petendum.</i> Patet <i>petendum</i> esse neutrum quasi substantivum, alioqui diceretur\n[[880.14]] <i>petendam.</i> Est ergo participium sua natura adjectivum, sed neutre sumtum. <i>Pacem petendum\n[[880.15]] est</i>, id est <i>pacem petere conveniens vel necessarium est.</i> </p>\n<p> [[880.16]] Supina in eo similia: <i>spectatum ludos</i>, id est ad <greek>tò</greek> <i>spectare ludos.</i> </p>\n<p> [[880.17]] Tempora in verbis accurate explicanda. Casus in nominibus. </p>\n<p> [[880.18]] <i>Facio</i> praesens. <i>Faciebam, cum hoc faciebam, Titius venit.</i> <i>Cum hoc facerem Titius\n[[880.19]] veniebat, cum hoc feceram Titius venit. Cum hoc fecissem Titius veniebat. Feceram</i>\n[[880.20]] activo respondet <i>factum erat</i> passivum. </p>\n<p> [[880.21]] <i>Feci. Facio. Faciam.</i> Praeteritum imperfectum est proprie praesens in tempore\n[[880.22]] aliquo praeterito, <i>faciebam</i>, id est <i>tunc dicere potui: facio.</i> Res omnis reducatur ad\n[[880.23]] Nomina sic: <i>loquens, locutus, locuturus: loquens sum, locutus sum, locuturus sum.\n[[880.24]] Loquens sim, locutus sim, locuturus sim</i>: pro <i>loquor</i>, <i>dixi, loquar. Dicam, faxim, fecero;\n[[880.25]] faxim</i>, id est <greek>péprajaw</greek> <i>sim, fecero</i> id est <i>facturus sim. Loquebar</i>, id est <i>loquens fui;\n[[880.26]] loquerer</i>, id est <i>locutus fuerim. Feceram</i>, <greek>péprajaw</greek> <i>eram</i> seu imperfectum in praeterito\n[[880.27]] vel saltem praeteritum in praeterito: <i>locutus</i> <i>fui</i>, <i>fecissem</i>, id est <greek>péprajaw</greek> <i>essem vel\n[[881.1]] fuerim</i>, saltem. Eodem modo in futuro rursus praesens praeteritum et futurum intelligi\n[[881.2]] potest. Imo et imperfectum aliaque multa comminisci licet, ut peculiare tempus pro\n[[881.3]] <i>locuturus fui</i> seu <i>dicturiebam. Fui</i> et <i>eram</i> nonnihil exactius distinguenda <i>fui</i> <i>Romae</i>, et\n[[881.4]] <i>eram Romae cum hoc fieret</i>. Quantum differunt <i>locutus sum</i>, et <i>locutus fui</i>, tantum\n[[881.5]] differunt: <i>locutum esse</i> et <i>locutum fore.</i> Nota <i>in principio creavit Deus</i>, etc. germanice <i>im\n[[881.6]] anfang schuf.</i> </p>\n<p> [[881.7]] <i>Pater</i> <i>et Chremes reversi</i>, <i>pater et Chremes reversus</i>, utrumque recte Vossius lib. <i>de\n[[881.8]] construct.</i> c. 3. Differentia apud Gallos inter haec duo: <i>il a fait cela</i>, et, <i>il fit cela.</i> </p>\n",
  "number": "185.",
  "title": "Grammatica",
  "date": "[Ende 1687 bis Ende 1688 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:185. Grammatica [Ende 1687 bis Ende 1688 (?)] [Ende 1687 bis Ende 1688 (?)] Grammatica Videtur pluralis inutilis in Lingua rationali. Persona accidit etiam nominibus ex sententia Vossii. Nam Titius significat vel ego Titius vel ille Titius. Vocativi semper personae secundae. Variae declinationes inu...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>