---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi2_4",
  "series": "Band VI 2 (1663-1672); durchgesehener Nachdruck 1990",
  "seq": 4,
  "text": "[[145.34]] <b>34. De baptismo liberorum invitis parentibus </b> <span>145.0;0:62:034:7001-7112:L:l^</span>.\n[[145.1]] Incidit nuper ex tali casu meditatio. Chirurgus nescio quis ad Judaei cujusdam\n[[145.2]] Moguntini infantem periculose decumbentem vocatus, aquam poscit, cum nemo adesset,\n[[145.3]] baptizat puerum in nomine Patris, Filii et Spiritus S. Infans moritur. Judaei re comperta\n[[145.4]] mire indignantur, Chirurgus a se animam Deo assertam gloriatur. Mihi hoc incidit, Canones\n[[145.5]] legesque vetare invitis Judaeis parentibus liberos baptizari. Hoc non facerent, si tam facile\n[[145.6]] iis salutem asseri posse crederent. Ergo hoc ad salutem sufficere non putant. Quid ergo\n[[145.7]] requiritur? an fides parentis? Quid igitur, si ille mortuus, cujus ergo, an tum nullius, ergo\n[[145.8]] deterioris conditionis qui habet, quam non habet. Cujus ergo tum? an omnino eius qui\n[[145.9]] jus regendi habet? Quid si igitur nemo eum habeat, qui jure habeat, sed qui detinet, de\n[[145.10]] facto detineat, an iste infans deterioris conditionis erit. An ille qui detinet? ergo qui Judaeis\n[[145.11]] abripit, puerum baptizat, recte facit, Deo enim vindicat animam thesauris mundi\n[[145.12]] pretiosiorem. Cur ergo leges Canonesque rem tam utilem vetuerunt. Si illae recte vetuerunt,\n[[145.13]] necesse est aliud quiddam requiri, quam baptismum et alterius fidem. Requiritur ergo\n[[145.14]] Baptismus et fides praevisa per scientiam vel absolutam vel mediam, neque aliud quiddam\n[[145.15]] mihi apparet. Nam ubi videt Deus infantem, si superstes esset, crediturum, proficit ei\n[[145.16]] baptismus ad salutem, sin non crediturum, et felicitatis et damnationis expers est, quasi\n[[145.17]] non baptizatus. Et haec ratio est, cur Leges Canonesque Christianorum liberos baptizari\n[[145.18]] tam severe jubeant, Judaeorum vetent, quia credibile est Judaeorum liberos, si praeter\n[[145.19]] baptismum eis tribuatur nihil, in Judaismo educatum iri, et baptismum irritum fore;\n[[145.20]] contra liberos Christianorum Christianos fore praesumitur, neque nisi rarissime aliter\n[[145.21]] contingit. Caeterum eodem haec res fundamento nititur quo praedestinatio. DEus iis\n[[145.22]] salutem dabit, quorum fidem praevidet, quod si igitur intercipiantur mature antequam se\n[[145.23]] fides exerat, nihilominus dabit, ne sine culpa sua tanto bono spolientur. Duo requiruntur:\n[[145.24]] Baptismus et fides B aptizati. Dico: baptizati. Nam ita verba sonant: qui crediderit\n[[145.25]] et baptizatus fuerit, salvus erit. Ejusdem igitur est credere et baptizari. Fides baptizati\n[[145.26]] vel praesens, vel futura, nam praeterita nulla cogitari potest. Praesens in adulto: Futura\n[[145.27]] in infante. Infans aut adolescet, aut immaturus decedet. Si adolescet fides requiritur\n[[145.28]] absolute futura. Si decedet immaturus, fides requiritur sub conditione futura, si nempe\n[[145.29]] viveret. Unde non dicitur: qui credet et baptizabitur salvus erit, sed qui crediderit. Non\n[[145.30]] dicitur ho pisteusyn qui credet, crediturus; sed ho pisteusas, Aoriston seu indefinitum tempus,\n[[146.1]] quod in se haec omnia complectitur: qui credit, credebat, credidit, credet, crederet,\n[[146.2]] crediderit, credidisset, crediturus esset. Breviter: Infanti baptizato morienti eadem felicitas\n[[146.3]] evenit, quae superstiti evenisset. Ita moritur, quasi nondum moreretur. Aut quod fidem\n[[146.4]] infantis morientis post baptismum et salutem attinet, idem evenit quod eveniret, si primo\n[[146.5]] adolescentiae momento moreretur.\n",
  "number": "34.",
  "title": "De baptismo liberorum invitis parentibus",
  "date": ""
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:34. De baptismo liberorum invitis parentibus 145.0;0:62:034:7001-7112:L:l^. Incidit nuper ex tali casu meditatio. Chirurgus nescio quis ad Judaei cujusdam Moguntini infantem periculose decumbentem vocatus, aquam poscit, cum nemo adesset, baptizat puerum in nomine Patris, Filii et Spiritus S. Infans ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_vi2_4","series":"Band VI 2 (1663-1672); durchgesehener Nachdruck 1990","seq":4,"text":"[[145.34]] <b>34. De baptismo liberorum invitis parentibus </b> <span>145.0;0:62:034:7001-7112:L:l^</span>.\n[[145.1]] Incidit nuper ex tali casu meditatio. Chirurgus nescio quis ad Judaei cujusdam\n[[145.2]] Moguntini infantem periculose decumbentem vocatus, aquam poscit, cum nemo adesset,\n[[145.3]] baptizat puerum in nomine Patris, Filii et Spiritus S. Infans moritur. Judaei re comperta\n[[145.4]] mire indignantur, Chirurgus a se animam Deo assertam gloriatur. Mihi hoc incidit, Canones\n[[145.5]] legesque vetare invitis Judaeis parentibus liberos baptizari. Hoc non facerent, si tam facile\n[[145.6]] iis salutem asseri posse crederent. Ergo hoc ad salutem sufficere non putant. Quid ergo\n[[145.7]] requiritur? an fides parentis? Quid igitur, si ille mortuus, cujus ergo, an tum nullius, ergo\n[[145.8]] deterioris conditionis qui habet, quam non habet. Cujus ergo tum? an omnino eius qui\n[[145.9]] jus regendi habet? Quid si igitur nemo eum habeat, qui jure habeat, sed qui detinet, de\n[[145.10]] facto detineat, an iste infans deterioris conditionis erit. An ille qui detinet? ergo qui Judaeis\n[[145.11]] abripit, puerum baptizat, recte facit, Deo enim vindicat animam thesauris mundi\n[[145.12]] pretiosiorem. Cur ergo leges Canonesque rem tam utilem vetuerunt. Si illae recte vetuerunt,\n[[145.13]] necesse est aliud quiddam requiri, quam baptismum et alterius fidem. Requiritur ergo\n[[145.14]] Baptismus et fides praevisa per scientiam vel absolutam vel mediam, neque aliud quiddam\n[[145.15]] mihi apparet. Nam ubi videt Deus infantem, si superstes esset, crediturum, proficit ei\n[[145.16]] baptismus ad salutem, sin non crediturum, et felicitatis et damnationis expers est, quasi\n[[145.17]] non baptizatus. Et haec ratio est, cur Leges Canonesque Christianorum liberos baptizari\n[[145.18]] tam severe jubeant, Judaeorum vetent, quia credibile est Judaeorum liberos, si praeter\n[[145.19]] baptismum eis tribuatur nihil, in Judaismo educatum iri, et baptismum irritum fore;\n[[145.20]] contra liberos Christianorum Christianos fore praesumitur, neque nisi rarissime aliter\n[[145.21]] contingit. Caeterum eodem haec res fundamento nititur quo praedestinatio. DEus iis\n[[145.22]] salutem dabit, quorum fidem praevidet, quod si igitur intercipiantur mature antequam se\n[[145.23]] fides exerat, nihilominus dabit, ne sine culpa sua tanto bono spolientur. Duo requiruntur:\n[[145.24]] Baptismus et fides B aptizati. Dico: baptizati. Nam ita verba sonant: qui crediderit\n[[145.25]] et baptizatus fuerit, salvus erit. Ejusdem igitur est credere et baptizari. Fides baptizati\n[[145.26]] vel praesens, vel futura, nam praeterita nulla cogitari potest. Praesens in adulto: Futura\n[[145.27]] in infante. Infans aut adolescet, aut immaturus decedet. Si adolescet fides requiritur\n[[145.28]] absolute futura. Si decedet immaturus, fides requiritur sub conditione futura, si nempe\n[[145.29]] viveret. Unde non dicitur: qui credet et baptizabitur salvus erit, sed qui crediderit. Non\n[[145.30]] dicitur ho pisteusyn qui credet, crediturus; sed ho pisteusas, Aoriston seu indefinitum tempus,\n[[146.1]] quod in se haec omnia complectitur: qui credit, credebat, credidit, credet, crederet,\n[[146.2]] crediderit, credidisset, crediturus esset. Breviter: Infanti baptizato morienti eadem felicitas\n[[146.3]] evenit, quae superstiti evenisset. Ita moritur, quasi nondum moreretur. Aut quod fidem\n[[146.4]] infantis morientis post baptismum et salutem attinet, idem evenit quod eveniret, si primo\n[[146.5]] adolescentiae momento moreretur.\n","number":"34.","title":"De baptismo liberorum invitis parentibus","date":""}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>