---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_44",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 44,
  "text": "[[108.1]] <b>36₂.  Tabula autorum TABULA AUTORUM\n [[108.2]] Ex quibus condendae definitiones omnium.\n [[108.3]] Vossii <tab/><picture>207</picture> <tab/>Cartesii <tab/><picture>205</picture>\n [[108.4]] Port Royal <tab/> <tab/>Fabri <tab/>\n [[108.5]] Sciopp[ii] <tab/> <tab/>Hobbii <tab/> <tab/> <tab/>Physica\n [[108.6]] Scalig[eri] <tab/> <tab/>Gram[matica] <tab/>Rohault <tab/>\n [[108.7]] Frischlin[i] <tab/> <tab/>Le Grand <tab/>\n [[108.8]] Neand[ri] <tab/>\n [[108.9]] Keiman[ni] <tab/>\n [[108.10]] Jungii <tab/><picture>202</picture> <tab/> Logica <tab/>Cartesii <tab/><picture>204</picture>\n [[108.11]] Fabri <tab/>Fabri <tab/> Metaphysica\n [[108.12]] <tab/>Spinosae </p>\n<p> [[108.13]] <tab/>Hobbii\n [[109.1]] Euclidis <tab/><picture>205</picture> <tab/>Kepler <tab/><picture>205</picture>\n [[109.2]] Stofleri puto. <tab/>Taquet\n [[109.3]] Barrovii <tab/>Geometria <tab/>Ubaldi problem[ata] <tab/>Astron[omia]\n [[109.4]] Greg[orii] a S. Vinc. <tab/>Ricciol[i]\n [[109.5]] Arnaldi <tab/>Mercat[or]\n [[109.6]] Elemens du plein chant <tab/><picture>205</picture> <tab/>Viet[ae] <tab/><picture>203</picture>\n [[109.7]] Birchensha quando prodibit <tab/>Diophant[i] <tab/>[Arithmetica]\n [[109.8]] Mercat[oris] quando prodibit <tab/>Musica <tab/>Collins.\n [[109.9]] Cartes[ii]\n [[109.10]] Glareani <tab/>Vitruvii <tab/><picture>202</picture> <tab/> Architecton[ice] </p>\n<p> [[109.11]] <tab/>Perralti\n [[110.1]] Mariotti quando prodibit <tab/><picture>205</picture> <tab/>Stevini <tab/><picture>206</picture>\n [[110.2]] Fabri <tab/>Pascal[ii]\n [[110.3]] Kohlhans <tab/>Optica <tab/>Boyl[ii] <tab/> Mechanica\n [[110.4]] Kepleri <tab/>Hugen[ii]\n [[110.5]] Cherubin <tab/>Wallis[ii] </p>\n<p> [[110.6]] <tab/>Mariott[i]\n [[110.7]] Septalii <tab/><picture>208</picture> <tab/>Aristot[elis] <tab/><picture>207</picture>\n [[110.8]] Coleri. Serres <tab/>Claramontii\n [[110.9]] <i>Hausbücher</i> <tab/>Spinos[ae] </p>\n<p> [[110.10]] ex variis linguis <tab/> Oeconom[ia] <tab/>Hobb[ii] <tab/>Ethica\n [[110.11]] Architecton. <tab/>Cardani\n [[110.12]] <i>Financen, Commercien</i>, <tab/>Campanell[ae]\n [[110.13]] Bech[er] etc. <tab/>Felden[ii]\n [[110.14]] <i>Bergsachen</i>,\n [[111.1]] Cardan[i] <tab/><picture>208</picture> <tab/>Histor[ia]\n [[111.2]] Conring[i] <tab/>Antiquitates\n [[111.3]] Hobb[ii]\n [[111.4]] Grot[ii] <tab/> Polit[ica] <tab/>Ius civil[e]\n [[111.5]] Limn<angle bracket>aei</angle bracket> <tab/> canon[icum]\n [[111.6]] Les Estats de France <tab/>Theol[ogia] moral[is] </p>\n<p> [[111.7]] Angleterre etc. <tab/> Scholast[ica]\n [[111.8]] S. Marthe <tab/> Controvers. </p>\n",
  "number": "36₂.",
  "title": "Tabula autorum",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:36₂. Tabula autorum TABULA AUTORUM Ex quibus condendae definitiones omnium. Vossii 207 Cartesii 205 Port Royal Fabri Sciopp[ii] Hobbii Physica Scalig[eri] Gram[matica] Rohault Frischlin[i] Le Grand Neand[ri] Keiman[ni] Jungii 202 Logica Cartesii 204 Fabri Fabri Metaphysica Spinosae Hobbii Euclidis 2...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>