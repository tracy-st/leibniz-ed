---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:36₂. Tabula autorum TABULA AUTORUM Ex quibus condendae definitiones omnium. Vossii 207 Cartesii 205 Port Royal Fabri Sciopp[ii] Hobbii Physica Scalig[eri] Gram[matica] Rohault Frischlin[i] Le Grand Neand[ri] Keiman[ni] Jungii 202 Logica Cartesii 204 Fabri Fabri Metaphysica Spinosae Hobbii Euclidis 2...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_vi4_44","series":"Band VI 4 (1677 - 1690)","seq":44,"text":"[[108.1]] <b>36₂.  Tabula autorum TABULA AUTORUM\n [[108.2]] Ex quibus condendae definitiones omnium.\n [[108.3]] Vossii <tab/><picture>207</picture> <tab/>Cartesii <tab/><picture>205</picture>\n [[108.4]] Port Royal <tab/> <tab/>Fabri <tab/>\n [[108.5]] Sciopp[ii] <tab/> <tab/>Hobbii <tab/> <tab/> <tab/>Physica\n [[108.6]] Scalig[eri] <tab/> <tab/>Gram[matica] <tab/>Rohault <tab/>\n [[108.7]] Frischlin[i] <tab/> <tab/>Le Grand <tab/>\n [[108.8]] Neand[ri] <tab/>\n [[108.9]] Keiman[ni] <tab/>\n [[108.10]] Jungii <tab/><picture>202</picture> <tab/> Logica <tab/>Cartesii <tab/><picture>204</picture>\n [[108.11]] Fabri <tab/>Fabri <tab/> Metaphysica\n [[108.12]] <tab/>Spinosae </p>\n<p> [[108.13]] <tab/>Hobbii\n [[109.1]] Euclidis <tab/><picture>205</picture> <tab/>Kepler <tab/><picture>205</picture>\n [[109.2]] Stofleri puto. <tab/>Taquet\n [[109.3]] Barrovii <tab/>Geometria <tab/>Ubaldi problem[ata] <tab/>Astron[omia]\n [[109.4]] Greg[orii] a S. Vinc. <tab/>Ricciol[i]\n [[109.5]] Arnaldi <tab/>Mercat[or]\n [[109.6]] Elemens du plein chant <tab/><picture>205</picture> <tab/>Viet[ae] <tab/><picture>203</picture>\n [[109.7]] Birchensha quando prodibit <tab/>Diophant[i] <tab/>[Arithmetica]\n [[109.8]] Mercat[oris] quando prodibit <tab/>Musica <tab/>Collins.\n [[109.9]] Cartes[ii]\n [[109.10]] Glareani <tab/>Vitruvii <tab/><picture>202</picture> <tab/> Architecton[ice] </p>\n<p> [[109.11]] <tab/>Perralti\n [[110.1]] Mariotti quando prodibit <tab/><picture>205</picture> <tab/>Stevini <tab/><picture>206</picture>\n [[110.2]] Fabri <tab/>Pascal[ii]\n [[110.3]] Kohlhans <tab/>Optica <tab/>Boyl[ii] <tab/> Mechanica\n [[110.4]] Kepleri <tab/>Hugen[ii]\n [[110.5]] Cherubin <tab/>Wallis[ii] </p>\n<p> [[110.6]] <tab/>Mariott[i]\n [[110.7]] Septalii <tab/><picture>208</picture> <tab/>Aristot[elis] <tab/><picture>207</picture>\n [[110.8]] Coleri. Serres <tab/>Claramontii\n [[110.9]] <i>Hausbücher</i> <tab/>Spinos[ae] </p>\n<p> [[110.10]] ex variis linguis <tab/> Oeconom[ia] <tab/>Hobb[ii] <tab/>Ethica\n [[110.11]] Architecton. <tab/>Cardani\n [[110.12]] <i>Financen, Commercien</i>, <tab/>Campanell[ae]\n [[110.13]] Bech[er] etc. <tab/>Felden[ii]\n [[110.14]] <i>Bergsachen</i>,\n [[111.1]] Cardan[i] <tab/><picture>208</picture> <tab/>Histor[ia]\n [[111.2]] Conring[i] <tab/>Antiquitates\n [[111.3]] Hobb[ii]\n [[111.4]] Grot[ii] <tab/> Polit[ica] <tab/>Ius civil[e]\n [[111.5]] Limn<angle bracket>aei</angle bracket> <tab/> canon[icum]\n [[111.6]] Les Estats de France <tab/>Theol[ogia] moral[is] </p>\n<p> [[111.7]] Angleterre etc. <tab/> Scholast[ica]\n [[111.8]] S. Marthe <tab/> Controvers. </p>\n","number":"36₂.","title":"Tabula autorum","date":null}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>