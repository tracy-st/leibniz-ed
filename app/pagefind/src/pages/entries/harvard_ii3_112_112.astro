---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_112",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 112,
  "text": "<p> [[294.1]] <b>112. LEIBNIZ AN VINCENT PLACCIUS</p>\n<p> [[294.2]] [Hannover,] 26. April (6. Mai) 1697. [111.113.]</b></p>\n\n<p> [[294.10]] Quis autor fuerit libri, suo merito celebris, qui inscribitur <i>Cautio Criminalis in processu\n[[294.11]] contra Sagas</i>, didici ex ore Eminentissimi Electoris Moguntini <b>Johannis Philippi.</b> Nempe\n[[294.12]] is fuit Fridericus <b>Spee,</b> Societatis Jesu Presbyter, ex nobili Westphaliae familia editus, pietate\n[[294.13]] et doctrina praestans: cujus extant libri <greek>ăskhtikoì</greek> plane in genere suo excellentes, et mihi ex\n[[294.14]] commendatione tanti Principis primum noti deinde semper familiares, et per me multis amicis\n[[294.15]] et ipsius et nostrae religionis commendati. Usque adeo, ut me etiam suggerente a nonnullis in\n[[294.16]] praxin traductum fuerit elegans, quod proponit, et Mathematica ratione demonstrat, <b>artificium\n[[294.17]] indesinenter laudandi Deum.</b> Hic tantus vir in Franconia Confessoris munere\n[[294.18]] fungebatur tunc, cum multi in <b>Herbipolitano et Bambergensi</b> tractu sceleratae magiae\n[[294.19]] infamia oppressi comburerentur. <b>Johannes Philippus Schoenbornius,</b> postea Episcopus\n[[294.20]] Herbipolitanus, et postremo Moguntinus Elector Herbipolitanae Ecclesiae Canonicus, in\n[[294.21]] juventute agens cum eo familiaritatem forte contraxit, et cum quaereret juvenis; <b>unde optimo\n[[294.22]] patri plus canitiei, quam pro aetate;</b> ille hoc sibi a sagis venisse, quas ad ignem\n[[294.23]] duxisset. Mirante Schoenbornio, aenigma explicuit <b>Spejus.</b> Nempe se multo studio inquirentem,\n[[294.24]] et jure etiam atque auctoritate confessionis usum, in nemine eorum quos ad ignem\n[[294.25]] comitatus sit, deprehendisse aliquid unde persuasus sit, vere illis magiae crimen improperatum.\n[[294.26]] Simpliciores ubi in confusione quaesisset, ne in nova tormenta proderentur veritos primum se\n[[294.27]] magos dixisse; post hausta fiducia, ubi intellexissent, nil tale a Confessario metuendum, in alia\n[[294.28]] omnia ivisse. Omnes ejulatibus miris, vel inscitiam, vel malitiam judicum, suamque miseriam\n[[294.29]] deplorasse; et ad Deum innocentiae testem in extremis provocasse. Tam miserabili totiesque\n[[294.30]] repetito spectaculo, ita se commotum, ut senuerit ante annos. Cumque processu temporis\n[[294.31]] <b>Schoenbornio</b> factus est familiarior, <b>libri illius auctorem se esse non dissimulavit.</b>\n[[294.32]] <b>Schoenbornius</b> postea ad Episcopatus Principatusque gradum evectus, memorque\n[[295.1]] eorum, quae vir tam gravis narraverat; quoties aliquis, aliquave, hujus sceleris insimulabatur,\n[[295.2]] rem omnem ad suam cognitionem evocavit, et quod ille monuerat, nimis verum deprehendit. Ita\n[[295.3]] hominum combustiones in illo tractu cessavere. </p></p>\n",
  "number": "112.",
  "title": "LEIBNIZ AN VINCENT PLACCIUS",
  "date": "[Hannover,] 26. April (6. Mai) 1697. [111.113.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:112. LEIBNIZ AN VINCENT PLACCIUS [Hannover,] 26. April (6. Mai) 1697. [111.113.] Quis autor fuerit libri, suo merito celebris, qui inscribitur Cautio Criminalis in processu contra Sagas, didici ex ore Eminentissimi Electoris Moguntini Johannis Philippi. Nempe is fuit Fridericus Spee, Societatis Jesu...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii3_112","series":"Band II 3 (1695 - 1700)","seq":112,"text":"<p> [[294.1]] <b>112. LEIBNIZ AN VINCENT PLACCIUS</p>\n<p> [[294.2]] [Hannover,] 26. April (6. Mai) 1697. [111.113.]</b></p>\n\n<p> [[294.10]] Quis autor fuerit libri, suo merito celebris, qui inscribitur <i>Cautio Criminalis in processu\n[[294.11]] contra Sagas</i>, didici ex ore Eminentissimi Electoris Moguntini <b>Johannis Philippi.</b> Nempe\n[[294.12]] is fuit Fridericus <b>Spee,</b> Societatis Jesu Presbyter, ex nobili Westphaliae familia editus, pietate\n[[294.13]] et doctrina praestans: cujus extant libri <greek>ăskhtikoì</greek> plane in genere suo excellentes, et mihi ex\n[[294.14]] commendatione tanti Principis primum noti deinde semper familiares, et per me multis amicis\n[[294.15]] et ipsius et nostrae religionis commendati. Usque adeo, ut me etiam suggerente a nonnullis in\n[[294.16]] praxin traductum fuerit elegans, quod proponit, et Mathematica ratione demonstrat, <b>artificium\n[[294.17]] indesinenter laudandi Deum.</b> Hic tantus vir in Franconia Confessoris munere\n[[294.18]] fungebatur tunc, cum multi in <b>Herbipolitano et Bambergensi</b> tractu sceleratae magiae\n[[294.19]] infamia oppressi comburerentur. <b>Johannes Philippus Schoenbornius,</b> postea Episcopus\n[[294.20]] Herbipolitanus, et postremo Moguntinus Elector Herbipolitanae Ecclesiae Canonicus, in\n[[294.21]] juventute agens cum eo familiaritatem forte contraxit, et cum quaereret juvenis; <b>unde optimo\n[[294.22]] patri plus canitiei, quam pro aetate;</b> ille hoc sibi a sagis venisse, quas ad ignem\n[[294.23]] duxisset. Mirante Schoenbornio, aenigma explicuit <b>Spejus.</b> Nempe se multo studio inquirentem,\n[[294.24]] et jure etiam atque auctoritate confessionis usum, in nemine eorum quos ad ignem\n[[294.25]] comitatus sit, deprehendisse aliquid unde persuasus sit, vere illis magiae crimen improperatum.\n[[294.26]] Simpliciores ubi in confusione quaesisset, ne in nova tormenta proderentur veritos primum se\n[[294.27]] magos dixisse; post hausta fiducia, ubi intellexissent, nil tale a Confessario metuendum, in alia\n[[294.28]] omnia ivisse. Omnes ejulatibus miris, vel inscitiam, vel malitiam judicum, suamque miseriam\n[[294.29]] deplorasse; et ad Deum innocentiae testem in extremis provocasse. Tam miserabili totiesque\n[[294.30]] repetito spectaculo, ita se commotum, ut senuerit ante annos. Cumque processu temporis\n[[294.31]] <b>Schoenbornio</b> factus est familiarior, <b>libri illius auctorem se esse non dissimulavit.</b>\n[[294.32]] <b>Schoenbornius</b> postea ad Episcopatus Principatusque gradum evectus, memorque\n[[295.1]] eorum, quae vir tam gravis narraverat; quoties aliquis, aliquave, hujus sceleris insimulabatur,\n[[295.2]] rem omnem ad suam cognitionem evocavit, et quod ille monuerat, nimis verum deprehendit. Ita\n[[295.3]] hominum combustiones in illo tractu cessavere. </p></p>\n","number":"112.","title":"LEIBNIZ AN VINCENT PLACCIUS","date":"[Hannover,] 26. April (6. Mai) 1697. [111.113.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>