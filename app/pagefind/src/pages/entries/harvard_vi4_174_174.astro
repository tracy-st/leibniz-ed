---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_174",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 174,
  "text": "[[592.10]] <b>142.  De Analysi veritatis et judiciorum humanorum [Ende 1684 bis Anfang 1685 (?)]</b>\n [[592.11]] <tab/>[Ende 1684 bis Anfang 1685 (?)]\n[[593.1]] <tit2><b>De Analysi veritatis et judiciorum humanorum</b> </tit2> </p>\n<p> [[593.2]] Apud Theologos libri habentur de Analysi Fidei, qualis extat Gregorii de Valentia\n[[593.3]] Societatis Jesu, et Henrici Holdeni Angli Theologi Parisini. Mirandum est itaque apud\n[[593.4]] philosophos nihil haberi de Analysi veritatis, nam libri <i>Analyticorum</i> Aristotelis sive\n[[593.5]] <i>posteriores</i> sive <i>priores</i> nihil minus quam analysin sive principia ultima humanorum\n[[593.6]] judiciorum continent. Scholastici quoque nonnulli de Primo Cognito potius disputare\n[[593.7]] more suo, quam quae sint prima cognita, et quomodo ex illis aliae cognitiones deriventur\n[[593.8]] monstrare voluere, nam si hoc praestitissent, dedissent nobis philosophiae Elementa\n[[593.9]] accurata, et ad Mathematicum morem exacta. Et viri ingeniosi qui scripsere nostro\n[[593.10]] tempore de inquirenda veritate, multa quidem elegantia et utilia exoterico quodam tractandi\n[[593.11]] modo, disserunt de humanis affectibus et praejudiciis infantiae, sed cum id agitur ut\n[[593.12]] certa judicandi principia substituantur, haerent ipsi et nos tandem revocant ad regulam\n[[593.13]] illam decantatam, quod iis demum fidendum sit, quae clare et distincte percipimus. </p>\n<p> [[593.14]] Verum non magnum usum habet ea regula quamdiu non habetur modus dijudicandi,\n[[593.15]] quid clarum et distinctum sit. Quod non satis novisse video illos ipsos qui regulam hanc\n[[593.16]] maxime celebrant; nam quaedam distinctissime sibi percipere visa sunt, quae falsa esse\n[[593.17]] compertum habemus et quae ipsi omni conatu adhibito cum demonstrare non possent,\n[[593.18]] coacti sunt monere, ut si alii eadem mentis prae oculis videre vellent, quae ipsi, eadem\n[[593.19]] quae ipsi meditarentur diu. Callide profecto, nam certum est consuetudine cogitandi\n[[593.20]] quaedam nobis ita familiaria fieri, ut depravato vel mutato naturali judicio tandem nobis\n[[593.21]] clara videantur. Idque inprimis succedit in his, quae, dictione nitida et ad plausum facta,\n[[593.22]] non sine quadam simplicitatis et evidentiae fucata artificiose specie proponuntur a celebri\n[[593.23]] autore. Et cum denique ad experientiam internam idearum provocant hi scriptores, eo\n[[593.24]] ipso et objectiones declinare et onere probandi se eximere conantur. Alii iisdem principiis\n[[594.1]] insistentes, sed apertiores, professi sunt, id clarum distinctumque censeri debere quod\n[[594.2]] sine interiore quadam repugnantia et conscientiae quasi morsu negari non potest. Verum\n[[594.3]] haec nota uti non contemnenda est, ita tamen dialectica tantum censeri debet. Sunt qui\n[[594.4]] omnia resolvunt in autoritatem. Ultima enim principia ajunt a nobis admitti, quia a\n[[594.5]] nemine revocantur in dubium. Ego quidem fateor in plerisque vulgo judiciis id esse\n[[594.6]] verum, contendo tamen altiora et certiora adesse. </p>\n",
  "number": "142.",
  "title": "De Analysi veritatis et judiciorum humanorum",
  "date": "[Ende 1684 bis Anfang 1685 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:142. De Analysi veritatis et judiciorum humanorum [Ende 1684 bis Anfang 1685 (?)] [Ende 1684 bis Anfang 1685 (?)] De Analysi veritatis et judiciorum humanorum Apud Theologos libri habentur de Analysi Fidei, qualis extat Gregorii de Valentia Societatis Jesu, et Henrici Holdeni Angli Theologi Parisini...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>