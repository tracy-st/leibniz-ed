          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:14 Demonstrationum Catholicarum Conspectus 1668-1669 (?) 494.0;0:61:014:6801-6912:L:l^. Prolegomena continebunt Elementa Philosophiae. Nempe prima principia Metaphysicae (de Ente) Logicae (de Mente) Matheseos (de Spatio) Physicae (de Corpore) Philosophiae Practicae (de Civitate). Pars I. Demonstrati...">
