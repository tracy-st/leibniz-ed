---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_116",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 116,
  "text": "<p> [[321.1]] <b>101. LEIBNIZ AN OTTO VON GUERICKE</p>\n<p> [[321.2]] [31. Januar 1672.] [83.103.]</b></p>\n<p> [[321.12]] An Herrn Gericken. </p>\n<p> [[321.13]] Ich bin neülich ohngefähr im Römischen <i>Journal</i> über eine Epistel eines <i>mathematici</i>\n[[321.14]] nahmens Eschinardi kommen, welcher vorgiebt, daß die Thermometra nicht in gleiche, sondern\n[[321.15]] einander ungleiche theile müsten abgetheilt werden, weil sie nicht <i>motu uniformi</i> sondern\n[[321.16]] <i>accelerato</i> stiegen und wüchsen. Es ist bekand daß ohne das die thermometra sehr ungewiß,\n[[321.17]] indem <i>gradus raritatis in aëre</i> nicht allein von Wärme und Kälte, sondern auch Trockne und\n[[321.18]] Feüchte variirt werden. So glaub ich auch gar gern, daß das Baroscopium von allen mit\n[[321.19]] einander einige impression empfange, denn die Lufft durch veränderung der Wärme und Kälte,\n[[321.20]] Trockne und Feüchte, und denn bewegung oder ruhe ihre Leichte oder schwere verändert. Einig\n[[321.21]] und allein deücht mich, sey das Hygroscopium oder mas der trockne und feüchtigkeit invariabel\n[[321.22]] und an eine einfache Ursache gebunden. Und derowegen mit deßen hülffe, auch wenn es\n[[321.23]] gleich ebenmäßig von zusammengesezten Ursachen hehrkommen solte, dennoch durch Combination\n[[321.24]] solcher Instrumenten zu einiger richtigkeit zu kommen. Denn wenn man solche\n[[321.25]] <i>instrumenta</i> zusammen hielte, würde vielleicht sich auß der differenz die Ursach finden. Als\n[[321.26]] zum exempel wenn sich das <i>Baroscopium</i> veränderte, das <i>Hygroscopium</i> aber nicht, oder nicht\n[[321.27]] mit gleicher proportion, köndte man daraus schließen, daß die verenderung der Schwehre nicht\n[[322.1]] von feüchtigkeit oder trockne sey sondern entweder von rarefaction und condensation, oder\n[[322.2]] Bewegung hehr rührte, solches nun wieder zu entscheiden, müste man das <i>Thermometrum</i>\n[[322.3]] dagegen halten, were, wenn darinn keine solche veränderung, zu schließen daß die veränderung\n[[322.4]] der Schwehre der Lufft von einer Bewegung hehrrühre, so die Lufft träget, und\n[[322.5]] dergestalt köndte man vielleicht etwas gründtliches von künfftigen wetter schließen, auch wohl\n[[322.6]] vielleicht gar zu <i>periodis tempestatum</i> kommen, wie dann an manchen orthen die winde\n[[322.7]] periodisch seyn. Damit aber die Mühe zu observiren gemindert werde, köndte es also angestellet\n[[322.8]] werden, daß die veränderungen von Zeiten zu zeiten sich selbst zeichneten wie Hookius\n[[322.9]] und andere am <i>Barometro</i> gethan zu haben vorgeben, mit hülffe einer gewißen machine. </p>\n<p> [[322.10]] Ob der Mond eine veränderung in Schwehre der Lufft causire, und dadurch zu einer\n[[322.11]] Mechanischen demonstration der Ursach der Meerfluten zu gelangen. </p>\n<p> [[322.12]] Ein zweifel fält mir hier noch bey. Ob die schwehre der Lufft durch tragung des windes\n[[322.13]] vermindert werden könne. Denn wenn man ein geschirr voll waßer nimt, so zum exempel mit\n[[322.14]] dem waßer 20 Pfund wieget, und ein stück holzes von 5 Pfund hinein leget, so vom waßer\n[[322.15]] getragen wird, so wird doch das ganze geschirr mit holz und wasser 25 Pfund wiegen. So sagt\n[[322.16]] man auch daß wenn ein Mensch in einer wage stehe, und etwas trage, werde solches mit ihm\n[[322.17]] wiegen und wenn eine Kugel vom winde über einen glatten boden getrieben würde, würde sie\n[[322.18]] nichts desto minder mit voriger gewalt den boden drücken. </p>\n",
  "number": "101.",
  "title": "LEIBNIZ AN OTTO VON GUERICKE",
  "date": "[31. Januar 1672.] [83.103.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:101. LEIBNIZ AN OTTO VON GUERICKE [31. Januar 1672.] [83.103.] An Herrn Gericken. Ich bin neülich ohngefähr im Römischen Journal über eine Epistel eines mathematici nahmens Eschinardi kommen, welcher vorgiebt, daß die Thermometra nicht in gleiche, sondern einander ungleiche theile müsten abgetheilt ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii1_116","series":"Band II 1 (1663 - 1685)","seq":116,"text":"<p> [[321.1]] <b>101. LEIBNIZ AN OTTO VON GUERICKE</p>\n<p> [[321.2]] [31. Januar 1672.] [83.103.]</b></p>\n<p> [[321.12]] An Herrn Gericken. </p>\n<p> [[321.13]] Ich bin neülich ohngefähr im Römischen <i>Journal</i> über eine Epistel eines <i>mathematici</i>\n[[321.14]] nahmens Eschinardi kommen, welcher vorgiebt, daß die Thermometra nicht in gleiche, sondern\n[[321.15]] einander ungleiche theile müsten abgetheilt werden, weil sie nicht <i>motu uniformi</i> sondern\n[[321.16]] <i>accelerato</i> stiegen und wüchsen. Es ist bekand daß ohne das die thermometra sehr ungewiß,\n[[321.17]] indem <i>gradus raritatis in aëre</i> nicht allein von Wärme und Kälte, sondern auch Trockne und\n[[321.18]] Feüchte variirt werden. So glaub ich auch gar gern, daß das Baroscopium von allen mit\n[[321.19]] einander einige impression empfange, denn die Lufft durch veränderung der Wärme und Kälte,\n[[321.20]] Trockne und Feüchte, und denn bewegung oder ruhe ihre Leichte oder schwere verändert. Einig\n[[321.21]] und allein deücht mich, sey das Hygroscopium oder mas der trockne und feüchtigkeit invariabel\n[[321.22]] und an eine einfache Ursache gebunden. Und derowegen mit deßen hülffe, auch wenn es\n[[321.23]] gleich ebenmäßig von zusammengesezten Ursachen hehrkommen solte, dennoch durch Combination\n[[321.24]] solcher Instrumenten zu einiger richtigkeit zu kommen. Denn wenn man solche\n[[321.25]] <i>instrumenta</i> zusammen hielte, würde vielleicht sich auß der differenz die Ursach finden. Als\n[[321.26]] zum exempel wenn sich das <i>Baroscopium</i> veränderte, das <i>Hygroscopium</i> aber nicht, oder nicht\n[[321.27]] mit gleicher proportion, köndte man daraus schließen, daß die verenderung der Schwehre nicht\n[[322.1]] von feüchtigkeit oder trockne sey sondern entweder von rarefaction und condensation, oder\n[[322.2]] Bewegung hehr rührte, solches nun wieder zu entscheiden, müste man das <i>Thermometrum</i>\n[[322.3]] dagegen halten, were, wenn darinn keine solche veränderung, zu schließen daß die veränderung\n[[322.4]] der Schwehre der Lufft von einer Bewegung hehrrühre, so die Lufft träget, und\n[[322.5]] dergestalt köndte man vielleicht etwas gründtliches von künfftigen wetter schließen, auch wohl\n[[322.6]] vielleicht gar zu <i>periodis tempestatum</i> kommen, wie dann an manchen orthen die winde\n[[322.7]] periodisch seyn. Damit aber die Mühe zu observiren gemindert werde, köndte es also angestellet\n[[322.8]] werden, daß die veränderungen von Zeiten zu zeiten sich selbst zeichneten wie Hookius\n[[322.9]] und andere am <i>Barometro</i> gethan zu haben vorgeben, mit hülffe einer gewißen machine. </p>\n<p> [[322.10]] Ob der Mond eine veränderung in Schwehre der Lufft causire, und dadurch zu einer\n[[322.11]] Mechanischen demonstration der Ursach der Meerfluten zu gelangen. </p>\n<p> [[322.12]] Ein zweifel fält mir hier noch bey. Ob die schwehre der Lufft durch tragung des windes\n[[322.13]] vermindert werden könne. Denn wenn man ein geschirr voll waßer nimt, so zum exempel mit\n[[322.14]] dem waßer 20 Pfund wieget, und ein stück holzes von 5 Pfund hinein leget, so vom waßer\n[[322.15]] getragen wird, so wird doch das ganze geschirr mit holz und wasser 25 Pfund wiegen. So sagt\n[[322.16]] man auch daß wenn ein Mensch in einer wage stehe, und etwas trage, werde solches mit ihm\n[[322.17]] wiegen und wenn eine Kugel vom winde über einen glatten boden getrieben würde, würde sie\n[[322.18]] nichts desto minder mit voriger gewalt den boden drücken. </p>\n","number":"101.","title":"LEIBNIZ AN OTTO VON GUERICKE","date":"[31. Januar 1672.] [83.103.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>