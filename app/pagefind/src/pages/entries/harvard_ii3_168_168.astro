---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_168",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 168,
  "text": "<p> [[432.1]] <b>168. JOHANN CHRISTIAN SCHULENBURG AN LEIBNIZ</p>\n<p> [[432.2]] Bremen, 7. (17.) April 1698. [165.175.]</b></p>\n\n<p> [[432.6]] Vir Illustris et Celeberrime! Patrone magne! </p>\n<p> [[432.7]] Erubescit calamus meus quod Tua audeat interrumpere Negotia gravissima non minus\n[[432.8]] quam Sublimia. Quanto sim perfusus gaudio acceptis literis Tuis quam profundissime doctis,\n[[432.9]] nec dici satis potest nec scribi etiam. Si quidem non tantum maximi Tui propensissimique in me\n[[432.10]] favoris testes existunt locupletes, verum etiam Eruditionis Solidioris rivulos in me derivarunt\n[[432.11]] perquam exoptatos gratissimosque. Quae Knolleus ex Metaphysica Mathematica excerpsit\n[[432.12]] Acutissimo debet Weigelio meo etiam quondam in his per discursum Praeceptore dexterrimo. </p>\n<p> [[432.13]] Easdem profecto de Creatarum rerum Valore, a Deo loco Nihili, quod hunc antecessit\n[[432.14]] mundum, infinita Potentia liberrime constituto, foveo cogitationes, quas Tu Vir Illustris ad me\n[[432.15]] perscripsisti, licet primos ego saltem Limitum horum limites salutaverim, Tuaque proinde\n[[432.16]] Oracula me ulterius in hoc negotium deducentia non possim non exosculari. Non licet saltem\n[[432.17]] hic Bremae, ubi Cartesiani, alios praejudiciis exuturi, in iisdem tamen nimium quantum haerentes\n[[432.18]] vident, quos olim <i>Miscellanea</i> mea <i>Philosophica</i> valde exagitavere, scandalo certe non\n[[432.19]] dato sed accepto, publice haec profiteri. Videntes oculos claudunt et Aliis quoque gluten\n[[432.20]] illinunt. Dyadica Supputandi ratio, Maecenas Optime, valde me delectavit. Memini Ingeniosissimum\n[[432.21]] Sturmium ad Analogiam Quaternarii Diapentismum aliquando excogitasse; sed, si\n[[432.22]] licet, sine omni tamen adulatione, effari quae sentio, palmam profecto Tua praeripit omnibus et\n[[432.23]] quod simplicissima et quod character sit Dei et Nihili, Positivitatis et Nullitatis, eandemque\n[[432.24]] semper rerum omnium a Deo, qui solus independentem habet positivitatem, dependentem\n[[432.25]] stationem et positionem, cum alias non essent, jucundissime indicet. Nescio an divinam hanc\n[[432.26]] supputandi Methodum, cujus quoque, in actu Supputationis hujus exercito, Terminos\n[[433.1]] Mnemonicos, loco <i>eins zehn hundert taus</i>[<i>end</i>] sine dubio a Te impositos pernoscere velim,\n[[433.2]] assecutus satis sim. Mitto eam continuatam, et si recte habuerit, facillime, volanti etiam calamo,\n[[433.3]] magna namque inest huic ipsi facilitas, si prima, quam monstrasti, progressio constanter fuerit\n[[433.4]] observata, quousque libet continuandam. Proprietates aliquas atque certas combinationes, modo\n[[433.5]] non has ipsas numerorum nostrorum vulgarium consuetudo per praejudicium aliquod mihi\n[[433.6]] suggesserit, appositis ductibus indicare volui, Tuam, quam peto humillime et mihi ob summum;\n[[433.7]] quem jam exhibuisti, favorem certissime promitto, Informationem, Correctionem, Confirmationem\n[[433.8]] avidissime exspectans. Ni fallor, utcunque jam video, ex prima progressionis serie, et\n[[433.9]] addendi et subtrahendi in hac dyadica Methodum. Tuarum Mellitissimarum copiam quamprimum\n[[433.10]] faciam Dn. Knolleo qui et Solertissimo Eimarto harum faciet Mentionem, ac communi\n[[433.11]] nomine Suae Hypotheseos deductionem ulteriorem desiderabit. Fateor Auctorem optimum\n[[433.12]] hanc ipsam in Astronomicis per viginti jam annorum et ultra observationes constantes, quae\n[[433.13]] utinam aliquando lucem publicam videant, habere exploratam et certissimam: an in Physicis\n[[433.14]] quoque omnibus satisfaceret Phaenomenis subdubitabat, aut modeste praetexebat, saepiusque\n[[433.15]] hunc in finem a me in multam noctem subdiu olim inter Coeli contemplationes dubia et\n[[433.16]] audiebat et solvebat. Doleo ego et infirmitati meae et officio in Augiae stabulo, pulvere\n[[433.17]] scholastico, purgando satis molesto. Habeo alias quaedam adhuc discursus Eimartiani excerpta\n[[433.18]] sed meditationes in ea defigere hactenus labores mei non permittunt, verum spero omnino fore\n[[433.19]] ut Eimartus ipse et Tibi obsecundet et meis votis respondeat. Fave Vir Illustr. Chartulis meis,\n[[433.20]] quibus ipse in omnibus non faveo. Cogita de calamo in Papyrum conjici qualiacunque mea\n[[433.21]] cogitata, adeoque morsos ungues et diuturnas meditationes non sapere. </p>\n<p> [[433.22]] Sic favebis Tui obsequiosissimo M. J. C. Schulenburgio. Rect. </p>\n<p> [[433.23]] Br. d. 7. Apr. 98. </p>\n<p> [[433.24]] Infiniti Tua Elementa et quae eo Bernoulliana Aliorumque spectant nondum vidi. Parheliorum\n[[433.25]] Iconismus distinctius expressus est quam ipsi apparuere. Pictoribus atque Poëtis forte\n[[433.26]] et Scriptoribus. </p>\n<p> [[433.27]] Urnas in Tui obsequium delineavit domesticus meus Valencampius Junior, ejus mentionem\n[[433.28]] dedit duodenarius meus Carolinus. Servavit vero in delineandis suis fere ubique rationem\n[[433.29]] subduplam, alias colorem et omnia secutus, quantum potuit. </p>\n<p> [[434.1]] <i>Nach dem Postskript quer zum Text die folgende Tabelle:</i> </p>\n",
  "number": "168.",
  "title": "JOHANN CHRISTIAN SCHULENBURG AN LEIBNIZ",
  "date": "Bremen, 7. (17.) April 1698. [165.175.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:168. JOHANN CHRISTIAN SCHULENBURG AN LEIBNIZ Bremen, 7. (17.) April 1698. [165.175.] Vir Illustris et Celeberrime! Patrone magne! Erubescit calamus meus quod Tua audeat interrumpere Negotia gravissima non minus quam Sublimia. Quanto sim perfusus gaudio acceptis literis Tuis quam profundissime doctis...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>