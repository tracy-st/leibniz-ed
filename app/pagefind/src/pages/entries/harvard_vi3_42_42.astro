---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi3_42",
  "series": "Band VI 3 (1672-1676); durchgesehener Nachdruck 1980",
  "seq": 42,
  "text": "[[409.17]] <b>42. Desiderata analytica </b> <span>409.17;0:63:042:74       :L:l^</span>.\n[[410.1]] 1674.\n[[410.2]] Desiderata Analytica.\n[[410.3]] Multum a perfectione ipsius artis analyticae absumus: ad analyticam numerorum\n[[410.4]] figuratorum absolvendam opus est tantum. Valorem quantitatum arbitrarium ita mutare,\n[[410.5]] ut eo in aequatione substituto evanescat rationalitas, hac ratione aequationum\n[[410.6]] omnium radices in numeris rationalibus reperiri possunt, quando id possibile est.\n[[410.7]] Cum saepe id fieri possit multis modis, artis fuerit omnes modos possibiles determinare,\n[[410.8]] quod hactenus in numeris potuit nemo. Huc pertinet, Ars inveniendi\n[[410.9]] quantitatem, quae eodem modo componatur ex AB et ex CD (posito CD componi ex\n[[410.10]] AB) quando id fieri potest, aut si non potest (,) demonstrare impossibilitatem. Huc\n[[410.11]] pertinet ars inveniendi quantitatem, quae certo quodam modo sed in ipsammet redeunte\n[[410.12]] tractata, producat datam, quando scilicet modus tractandi aequatione exprimi\n[[410.13]] non potest. Et tale est problema methodus tangentium inversa. Sunt et quaedam\n[[410.14]] problemata, in quibus compendium quaeritur, ut cum quaeritur additio terminorum\n[[410.15]] finitorum alicuius seriei; item terminus dato eius loco non inventis omnibus intermediis,\n[[410.16]] etc. Sed si series sit infinita, necessarium fit eiusmodi compendium. Facilius\n[[410.17]] invenitur series infinitarum linearum spatium componentium, quam infinitorum spatiorum\n[[410.18]] spatium finitum componentium.\n[[410.19]] Freniclius non utitur analysi, sed methodo quam vocat exclusivam: scil. determinat\n[[410.20]] numerum qui quaeritur non esse v.g. ternarium, non quaternarium etc. ac\n[[410.21]] exclusis paulatim omnibus eum eo reducit, ut tandem definiri possit. Haec methodus\n[[410.22]] dependet ex theorematis multis jam praedemonstratis.\n",
  "number": "42.",
  "title": "Desiderata analytica",
  "date": ""
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:42. Desiderata analytica 409.17;0:63:042:74 :L:l^. 1674. Desiderata Analytica. Multum a perfectione ipsius artis analyticae absumus: ad analyticam numerorum figuratorum absolvendam opus est tantum. Valorem quantitatum arbitrarium ita mutare, ut eo in aequatione substituto evanescat rationalitas, hac...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>