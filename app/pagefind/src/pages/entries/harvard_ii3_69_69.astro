---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_69",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 69,
  "text": "<p> [[185.6]] <b>69. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[185.7]] Venedig, 10. August [1696]. [64.71.]</b></p>\n\n[[186.1]] <petit> imputet. Rogo ut ei salutem a me nunties et has ipsas lineas communices, ut discam an mea adhuc probet, an vero\n[[186.2]] putet alibi reperisse meliora.\" Leibniz beantwortet unseren Brief zusammen mit N. 71 durch N. 72. Beigeschlossen\n[[186.3]] (\"incluso in foglio\") war die Ankündigung von Fardellas Buch <i>Animae humanae natura ab Augustino\n[[186.4]] detecta</i> (Venedig 1698) noch unter dem ursprünglich vorgesehenen Titel <i>Animae rationalis natura, Democrito,\n[[186.5]] Platoni, Aristoteli, caeterisque philosophis ignota, ab Augustino, prospero eventu, detecta in libro de Quantitate\n[[186.6]] animae. Seu Augustinus de Quantitate animae, notis et dissertationibus illustratus</i> in <i>La Galleria di Minerva</i>,\n[[186.7]] Bd 1, Tl 2, Venedig 1696, S. 27-34 (LH IV, 3, 2b, Bl. 7-10). </petit> </p>\n<p> [[186.8]] Ill^#'m^#'o Sig^#'r^#'e, Sig^#'r^#'e, mio Padron Col^#'m^#'o </p>\n<p> [[186.9]] Ricevo la benignissima di V. S. Ill^#'m^#'a che sommamente mi consola, essendo passato molto\n[[186.10]] tempo che non hò l'onore de' suoi pretiosi caratteri. Consegnarò al Sig^#'r^#'e Mendelino l'Ongarello\n[[186.11]] consistente in trecento e più fogli, l' ho fatto copiare in Padova con gran stento, e l'Abbate\n[[186.12]] Zacco non hà voluto lasciarmi il suo, onde m'è convenuto gettare via una copia imperfetta, e\n[[186.13]] procurarne un altro, che m'è stato concesso per un solo mese. Farò venire il manoscritto da\n[[186.14]] Padova e coll'occasione che passerà per Venetia la Principessa le sarà trasmesso forse insieme\n[[186.15]] con qualche altro manoscritto ed adoperarò tutto il mio talento per mandarle una copia del\n[[186.16]] manuscritto di Vergerio. Coll'ordinario vegnente l'informarò di quel che si è fatto dei manuscritti\n[[186.17]] del Convento delle Carceri, havendone data condissione ad un Amico che penetrarà tutto.\n[[186.18]] Ecco qui incluso un foglio, in cui leggerà l'argomento ed idea del libro che devo quanto prima\n[[186.19]] publicare. </p>\n<p> [[186.20]] La priego favorirmi d'accennarmi il suo sentimento circa la natura così dell'Anima, come\n[[186.21]] del Corpo, se questi consiste nel semplice e nudo stendimento, se lo Spatio è l'istesso che il\n[[186.22]] corpo, infinito, e senza termine. Di più la supplico mandarmi almeno un saggio della sua\n[[186.23]] Analisi acciò me ne possa servire. Mi comandi con libertà e sì persuada che sono </p>\n<p> [[186.24]] Di V. S. Ill^#'m^#'a Umil^#'m^#'o, Obg^#'m^#'o S^#'r^#'e Michel Ang. Fardella </p>\n<p> [[186.25]] Venetia 10 Agosto. </p>\n<p> [[186.26]] Indrizzerà le risposte a Padova. </p>\n",
  "number": "69.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Venedig, 10. August [1696]. [64.71.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:69. MICHEL ANGELO FARDELLA AN LEIBNIZ Venedig, 10. August [1696]. [64.71.] imputet. Rogo ut ei salutem a me nunties et has ipsas lineas communices, ut discam an mea adhuc probet, an vero putet alibi reperisse meliora.\" Leibniz beantwortet unseren Brief zusammen mit N. 71 durch N. 72. Beigeschlossen ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>