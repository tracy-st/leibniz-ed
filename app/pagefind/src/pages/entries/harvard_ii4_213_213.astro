---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_213",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 213,
  "text": "<p> [[658.1]] <b>213. MICHAEL GOTTLIEB HANSCH AN LEIBNIZ</p>\n<p> [[658.2]] Leipzig, 27. August 1707. [210.216.] </b></p>\n<p> [[658.22]] Vir Illustris et Excellentissime, Patrone et Fautor aetatem devenerande! </p>\n<p> [[658.23]] Binas tuas per Dn. Clausnizerum recte quidem, sed priores justo serius accepi, Halae tum\n[[658.24]] temporis agens cum illae deferrentur. Gratias autem Excellentiae Tuae maximas debeo, quod\n[[658.25]] desideriis meis tam benevole annuere haud fuerit dedignata. </p>\n<p> [[658.26]] Nulla se hactenus obtulit occasio Libros Brunsvigam tuto satis mittendi. Quare nundinas\n[[658.27]] nostras expectare Librosque Dn. Forstero tradere commodissimum mihi videtur, nullam interea\n[[658.28]] aliam, si forte dabitur occasionem neglecturo. Alcmanis monumentum cum Marsigliano opere\n[[659.1]] nondum accipere potui a Dn. Menckenio, sed tamen me accepturum esse spero, unaque cum\n[[659.2]] reliquis per Forsterum mittam. Dn. Mencke nuper in praesentia Illustrissimorum Dominorum\n[[659.3]] Legatorum ex utriusque Resp. Procerum ipso Annae die Serenissimae Annae de Unione\n[[659.4]] Angliae atque Scotiae nomine Academiae nostrae magna cum solemnitate gratulatus est. </p>\n<p> [[659.5]] Caeterum non possum quin Tecum, Vir Excellentissime, thesaurum quendam communicem\n[[659.6]] Mss^#'t^#'o^#'r^#'u^#'m Kepleraniorum, quorum cum essemus invicem in Bibliotheca Paulina mentio a me\n[[659.7]] injiciebatur, a Curiosis harum literarum aestimationibus adhuc comparabilem. Continetur ille\n[[659.8]] aliquot fasciculis, quorum primus complectitur Kepleri Genethliaca, item Tychonis Brahe,\n[[659.9]] Bartschii etc., secundus Genealogica et Geographica Sacra, tertius Epistolas Davidis Fabricii ad\n[[659.10]] Joh. Keplerum cum responsionibus ejusdem ab anno 1601 ad annum usque 1609, una cum\n[[659.11]] Epistolis Joh. Georg. Herward von Hohenburg etc.[,] quartus Ptolemaei Pelusiensis <i>Harmonicorum</i>\n[[659.12]] Libros interprete Antonio [Gogavino Graviensi]: item Aristoxeni Musici antiquissimi\n[[659.13]] <i>Harmonicorum Elementorum Libros 3</i>. et aliquid ejusd. argumenti ex Dialogis Galilaei; quintus\n[[659.14]] Kepleri Fragmenta varii argumenti; sextus Kepleri annotata <i>de stella nova</i>, aliorumque Epistolas,\n[[659.15]] item Tychonis Scriptum: septimus Lunaria Tychonis et alia quaedam Kepleri: octavus de\n[[659.16]] ratione anni rudimentum Calendarii: nonus Tabularum Rudolphi Partem illam, quae generaliter\n[[659.17]] servit, cuicunque restitutioni, et alia quaedam: decimus Kepleri Appendicem ad Harmonices\n[[659.18]] Mundi Librum quintum continentem Ptolemaei Lib. 3. a c. 3. usque ad fin.[,] item Commentaria\n[[659.19]] Porphyrii in Ptolemaei <i>Harmonica</i>, item de aetate Mundi; undecimus Epistolas varias ad\n[[659.20]] Keplerum: duodecimus Canonem rectanguli Sphaerici, item doctrinam Triangulorum etc.[,]\n[[659.21]] decimustertius Genethliaca; item de Interitu Regni Turcici, it[em] de quantitate in genere et\n[[659.22]] plurima alia: decimus quartus Tabulas complectitur Rudolphinas. </p>\n<p> [[660.1]] Catalogum hunc nuper per Amicum consecutus sum, et Excellentiae Tuae hac occasione\n[[660.2]] mitto. Quod superest vale, meisque studiis, ut coepisti, patrocinio Tuo adesse perge qui sum\n[[660.3]] maneoque </p>\n<p> [[660.4]] Excellentiae Tuae observantissimus M. G. Hansch. </p>\n<p> [[660.5]] Dab. Lipsiae 1707. 27. August. </p>\n<p> [[660.6]] P. S. Nolim semper litteras ad Clausnizerum dirigi, ne ipsius humanitate abuti videar.\n[[660.7]] Iterum Vale! </p>\n<p> [[660.8]] NB A Son Excellence Monseigneur de Leibnitz Conseiller privé de Son Altesse Electorale\n[[660.9]] de Brounsvic et Lunebourg presentement à Hannover </p>\n",
  "number": "213.",
  "title": "MICHAEL GOTTLIEB HANSCH AN LEIBNIZ",
  "date": "Leipzig, 27. August 1707. [210.216.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:213. MICHAEL GOTTLIEB HANSCH AN LEIBNIZ Leipzig, 27. August 1707. [210.216.] Vir Illustris et Excellentissime, Patrone et Fautor aetatem devenerande! Binas tuas per Dn. Clausnizerum recte quidem, sed priores justo serius accepi, Halae tum temporis agens cum illae deferrentur. Gratias autem Excellent...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>