---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_166",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 166,
  "text": "<p> [[548.8]] <b>150. LEIBNIZ AN HERMANN CONRING</p>\n<p> [[548.9]] Hannover, 19. (29.) Juni 1677. [145.151.]</b></p>\n<p> [[548.16]] Amplissime Domine Hanoverae 19 Jun. 1677. </p>\n<p> [[548.17]] Literas Tuas eo majore gaudii sensu accepi, quo minus sperabam aliquam Tibi restare\n[[548.18]] memoriam mei, quam certe meruisse me, dicere non possum: nam cum temporum locorumque\n[[548.19]] intervalla colere amicitiam illam vetuissent, qua me olim dignari velle visus es, habebam cur\n[[548.20]] vererer ne hominis tui quidem studiosissimi, sed reapse inutilis parum recordareris. Sed hoc\n[[548.21]] metu me literae tuae absolverunt, quas humanitati potius tuae, quam ulli merito meo tribuo.\n[[548.22]] Redditae sunt mihi tardius ob absentiam: postea expectandus fuit reditus Ser^#'m^#'i Principis ex\n[[548.23]] Holsatia ut tibi de nonnullis responderem certius. Gratias ago maximas quod misisti literas\n[[548.24]] Cl^#'m^#'i Justelli. Cui si respondere voles, poteris id tuto facere per me. Ab eo tempore alias accepi\n[[549.1]] ab eodem Justello, quas Glazius quidam Secretarii Consistorialis filius nuper redux attulit. Sed\n[[549.2]] nihil est in illis quod in prioribus non contineretur: nam dubitasse de earum redditione visus est. </p>\n<p> [[549.3]] Diu est quod laborat in Diplomatum vetustorum Critica, quae mihi hodie longe utilior\n[[549.4]] videtur, quam vetus illa quam autores nostri in autores tantum graecos et latinos, quos ipsi\n[[549.5]] vocant classicos, exercebant. Multas in eam rem collegit regulas, quibus vera a supposititiis\n[[549.6]] discerni possint, quas lectissimis exemplis illustravit: non dubito quin hoc suum institutum tibi\n[[549.7]] quoque exposuerit, a quo et juvari potest. Sciunt enim omnes quantum tum in aliis multis rebus,\n[[549.8]] tum maxime in hoc genere possis. </p>\n<p> [[549.9]] Audio resumtum a Te opus <i>de finibus Imperii</i>, quod haud dubie te dignum pariter et\n[[549.10]] praesenti rerum statui congruum est. Si qua alia aut meditaris aut affecta habes, eorum indicem\n[[549.11]] aliquem ex Te discere opto, ut saltem interim nos spe pascamus. Ego certe non dubito quin\n[[549.12]] multa habeas praeclara cogitata, quae nondum comparent in scriptis tuis. Neque de rebus\n[[549.13]] tantum civilibus aut Germanicis loquor, scimus enim ad omnia pene studiorum genera extendi\n[[549.14]] ingenii tui vastitatem, et in religionis quoque negotio et in ipsa scientia medica sive naturali\n[[549.15]] multa minime vulgaria a te dici posse. Nescio an videris libellum quem P. Honoratus Fabry e\n[[549.16]] Societate Jesu, Gallus natione, sed Romae a multis annis agens libro tuo, quem <i>Concussionem\n[[549.17]] Fundamentorum fidei pontificiae</i> appellasti, opposuit. Autor est sine controversia eruditus, et in\n[[549.18]] variis scientiis, etiam mathematicis ac physicis egregie versatus. </p>\n<p> [[549.19]] Cum tot annorum decursu partim experientia quam non negligis, partim meditatione, qua\n[[549.20]] inprimis vales, multa de re medica praeclara observare potueris, quae certe ad hominum\n[[549.21]] multorum salutem conferre possunt, optandum est profecto ut des operam ne quicquam eorum\n[[549.22]] pereat. </p>\n<p> [[549.23]] Pro libello <i>de Pace protestantibus danda</i> gratias ago nomine Serenissimi Principis: eidem\n[[549.24]] non ingratum erit, quicquid ei mittes, etiamsi contra Capucinos dirigatur, tametsi intellexisse se\n[[549.25]] dicat, scribi a te quaedam acrius, quam nonnulli desiderant, aut necessitas postulet. </p>\n<p> [[549.26]] Si quid est in his locis, quo tibi operam meam probare possim, id mihi ut imperes rogo.\n[[549.27]] Vale interea faveque </p>\n<p> [[550.1]] Vir Amplissime Tibi deditissimo Gottfredo Guilielmo Leibnitio. </p>\n",
  "number": "150.",
  "title": "LEIBNIZ AN HERMANN CONRING",
  "date": "Hannover, 19. (29.) Juni 1677. [145.151.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:150. LEIBNIZ AN HERMANN CONRING Hannover, 19. (29.) Juni 1677. [145.151.] Amplissime Domine Hanoverae 19 Jun. 1677. Literas Tuas eo majore gaudii sensu accepi, quo minus sperabam aliquam Tibi restare memoriam mei, quam certe meruisse me, dicere non possum: nam cum temporum locorumque intervalla cole...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>