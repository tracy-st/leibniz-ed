---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_280",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 280,
  "text": "<p> [[842.1]] <b>283. GIOVANNI BATTISTA TOLOMEI AN LEIBNIZ</p>\n<p> [[842.2]] Rom, 4. September 1694. [269.]</b></p>\n<p> [[842.7]] Ill^#'m^#'o Sig^#'r^#'e e Padron mio Col^#'m^#'o </p>\n<p> [[842.8]] Mi impedirono alcune mie replicate occupazioni di rispondere alla prima di V.S. Ill^#'m^#'a, e\n[[842.9]] sostituij in mio luogo il P. Isensehe che la ringraziassi e riverissi a mio nome scusando la mia\n[[842.10]] mancanza. Di presente non voglio commettere il secondo mancamento, e con tutte le espressione\n[[842.11]] a me possibile mi professo obligatissimo alla di lei Gentilezza, e desiderosissimo di\n[[842.12]] haver<angle bracket>e</angle bracket> le sue sì degne notizie letterarie, delle quali se si compiacerà continuarmi il favore o a\n[[842.13]] me o al P. Isensehe con cui convivo, lo riceverò a somma grazia, e quando non possa io,\n[[842.14]] risponderà il detto P^#'r^#'e. </p>\n<p> [[842.15]] Quanto alla opera che ella destina di publicare <i>de Dynamicis</i> sommamente l'applaudisco e\n[[842.16]] la prego a sbrigarla stimandola utilissima. Nel sistema di Cartesio la notione del <b>corpo\n[[842.17]] naturale</i> è la prima petra scandali, e in queste scuole del Collegio nostro Romano sono stato\n[[842.18]] io il primo ad impugnarla in Filosofia introducendovi tal questione per avanti non dibattutavi:\n[[842.19]] benche par altro ammiri la maniera con cui Cartesio e i suoi spiegano moltissimi fenomeni\n[[842.20]] naturali, e stimo che non con grandissima difficoltà si possa accordare la diferenza che corre\n[[842.21]] nella filosofia e farne una terza Hipotesi che habbia il buono de moderni fisici, e degl'antichi\n[[842.22]] Filosofi specialmente Platone e Aristotele: e ciò per il mezzo che ella tanto bene auvisa col\n[[842.23]] riconoscere un Entelechia a virtu innata attiva ne'corpi corrispondente per analogia al niso\n[[842.24]] de' gravi al centro, o al globo: e consistente in un attuale nozione de' corpi impressa continuamente,\n[[842.25]] o conservata in essi dal Autore della natura. Di che pero la spiegazione spero che\n[[842.26]] haverò la sorte di leggere nella sua opera, non havendo trovato chi chiaramente e distintamente\n[[842.27]] ne parli: e per altro parendomi che tutte le sette de Filosofi sotto diversi vocaboli l'ammettano\n[[842.28]] eccetto forse i Peripatetici scolastici. Se il tempo me lo permettesse volontierissime m'allargherei\n[[842.29]] con V.S. Ill^#'m^#'a sù quest'argumento. </p>\n<p> [[843.1]] Quanto alla correzzione del Calendario è vero che ne fù parlato in Roma, mà attese le altre\n[[843.2]] gravi occupazioni della Corte si crede che se non si fà instanza a Prencipi e segnatamente dal\n[[843.3]] Imperatore l'affare qui non sia per promuoversi: in tal caso però non si mancherebbe dal\n[[843.4]] P. Generale (il quale è alto stimatore del merito di V.S.) di conconcorrere e offerire l'opera de\n[[843.5]] suoi sudditi. E per fine resto riverendola con tutto l'ossequio del mio animo </p>\n<p> [[843.6]] Devo^#'m^#'o et obl^#'m^#'o servi^#'r^#'e Gio. Batt^#'a Tolomei. </p>\n<p> [[843.7]] Roma 4 7^#'b^#'r^#'e 1694. </p>\n",
  "number": "283.",
  "title": "GIOVANNI BATTISTA TOLOMEI AN LEIBNIZ",
  "date": "Rom, 4. September 1694. [269.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:283. GIOVANNI BATTISTA TOLOMEI AN LEIBNIZ Rom, 4. September 1694. [269.] Ill^#'m^#'o Sig^#'r^#'e e Padron mio Col^#'m^#'o Mi impedirono alcune mie replicate occupazioni di rispondere alla prima di V.S. Ill^#'m^#'a, e sostituij in mio luogo il P. Isensehe che la ringraziassi e riverissi a mio nome sc...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii2_280","series":"Band II 2 (1686 - 1694)","seq":280,"text":"<p> [[842.1]] <b>283. GIOVANNI BATTISTA TOLOMEI AN LEIBNIZ</p>\n<p> [[842.2]] Rom, 4. September 1694. [269.]</b></p>\n<p> [[842.7]] Ill^#'m^#'o Sig^#'r^#'e e Padron mio Col^#'m^#'o </p>\n<p> [[842.8]] Mi impedirono alcune mie replicate occupazioni di rispondere alla prima di V.S. Ill^#'m^#'a, e\n[[842.9]] sostituij in mio luogo il P. Isensehe che la ringraziassi e riverissi a mio nome scusando la mia\n[[842.10]] mancanza. Di presente non voglio commettere il secondo mancamento, e con tutte le espressione\n[[842.11]] a me possibile mi professo obligatissimo alla di lei Gentilezza, e desiderosissimo di\n[[842.12]] haver<angle bracket>e</angle bracket> le sue sì degne notizie letterarie, delle quali se si compiacerà continuarmi il favore o a\n[[842.13]] me o al P. Isensehe con cui convivo, lo riceverò a somma grazia, e quando non possa io,\n[[842.14]] risponderà il detto P^#'r^#'e. </p>\n<p> [[842.15]] Quanto alla opera che ella destina di publicare <i>de Dynamicis</i> sommamente l'applaudisco e\n[[842.16]] la prego a sbrigarla stimandola utilissima. Nel sistema di Cartesio la notione del <b>corpo\n[[842.17]] naturale</i> è la prima petra scandali, e in queste scuole del Collegio nostro Romano sono stato\n[[842.18]] io il primo ad impugnarla in Filosofia introducendovi tal questione per avanti non dibattutavi:\n[[842.19]] benche par altro ammiri la maniera con cui Cartesio e i suoi spiegano moltissimi fenomeni\n[[842.20]] naturali, e stimo che non con grandissima difficoltà si possa accordare la diferenza che corre\n[[842.21]] nella filosofia e farne una terza Hipotesi che habbia il buono de moderni fisici, e degl'antichi\n[[842.22]] Filosofi specialmente Platone e Aristotele: e ciò per il mezzo che ella tanto bene auvisa col\n[[842.23]] riconoscere un Entelechia a virtu innata attiva ne'corpi corrispondente per analogia al niso\n[[842.24]] de' gravi al centro, o al globo: e consistente in un attuale nozione de' corpi impressa continuamente,\n[[842.25]] o conservata in essi dal Autore della natura. Di che pero la spiegazione spero che\n[[842.26]] haverò la sorte di leggere nella sua opera, non havendo trovato chi chiaramente e distintamente\n[[842.27]] ne parli: e per altro parendomi che tutte le sette de Filosofi sotto diversi vocaboli l'ammettano\n[[842.28]] eccetto forse i Peripatetici scolastici. Se il tempo me lo permettesse volontierissime m'allargherei\n[[842.29]] con V.S. Ill^#'m^#'a sù quest'argumento. </p>\n<p> [[843.1]] Quanto alla correzzione del Calendario è vero che ne fù parlato in Roma, mà attese le altre\n[[843.2]] gravi occupazioni della Corte si crede che se non si fà instanza a Prencipi e segnatamente dal\n[[843.3]] Imperatore l'affare qui non sia per promuoversi: in tal caso però non si mancherebbe dal\n[[843.4]] P. Generale (il quale è alto stimatore del merito di V.S.) di conconcorrere e offerire l'opera de\n[[843.5]] suoi sudditi. E per fine resto riverendola con tutto l'ossequio del mio animo </p>\n<p> [[843.6]] Devo^#'m^#'o et obl^#'m^#'o servi^#'r^#'e Gio. Batt^#'a Tolomei. </p>\n<p> [[843.7]] Roma 4 7^#'b^#'r^#'e 1694. </p>\n","number":"283.","title":"GIOVANNI BATTISTA TOLOMEI AN LEIBNIZ","date":"Rom, 4. September 1694. [269.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>