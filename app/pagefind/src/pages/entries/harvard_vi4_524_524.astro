    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:412. De Ecclesia Catholica [Februar bis Oktober 1685 (?)] [Februar bis Oktober 1685 (?)] [Anfang fehlt] aliquid et pietatis habet, verba Servatoris sine tremore legere attente legere non poterit, quibus Ecclesiae jurisdictionem stabilivit, dicens Matth. XVIII quaecunque alligaveritis super terram er...">

