---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_41",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 41,
  "text": "<p> [[121.1]] <b>35a. LEIBNIZ AN JOHANN HEINRICH HORB</p>\n<p> [[121.2]] [Mainz,] 2.(12.) Januar 1671</b></p>\n<p> [[121.12]] Ex responsione ad literas Horbianas 2 Jan. 1671. Styl. vet. </p>\n<p> [[121.13]] Memorabile est quod de Joach. Stollii sudore lucido refers. Memini in Borelli <i>observationibus</i>\n[[121.14]] similia exempla legere, sed obiter, ac sine circumstantiarum luce relata. Constat et\n[[121.15]] Bartolinum peculiari opusculo <i>de animalium luce</i> disseruisse. Hyeme efflorescere, rationi\n[[121.16]] consentaneum est, quo tempore intestini caloris vis major. Saccarum collisum, pilos felium\n[[121.17]] mulcendo frictos, in tenebris micare, squamas etiam piscium nonnullorum lucere constat.\n[[121.18]] <b>Lucem</b> equidem certum est esse motum partium corporis lucidi intestinum tam fortem ut\n[[121.19]] partes emissae in omne circa punctum sensibile motum propagent, differreque a <b>calore</b> sola\n[[121.20]] subtilitate. Erit ergo flos quasi quidam caloris bene depurati. Nec refert, quod calor tactu non\n[[122.1]] sentitur, nam et cicindelae tactu frigidae sunt, quas tamen lucem longa ad solem apricatione\n[[122.2]] aestivis diebus colligere credibile est. Erit ergo sudor lucens, nihil aliud quam calor (ignis)\n[[122.3]] purus et subtilis, humori viscoso sed bene subacto et transparenti, uno verbo <b>Gelatinae</b>\n[[122.4]] mixtus. Gelatinae enim omnes die lucent, noctu non omnes. Stollianam autem etiam noctu\n[[122.5]] lucere ex tuis suspicor, quod discrimen in solo gradu consistit. </p>\n<p> [[122.6]] Cum diu multumque cogitassem de hypothesi quadam Physica struenda, quae phaenomenis\n[[122.7]] omnibus satisfaceret, visus sum mihi tandem pretium operae nonnullum fecisse, detexisse\n[[122.8]] enim mihi videor motum quendam universalem in globo nostro, ex quo solo quod mireris\n[[122.9]] pene omnium globi nostri phaenomenorum, directionum, attractionum, sympathiarum, antipathiarum,\n[[122.10]] reactionum, praecipitationum, gravitatis, vis Elasticae, ratio peti possit. Forte dicta\n[[122.11]] hic sunt quaedam quae hactenus a nullo. Non quod possim aut ego, aut quisquam, paucis\n[[122.12]] exceptis, in quibus ars naturam imitari potest (quod unicum causae proximae cognitae <greek>krith́rion</greek>\n[[122.13]] est), proximas atque plenas rerum naturalium causas exhibere. Nam qui hoc posset,\n[[122.14]] esset in natura omnipotens, quidlibet ex quolibet facturus: materia enim omnium eadem est.\n[[122.15]] Sed quod non contemnendus ad veram causam integram gradus sit, nosse veram causam\n[[122.16]] motricem, etsi omnes ejus determinationes, vias, gradus, combinationes, applicationes nosse\n[[122.17]] hactenus nemini mortalium datum sit. </p>\n",
  "number": "35a.",
  "title": "LEIBNIZ AN JOHANN HEINRICH HORB",
  "date": "[Mainz,] 2.(12.) Januar 1671"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:35a. LEIBNIZ AN JOHANN HEINRICH HORB [Mainz,] 2.(12.) Januar 1671 Ex responsione ad literas Horbianas 2 Jan. 1671. Styl. vet. Memorabile est quod de Joach. Stollii sudore lucido refers. Memini in Borelli observationibus similia exempla legere, sed obiter, ac sine circumstantiarum luce relata. Consta...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>