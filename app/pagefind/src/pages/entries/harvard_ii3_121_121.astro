---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_121",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 121,
  "text": "<p> [[321.1]] <b>121. LEIBNIZ AN VINCENT PLACCIUS</p>\n<p> [[321.2]] Hannover, 4. (14.) Juni 1697. [117.124.]</b></p>\n\n<p> [[321.11]] In causa haud dubie ipse sum, quod meum in edendis <i>Sinicis</i> consilium non satis percepisti,\n[[321.12]] dum locutus sum paulo obscurius. Ego in praefatione studiose evitavi quae poterant\n[[321.13]] irritare Jesuitas, non quod putem illos nostris in illas regiones accessuris fauturos, cum nec\n[[321.14]] Batavi ipsis euntibus faveant, sed ut ipsorum communicationibus porro utar privatim. Caeterum\n[[321.15]] nostri in eas regiones accessuri ipsorum ope non indigebunt. Nam Monarcha tanti imperii in\n[[321.16]] Jesuitis non nisi scientias Europaeas aestimat, in [quibus] nostri, ut minimum dicam ipsis non\n[[321.17]] concedunt. Quin puto sapientes gentis puriorem religionem vel ipsa natura duce magis probaturos,\n[[321.18]] si vel maxime concertationes evitari non possint. Caeterum ipsis Jesuitis cum Dominicanis\n[[321.19]] et Episcopis a Papa missis, imo Jesuitis ipsis inter se, nempe Lusitanis et Italis cum\n[[321.20]] Gallis certamina fuere, quae prolixe edisserere nolui, ne ipsis aegre facerem. </p>\n<p> [[321.21]] Dissertationes Te subinde editurum gaudeo et nobis gratulor. Pro diss. elegante <i>de Antizelia</i>\n[[321.22]] utili argumento gratias ago. Dn. Weigelium non ita res instituere ut bene procedere\n[[321.23]] possint, doleo. Pene in mentem venit ipsi suadere ut Magnum Moscorum Czarem adeat, de quo\n[[321.24]] nunc peregrinante mira mihi Regiomonte scribuntur, ardenti enim studio fertur ad res suae\n[[321.25]] gentis emendandas. Quid Dn. Weigelius optare magis possit? Quin imo jam nunc decerno, vel\n[[321.26]] si irrideatis litteras ad eum hic occludere. Jenae non est, ubi sit Dn. Bussingius haud dubie\n[[322.1]] novit, cui cum officiosa a me salute has litteras curandas ad ipsum commendari peto. Ajunt\n[[322.2]] Ratisbonam vel Viennam rediisse. Quodsi certam curandi rationem non habetis, fac quaeso ut\n[[322.3]] mature ad me remittantur. </p>\n<p> [[322.4]] Caeterum non curo, si quis pia et recta desideria dicat effectu caritura. Nos nostra agamus,\n[[322.5]] Deus suum aget cum volet. Suadeamus bona, quantum aures hominum ferre possunt; agamus\n[[322.6]] etiam quantum non stat per potentiores. Nam velle ultra ire sine peculiari Dei impulsu auxilioque,\n[[322.7]] est bona inconsulte quaerendo mala pejora reddere, ut solent qui dant turbas emendandi\n[[322.8]] praetextu. Nihil igitur praeter prudentiae leges agamus vel dicamus. Et si spartam nostram qua\n[[322.9]] pote ornaverimus, contenti simus. Quid dicis de indicio autoris libri inscripti: <i>Cautio criminalis</i>,\n[[322.10]] quod tibi feci[?] </p>\n<p> [[322.11]] Hanoverae d. 4. Jun. 1697. </p>\n",
  "number": "121.",
  "title": "LEIBNIZ AN VINCENT PLACCIUS",
  "date": "Hannover, 4. (14.) Juni 1697. [117.124.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:121. LEIBNIZ AN VINCENT PLACCIUS Hannover, 4. (14.) Juni 1697. [117.124.] In causa haud dubie ipse sum, quod meum in edendis Sinicis consilium non satis percepisti, dum locutus sum paulo obscurius. Ego in praefatione studiose evitavi quae poterant irritare Jesuitas, non quod putem illos nostris in i...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>