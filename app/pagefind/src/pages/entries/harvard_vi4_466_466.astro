---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_466",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 466,
  "text": "[[2068.1]] <b>377₂.  De praestantia systematis Copernicani. Erste Fassung </p>\n<p> [[2068.3]] Praeclare a Cicerone dictum est: <i>opinionum</i> <i>commenta delet dies, naturae judicia\n[[2068.4]] confirmat</i>. Id circa verum Mundi Systema experimur. Novis enim quotidie inventis\n[[2068.5]] Pythagoraea Hypothesis ad summam verisimilitudinem accedit. Ut jam vix quisquam sit\n[[2068.6]] intelligentiorum Mathematicarum qui non praeferendam fateatur, si modo per superiorum\n[[2068.7]] decreta liceret. </p>\n<p> [[2068.8]] Mihi vero videtur censuram in Galilaeum non ita accipi debere quasi eos in universum\n[[2068.9]] damnet, qui Hypothesin Copernici veriorem credunt, sed hos tantum qui temere\n[[2068.10]] eam propugnant, et Scripturam Sacram minus proprie locutam audacius censent. </p>\n<p> [[2068.11]] Hodie autem omnes intelligentes fatentur tantis nove repertis argumentis adjuvari\n[[2068.12]] Copernicanos, ut temeritas illis imputari amplius non possit, et prudentiores ex ipsis\n[[2068.13]] fatentur ac defendunt Scripturam Sacram proprie et apte fuisse locutam, imo aliter non\n[[2068.14]] debuisse nec potuisse etiamsi ipsi scriptores ex schola Copernici prodiisse fingerentur. </p>\n<p> [[2068.15]] Itaque interesse et Reipublicae literariae, et ipsius Ecclesiae videtur, ut ne amplius\n[[2068.16]] obex ingeniis in hoc argumento ponatur, neve adversariis calumniandi ansa detur, quasi\n[[2068.17]] veritas in Italia intolerabili quadam servitute opprimatur. </p>\n<p> [[2068.18]] Quod ut admoneam studiosius ansam mihi dedere cogitationes quaedam, quae nobis\n[[2068.19]] arcana systematis et physicas motuum coelestium causas pro bona parte aperire videntur,\n[[2068.20]] quae nunc paucis attingam. </p>\n<p> [[2069.1]] Cum nempe viderem Keplerum ex Tychonicis observationibus et meditationibus\n[[2069.2]] propriis leges quasdam generales pulcherrimas Motuum Coelestium invenisse, phaenomenis\n[[2069.3]] valde satisfacientes, unde facile apparebat physicas quasdam rationes subesse\n[[2069.4]] debere; ego diu in causarum investigationem incubui, tandemque subita quadam luce\n[[2069.5]] hausta prope supra ipsam spem mihi visus sum magna voti parte positus. </p>\n<p> [[2069.6]] Leges planetariae hae sunt 1) Planetam (primarium) ferri in Ellipsi in cujus foco sol,\n[[2069.7]] 2) tempora ejusdem planetae esse Sectoribus Ellipticis ex sole abscissis proportionalia, 3)\n[[2069.8]] quadrata a temporibus periodicis diversorum planetarum esse ut cubos mediarum a sole\n[[2069.9]] distantiarum. </p>\n<p> [[2069.10]] Ex lege 2^#'d^#'a demonstravi planetam atque adeo aethera ejus deferentem circulari\n[[2069.11]] harmonice, id est sic ut distantiis a sole existentibus progressionis Arithmeticae, sint\n[[2069.12]] velocitates circulationis progressionis Harmonicae; et contra. Generale enim theorema\n[[2069.13]] inveni, si mobile moveatur motu composito ex circulatione harmonica circa aliquod\n[[2069.14]] centrum, et motu quocunque paracentrico respectu ejusdem centri describere areas temporibus\n[[2069.15]] proportionales; et contra. Et vicissim si has describat, motum ejus in dictam\n[[2069.16]] circulationem resolvi posse. </p>\n<p> [[2069.17]] Deinde investigavi, quaenam debeat esse lex motus paracentrici seu attractionis ad\n[[2069.18]] solem. </p>\n",
  "number": "377₂.",
  "title": "De praestantia systematis Copernicani. Erste Fassung",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:377₂. De praestantia systematis Copernicani. Erste Fassung Praeclare a Cicerone dictum est: opinionum commenta delet dies, naturae judicia confirmat. Id circa verum Mundi Systema experimur. Novis enim quotidie inventis Pythagoraea Hypothesis ad summam verisimilitudinem accedit. Ut jam vix quisquam s...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>