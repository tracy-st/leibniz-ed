---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_288",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 288,
  "text": "<p> [[872.9]] <b>253. LEIBNIZ AN VEIT LUDWIG VON SECKENDORFF</p>\n<p> [[872.10]] [26. Juli 1685.] [252.]</b></p>\n<p> [[872.21]] Ill^#'m^#'e ac Generosissime Dⁿ^#'e </p>\n<p> [[872.22]] Incomparabile opus Tuum, de vera ratione status Christianorum transmittente D. Menckenio\n[[872.23]] nostro recte accepi, lautoque muneri quo me beasti et communes cum iis omnibus, ad quos\n[[872.24]] inde fructus pervenire potest maximus, et privatas gratias ago. Habemus sane multa pie et\n[[872.25]] quaedam erudite et sapienter et nonnulla etiam eloquenter scripta nostro sermone vernaculo,\n[[872.26]] sed ubi omnes illae laudes tanta mensura collectae ac cumulatae reperiantur, equidem extra\n[[873.1]] librum tuum videre me non memini. Plura non addo, ne mediocria de eo dicendo veritatem,\n[[873.2]] digna tentando modestiam tuam offendam. Ubi primum accepi, temperare mihi non potui, quin\n[[873.3]] statim pervaderem a capite ad calcem; maxima cum delectatione. Nunc vero, ubi a Bibliopego\n[[873.4]] recepi, in eo sum ut attente relegam, et singulis partibus immorer quo majorem inde fructum\n[[873.5]] percipiam. Si quis mihi notus esset Gallus Germanicae linguae peritus, et scribendo validus, ei\n[[873.6]] autor essem ego futurus, ut transfunderet in suam linguam. </p>\n<p> [[873.7]] Novissimas meas circa superiores nundinas recte perlatas spero. Nuper legi missum ad\n[[873.8]] Serenissimam nostram libellum vel potius Schediasma Ducis Buckinghamii pro veritate Religionis,\n[[873.9]] Anglica lingua scriptum cujus illa est intelligentissima. Ingenium sane autoris ostendit,\n[[873.10]] quanquam sint quae non satis liquido confirmantur. Aliqua video inspergi quae a Weigelii\n[[873.11]] nostri placitis non abhorrent et a me aliquando expensa sunt. Putat enim nihil manere idem, sed\n[[873.12]] omnia esse in perpetuo fluxu excepto Deo. Weigelii demonstrationem existentiae Dei, quam\n[[873.13]] Germanica pariter ac latina lingua aliquot abhinc annis amicis communicavit, vidisse te arbitror.\n[[873.14]] Mihi valde consideratu digna videtur, tametsi nonnulla supplenda videri monuerim, quorum\n[[873.15]] adhuc demonstrationem desiderabam. Optima mihi haec videtur via si ostendi posset\n[[873.16]] omnia accidentia nihil aliud esse quam modos substantiam concipiendi, ita enim demonstratum\n[[873.17]] esset quod illi ponunt, substantias ipsas revera non durare, si rem ad summam <greek>ăkribeían</greek>\n[[873.18]] exigas, sed alias atque alias prioribus similes vel si mavis easdem a Deo continue creari, Deus\n[[874.1]] autem necessario eximi deberet, alioqui si omnia continuo perirent, ne ipso quidem excepto,\n[[874.2]] nihil esset quod ea restitueret, nam ubi semel nihil esset in toto universo, in aeternum nihil\n[[874.3]] maneret. Sed haec occasione Buckinghamiarum meditationum. Cum vero in eodem libello Dux\n[[874.4]] tolerationem heterodoxorum suasisset Anglis, exortus est refutator quidam anonymus, cujus\n[[874.5]] schedam vidi, sed quae exigui momenti apparuit. Vale. </p>\n",
  "number": "253.",
  "title": "LEIBNIZ AN VEIT LUDWIG VON SECKENDORFF",
  "date": "[26. Juli 1685.] [252.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:253. LEIBNIZ AN VEIT LUDWIG VON SECKENDORFF [26. Juli 1685.] [252.] Ill^#'m^#'e ac Generosissime Dⁿ^#'e Incomparabile opus Tuum, de vera ratione status Christianorum transmittente D. Menckenio nostro recte accepi, lautoque muneri quo me beasti et communes cum iis omnibus, ad quos inde fructus perven...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>