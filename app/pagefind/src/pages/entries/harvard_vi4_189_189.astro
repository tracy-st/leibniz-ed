---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_189",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 189,
  "text": "[[667.7]] <b>156₁.  Erste Fassung ERSTE FASSUNG </p>\n<p> [[667.12]] Extensum est totum continuum. </p>\n<p> [[667.13]] Extensi partes sunt coexistentes. </p>\n<p> [[667.14]] Extensum omne est pars alterius cujusdam extensi. </p>\n<p> [[667.15]] Duo quaelibet extensa data sunt partes ejusdem alicujus extensi. </p>\n<p> [[667.16]] In quolibet corpore habetur extensum dato simile. </p>\n<p> [[668.1]] Dato quolibet extenso datur aliud congruum cujus pars sit in corpore dato. </p>\n<p> [[668.2]] Extensum est continuum habens partes coexistentes. </p>\n<p> [[668.3]] Continuum est cujus partes sunt indefinitae. </p>\n<p> [[668.4]] Spatium infinitum est extensum uniforme in quo extensum, quodcunque existere\n[[668.5]] ponitur, existit. </p>\n<p> [[668.6]] Corpus ubique uniforme est, praeter quam in parte cujus termini pars eadem est cum\n[[668.7]] parte termini totius. </p>\n<p> [[668.8]] Corporis <i>A</i> aliqua pars <i>B</i> assumi potest, talis, ut si assumatur aliud <i>C</i> nullam habens\n[[668.9]] partem in <i>A</i> existentem, non possit dari aliquod comprehen[den]s tam <i>B</i> quam <i>C</i>, quin\n[[668.10]] partem habeat intra <i>A</i>. Et haec est notio profunditatis. </p>\n<p> [[668.11]] Satius forte simplicissimas adhibere notiones. </p>\n<p> [[668.12]] <b>Spatium</b> mundanum est quod extensum est, et in quo est omne quod in extenso\n[[668.13]] est. </p>\n<p> [[668.14]] Duo quaelibet extensa <i>A</i> et <i>B</i>, sunt in eodem extenso <i>C.</i> Vel adhuc generalius: Duo\n[[668.15]] quaelibet <i>A</i> et <i>B</i> quorum unumquodque in aliquo extenso est (licet diverso), sunt in\n[[668.16]] eodem extenso. </p>\n",
  "number": "156₁.",
  "title": "Erste Fassung",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:156₁. Erste Fassung ERSTE FASSUNG Extensum est totum continuum. Extensi partes sunt coexistentes. Extensum omne est pars alterius cujusdam extensi. Duo quaelibet extensa data sunt partes ejusdem alicujus extensi. In quolibet corpore habetur extensum dato simile. Dato quolibet extenso datur aliud con...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>