---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi3_85",
  "series": "Band VI 3 (1672-1676); durchgesehener Nachdruck 1980",
  "seq": 85,
  "text": "[[583.85]] <b>85. Catena mirabilium demonstrationum de summa rerum. </b> <span>583.0;0:63:085:76!      :L:l^</span>.\n[[583.1]] Idem est ex alicuius possibilitate sequi existentiam, et ex alicuius essentia sequi\n[[583.2]] existentiam, quia idem est rei essentia et specialis ratio possibilitatis, seu ex quo\n[[583.3]] concepto rem possibilem esse distincte sive a priori concipitur: a priori inquam, id est\n[[583.4]] non ab experientia, sed ex ipsa rei natura, quemadmodum numerum ternarium, lineam\n[[583.5]] circularem, aliaque id genus possibilia esse concipimus, etsi nunquam ea reapse\n[[583.6]] existere essemus experti, vel saltem nulla huius experimenti habita ratione.\n[[583.7]] Idem est Ens a se, et Ens ex cuius Essentia sequitur Existentia, nempe Ens cui\n[[583.8]] essentiale est Existere, seu quod per suam essentiam existit.\n[[583.9]] Idem quoque est Ens necessarium, et Ens ex cuius essentia sequitur existentia;\n[[583.10]] Ens scilicet necessarium est, quod necessario existit, ita ut ipsum non existere implicet\n[[583.11]] contradictionem, atque adeo cum conceptu seu essentia huius Entis pugnet.\n[[583.12]] Itaque de conceptu seu Essentia eius est existentia.\n[[583.13]] Hinc habemus praeclarum Theorema, quod est fastigium doctrinae Modalium,\n[[583.14]] et quo transitur mirabili ratione, a potentia ad actum:\n[[583.15]] Si Ens necessarium est possibile, sequitur quod existat actu seu quod tale Ens\n[[583.16]] actu reperiatur in Universo.\n[[584.2]] Catena mirabilium demonstrationum de Summa rerum\n[[584.3]] Nihil simul est et non est, vel quidlibet vel est vel non est. Nunc aliquid fieri est\n[[584.4]] circa praesentia. Praeteritum autem aut futurum, nunc aliquid suscipere, esset ipsum\n[[584.5]] esse praesens; nihil autem simul praesens et praeteritum, hinc factum fieri non potest\n[[584.6]] infectum, nec futurum aliquid esse desinit, nisi cum fit praesens.\n[[584.7]] Nihil est sine causa, quia nihil est sine omnibus ad existendum requisitis.\n[[584.8]] Effectus integer aequipollet causae plenae, quia aequatio quaedam debet\n[[584.9]] esse inter causam et effectum, transiens ex uno in aliud. Ea vero consistit in hac\n[[584.10]] aequipollentia, nec alia mensura reperiri posset. Non nisi unum est genus Mundi, seu\n[[584.11]] nulla dantur Entia praeter corpora et mentes, seu qualia sentimus, nec corpora, nisi\n[[584.12]] quorum distantia certa a nobis. Nam si dentur, non poterit dici sintne nunc an non\n[[584.13]] sint. Quod est contra primum principium. Hinc jam sequitur non omnia possibilia\n[[584.14]] existere.\n[[584.15]] Spatium et tempus esse infinita, quaerenda demonstratio perfecta. Dicere tempus\n[[584.16]] fuisse sine rebus, est nihil dicere, quia eius temporis quantitas per nullam notam\n[[584.17]] determinari potest. Quia causa aequipollet effectui non perfectione sed expressione,\n[[584.18]] non potest aliquando incepisse creaturarum ordo, sed semper aliquid fuit praeter\n[[584.19]] Deum seu Deus semper aliquid creavit, pater meus usque operatur. Magnum discrimen\n[[584.20]] inter tempus et lineam, intervallum inter duos status momentaneos inter quos\n[[584.21]] nihil intercessit nullo posset modo determinari, nec dici potest quot res interjici potuerint,\n[[584.22]] cur enim non plures. Quod non est in spatio, ut si globus sit intus vacuus.\n[[584.23]] Itaque quae in tempore inter quae nihil (intercedit), ea se tangunt, quod non est in\n[[584.24]] spatio ob situm.\n[[585.1]] Spatium esse infinitum vel hinc demonstratur, quia qualecunque ponatur nulla\n[[585.2]] est ratio cur non factum sit majus. Nullam autem rationem reddi posse patet, quia\n[[585.3]] summa in eo homogeneitas, et eius existentia aliis rebus non obstat. Aliquid faciendum\n[[585.4]] fuisse ex eo patet quia aliquid factum est, et quia nulla ratio determinans quantum,\n[[585.5]] seu limitans, erit quantum maximum esse potest seu absolute infinitum.\n[[585.6]] Eodem argumento postea probatur etiam nullum dari vacuum vel interspersum\n[[585.7]] vel magnum, quia omnia impleri possibile est. Aliunde peculiariter refutetur spatium\n[[585.8]] magnum ultramundanum in quo infinito mundus finitus, quia materia haec in ipsum\n[[585.9]] dispergeretur, neque unquam recolligeretur. Posita plenitudine demonstrantur atomi.\n[[585.10]] Imo et sine plenitudine, ex ea sola consideratione quod omne flexile dividetur in\n[[585.11]] puncta.\n[[585.12]] Videtur rationi valde consentaneum, ut corpora primitiva omnia sint sphaerica,\n[[585.13]] directiones autem omnes rectilineae. Corpora cohaerentia ex eo, si scilicet corpora\n[[585.14]] quaedam in fornicem componantur intus cavum, id est materia subtiliore plenum,\n[[585.15]] qui fornix difficulter dissolvetur quia pori a componentibus relicti minores sunt,\n[[585.16]] quam ut pervii sint materiae circumstanti ad locum replendum. Haec corpora firma\n[[585.17]] fere in globosam quantumlibet redigentur formam, quia sic quam minime obstant\n[[585.18]] circumstantibus, et quia id fieri potest sine dissolutione. Hinc omnia ex globis, et\n[[585.19]] tametsi non essent globi infima elementa, tamen semper rediretur ad globos, inutilis\n[[585.20]] ergo foret figurarum in Atomis varietas quare sufficit esse Atomos omnes globosas.\n[[585.21]] Optima demonstratio, quod corpus a spatio seu extensione differat, ex eo sumitur,\n[[585.22]] quod ex sola extensione seu longitudinis latitudinis et profunditatis notione\n[[585.23]] demonstrari non potest impenetrabilitas, seu quod duo extensa non possint esse in\n[[585.24]] eodem loco sive quod impossibile sit duo esse extensa, solida inter se congruentia, seu\n[[585.25]] quorum nullum punctum sit Punctum, quod non distantia ab aliquo alterius puncto\n[[585.26]] careat.\n",
  "number": "85.",
  "title": "Catena mirabilium demonstrationum de summa rerum.",
  "date": ""
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:85. Catena mirabilium demonstrationum de summa rerum. 583.0;0:63:085:76! :L:l^. Idem est ex alicuius possibilitate sequi existentiam, et ex alicuius essentia sequi existentiam, quia idem est rei essentia et specialis ratio possibilitatis, seu ex quo concepto rem possibilem esse distincte sive a prio...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>