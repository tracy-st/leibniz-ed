---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_147",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 147,
  "text": "<p> [[477.1]] <b>147. LEIBNIZ AN JACQUES BERNARD</p>\n<p> [[477.2]] [Hannover, Ende September bis Mitte Oktober 1706]. [133.] </b></p>\n<p> [[477.23]] Monsieur </p>\n<p> [[477.24]] Vos <i>nouvelles de la Republique des lettres</i> estant fort instructives, j'ay coustume de les lire\n[[477.25]] pour estre mieux informé de ce qui se passe dans le pays literaire. Et comme j'y ay remarqué un\n[[477.26]] endroit qui me touche, où vous donnés l'extrait d'un recit qui regarde l'Histoire de mon\n[[477.27]] invention de l'Analyse infinitesimale, mais qui n'est pas trop bien fondé; j'ay crû necessaire,\n[[478.1]] Monsieur, de vous envoyer le papier cyjoint qui en contient une narration exacte et circomstantiée,\n[[478.2]] approuvée même par Monsieur Bernoulli professeur maintenant à Bale et auparavant à\n[[478.3]] Groningue, qui avec feu Monsieur son frere y est le plus interessé à qui je l'avois communiqué,\n[[478.4]] et c'est la cause que vous le recevés un peu tard. Quoyque la narration que je refute, paroisse\n[[478.5]] fait pour favoriser ces Messieurs en apparence à mes depens; ils ont esté tousjours trop\n[[478.6]] raisonnables pour avoir des telles pretensions et leur avantages veritables et solides sont assez\n[[478.7]] grands sans qu'ils ayent besoin d'en chercher de faux. Aussi se seroient ils crû deshonnorés par\n[[478.8]] les procedés artificieux et injustes qu'on leur attribue. Ainsi je ne doute point que vous ne nous\n[[478.9]] fassiés la justice de publier nostre Apologie. Peutestre qu'un savant Medecin ecossois de mes\n[[478.10]] amis vous aura monstré en passant une longue lettre que je luy ay donnée pour Monsieur Coste\n[[478.11]] traducteur des <i>Essais</i> de M. Lock, et du livre de Mylady Masham contre M. Norris touchant\n[[478.12]] l'Amour divin. Ma Lettre regarde ce dernier livre que Mons. Coste m'avoit envoyé. Au reste je\n[[478.13]] suis </p>\n<p> [[478.14]] Monsieur vostre etc. </p>\n<p> [[478.15]] P. S. Si vous aviés quelque chose à m'ordonner Monsieur, vous pourriés l'envoyer à\n[[478.16]] Monsieur Mezquita Agent de Madame l'Electrice de Bronsvic à Amsterdam. </p>\n",
  "number": "147.",
  "title": "LEIBNIZ AN JACQUES BERNARD",
  "date": "[Hannover, Ende September bis Mitte Oktober 1706]. [133.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:147. LEIBNIZ AN JACQUES BERNARD [Hannover, Ende September bis Mitte Oktober 1706]. [133.] Monsieur Vos nouvelles de la Republique des lettres estant fort instructives, j'ay coustume de les lire pour estre mieux informé de ce qui se passe dans le pays literaire. Et comme j'y ay remarqué un endroit qu...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii4_147","series":"Band II 4 (1701 - 1707)","seq":147,"text":"<p> [[477.1]] <b>147. LEIBNIZ AN JACQUES BERNARD</p>\n<p> [[477.2]] [Hannover, Ende September bis Mitte Oktober 1706]. [133.] </b></p>\n<p> [[477.23]] Monsieur </p>\n<p> [[477.24]] Vos <i>nouvelles de la Republique des lettres</i> estant fort instructives, j'ay coustume de les lire\n[[477.25]] pour estre mieux informé de ce qui se passe dans le pays literaire. Et comme j'y ay remarqué un\n[[477.26]] endroit qui me touche, où vous donnés l'extrait d'un recit qui regarde l'Histoire de mon\n[[477.27]] invention de l'Analyse infinitesimale, mais qui n'est pas trop bien fondé; j'ay crû necessaire,\n[[478.1]] Monsieur, de vous envoyer le papier cyjoint qui en contient une narration exacte et circomstantiée,\n[[478.2]] approuvée même par Monsieur Bernoulli professeur maintenant à Bale et auparavant à\n[[478.3]] Groningue, qui avec feu Monsieur son frere y est le plus interessé à qui je l'avois communiqué,\n[[478.4]] et c'est la cause que vous le recevés un peu tard. Quoyque la narration que je refute, paroisse\n[[478.5]] fait pour favoriser ces Messieurs en apparence à mes depens; ils ont esté tousjours trop\n[[478.6]] raisonnables pour avoir des telles pretensions et leur avantages veritables et solides sont assez\n[[478.7]] grands sans qu'ils ayent besoin d'en chercher de faux. Aussi se seroient ils crû deshonnorés par\n[[478.8]] les procedés artificieux et injustes qu'on leur attribue. Ainsi je ne doute point que vous ne nous\n[[478.9]] fassiés la justice de publier nostre Apologie. Peutestre qu'un savant Medecin ecossois de mes\n[[478.10]] amis vous aura monstré en passant une longue lettre que je luy ay donnée pour Monsieur Coste\n[[478.11]] traducteur des <i>Essais</i> de M. Lock, et du livre de Mylady Masham contre M. Norris touchant\n[[478.12]] l'Amour divin. Ma Lettre regarde ce dernier livre que Mons. Coste m'avoit envoyé. Au reste je\n[[478.13]] suis </p>\n<p> [[478.14]] Monsieur vostre etc. </p>\n<p> [[478.15]] P. S. Si vous aviés quelque chose à m'ordonner Monsieur, vous pourriés l'envoyer à\n[[478.16]] Monsieur Mezquita Agent de Madame l'Electrice de Bronsvic à Amsterdam. </p>\n","number":"147.","title":"LEIBNIZ AN JACQUES BERNARD","date":"[Hannover, Ende September bis Mitte Oktober 1706]. [133.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>