---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_73",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 73,
  "text": "<p> [[195.1]] <b>73. LEIBNIZ AN HENRI BASNAGE DE BAUVAL</p>\n<p> [[195.2]] [Hannover,] 8./18. September 1696. [67.91.]</b></p>\n\n<p> [[195.10]] Monsieur </p>\n<p> [[195.11]] Vous <Fn><i>Am Kopf der Seite von Leibniz' Hand</i>: à M. Bauval à la Haye 8/18 Sept. 1696.</Fn> aurés receu ma derniere où j'avois joint des vers sur feu Monsieur Hugens, que je\n[[195.12]] vous envoye de nouveau parce que j'ay changé quelques mots, par exemple au lieu de <i><b>Tutus</i></b> <i>et\n[[195.13]] in mediis navita fertur aquis</i> j'ay mis <i><b>certus</b> et in</b> etc. Car les longitudes qu'on peut connoître\n[[195.14]] en quelque façon par les pendules ne garantissent point le vaisseau des dangers de toute sorte,\n[[195.15]] mais le rendent au moins plus certain de sa route. </p>\n<p> [[195.16]] Mons. Dartis depuis quelque temps ne continue point son <i>Journal</i>, mais en echange\n[[195.17]] M. Chauvin pousse le sien à Berlin. On imprime quelque chose en Italie sous le titre de\n[[195.18]] <i>Galleria di Minerva</i>, qui a l'air d'un Journal. Mons. l'Abbé Fardella professeur à Padoue m'en\n[[195.19]] a envoyé un échantillon, où l'on fait rapport d'un livre qu'il prepare pour nous expliquer <b>la</b>\n[[196.1]] <b>Philosophie de S. Augustin</b> dans son livre <i>de quantitate animae</i> et autres ouvrages. Il\n[[196.2]] pretend que ce pere a mieux rencontré que la plupart des philosophes. Et en effect il a puisé du\n[[196.3]] Platonisme le meilleur et de plus convenable à nôtre religion. Cet habile Abbé qui est Professeur\n[[196.4]] de Mathematiques y mettra beaucoup du sien, et comme en passant autresfois à Venise je\n[[196.5]] luy avois fait connoître quelque chose de mes nouvelles hypotheses de philosophie, autant que\n[[196.6]] l'occasion le pouvoit permettre, il l'entendit avec beaucoup d'applaudissemens, et a marqué\n[[196.7]] depuis d'en avoir fait grand usage, et de vouloir pousser plus avant ces meditations. Je suis avec\n[[196.8]] zele. </p>\n",
  "number": "73.",
  "title": "LEIBNIZ AN HENRI BASNAGE DE BAUVAL",
  "date": "[Hannover,] 8./18. September 1696. [67.91.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:73. LEIBNIZ AN HENRI BASNAGE DE BAUVAL [Hannover,] 8./18. September 1696. [67.91.] Monsieur Vous Am Kopf der Seite von Leibniz' Hand: à M. Bauval à la Haye 8/18 Sept. 1696. aurés receu ma derniere où j'avois joint des vers sur feu Monsieur Hugens, que je vous envoye de nouveau parce que j'ay changé ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii3_73","series":"Band II 3 (1695 - 1700)","seq":73,"text":"<p> [[195.1]] <b>73. LEIBNIZ AN HENRI BASNAGE DE BAUVAL</p>\n<p> [[195.2]] [Hannover,] 8./18. September 1696. [67.91.]</b></p>\n\n<p> [[195.10]] Monsieur </p>\n<p> [[195.11]] Vous <Fn><i>Am Kopf der Seite von Leibniz' Hand</i>: à M. Bauval à la Haye 8/18 Sept. 1696.</Fn> aurés receu ma derniere où j'avois joint des vers sur feu Monsieur Hugens, que je\n[[195.12]] vous envoye de nouveau parce que j'ay changé quelques mots, par exemple au lieu de <i><b>Tutus</i></b> <i>et\n[[195.13]] in mediis navita fertur aquis</i> j'ay mis <i><b>certus</b> et in</b> etc. Car les longitudes qu'on peut connoître\n[[195.14]] en quelque façon par les pendules ne garantissent point le vaisseau des dangers de toute sorte,\n[[195.15]] mais le rendent au moins plus certain de sa route. </p>\n<p> [[195.16]] Mons. Dartis depuis quelque temps ne continue point son <i>Journal</i>, mais en echange\n[[195.17]] M. Chauvin pousse le sien à Berlin. On imprime quelque chose en Italie sous le titre de\n[[195.18]] <i>Galleria di Minerva</i>, qui a l'air d'un Journal. Mons. l'Abbé Fardella professeur à Padoue m'en\n[[195.19]] a envoyé un échantillon, où l'on fait rapport d'un livre qu'il prepare pour nous expliquer <b>la</b>\n[[196.1]] <b>Philosophie de S. Augustin</b> dans son livre <i>de quantitate animae</i> et autres ouvrages. Il\n[[196.2]] pretend que ce pere a mieux rencontré que la plupart des philosophes. Et en effect il a puisé du\n[[196.3]] Platonisme le meilleur et de plus convenable à nôtre religion. Cet habile Abbé qui est Professeur\n[[196.4]] de Mathematiques y mettra beaucoup du sien, et comme en passant autresfois à Venise je\n[[196.5]] luy avois fait connoître quelque chose de mes nouvelles hypotheses de philosophie, autant que\n[[196.6]] l'occasion le pouvoit permettre, il l'entendit avec beaucoup d'applaudissemens, et a marqué\n[[196.7]] depuis d'en avoir fait grand usage, et de vouloir pousser plus avant ces meditations. Je suis avec\n[[196.8]] zele. </p>\n","number":"73.","title":"LEIBNIZ AN HENRI BASNAGE DE BAUVAL","date":"[Hannover,] 8./18. September 1696. [67.91.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>