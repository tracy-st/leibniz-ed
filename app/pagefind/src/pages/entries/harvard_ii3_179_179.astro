          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:179. HENRI BASNAGE DE BAUVAL AN LEIBNIZ 12. September [1698]. [141.196.] Le 12 de Sept. Il Am Kopf der Seite von Leibniz' Hand: resp. est vrai Monsieur qu'il y a long temps que je ne vous ay ecrit, et je vous en demande pardon. Mais en verité mes occupations ne me laissent presque pas le loisir de m...">

