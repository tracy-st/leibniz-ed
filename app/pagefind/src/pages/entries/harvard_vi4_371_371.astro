---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_371",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 371,
  "text": "[[1634.1]] <b>314.  De ratione cur haec existant potius quam alia [März bis August 1689 (?)]</b>\n [[1634.2]] <tab/>[März bis August 1689 (?)] </p>\n<p> [[1634.24]] Quae ratio facit ut haec existant potius quam alia, facit etiam ut potius aliquid existat\n[[1634.25]] quam nihil: Nam si ratio reddatur cur haec existant, reddita etiam erit cur aliqua existant.\n[[1634.26]] Haec ratio est in praevalentia rationum ad existendum, prae rationibus ad non existendum\n[[1634.27]] seu ut verbo dicam in Existiturientia Essentiarum, ita ut existitura sint quae non impediantur.\n[[1634.28]] Neque enim si nihil existituriret ratio esset existendi. Jam porro ratio reddi non\n[[1634.29]] potest, cur unum possibile pro alio sit existituriens. Posita vero existiturientia omnium,\n[[1634.30]] sequitur existentia quorundam, cum enim omnia coexistere non possint, sequitur existentia\n[[1634.31]] eorum per quae plurima coexistunt. Veluti si <i>a</i> et <i>b</i>, itemque <i>c</i>, essent paria, et <i>a</i>\n[[1635.1]] esset incompatibile cum <i>b</i> et cum <i>c</i>; sed <i>b</i> incompatibile cum <i>a</i> et compatibile cum <i>c</i>; et\n[[1635.2]] similiter <i>c</i> incompatibile cum <i>a</i>, compatibile cum <i>b</i>, sequeretur non existere omnia tria\n[[1635.3]] simul <i>a, b, c</i>; neque unum tantum <i>a</i>, vel <i>b</i>, vel <i>c</i>, sed bina et ex binionibus non <i>ab</i>, neque\n[[1635.4]] <i>ac</i>, sed sola <i>bc</i>. Hinc patet omne possibile tendere ad existendum ex se, sed per accidens\n[[1635.5]] impediri, nec esse alias rationes non existendi, nisi ex ipsis existendi rationibus conjunctis\n[[1635.6]] natas. </p>\n<p> [[1635.7]] Caeterum existituritionis essentiarum oportet esse radicem existentem, a parte rei;\n[[1635.8]] alioqui nihil prorsus erit in Essentiis nisi animi figmentum, et cum ex nihilo nil sequatur\n[[1635.9]] erit perpetuum et necessarium Nihil. Haec autem radix non potest alia esse quam Ens\n[[1635.10]] necessarium, fundus essentiarum, fons Existentiarum, id est Deus, agens perfectissime,\n[[1635.11]] quia omnia in ipso et ex ipso; adeoque voluntarie, sed tamen ad id quod optimum est\n[[1635.12]] determinate; eligit ergo id ipsum quod postulat major perfectio in concursu [existiturientium],\n[[1635.13]] qui ipse concursus per hoc ipsum, quod talis primae causae sapientia et potentia\n[[1635.14]] est, ut locum det vimque praestet summae rationi, realis est et effectum habet. Neque\n[[1635.15]] enim nisi in Deo et per Deum Essentiae sibi viam faciunt ad existendum, ita ut in Deo sit\n[[1635.16]] realitas essentiarum, seu aeternarum veritatum, et productio existentiarum, seu contingentium\n[[1635.17]] veritatum. </p>\n",
  "number": "314.",
  "title": "De ratione cur haec existant potius quam alia",
  "date": "[März bis August 1689 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:314. De ratione cur haec existant potius quam alia [März bis August 1689 (?)] [März bis August 1689 (?)] Quae ratio facit ut haec existant potius quam alia, facit etiam ut potius aliquid existat quam nihil: Nam si ratio reddatur cur haec existant, reddita etiam erit cur aliqua existant. Haec ratio e...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>