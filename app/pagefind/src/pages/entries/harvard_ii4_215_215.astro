---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_215",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 215,
  "text": "<p> [[667.16]] <b>215. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[667.17]] Padua, 22. September 1707. [212.221.] </b></p>\n<p> [[667.23]] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o </p>\n<p> [[667.24]] Hò <Fn><i>Am Kopf der Seite von Leibniz' Hand</i>: resp</Fn> ricevuto l'humani^#'m^#'o foglio di V. S. Illu^#'m^#'a 25 del caduto che m'è stato d'un eccessivo\n[[667.25]] contento nel sentire in primo luogo l'ottima di lei salute, e felice ritorno costi, e poi nel vedermi\n[[667.26]] incessantemente così generosamente e con si rara cortesia beneficato, e protetto da V. S. Ill^#'m^#'a\n[[668.1]] che maneggia ora questo mio affare come se fosse suo medesimo, con tanta prudenza e\n[[668.2]] saviezza poiché non posso bramare di vantaggio. Io certamente resto ammirato nel vedere alla\n[[668.3]] sua meravigliosa ed incomparabile letteratura accoppiata una si eroica beneficenza ed un si\n[[668.4]] ardente e vigilantissimo amore verso i suoi Amici e fedeli Servitori fra quali V. S. Ill^#'m^#'a s'è per\n[[668.5]] tanto tempo con tanta mia gloria degnata d'annoverarmi, e nella maniera come V. S. Ill^#'m^#'a và\n[[668.6]] stabilendo e promovendo il mio affare sopra così validi fondamenti non ne posso sperare che un\n[[668.7]] felicissimo esito, dipendendo ciò principalmente dall'impegno della Nova Regina, che si dirà\n[[668.8]] da dovero otterà per me tutto ciò che domanderà dal suo Augu^#'m^#'o Sposo. L'essersi fin ora V. S.\n[[668.9]] Ill^#'m^#'a contenuta in termini generali, è cosa sommamente savia e lodevole, mentre che si potrà poi\n[[668.10]] con migliore effetto descendere al particolare quando il Regno della Sicilia sarà sotto il dominio\n[[668.11]] Austriaco, come perciò che si dice accaderà in breve tempo. Il Sig^#'r^#'e Marchese Querini hà scritto\n[[668.12]] ad un Gentiluomo suo Parente, come anche al Sig^#'r^#'e Zanovelli che unitamente con V. S. Ill^#'m^#'a\n[[668.13]] adopererà i mezzi più efficaci per assistermi e favorirmi, io però unicamente m'abbandono\n[[668.14]] nell'autorevole e potente protettione di V. S. Ill^#'m^#'a, che opera per me con un amore vero e\n[[668.15]] sincero, e può con giustitia sopra d'ogn'altro nel cuore di cotesti Seren^#'m^#'i Principi. Hò letto\n[[668.16]] l'inclusa lettera del Sig^#'r^#'e Barone d'imhof; che m'hà fatto ben concepire quanta sia la bontà e\n[[668.17]] passione che V. S. Ill^#'m^#'a hà presentemente per me, prevenendomi con tanta benignità. Mi figuro\n[[668.18]] che averà ricevuta un'altra mia, in cui v'era incluso un foglio del Dott^#'m^#'o Sig^#'r^#'e Herman, il quale è\n[[668.19]] stato accolto in Venetia da gli Eccell^#'m^#'i Signori Riformatori con una stima distinta, come anche\n[[668.20]] da piu dotti Soggetti, e massimamente da coloro che amano le discipline matematiche ed in\n[[668.21]] particolare la nuova Analisi, che anno ammirato il suo gran sapere, e molto piu l'incomparabile\n[[668.22]] sua Morale. Esso ora si trova in casa mia che si puo vantare d'avere per Ospite un Angelo, io in\n[[668.23]] verita non le posso esprimere quanto sia soave, onesto ed amabile il suo costume veramente\n[[668.24]] cristiano che può servire d'esempio a quanti qui dimoriamo. Io l'amo con tenerezza piu che se\n[[668.25]] fosse mio figliolo medesimo. Egli ora s'apparecchia per la Prolusione nell'ingresso dello Studio\n[[668.26]] che sarà elegantissima, e contiene un grand^#'m^#'o elogio dovuto a V. S. Ill^#'m^#'a come Autore principalmente\n[[668.27]] dell'Arte nuova Analitica, credo che si stamperà, e se ne manderanno poi subito\n[[668.28]] delle copie a V. S. Ill^#'m^#'a. L'Ill^#'m^#'o Sig^#'r^#'e Valsiniero m'hà favorito per servire V. S. Ill^#'m^#'a d'una buona\n[[669.1]] quantità de' frutti istessi del moro coll'inclusa istruttione che la trasmetto a V. S. Ill^#'m^#'a, a cui\n[[669.2]] manderò ben presto una gran scatola de medesimi, quando capiterà qui un mio Dotto Amico di\n[[669.3]] Vicenza che me ne porterà una grand^#'m^#'a misura, così i semi si conserveranno bene fin alla\n[[669.4]] ventura primavera, e V. S. Ill^#'m^#'a riceverà tutto in tempo proprio. Il Sig^#'r^#'e Herman la riverisce, ed\n[[669.5]] io profondamente inchinandola mi protesto </p>\n<p> [[669.6]] Di V. S. Ill^#'m^#'a Umil^#'m^#'o Obl^#'m^#'o Div^#'m^#'o S^#'r^#'e vero Michel Angelo Fardella </p>\n<p> [[669.7]] Padova 22 7^#'b^#'r^#'e 1707 </p>\n",
  "number": "215.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Padua, 22. September 1707. [212.221.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:215. MICHEL ANGELO FARDELLA AN LEIBNIZ Padua, 22. September 1707. [212.221.] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o Hò Am Kopf der Seite von Leibniz' Hand: resp ricevuto l'humani^#'m^#'o foglio di V. S. Illu^#'m^#'a 25 del caduto che m'è stato d'un eccessivo contento nel sentire in p...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>