---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_57",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 57,
  "text": "<p> [[160.11]] <b>57. CLAUDE NICAISE AN LEIBNIZ</p>\n<p> [[160.12]] Dijon, 30. April 1696. [50.68.]</b></p>\n\n<p> [[161.1]] Dijon le 30 avril <b>1696</b> </p>\n<p> [[161.2]] Voilà monsieur une lettre pour monsieur Morel que je prends la liberté de vous adresser;\n[[161.3]] Je la laisse ouverte pour que vous y voyiés ce que je luy mande et que cela me delivre de vous\n[[161.4]] faire une grande lettre; je croy que vous aurés recû ma precedente où j'en avois mis une de\n[[161.5]] mons^#'r le president Boisot. Je n'ay pas dit à mons^#'r Morel une nouvelle qu'on m'ecript de Rome,\n[[161.6]] que le pape n'a pas voulu permettre à mons^#'r Fabretti d'y faire imprimer son grand Receüil\n[[161.7]] d'Inscriptions. On refute en Hollande d'imprimer celles de mons^#'r Gudius, dont vous m'avés\n[[161.8]] ecript de si belles choses; il fault que le siecle soit bien ennemy de la belle antiquité et des\n[[161.9]] sciences, et soit d'un goust bien depravé, temoin ce qu'on vient de me mander au subjet de\n[[161.10]] l'ouvrage de cette Beate Espagnole dont je croy vous avoir parlé dans ma derniere; voicy ce\n[[161.11]] qu'on m'en ecrivoit ancor hier. <i>Il court une lettre facheuse contre mons^#'r de Meaux au subjet de\n[[161.12]] la censure de ce livre intitulé <b>La mystique cité de Dieu</b> composé par la soeur Marie du\n[[161.13]] convent d'Agreda religieuse portugoise traduit en francois par un Recolect et imprimé à\n[[161.14]] Marseille; dans cette lettre on se dechaisne impytoiablement contre ce prelat; elle est adressée\n[[161.15]] au p. Quesnel par un colonel d'Infanterie. Le livre de la religieuse est in fol. en 3 vol. Il y a une\n[[161.16]] infinité de folies et d'extravagances dignes des petites maisons; ce sont des Revelations\n[[161.17]] perpetuelles sur des faicts impertinents. Le 1^#'e^#'r tome est la vie de la vierge dans le ventre de S^#'t^#'e\n[[161.18]] Anne et dans le berceau. Il y a beaucoup de Revelations sur les SS^#'t^#'s et les SS^#'t^#'e^#'s dont on ne trouve\n[[161.19]] point de Reliques comme S^#'t^#'e Anne, S^#'t Joachim, S^#'t Joseph</i> etc. </p>\n<p> [[161.20]] Je ne reçois plus de lettres de nostre philosophe mons^#'r Foucher; il est appliqué à sa\n[[161.21]] traduction de S^#'t Augustin. J'ay faict part à nostre eminence de vostre Beau distique sur sa\n[[162.1]] promotion. Huict jours après sa lettre recûe j'en recûs une d'un de mes amis de Rome qui\n[[162.2]] m'appris la mort de nostre bon amy mons^#'r Bellori. C'est une perte considerable pour Rome et\n[[162.3]] pour la rep. des lettres. Je suis monsieur Tout à vous et du meilleur de mon Coeur. </p>\n",
  "number": "57.",
  "title": "CLAUDE NICAISE AN LEIBNIZ",
  "date": "Dijon, 30. April 1696. [50.68.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:57. CLAUDE NICAISE AN LEIBNIZ Dijon, 30. April 1696. [50.68.] Dijon le 30 avril 1696 Voilà monsieur une lettre pour monsieur Morel que je prends la liberté de vous adresser; Je la laisse ouverte pour que vous y voyiés ce que je luy mande et que cela me delivre de vous faire une grande lettre; je cro...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii3_57","series":"Band II 3 (1695 - 1700)","seq":57,"text":"<p> [[160.11]] <b>57. CLAUDE NICAISE AN LEIBNIZ</p>\n<p> [[160.12]] Dijon, 30. April 1696. [50.68.]</b></p>\n\n<p> [[161.1]] Dijon le 30 avril <b>1696</b> </p>\n<p> [[161.2]] Voilà monsieur une lettre pour monsieur Morel que je prends la liberté de vous adresser;\n[[161.3]] Je la laisse ouverte pour que vous y voyiés ce que je luy mande et que cela me delivre de vous\n[[161.4]] faire une grande lettre; je croy que vous aurés recû ma precedente où j'en avois mis une de\n[[161.5]] mons^#'r le president Boisot. Je n'ay pas dit à mons^#'r Morel une nouvelle qu'on m'ecript de Rome,\n[[161.6]] que le pape n'a pas voulu permettre à mons^#'r Fabretti d'y faire imprimer son grand Receüil\n[[161.7]] d'Inscriptions. On refute en Hollande d'imprimer celles de mons^#'r Gudius, dont vous m'avés\n[[161.8]] ecript de si belles choses; il fault que le siecle soit bien ennemy de la belle antiquité et des\n[[161.9]] sciences, et soit d'un goust bien depravé, temoin ce qu'on vient de me mander au subjet de\n[[161.10]] l'ouvrage de cette Beate Espagnole dont je croy vous avoir parlé dans ma derniere; voicy ce\n[[161.11]] qu'on m'en ecrivoit ancor hier. <i>Il court une lettre facheuse contre mons^#'r de Meaux au subjet de\n[[161.12]] la censure de ce livre intitulé <b>La mystique cité de Dieu</b> composé par la soeur Marie du\n[[161.13]] convent d'Agreda religieuse portugoise traduit en francois par un Recolect et imprimé à\n[[161.14]] Marseille; dans cette lettre on se dechaisne impytoiablement contre ce prelat; elle est adressée\n[[161.15]] au p. Quesnel par un colonel d'Infanterie. Le livre de la religieuse est in fol. en 3 vol. Il y a une\n[[161.16]] infinité de folies et d'extravagances dignes des petites maisons; ce sont des Revelations\n[[161.17]] perpetuelles sur des faicts impertinents. Le 1^#'e^#'r tome est la vie de la vierge dans le ventre de S^#'t^#'e\n[[161.18]] Anne et dans le berceau. Il y a beaucoup de Revelations sur les SS^#'t^#'s et les SS^#'t^#'e^#'s dont on ne trouve\n[[161.19]] point de Reliques comme S^#'t^#'e Anne, S^#'t Joachim, S^#'t Joseph</i> etc. </p>\n<p> [[161.20]] Je ne reçois plus de lettres de nostre philosophe mons^#'r Foucher; il est appliqué à sa\n[[161.21]] traduction de S^#'t Augustin. J'ay faict part à nostre eminence de vostre Beau distique sur sa\n[[162.1]] promotion. Huict jours après sa lettre recûe j'en recûs une d'un de mes amis de Rome qui\n[[162.2]] m'appris la mort de nostre bon amy mons^#'r Bellori. C'est une perte considerable pour Rome et\n[[162.3]] pour la rep. des lettres. Je suis monsieur Tout à vous et du meilleur de mon Coeur. </p>\n","number":"57.","title":"CLAUDE NICAISE AN LEIBNIZ","date":"Dijon, 30. April 1696. [50.68.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>