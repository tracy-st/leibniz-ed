---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_7",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 7,
  "text": "<p> [[29.11]] <b>7. CLAUDE NICAISE AN LEIBNIZ</p>\n<p> [[29.12]] Dijon, 11. Juli 1701. [5.8.] </b></p>\n<p> [[30.1]] Dijon le XI. Jüillet <b>1701</b> </p>\n<p> [[30.2]] J'oubliay <Fn><i>Am Kopf des Briefes von Leibniz' Hand</i>: Mons. l'Abbé Nicaise</Fn> monsieur de vous dire dans la derniere que j'ay eû l'honneur de vous écrire une\n[[30.3]] nouvelle qui ne sera pas tout à faict desagreable à m^#'r Ludolfe. C'est touchant le p. Bonjour,\n[[30.4]] dont les lettres luy paroissoient un peu trop seches et trop steriles: ce pere me mande qu'il a\n[[30.5]] abandonné les Antiquités d'Egypte[;] ses superieurs luy ayant ordonné une autre étude plus\n[[30.6]] conforme à son étât de Religieux, il a cependant faict une Grammaire en langue Copte, ainsy\n[[30.7]] mons^#'r voilà le champ des Antiquités d'Egypte abandonné à mons^#'r l'abbé de la Charmoye\n[[30.8]] autrement le Rev. p. Pezron de l'ordre de Cisteaux qui nous promet bientost son <i>Antiquité des\n[[30.9]] Nations</i>, après nous avoir donné celles <i>des tems</i>; il m'a écrit qu'il y fournie beaucoup de\n[[30.10]] Recherches sur la Langue Celtique, pourveû qu'il ne donne pas dans le Goust de Goropius\n[[30.11]] Becanus et de Schrickius qui nous ont donné de grandes Recueils sur cette Langue et sur la\n[[30.12]] Belgique à la bonne heure; ce que je ne croy pas de ce judicieux ecrivain qui nous decouvrira\n[[30.13]] asseurement de belles et agreables choses à sa maniere. Je croy que m^#'r Pinsson vous aura\n[[30.14]] envoyé le journal de Trevoux du mois de may et de Juin dernier où vous aurés veu ce qu'il y est\n[[30.15]] dit d'une nouvelle edition du Suidas par m^#'r Neocorus qui profitera du travail du scavant m^#'r\n[[30.16]] Pearson sur ce beau Lexicon. Il y a long tems que je n'ay recû des nouvelles de Rome; j'en\n[[30.17]] attends incessamment avec les Antiquités de Neffane de l'abbé della Torre, où il a renfermé\n[[30.18]] quantité de choses qui regardent la belle Antiquité, je ne scay aucunes nouvelles de nostre cher\n[[31.1]] et important amy mons^#'r de Spanheim; voilà un petit mot que je prends la liberté de vous\n[[31.2]] adresser pour luy aussi bien que pour m^#'r Morel: mons^#'r d'Avranches faict imprimer à Roüen <i>les\n[[31.3]] Antiquités de la ville de Caën</i>; pour toujours monsieur à vostre chere et pretieuse amitié. Tout a\n[[31.4]] vous </p>\n<p> [[31.5]] Nicaise </p>\n",
  "number": "7.",
  "title": "CLAUDE NICAISE AN LEIBNIZ",
  "date": "Dijon, 11. Juli 1701. [5.8.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:7. CLAUDE NICAISE AN LEIBNIZ Dijon, 11. Juli 1701. [5.8.] Dijon le XI. Jüillet 1701 J'oubliay Am Kopf des Briefes von Leibniz' Hand: Mons. l'Abbé Nicaise monsieur de vous dire dans la derniere que j'ay eû l'honneur de vous écrire une nouvelle qui ne sera pas tout à faict desagreable à m^#'r Ludolfe...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>