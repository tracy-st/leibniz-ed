---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_140",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 140,
  "text": "[[449.10]] <b>114₁.  Erster Ansatz ERSTER ANSATZ </p>\n<p> [[449.12]] Rem tractare aggressus, cujus vim a multis agnosci, omnium interest, praevaricator\n[[449.13]] essem in causa publica si quae ad commendationem ejus atque accendendos homines\n[[449.14]] studia necessaria dictu videntur dissimularem, mihi enim pene adhuc puero divino\n[[449.15]] munere obtigere initia, satis quidem tenuia, artis cujusdam Magnae, cujus quantum legere\n[[449.16]] vel audire contigit, ne suspicio quidem inter homines fuisse videtur, itaque veniam mihi\n[[449.17]] ab aequitate lectoris spero, si de praesenti negotio loqui magnificentius, quam ego de\n[[449.18]] rebus meis sentire soleo. Cum enim eo consilio scribam, ut ad conferendam operam\n[[449.19]] accendantur homines, intellecta magnitudine praesentaneae utilitatis, praevaricator essem\n[[449.20]] in causa publica, si quae ad persuadendum valere possunt, dissimularem. Ajo igitur\n[[449.21]] sequentia ab hominibus etiam mediocris ingenii, sed praeclarae voluntatis, inter se conspirantibus,\n[[449.22]] exiguo tempore, nec magnis sumtibus praestari posse: </p>\n<p> [[450.1]] Primum scilicet constituetur <b>Canon</b>, sive <b>Ars</b> quaedam <b>judicandi</b>, cujus ope\n[[450.2]] omnes controversiae quae sive de scientiis humanis sive etiam de singularibus vitae\n[[450.3]] negotiis, rebusque agendis oriri possunt. Palpabili quodam modo ad calculi Mathematici\n[[450.4]] instar tam accurate definiantur, quam ex datis utrinque rationibus possibile est. Ita\n[[450.5]] scilicet, ut cum sufficientia sunt data ad veritatem infallibiliter determinandam,\n[[450.6]] demonstratio habeatur veritatis; sin minus, habeatur saltem interim demonstratio maximae\n[[450.7]] probabilitatis, quae argumentorum utrinque pugnantium commodorumque atque\n[[450.8]] incommodorum aestimatione certo semper determinari ex datis potest. Nec jam clamoribus\n[[450.9]] res agatur, sed dissentientium alter alteri, aut etiam quisque secum disputans sibi\n[[450.10]] dicere possit: <i>calculemus</i>. Non enim soli Logicorum Syllogismi sed et computistarum\n[[450.11]] rationes reddentium Tabulae, et Arithmeticorum vel Algebristarum dispositiones ac processus,\n[[450.12]] recte, argumenta in formam redacta nominabuntur. Error autem omnis erit vel\n[[450.13]] calculi, vel omissionis alicujus ex datis; et error quidem calculi semper deprehendi atque\n[[450.14]] emendari poterit ex ipsis calculi regulis; at omissionem sive insufficientem enumerationem\n[[450.15]] emendare pertinet non ad formam sed ad materiam, id est non ad artem judicandi,\n[[450.16]] sed inveniendi. Initia autem hujus <b>Canonis</b>, sive artis judicandi, trademus hoc loco\n[[450.17]] constitutis <b>Elementis veritatis aeternae</b>, unde apparebit, an sperari possint, quae\n[[450.18]] pollicemur. Quod si certa demonstratione conficiemus, haec non tantum possibilia, sed et\n[[450.19]] in potestate nostra sita esse; omnium certe mortalium quod sua interest intelligentium\n[[450.20]] voluntates excitari oportet, ad favendum constitutioni tantae artis, sed eorum maxime, qui\n[[450.21]] de maximis rebus deliberantes majore periculo decipiuntur; plerumque enim etiam magni\n[[450.22]] viri post multas rationes utrinque ventilatas, non omnes in unam summam colligunt, cum\n[[450.23]] ea ars addendi rationes, ne quidem satis extet, sed vel prima qua praeoccupati sunt, vel\n[[450.24]] ultima quae maxime adhuc in memoria eorum viget, vel illa denique quae affectibus\n[[450.25]] eorum secunda est, vel denique quo cumque nullum sit periculo salutis periculum majus,\n[[450.26]] de quo deliberare debent omnes; quantivis pretii erit in rebus divinis ac moralibus a\n[[450.27]] ratione pendentibus, circa Deum atque Animam demonstrationes tandem aliquando asse-\n[[451.1]] ­qui, vel plane absolutas, vel moralem certitudinem, aut etiam maximae probabilitatis\n[[451.2]] gradum definientes. Fatendum est enim hactenus in his rebus potius demonstrationum\n[[451.3]] tentamenta, vel simulacra, quam demonstrationes haberi. In publicis quoque negotiis\n[[451.4]] maximum artis usum esse necesse est ut non jam negligenter, neque etiam anxie, et cum\n[[451.5]] multa formidine, sed secure, et quadam fidentis animi tranquillitate agamus, ut solent illi,\n[[451.6]] qui certas in agendo leges sequuntur. Nunc enim [<i>bricht ab</i>] </p>\n",
  "number": "114₁.",
  "title": "Erster Ansatz",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:114₁. Erster Ansatz ERSTER ANSATZ Rem tractare aggressus, cujus vim a multis agnosci, omnium interest, praevaricator essem in causa publica si quae ad commendationem ejus atque accendendos homines studia necessaria dictu videntur dissimularem, mihi enim pene adhuc puero divino munere obtigere initia...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>