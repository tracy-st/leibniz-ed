---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_6",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 6,
  "text": "<p> [[13.3]] <b>6. CHRISTIAN DAUM AN LEIBNIZ</p>\n<p> [[13.4]] Zwickau, 28. April (8. Mai) 1666. [5.7.]</b></p>\n<p> [[13.11]] Cl. et Pereximie Vir </p>\n<p> [[13.12]] Porphyrium cum caeteris pergratum Tibi fuisse lubens intellexi. Editione sane ejus nova\n[[13.13]] opus est, et adsunt praeterea aliqua alia adjumenta. Sed otium ejusmodi Opus elaborandi et\n[[13.14]] sumptus ad illud in publicum proferendum necessarios quis procurabit? Nescio an videris\n[[13.15]] Rhabanum Maurum qui mirificas pari fere opera figuras exstruxit in libro <i>de laudibus S. Crucis</i>,\n[[13.16]] cujus antiquam et novam Editionem possideo. Utar his in meis de Lat. lingua (si Deo videbitur)\n[[13.17]] Commentariis. Distichon quod reperire non potuisti, vides in Pithoeana haberi p. 378. Nisi\n[[13.18]] fallor, inerit et Velserianae. Eos meos libros proximis Nundinis exspecto reduces. De dividendis\n[[14.1]] vel separatim scribendis Diphthongis quae injecisti vera sunt: Et in multis antiquis membranis\n[[14.2]] ita reperi. (Nam et valde antiquas membranas habeo, in quibus connexae conspiciuntur illae\n[[14.3]] literae). Usum tamen <greek>kalligrafíaw</greek> per connexionem qui tot secula obtinuit velle convellere\n[[14.4]] nescio an e re sit literarum. Est interdum genus eruditionis vitare quae doctis placent: ait\n[[14.5]] Cassiodorus. Consilium aperiendi variationum fontes quod dedisti, possum amplecti, si non\n[[14.6]] abnuent sequi typographi, vel bibliopolae. Et nisi opera illa valde increscat, quod valde vereor.\n[[14.7]] Concinnatum est a me Volumen, Stichographiae nomine, ex plus mille (non mentior) Poëtis et\n[[14.8]] infinitis Philologo-Criticis, sed perpetuo a triginta jam annis lusu ita attritum, ut nisi in mundum\n[[14.9]] descriptum nemini fere esse possint usui haec, ut ita appellem, Sibyllae folia. Et opus ipsum, si,\n[[14.10]] quae praeterea observavi interim adjecero, exaequet fere magnitudine Statianum Barthii Commentarium.\n[[14.11]] Vident et tenent manibus hoc mei. Sed ne quid pereat, non facile cuiquam utendum\n[[14.12]] concedo. Excerpta tamen jam olim confecta et summam quasi etsi imperfecta multis concessi,\n[[14.13]] quae et ipse videre queas, si denuo <greek>paliggenesíä</greek> quasi quadam in purum descripta fuerint. Pro\n[[14.14]] Voto tuo et Exercitio gratias ago ingentes et ut brevitati huic meae, qui hactenus infinitis\n[[14.15]] occupationibus avocatus alio animum attendi, volens ignoscentiam indulgeas rogo. B.V. PerEximie\n[[14.16]] Dⁿ^#'e et fave qui omnia Tibi felicia precatur, et haec defestinabat </p>\n<p> [[14.17]] Cygn. d. 28. Aprili. 1666. Clarit. Tuae Studiosiss^#'o Christiano Daumio. </p>\n<p> [[14.18]] Ab harum Exhibitore meo nuper discipulo, quem (tenuium parentum filium, probum\n[[14.19]] tamen et diligentem) peculiariter Tibi commendo, si qua in re illi commodare potes, Excerptorum\n[[14.20]] illorum quae dixi conspectum petere licebit, quae tamen lima omnino habent opus, et\n[[14.21]] meliore digestione. </p>\n<p> [[14.22]] Quanti vaeneat in Bibliopolio Diatriba tua scire velim, unum et alterum mihi pro alibi\n[[14.23]] Amicis exemplum comparaturus. </p>\n",
  "number": "6.",
  "title": "CHRISTIAN DAUM AN LEIBNIZ",
  "date": "Zwickau, 28. April (8. Mai) 1666. [5.7.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:6. CHRISTIAN DAUM AN LEIBNIZ Zwickau, 28. April (8. Mai) 1666. [5.7.] Cl. et Pereximie Vir Porphyrium cum caeteris pergratum Tibi fuisse lubens intellexi. Editione sane ejus nova opus est, et adsunt praeterea aliqua alia adjumenta. Sed otium ejusmodi Opus elaborandi et sumptus ad illud in publicum p...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii1_6","series":"Band II 1 (1663 - 1685)","seq":6,"text":"<p> [[13.3]] <b>6. CHRISTIAN DAUM AN LEIBNIZ</p>\n<p> [[13.4]] Zwickau, 28. April (8. Mai) 1666. [5.7.]</b></p>\n<p> [[13.11]] Cl. et Pereximie Vir </p>\n<p> [[13.12]] Porphyrium cum caeteris pergratum Tibi fuisse lubens intellexi. Editione sane ejus nova\n[[13.13]] opus est, et adsunt praeterea aliqua alia adjumenta. Sed otium ejusmodi Opus elaborandi et\n[[13.14]] sumptus ad illud in publicum proferendum necessarios quis procurabit? Nescio an videris\n[[13.15]] Rhabanum Maurum qui mirificas pari fere opera figuras exstruxit in libro <i>de laudibus S. Crucis</i>,\n[[13.16]] cujus antiquam et novam Editionem possideo. Utar his in meis de Lat. lingua (si Deo videbitur)\n[[13.17]] Commentariis. Distichon quod reperire non potuisti, vides in Pithoeana haberi p. 378. Nisi\n[[13.18]] fallor, inerit et Velserianae. Eos meos libros proximis Nundinis exspecto reduces. De dividendis\n[[14.1]] vel separatim scribendis Diphthongis quae injecisti vera sunt: Et in multis antiquis membranis\n[[14.2]] ita reperi. (Nam et valde antiquas membranas habeo, in quibus connexae conspiciuntur illae\n[[14.3]] literae). Usum tamen <greek>kalligrafíaw</greek> per connexionem qui tot secula obtinuit velle convellere\n[[14.4]] nescio an e re sit literarum. Est interdum genus eruditionis vitare quae doctis placent: ait\n[[14.5]] Cassiodorus. Consilium aperiendi variationum fontes quod dedisti, possum amplecti, si non\n[[14.6]] abnuent sequi typographi, vel bibliopolae. Et nisi opera illa valde increscat, quod valde vereor.\n[[14.7]] Concinnatum est a me Volumen, Stichographiae nomine, ex plus mille (non mentior) Poëtis et\n[[14.8]] infinitis Philologo-Criticis, sed perpetuo a triginta jam annis lusu ita attritum, ut nisi in mundum\n[[14.9]] descriptum nemini fere esse possint usui haec, ut ita appellem, Sibyllae folia. Et opus ipsum, si,\n[[14.10]] quae praeterea observavi interim adjecero, exaequet fere magnitudine Statianum Barthii Commentarium.\n[[14.11]] Vident et tenent manibus hoc mei. Sed ne quid pereat, non facile cuiquam utendum\n[[14.12]] concedo. Excerpta tamen jam olim confecta et summam quasi etsi imperfecta multis concessi,\n[[14.13]] quae et ipse videre queas, si denuo <greek>paliggenesíä</greek> quasi quadam in purum descripta fuerint. Pro\n[[14.14]] Voto tuo et Exercitio gratias ago ingentes et ut brevitati huic meae, qui hactenus infinitis\n[[14.15]] occupationibus avocatus alio animum attendi, volens ignoscentiam indulgeas rogo. B.V. PerEximie\n[[14.16]] Dⁿ^#'e et fave qui omnia Tibi felicia precatur, et haec defestinabat </p>\n<p> [[14.17]] Cygn. d. 28. Aprili. 1666. Clarit. Tuae Studiosiss^#'o Christiano Daumio. </p>\n<p> [[14.18]] Ab harum Exhibitore meo nuper discipulo, quem (tenuium parentum filium, probum\n[[14.19]] tamen et diligentem) peculiariter Tibi commendo, si qua in re illi commodare potes, Excerptorum\n[[14.20]] illorum quae dixi conspectum petere licebit, quae tamen lima omnino habent opus, et\n[[14.21]] meliore digestione. </p>\n<p> [[14.22]] Quanti vaeneat in Bibliopolio Diatriba tua scire velim, unum et alterum mihi pro alibi\n[[14.23]] Amicis exemplum comparaturus. </p>\n","number":"6.","title":"CHRISTIAN DAUM AN LEIBNIZ","date":"Zwickau, 28. April (8. Mai) 1666. [5.7.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>