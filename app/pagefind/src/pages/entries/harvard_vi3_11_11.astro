const entry = {
  "id": "harvard_vi3_11",
  "series": "Band VI 3 (1672-1676); durchgesehener Nachdruck 1980",
  "seq": 11,
  "text": "[[163.11]] <b>11. Aus und zu Galileis Discorsi </b> <span>163.0;0:63:011:72       :E:l^</span>.\n[[163.21]] Gal. Dial. 2. Mechan. p. 82. 83. ed. Bol. 1656. Si pondera sint in reciproca\n[[163.22]] ratione distantiarum aequiponderare probat methodo, ut mihi videtur obscura,\n[[163.23]] et male secura, cum sint aliae in promtu.\n[[164.1]] p. 102. Inquirit eaedem vis minusne an plus, an idem agant in rumpendum v.g.\n[[164.2]] super genu lignum, si genu non in medio, sed in extremis locetur. Id ille intricatus,\n[[164.3]] ego ita persequor. Esto medium a extremitates\n[[164.4]] b c in quibus pondera applicata, aequalia,\n[[164.5]] sufficientia praecise ad rupturam. Supponatur\n[[164.6]] genu poni in extremo b applicatis iisdem\n[[164.7]] viribus c tantum, omissis b. Patet duplicari\n[[164.8]] distantiam ac. Ergo duplicari quoque vires, et ideo rem eodem recidere, sive genu\n[[164.9]] in medio, sive quam remotissime a medio ponas. Sed nunc mutemus calculum, supponamusque\n[[164.10]] non pondere appenso in c et b sed proprio trabis pondere rumpi debere,\n[[164.11]] ibi vero alius orietur calculus. Nimirum posito genu sub b Trabis seu prismatis bc\n[[164.12]] longitudo erit duplicata, ergo vis quadruplicata. Cum antea retento b fuerit tantum\n[[164.13]] duplicata. Hinc colligo statim, regulam quandam generalem notabilem omne prisma\n[[164.14]] sustentatum in medio ad seipsum sustentatum in altero extremorum, quadruplam\n[[164.15]] habere rationem firmitatis, seu posse esse quadruplo gravius, ut non rumpatur. Quod\n[[164.16]] si in utroque extremo suffulta sit trabs, sed non in medio, suffulta inquam, sed libere\n[[164.17]] seu non infixa, ita scilicet ut scissa in a, casura sit pars ba circa centrum b et ac circa\n[[164.18]] centrum c, ajo eam esse rationem resistentiae Trabis in utroque extremo suffultae ad\n[[164.19]] suffultam in medio, quae est resistentiae absolutae seu liberae in data sectione a ad\n[[164.20]] centralem. At si b et c fixae sint in extremis, tunc duplicanda est centralis eique\n[[164.21]] addenda absoluta, productum erit resistentia quaesita.\n[[164.22]] Supponamus brachium ac vel ab quod est ut 3 habere vires ut 9 utrumque simul\n[[164.23]] ut 18 posito genu vel fulcro in a ponatur postea in aa, manifestum est brachium aac\n[[164.24]] habere vires ut 16 et brachium baa ut 4 summa 20. En vires rumpentes auctas; seu\n[[164.25]] minorem resistentiam ad proprium pondus.\n[[164.26]] Galilaeus in his calculandis erravit, ni fallor, quod remoto proprio pondere si\n[[164.27]] simpliciter super genu frangatur muteturve genu locus alium calculum fore putat,\n[[164.28]] quod non est.\n[[164.29]] Summae quadratorum duorum numerorum eundem numerum totalem constituentium\n[[164.30]] majores sunt, quando differentia duorum numerorum partialium major est\n[[164.31]] ut\n[[164.32]] 5 et 5 = 10 25  25 = 50\n[[165.1]] Jam\n[[165.2]] 4  6 = 10 16  36 = 52\n[[165.3]] Hoc ita generaliter demonstrabitur:\n[[165.4]] a a a  a = 2a\n[[165.5]] a - b a  b. Quadrata sunt:\n[[165.6]] a  b - 2ab  a  b  2ab. Summa 2a  2b.\n[[165.7]] Regula ergo generalis ita concipietur: accedere potentiae rumpenti (seu decedere resistentiae)\n[[165.8]] tantum, ut accessio sit ad dimidium potentiae prioris, ut est quadratum\n[[165.9]] differentiae linearum ad lineam dimidiam. Et inquiri poterit figura, in qua resistentia\n[[165.10]] ubique sit eadem, ubicunque fulcrum supponas. Item inveniri potest punctum fulcri,\n[[165.11]] ut potentia rumpens tantum augeatur vel minuatur, dummodo non ultra quadruplum.\n[[165.12]] Potest enim progressio esse incrementi in infinitum, ut tamen maximum sit\n[[165.13]] quadruplum.\n[[165.14]] Ponatur b esse = a, erit a - b = 0 et a  b = 2a. Cuius quadratum 4a.\n[[165.15]] Galilaeus qui supponit non de proprio Trabis pondere sed de ponderibus seu\n[[165.16]] potentiis applicatis simpliciter, verum esse, ut augeatur vis, remota manu a fulcro,\n[[165.17]] mihi videtur errare valde. Et hinc corruere problema quod habet p. 103 invenire\n[[165.18]] punctum in cylindro ex quo suspensum pondus datum eo maius quod in medio rumperet,\n[[165.19]] sit sufficiens minimum ad rumpendum. Consideratio talis est, mutata jam\n[[165.20]] sentiens tota a fulcro medio ad pondus medium, nescio quo saltu, sine admonitione:\n[[165.21]] Si Trabs acb ita fixa sit in utroque extremo a, b, ajo pondus appensum in medio c\n[[165.22]] debere superare resistentiam centralem primum in ad quasi abesset totum cbe et\n[[165.23]] solum esset brachium adc fixum in ad, deinde eodem modo resistentiam be et proinde\n[[165.24]] si c sit in medio priorem ad duplicatam, et quidem has contra has resistentias\n[[165.25]] calculari debet pondus c, quasi ex vecte dc vel ec sed denique etiam vincere debet\n[[165.26]] resistentiam, quae est in cf. Quaestio est jam an resistentia in cf sit absoluta an\n[[165.27]] centralis. Hoc jam dependet a longitudine ac vel cb si enim c parum distet a centro,\n[[165.28]] et ideo pondus in c sit magnum, centralis conatus parum augebit eius vires, imo\n[[165.29]] revera nunquam auget; an dicemus rectam quidem conari, sed effectum esse centralem,\n[[166.1]] esset, si in medio tanta sit crassities vel potius\n[[166.2]] grossities, ut resistentia absoluta vincat centralem\n[[166.3]] in extremis quod et aliter per maximam\n[[166.4]] variationem obtineri potest. Sed supponamus\n[[166.5]] saltem eandem connexionem in extremis quae\n[[166.6]] est in medio, vel saltem non minorem. Hoc casu\n[[166.7]] non recta perfringet potius, quam centrali conatu.\n[[166.8]] Et potest ea fingi figura, quasi dolii vinarii\n[[166.9]] in fine se contrahentis vel aliter, ut semper cogatur\n[[166.10]] pondus impositum eligere rupturam centralem.\n[[166.11]] Sed nondum propterea tamen invenio\n[[166.12]] modum efficiendi, ut pondus quocunque in loco imponatur eandem semper resistentiam\n[[166.13]] inveniat, nisi non sit trabs transversa, sed pavimentum planum vel curvilineum\n[[166.14]] circumcirca fultum, in quo id per calculum obtineri posset.\n[[166.15]] Prisma est aequiresistens si conatus non sit centralis. Si sit centralis, nullo modo\n[[166.16]] potest esse resistentia aequalis ad idem pondus. Quare fateor me nondum intelligere\n[[166.17]] hunc locum Galilaei, ut nec Dn. B. satis intelligere fatetur. Si sermo est de ipsius\n[[166.18]] corporis proprio pondere tale quid calculari posset, sed quo usu?\n[[167.2]] Galilaeus putabat in Dial. 1. non assurgere aquam ultra 18 ulnas quia scilicet\n[[167.3]] pondus eius ipsiusmet cohaesionem superaret. Aquam autem cohaerere ait, idque a se\n[[167.4]] demonstratum, nullo alio vinculo, nisi vacui. Hinc calculari ait posse et reliquorum\n[[167.5]] resistentiam an a fuga vacui, aut quantum ultra, quatenus scilicet maioris chordae\n[[167.6]] pondus sustineat.\n[[167.7]] Galilaeus ex principio indivisibilium suppositorum explicare conatur volutionem\n[[167.8]] circulorum.\n[[167.9]] Gal. dial. 1. p. 22. Edit. 1656. Ital. dicit definitiones Geometricas non esse nisi\n[[167.10]] compendia loquendi. Adde quae Pascal. in Triang. Arithm. de variandis enunciandi\n[[167.11]] modis.\n[[167.12]] Galil. dial. 1. p. 21. egregie demonstrat punctum quoddam cuidam lineae, nempe\n[[167.13]] circumferentiae cujusdam circuli aequale esse. Si rectangulum\n[[167.14]] ABED, semicirculus AFB, Triangulum\n[[167.15]] CDE circumagantur circa CF, rectangulum generabit\n[[167.16]] Cylindrum, semicirculus hemisphaerium,\n[[167.17]] Triangulum conum. Auferatur Hemisphaerium ex\n[[167.18]] cylindro, restabit locus hemisphaerii vacuus, inter\n[[167.19]] conum et scutellam quandam ex cylindro residuam,\n[[167.20]] quae erit cono aequalis, et eodem modo conus HCL plano utcunque alto GN abscissus,\n[[167.21]] et idem est quantacunque sit linea CA. Iam si GN sit summae ACB ita propinqua,\n[[167.22]] ut differentia sit minor quolibet dato, conus iste CHL evanescet in punctum, et\n[[167.23]] scutella ex cylindro relicta evanescet in Circulum. Erit ergo ultimus conus aequalis\n[[167.24]] ultimae scutellae, seu punctum circulo. Haec satis demonstrant, puncta nihil esse, nec\n[[167.25]] utendum nisi corporibus minoribus quolibet dato, ex quibus infinitum latitudine, sed\n[[167.26]] angustissimum instar scutellae, potest esse aequale, alteri et latitudine et longitudine\n[[167.27]] minore quovis dato, infinitum aequale indivisibili. Hoc etiam esse demonstratum a\n[[167.28]] Luca Valerio fatetur.\n[[168.1]] Gal. Dial. 1. p. 23. Bologn. 1656. Lucae Valerii tract. de centro gravitatis\n[[168.2]] solidorum, mire laudat, vocat alterum Archimedem seculi nostri.\n[[168.3]] p. 24. Indivisibile additum indivisibili nil efficere nisi addantur infinita indivisibilia.\n[[168.4]] In infinito non esse nec maius nec minus ait p. 25. quod mihi videtur contra ea\n[[168.5]] esse, quae ait ipse Galilaeus. Putat infinitum non tantum non esse maius alio infinito,\n[[168.6]] sed nec finito. Et demonstratio est notanda: In Numeris infinitae sunt radices, infinita\n[[168.7]] quadrata, infiniti cubi. Porro tot sunt radices quot numeri. Et tot sunt quadrata\n[[168.8]] quot radices. Ergo tot sunt quadrata quot numeri, seu tot numeri quadrati quot numeri\n[[168.9]] in universum. Quod est impossibile. Hinc sequitur aut totum non esse maius\n[[168.10]] parte in infinito, quae est sententia Galilaei et Gregorii a S. Vincentio quam probare\n[[168.11]] non possum, aut ipsum infinitum esse nihil, seu non esse Unum nec totum. An\n[[168.12]] dicemus: distinguendo inter infinita, scilicet infinitissimum, seu Omnes numeros esse\n[[168.13]] quiddam implicans contradictionem, nam si totum sit, intelligi potest factus ex numeris\n[[168.14]] omnibus continue in infinitum, qui erit longe major omnibus numeris seu\n[[168.15]] numero maximo. An dicemus non debere dici aliquid de infinito, ut de toto, nisi ubi\n[[168.16]] adest demonstratio. Galilaeus addit nec infinitum esse maius finito, quia in millione\n[[168.17]] numerus quadratorum non est centesima pars millionis, at in denario numerus\n[[168.18]] quadratorum (1. 4. 9.) est pene tertia, in novenario tertia pars; radicum, in unitate\n[[168.19]] aequatur numerus radicum et quadratorum. Hinc millio magis abit ab infinito, quam\n[[168.20]] denarius, cum in infinito aequalis sit numerus radicum et quadratorum. Ad quaestionem\n[[168.21]] an partes continui sint finitae, an infinitae respondet Galilaeus neutrum\n[[168.22]] esse, sed tales ut respondeant cuilibet numero dato ( seu indefinitas ).\n",
  "number": "11.",
  "title": "Aus und zu Galileis Discorsi",
  "date": ""
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:11. Aus und zu Galileis Discorsi 163.0;0:63:011:72 :E:l^. Gal. Dial. 2. Mechan. p. 82. 83. ed. Bol. 1656. Si pondera sint in reciproca ratione distantiarum aequiponderare probat methodo, ut mihi videtur obscura, et male secura, cum sint aliae in promtu. p. 102. Inquirit eaedem vis minusne an plus, a...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>