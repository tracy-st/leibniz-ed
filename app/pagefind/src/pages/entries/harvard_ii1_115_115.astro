---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_115",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 115,
  "text": "<p> [[319.9]] <b>100. LEIBNIZ AN JAKOB THOMASIUS</p>\n<p> [[319.10]] Mainz, 21./31. Januar 1672. [50.]</b></p>\n<p> [[319.22]] Scis, celeberrimum Reinesium, quondam nostrum, MS^#'t^#'u^#'m inscriptionum opus reliquisse.\n[[319.23]] Id ille Regi Christianissimo dedicare constituerat, et Fridericus Brummerus noster ei rei Parisiis\n[[320.1]] institerat, et paullo post defuncto Reinesio illustris Gersdorfius, ni fallor, Serenissimi Saxoniae\n[[320.2]] electoris legatus, secum exemplar ipsum Parisios tulerat. Sed nihil actum est, sive quod alieno\n[[320.3]] tempore, sive quod alieno loco res proposita, aut alioquin difficultatibus, nescio quibus, impedita\n[[320.4]] fuit. Ego, qui cum Domino de Carcavy, Bibliothecario Regis, qui Colberti jussu res\n[[320.5]] literarias curat, commercium colere soleo, inter cetera forte in Reinesianarum inscriptionum\n[[320.6]] mentionem incidi. Ex eo tempore scripsit mihi Dominus de Gravelle, legatus ordinarius, sive, ut\n[[320.7]] vulgo vocant, Residens regius (Plenipotentiarii Ratisbonae agentis frater), commissum sibi, ut\n[[320.8]] inquireret, qui Reinesii heredes, et quo loco MS^#'t^#'u^#'m esset, rogavitque me, ut operam in eo\n[[320.9]] negotio sibi navarem. Addidit, intellexisse sese, gratum Regi munus fore, si offeratur, et certa\n[[320.10]] munificentia recognoscendum, sed et, quod auctor olim quaesiverit, ex typographia regia\n[[320.11]] edendum. Ego inquirere, et nuncium, ut credo, non ingratum perferre, in me recepi, et te, quem\n[[320.12]] et Reinesio olim amicum fuisse, et nunc ejus heredibus (quorum nomina non satis scio, et nosse\n[[320.13]] desidero) esse non dubito, rogare volui, ut mihi opem feras, quod ego, re confecta, honorifica\n[[320.14]] tuae operae mentione, ut alioquin debeo, apud amicos Parisienses agniturus sum. Quaecunque\n[[320.15]] Dnn. heredum sententia desideriumve est, mihi tuto libereque perscribere, aut significare\n[[320.16]] possunt, ego omnia fideliter curabo. De re literaria nihil novi magnopere ad me pervenit. </p>\n<p> [[320.17]] Auctor libri de libertate philosophandi, cujus refutationem brevem, sed elegantem, programmate\n[[320.18]] complexus es, est Benedictus Spinoza, Judaeus <greek>ăposynágvgow,</greek> ob opinionum\n[[320.19]] monstra, ut mihi e Batavis scribitur. Ceterum homo omni literatura excultus, et inprimis\n[[320.20]] insignis Opticus, praeclarorum admodum tuborum elaborator. </p>\n<p> [[320.21]] Abulfedam, Geographum Arabem magni nominis, Schickardus, multis collatis manuscriptis\n[[320.22]] recensuerat, versioneque latina expresserat, et notis illustraverat. Reliquias tanti viri tam\n[[320.23]] praeclaras cum alicubi latere didicissem, Gallis significavi, qui redemere: et ita fore spero, ut\n[[320.24]] opus tam diu in publico desideratum cura clarissimi Ferrandi, Galli orientalia doctissimi,\n[[320.25]] prodeat in lucem. Ex quo multa hactenus ignorata discemus, circa res orientis, quae Abulfeda\n[[320.26]] ille, princeps Hamae, maximis sumtibus indagavit. Europaei hactenus fere non nisi litora Asiae\n[[320.27]] Africaeque legere, at Arabes religionis linguaeque beneficio in intima mediterranearum gentium\n[[320.28]] penetravere. Mogunt. 21/31 Jan. 1672. </p>\n",
  "number": "100.",
  "title": "LEIBNIZ AN JAKOB THOMASIUS",
  "date": "Mainz, 21./31. Januar 1672. [50.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:100. LEIBNIZ AN JAKOB THOMASIUS Mainz, 21./31. Januar 1672. [50.] Scis, celeberrimum Reinesium, quondam nostrum, MS^#'t^#'u^#'m inscriptionum opus reliquisse. Id ille Regi Christianissimo dedicare constituerat, et Fridericus Brummerus noster ei rei Parisiis institerat, et paullo post defuncto Reines...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>