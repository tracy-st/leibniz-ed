---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_174",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 174,
  "text": "<p> [[538.15]] <b>174. LEIBNIZ AN MICHAEL GOTTLIEB HANSCH</p>\n<p> [[538.16]] Berlin, 6. Februar 1707. [172.176.] </b></p>\n<p> [[539.2]] Vir Clarissime Fautor et Amice Honoratissime </p>\n<p> [[539.3]] Quod quaedam a R. P. Longo quaesita doces gratias ago. Dn. D. Maierus ut video alibi\n[[539.4]] quaerendus est. Recuperato Scripto Longi ex ipsius manibus tentabo frui aliorum doctissimorum\n[[539.5]] virorum, sed inprimis venerandi Ittigii beneficio. </p>\n<p> [[539.6]] Ex definitione <b>Rectae</b> quod inter duo puncta sit brevissima, id ipsum quod assumis\n[[539.7]] demonstrari petitur, brevissimam hanc esse unicam. Hoc enim habito utique per se patet duas\n[[539.8]] rectas spatium non comprehendere. Porro quo magis videas demonstratione opus esse considerandum\n[[539.9]] est, aeque brevissimas plures, imo infinitas aliquando dari; veluti <Fn><i>Leibniz verdeutlicht nur in L^#'1 seine Ausführungen durch zwei Zeichnungen</i>:    </Fn> in superficie\n[[539.10]] sphaerica; ubi inter duo quaedam puncta nempe polos, infinitae [lineae] tales duci possunt; tot\n[[539.11]] scilicet quot sunt semicircumferentiae circulorum magnorum per hos polos transeuntium, seu\n[[539.12]] meridianorum; quarum quaelibet est via a polo ad polum qua brevior non datur. Ostendendum\n[[539.13]] ergo erat, quod in superficie sphaerica possibile est inter duo puncta, id absolute inter duo\n[[539.14]] puncta fieri non posse. <Fn><i>Auf der sonst leeren Rückseite von L^#'2 (Bl. 5 v^#'o) findet sich die folgende gestrichene Bemerkung von Leibniz' Hand</i>: In superficie sphaerica non datur brevissima, ea generari concipitur ex superficie curva at haec genesis flexu lineae circulari.</Fn> Praeterea ex definitione Rectae non tantum ostendendum est duas\n[[539.15]] rectas non comprehendere spatium, sed etiam duas rectas non posse habere partem communem,\n[[540.1]] seu ut Euclides loquitur, segmentum commune. Atque adeo generaliter ostendendum est duas\n[[540.2]] rectas (quae continuatione utrinque facta non coincidant) <k>per</k> duo puncta duci non posse. </p>\n<p> [[540.3]] In optimo et doctissimo Viro Dn. Ottone Menkenio amicum insignem perdidi ego, perdidit\n[[540.4]] respublica literaria columen non vulgare. Spero tamen eximium ejus filium laudes paternas\n[[540.5]] nobis ut coepit repraesentaturum. Eum rogo ut data occasione a me salutes, condolendi\n[[540.6]] officium meo nomine peragas, et studia ei mea deferas. Spero <i>Actorum</i> laborem utilissimum\n[[540.7]] ipsius opera porro processurum. </p>\n<p> [[540.8]] Rogo etiam ut inquiras, utrum Dn. de Schulenburg Generalis rei pedestris vestrae praefectus,\n[[540.9]] (neque enim de fratre ejus Generali Majore quaero) sit Lipsiae aut in Saxonia, et si adest\n[[540.10]] ex ipso (obsequiosissima salute a me nuntiata) sin abest ex Dn. Wunderling Bancario seu\n[[540.11]] Trapezita quaeras, an per aliquot septimanas in Saxonia Dn. Generalis moraturus credatur et\n[[540.12]] mox doce. </p>\n<p> [[540.13]] Vellem mereri hunc Tuum favorem aliquo officio posse. Interea vale, et me ama. </p>\n<p> [[540.14]] Dabam Berolini 6 Febr. 1707 </p>\n<p> [[540.15]] deditissimus G. G. Leibnitius </p>\n<p> [[540.16]] P. S. Rogo etiam ut ei qua erit res literaria docere velis. </p>\n",
  "number": "174.",
  "title": "LEIBNIZ AN MICHAEL GOTTLIEB HANSCH",
  "date": "Berlin, 6. Februar 1707. [172.176.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:174. LEIBNIZ AN MICHAEL GOTTLIEB HANSCH Berlin, 6. Februar 1707. [172.176.] Vir Clarissime Fautor et Amice Honoratissime Quod quaedam a R. P. Longo quaesita doces gratias ago. Dn. D. Maierus ut video alibi quaerendus est. Recuperato Scripto Longi ex ipsius manibus tentabo frui aliorum doctissimorum ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>