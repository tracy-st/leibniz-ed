---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_31",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 31,
  "text": "<p> [[142.1]] <b>32. LEIBNIZ AN PIERRE BAYLE</p>\n<p> [[142.2]] [Hannover, 19. Januar 1687.] [31.]</b></p>\n<p> [[142.19]] Monsieur </p>\n<p> [[142.20]] Ce <Fn><i>Am Kopf des Briefes</i>: À Monsieur Bayle (auteur des <i>nouvelles de la republique des lettres</i>.)</Fn> qui me plait le plus dans la reponse de M. l'Abbé C. que vous avés inserée dans vos\n[[142.21]] <i>nouvelles</i> instructives du septembre passé, c'est qu'elle me donne l'occasion de faire quelque\n[[142.22]] connoissance avec une personne de vostre merite. Je vous envoye ma replique cy-jointe, et en\n[[143.1]] cas que vous la voulés employer je vous supplie de ne mettre en cette rencontre que <i>M. L.</i> au\n[[143.2]] lieu de marquer mon nom tout entier. Messieurs de Leipzig en usent de même. Car quoyque\n[[143.3]] j'aye fait imprimer quelques essais touchant le droit, la physique, les mathematiques et même\n[[143.4]] touchant les affaires qu'un grand prince m'avoit ordonné à éclaircir, j'ay abstenu le plus\n[[143.5]] souvent de mettre mon nom. </p>\n<p> [[143.6]] On a publié icy un ouvrage in grand folio dont vous pourriés peutestre faire mention dans\n[[143.7]] l'article des livres, si vous le trouvés apropos. Le titre est: <i>Justa funebria Serenissimo Principi\n[[143.8]] Johanni Friderico Brunsvicensium et Luneburgensium Duci à R^#'m^#'o et S^#'m^#'o Fratre Ernesto\n[[143.9]] Augusto Episcopo Osnabrugensi Duce Brunsv. et Luneb. persoluta</i>. Plusieurs empechemens\n[[143.10]] n'ont pas permis que cet ouvrage fait à l'honneur de feu Monseigneur le Duc d'Hanover ait pû\n[[143.11]] paroistre plus tost. Il y a des panegyriques, vers, devises, pourtraits, medailles, armoiries,\n[[143.12]] descriptions et representations des ceremonies, suivant ce qui se practique chez les princes\n[[143.13]] d'Allemagne. On voit d'autres livres de cette nature qu'on a publiés à l'honneur de quelque\n[[143.14]] grand prince; mais il y en a peu en Allemagne qui passeront cet ouvrage en egard aux belles\n[[143.15]] planches et autres particularités, le S^#'m^#'e Successeur n'ayant rien epargné qui pourroit marquer\n[[143.16]] l'amour qu'il portoit à feu son frere. Tout le monde sçait combien un Duc d'Hanovre comme un\n[[143.17]] des princes Regens de la maison de Bronsvic a de part aux affaires generales. C'est pourquoy\n[[143.18]] les <i>personalia</i>, ou ce qu'il y a de sa vie inseré dans cet ouvrage servira à l'histoire du temps.\n[[143.19]] Comme ce prince avoit pour moy une bonté particuliere, j'ay marqué ma gratitude par les vers\n[[143.20]] que je vous envoye, qu'on a aussi inserés dans cet ouvrage, mais que j'ay fait imprimer à part\n[[144.1]] pour les pouvoir communiquer moy même. Vous y pourrés remarquer Monsieur que ce grand\n[[144.2]] prince se plaisoit merveilleusement à toute sorte de belles connoissances; et comme le vray\n[[144.3]] phosphore, ou ce feu maniable qui a esté trouvé depuis quelques années, fut travaillé et\n[[144.4]] demonstré icy par l'inventeur, et même perfectionné en quelque façon en ma presence, le tout\n[[144.5]] suivant les ordres de feu S.A.S., j'en ay inseré une description dans ces vers, pour diversifier un\n[[144.6]] peu la matiere. Les sciences ont tousjours beaucoup d'obligation aux Princes qui les aiment,\n[[144.7]] c'est pourquoy il est juste d'en conserver la memoire pour servir d'exemple. L'Eloge de celuy\n[[144.8]] cy que feu Monseigneur l'Evesque de Padeborne et Munster (qui estoit luy même si digne de\n[[144.9]] louanges) a fait, que j'ay adjouté à cet <i>Epicede</i>, est bien expressif, et ne sçauroit passer pour\n[[144.10]] suspect. Cependant je n'ay rien à vous prescrire, et je suis avec passion </p>\n<p> [[144.11]] Monsieur </p>\n",
  "number": "32.",
  "title": "LEIBNIZ AN PIERRE BAYLE",
  "date": "[Hannover, 19. Januar 1687.] [31.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:32. LEIBNIZ AN PIERRE BAYLE [Hannover, 19. Januar 1687.] [31.] Monsieur Ce Am Kopf des Briefes: À Monsieur Bayle (auteur des nouvelles de la republique des lettres.) qui me plait le plus dans la reponse de M. l'Abbé C. que vous avés inserée dans vos nouvelles instructives du septembre passé, c'est q...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>