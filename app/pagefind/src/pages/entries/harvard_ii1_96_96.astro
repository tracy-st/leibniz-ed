---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_96",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 96,
  "text": "<p> [[257.16]] <b>82. OTTO VON GUERICKE AN LEIBNIZ</p>\n<p> [[257.17]] Magdeburg, 13. Oktober 1671. [77.83.]</b></p>\n<p> [[258.1]] Wohl Edler Vest: und hochgelerter etc. </p>\n<p> [[258.2]] Insonders großg: hochge. Herr etc. </p>\n<p> [[258.3]] Desselben vom 5 Octob. habe den 12 <i>ejusd. styl. nov.</i> zu rächt empfangen, bedancke mich\n[[258.4]] gehabter mühewaltung und geneigter willfahrung, werde nicht unterlassen der beyden desiderirten\n[[258.5]] Exemplar halber, beym Buchführer, wan gelibets Gott daß werck zu seiner perfectikeitt\n[[258.6]] kommen, schuldige beforderung zu thuende. Die begehrte kugel ist <b>hirbey</b>, auch von denen\n[[258.7]] <b>Pflaumfederlein</b> ein stücke oder 3, darauß zu sehen wie sie sein müssen, dan keile müssen\n[[258.8]] sie nicht haben. <i>Notandum</i>: Die Fädern ie freier sie von einander gespärrt bleiben, und ie\n[[258.9]] weniger sie zusammen gedrucktt werden, ie besser es ist. So ist auch <b>hirbey</b> auß meinem\n[[258.10]] buche geschriben <b>der gebrauch</b>, wan künfftig daß buch herauß kommen, so wird auch daß\n[[258.11]] außgeschriben <i>Caput</i> ein bessern verstand erlangen, <i>Interim</i> kan sich mein hochg. Herr der\n[[258.12]] kugel gebrauchen. </p>\n<p> [[258.13]] Dabey dan zu wissen daß sie nicht alle zeitt gleich starck auch nicht allen leütten gleich\n[[258.14]] operiret, dan denen die weiche und feüchte hende haben (gleich wie mein Sohn ChurBr.\n[[258.15]] Resident im NiederSachs. kreisse) operiret sie wenig, hergegen mihr, der ich in mechanischen\n[[258.16]] vorfallenden sachen bißweilen selbst waß angreyffe und daher härter hende habe, wohl. Sie\n[[258.17]] thutt nichts, muß zuvor mitt der hand an einen orth (als etwa im <i>aequatore</i>) wohl begriffen und\n[[258.18]] dan mitt ein par schlagen perstringiret werden, wan sie dan uber leichte sachen alß etwa hoppen\n[[258.19]] blätter oder waß es ist gehalten wird, so zeügtt sies an sich; Dann kan man auch die Operation\n[[258.20]] mitt der fäder vornehmmen und den 3 articulen des <i>Capitis</i> nachgehen. </p>\n<p> [[258.21]] Wen man nicht rächtt weiß wie sie zu atteriren und zu perstringiren, so nehmme man sie\n[[258.22]] bey abends inß finstere vor, da wird man sehen uff welche art sie am besten schein von sich\n[[258.23]] gibtt, also will sie auch tractiret sein; allein an keinen feüchten orth, noch auch nicht mitt\n[[258.24]] feüchten und feisten henden. Wie die kugel zu praepariren, ist zward mitt wenigen in dem\n[[258.25]] <b>beygelegten</b> Cap. XV. zu befinden, weil es aber mein hg. Herr umbständlicher begehrett,\n[[258.26]] will ihm mitt nächsten, gerne damitt willfahren, ietzo hatts nicht sein können, weniger uff daß\n[[258.27]] andere zu antworten, weil die Post uff Leiptzigk zu mittage wegk gehett, und solte ich nuhn biß\n[[258.28]] uber 8 tage warten, so möchten die Franckfurter kauffleütte so die kugel mitt nehmmen sollen,\n[[258.29]] hinwegk sein. Und wolle also vor daß mahl mein h. ge. Herr mich entschuldigett halten,\n[[258.30]] denselben inzwischen der göttl. obhutt treülichst ergebe und allezeit verbleibe </p>\n<p> [[258.31]] Meines hochgeerten Herrns bereitwilligster Diener </p>\n<p> [[258.32]] Magdeburgk den 13 Octob. sty. no. A^#'o 1671. Otto von Guericke </p>\n<p> [[259.1]] P. S. Von neüen fellett hier nichts vor, als daß wegen Collen die sachen ietzo waß besser\n[[259.2]] lauffen, darin ich dan sehe daß auch Ihr Churf. Gn. zu Mayntz hochst rühmligst beflissen seind.\n[[259.3]] Franckreich dürffte wohl gegen den winter wieder die Hollender waß vornehmmen. </p>\n",
  "number": "82.",
  "title": "OTTO VON GUERICKE AN LEIBNIZ",
  "date": "Magdeburg, 13. Oktober 1671. [77.83.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:82. OTTO VON GUERICKE AN LEIBNIZ Magdeburg, 13. Oktober 1671. [77.83.] Wohl Edler Vest: und hochgelerter etc. Insonders großg: hochge. Herr etc. Desselben vom 5 Octob. habe den 12 ejusd. styl. nov. zu rächt empfangen, bedancke mich gehabter mühewaltung und geneigter willfahrung, werde nicht unterlas...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>