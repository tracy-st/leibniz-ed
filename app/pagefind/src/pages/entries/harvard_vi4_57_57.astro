---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_57",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 57,
  "text": "[[139.10]] <b>45₂.  Zweiter Ansatz ZWEITER ANSATZ </p>\n<p> [[139.14]] Sapientiam nihil aliud esse arbitror quam Scientiam foelicitatis, <Fn><i>Am Rande</i>: Studia ad foelicitatem dirigenda</Fn> et veram eruditionem\n[[139.15]] (tanquam apparatum ad sapientiam) esse habitum animi plurimis maximeque efficacibus\n[[139.16]] ad bene beateque vivendum notitiis instructi, qui studiorum pariter atque omnis\n[[140.1]] vitae finis semper respiciendus est, ut quando interdum animi gratia per curiosa magis\n[[140.2]] quam utilia vagati aut impetu quodam vel necessitate in diverticula abrepti sumus, mature\n[[140.3]] in viam redeamus. Cum vero maximum nobis sit commercium cum tota rerum natura,\n[[140.4]] multaque nos juvare et laedere possint opus est nobis multiplici cognitione, <Fn><i>Am Rande</i>: Multiplici cognitione hominibus opus est</Fn> et nostrae\n[[140.5]] Mentis, et eorum quae in nos agere aut a nobis pati possunt. Sed maxime expetenda est\n[[140.6]] scientia de universo seu de causis rerum, inprimis vero de autore omnium Deo, a quo ut\n[[140.7]] cuncta alia, ita et foelicitas nostra pendet, deinde de statu aliarum mentium, praesertim\n[[140.8]] cum quibus aliqua est nobis societas, denique de natura corporea variisque corporum\n[[140.9]] qualitatibus. Haec enim omnia ad mala vitanda bonaque procuranda aliquando conferre\n[[140.10]] possunt. </p>\n<p> [[140.11]] Verum non putandum est omnia quae sciri hominum interest, etiam singulis hominibus\n[[140.12]] cognita esse debere, in tanta enim brevitate vitae, et discendorum multitudine, et\n[[140.13]] humanae Mentis imbecillitate compendio studendum est, utendumque duobus maximis\n[[140.14]] Dei beneficiis, societate hominum sese mutuo in rerum indagatione sublevantium, et\n[[140.15]] monumentis literarum, quibus semel cognita ab oblivione vindicantur. </p>\n",
  "number": "45₂.",
  "title": "Zweiter Ansatz",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:45₂. Zweiter Ansatz ZWEITER ANSATZ Sapientiam nihil aliud esse arbitror quam Scientiam foelicitatis, Am Rande: Studia ad foelicitatem dirigenda et veram eruditionem (tanquam apparatum ad sapientiam) esse habitum animi plurimis maximeque efficacibus ad bene beateque vivendum notitiis instructi, qui s...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>