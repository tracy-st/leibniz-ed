---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_185",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 185,
  "text": "<p> [[614.1]] <b>187. LEIBNIZ AN PAUL PELLISSON-FONTANIER</p>\n<p> [[614.2]] [Hannover, 2. Hälfte November 1692.] [180.191.]</b></p>\n<p> [[614.14]] Monsieur </p>\n<p> [[614.15]] Puisque vous témoignés que les objections qu'on vous a envoyées contre nostre sentiment\n[[614.16]] viennent de bon lieu, je tacheray d'y repondre. Il est vray qu'il y a des expressions, qui m'ont\n[[614.17]] fait douter si cela pourroit servir. La question est en quoy consiste l'essence du corps. L'auteur\n[[614.18]] de l'objection dit que par le mot d'<i>essence</i> il entend <i>le premier de tous les attributs et dont tous\n[[614.19]] les autres attributs dependent.</i> </p>\n<p> [[614.20]] <petit><i>Der folgende kleingedruckte Text wurde von Leibniz gestrichen und durch den anschließenden ersetzt</i>:\n [[614.21]] Il luy est permis de l'entendre ainsi, pour moy ce n'est pas ainsi que je l'entendois; et les autres peut estre non\n[[614.22]] plus. Tout predicat necessaire est de l'essence du sujet, ainsi on peut dire que l'egalité des angles à deux droits est\n[[614.23]] essentielle au triangle; mais tout predicat reciproque epuise l'essence du sujet; de sorte que tous les predicats\n[[614.24]] essentiels en peuvent estre tirés. Ainsi pour sçavoir <b>en quoy consiste l'essence d'un sujet</b>, il n'est pas\n[[614.25]] necessaire de sçavoir le premier de tous ses attributs (que nous ne connoissons que rarement), mais il suffit d'en\n[[614.26]] sçavoir un qui luy soit reciproque, que les logiciens appellent <b><i>proprium in quarto modo</b>. </petit>\n [[615.1]] Je ne luy veux point contester cette definition du mot, mais je diray seulement, que pour sçavoir\n[[615.2]] en quoy consiste l'essence d'une chose, il n'est pas tousjours necessaire de sçavoir distinctement\n[[615.3]] ce premier attribut; et le plus souvent on se contente de connoistre des proprietés\n[[615.4]] reciproques du sujet, les quelles en contiennent et enveloppent tousjours toute l'essence, en\n[[615.5]] sorte que toutes les affections essentielles en peuvent estre tirées. D'où vient aussi, qu'on peut\n[[615.6]] donner plusieurs bonnes definitions d'un même sujet. Qui est ce qui ne pense sçavoir en quoy\n[[615.7]] consiste l'essence de la ligne droite? Cependant je ne connois encor personne qui en ait donné\n[[615.8]] au public le premier attribut. Et celuy qui me paroist le plus approchant est, que c'est une ligne\n[[615.9]] dont chaque partie est semblable au tout. </p>\n<p> [[615.10]] Pour parler de l'essence du corps, on peut distinguer entre predicats essentiels, reciproques\n[[615.11]] et primitifs. Tout predicat necessaire est de l'essence d'une chose ou essentiel, tout\n[[615.12]] predicat reciproque epuise toute l'essence, et lors qu'on le connoist, on peut dire qu'on connoist\n[[615.13]] en quoy consiste l'essence de la chose; mais lors qu'on en connoist les attributs primitifs on se\n[[615.14]] peut vanter de la connoistre parfaitement. Or il s'en faut tant que l'essence du corps consiste\n[[615.15]] dans l'étendue que ceux qui avouent qu'un corps peut estre en plusieurs [lieux], sont obligés\n[[615.16]] d'avouer que l'etendue n'est pas mêmes de l'essence du corps. </p>\n",
  "number": "187.",
  "title": "LEIBNIZ AN PAUL PELLISSON-FONTANIER",
  "date": "[Hannover, 2. Hälfte November 1692.] [180.191.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:187. LEIBNIZ AN PAUL PELLISSON-FONTANIER [Hannover, 2. Hälfte November 1692.] [180.191.] Monsieur Puisque vous témoignés que les objections qu'on vous a envoyées contre nostre sentiment viennent de bon lieu, je tacheray d'y repondre. Il est vray qu'il y a des expressions, qui m'ont fait douter si ce...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>