---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_161",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 161,
  "text": "<p> [[421.3]] <b>161. JOHANN JAKOB LUNGERSHAUSEN AN LEIBNIZ</p>\n<p> [[421.4]] Jena, 18. (28.) März 1698. [174.]</b></p>\n\n<p> [[421.11]] Illustris atque Excellentissime Domine, Maecenas Magne! </p>\n<p> [[421.12]] Quae superiori anno transmittere audebam <i>specimina</i>, recte credam perlata: nunc his se\n[[421.13]] sociat opella quaedam Hermeneutica, benevolo intuitu ut beare velis, submisse rogito, studia\n[[421.14]] mea quaecumque Gratioso patrocinio Tuo ulterius commendans. Proxime mittam <i>Specimen\n[[421.15]] Arabicum</i>, pactum Scil. Mahummedis cum Nazarenis, quos vocat, seu Christianis initum, quod\n[[421.16]] juxta indolem Arabismi Latine transtuli, annexa simul crisi de ejus origine, an sit genuinus\n[[421.17]] Mahummedis foetus? Vale Vir Magne ac fave </p>\n<p> [[421.18]] Illustris Dominis Tui cultori devotissimo M. Joh. Jac. Lungershausen, </p>\n<p> [[421.19]] Jenae d. 18. Mart. Anno 1698. Fac. Phil. Adj. </p>\n<p> [[421.20]] P.S. Audio quod D. Niemeier Prof. Log. et Met. Helmst. B. Sandhagenii locum occupaturus\n[[421.21]] sit, quod si ita sit, liceat ab Illustri Tua Excell. percunctari quis spem successionis\n[[422.1]] hactenus conceperit. Studia mea quaec. per 15. annos Academicos Log. et Met. Prof. <greek>kaddýnamin</greek>\n[[422.2]] praeparavi. Si beneficio Tuo ambire liceret professionem illam Helmst., praesigni\n[[422.3]] favore me mactatum putarem.\n[[422.4]] <yi>Viro Illustri atque Excellentissimo, Domino Leibniz, Potentiss. Elect. Brunsv. ac Luneb.\n[[422.5]] Consiliario intimo etc. Domino meo Gratioso. <i>Hannover. par Amy.</i> </p>\n",
  "number": "161.",
  "title": "JOHANN JAKOB LUNGERSHAUSEN AN LEIBNIZ",
  "date": "Jena, 18. (28.) März 1698. [174.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:161. JOHANN JAKOB LUNGERSHAUSEN AN LEIBNIZ Jena, 18. (28.) März 1698. [174.] Illustris atque Excellentissime Domine, Maecenas Magne! Quae superiori anno transmittere audebam specimina, recte credam perlata: nunc his se sociat opella quaedam Hermeneutica, benevolo intuitu ut beare velis, submisse rog...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii3_161","series":"Band II 3 (1695 - 1700)","seq":161,"text":"<p> [[421.3]] <b>161. JOHANN JAKOB LUNGERSHAUSEN AN LEIBNIZ</p>\n<p> [[421.4]] Jena, 18. (28.) März 1698. [174.]</b></p>\n\n<p> [[421.11]] Illustris atque Excellentissime Domine, Maecenas Magne! </p>\n<p> [[421.12]] Quae superiori anno transmittere audebam <i>specimina</i>, recte credam perlata: nunc his se\n[[421.13]] sociat opella quaedam Hermeneutica, benevolo intuitu ut beare velis, submisse rogito, studia\n[[421.14]] mea quaecumque Gratioso patrocinio Tuo ulterius commendans. Proxime mittam <i>Specimen\n[[421.15]] Arabicum</i>, pactum Scil. Mahummedis cum Nazarenis, quos vocat, seu Christianis initum, quod\n[[421.16]] juxta indolem Arabismi Latine transtuli, annexa simul crisi de ejus origine, an sit genuinus\n[[421.17]] Mahummedis foetus? Vale Vir Magne ac fave </p>\n<p> [[421.18]] Illustris Dominis Tui cultori devotissimo M. Joh. Jac. Lungershausen, </p>\n<p> [[421.19]] Jenae d. 18. Mart. Anno 1698. Fac. Phil. Adj. </p>\n<p> [[421.20]] P.S. Audio quod D. Niemeier Prof. Log. et Met. Helmst. B. Sandhagenii locum occupaturus\n[[421.21]] sit, quod si ita sit, liceat ab Illustri Tua Excell. percunctari quis spem successionis\n[[422.1]] hactenus conceperit. Studia mea quaec. per 15. annos Academicos Log. et Met. Prof. <greek>kaddýnamin</greek>\n[[422.2]] praeparavi. Si beneficio Tuo ambire liceret professionem illam Helmst., praesigni\n[[422.3]] favore me mactatum putarem.\n[[422.4]] <yi>Viro Illustri atque Excellentissimo, Domino Leibniz, Potentiss. Elect. Brunsv. ac Luneb.\n[[422.5]] Consiliario intimo etc. Domino meo Gratioso. <i>Hannover. par Amy.</i> </p>\n","number":"161.","title":"JOHANN JAKOB LUNGERSHAUSEN AN LEIBNIZ","date":"Jena, 18. (28.) März 1698. [174.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>