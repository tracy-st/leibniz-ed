const entry = {
  "id": "harvard_vi4_17",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 17,
  "text": "[[53.8]] <b>11.  Exemplarischer Ansatz zu einer alphabetischen Definitionenliste nach Dalgarno [Oktober 1677 bis September 1680 (?)]</b>\n [[53.10]] <tab/>[Oktober 1677 bis September 1680 (?)] </p>\n<p> [[53.23]] <b>Ab</b> <i>A</i> est quod fuit apud <i>A</i>, et nunc est apud <i>B</i>. </p>\n<p> [[53.24]] <b>Abalienare</b> facere ut quis cesset esse benevolus. </p>\n<p> [[53.25]] <b>Abacus</b> v. <i>mensa</i>. </p>\n<p> [[54.1]] <b>Abbas</b> rector monasterii, ad vitam constitutus. </p>\n<p> [[54.2]] <b>Abdicare</b> rem, rei curae renuntiare. </p>\n<p> [[54.3]] <b>Abdere</b> rem imperceptibilem facere. </p>\n<p> [[54.4]] <b>Abdomen</b>. </p>\n<p> [[54.5]] <b>Aberrare</b> praeterire per errorem. </p>\n<p> [[54.6]] <b>Abies</b>. </p>\n<p> [[54.7]] <b>Abire</b> desinere adesse. </p>\n<p> [[54.8]] <b>Abhinc</b> fit, quod nunc incipit. </p>\n<p> [[54.9]] <b>Abhorrere</b> dicimur id cujus cogitatio valde ingrata est, et facit metum. </p>\n<p> [[54.10]] <b>Abjurare</b> est juramento declarare aliquid a se alienum. </p>\n<p> [[54.11]] <b>Ablactare</b> pro lacte nutricis aliud nutrimentum dare. </p>\n<p> [[54.12]] <b>Abluere</b> lavando tollere. </p>\n<p> [[54.13]] <b>Abnegare</b> negare appertinentiam. </p>\n<p> [[54.14]] <b>Abolere</b> destruere speciem, seu aliquid universale, ut paganos, paganismum, idololatriam. </p>\n<p> [[54.16]] <b>Abominari</b>, cujus valde ingrata est perceptio, ob malum omen v. <i>abhorrere.</i> </p>\n<p> [[54.17]] <b>Aboriri</b> est intempestive, atque ideo imperfecte oriri. </p>\n<p> [[54.18]] <b>Abrogare</b> est legem tollere. </p>\n<p> [[54.19]] <b>Abrumpere</b> rumpendo separare. </p>\n<p> [[54.20]] Ex <b>abrupto</b> relicto quod agebatur imperfecto aliud subito agere. </p>\n<p> [[54.21]] <b>Absinth</b>. </p>\n<p> [[54.22]] <b>Absolvere</b> solvere a vinculo quod astringit ad poenam, tollere reatum delicti. Hinc\n[[54.23]] absolvitur tam nocens per remissionem, quam innocens per sententiam. </p>\n<p> [[54.24]] <b>Abscindere</b> scindendo separare, seu scindere et ita separare. </p>\n<p> [[54.25]] <b>Absens</b> non praesens. </p>\n<p> [[54.26]] <b>Abstemius</b> qui a vino abstinet. </p>\n<p> [[54.27]] <b>Absterret</b> qui facit abstinere terrendo. </p>\n<p> [[54.28]] <b>Abstinere</b> non facere, non uti cum possis, et cum ratio sit faciendi vel utendi. </p>\n<p> [[54.29]] <b>Abstrahere</b> philosophis, quod est cum aliis separatim considerare. </p>\n<p> [[54.30]] <b>Abstractum</b> constitutivum praedicationis. </p>\n<p> [[55.1]] <b>Absurdum</b> auditu molestum, quia incongruum ex vocis origine, sed usu, manifeste\n[[55.2]] falsum. </p>\n<p> [[55.3]] <b>Absolutum</b> non limitatum, pure positivum. </p>\n<p> [[55.4]] <b>Abundans</b> plus quam sufficit. </p>\n<p> [[55.5]] <b>Abusus</b> usus malus. </p>\n<p> [[55.6]] <b>Abyssus</b> cujus profunditas occulta est. </p>\n<p> [[55.7]] <b>Academia</b> societas multorum ob studia. </p>\n<p> [[55.8]] <b>Acarus</b>. </p>\n<p> [[55.9]] <b>Accendere</b> efficere ut aliquid incipiat flammam emittere. </p>\n<p> [[55.10]] <b>Accensere</b> recensere, seu esse, ponere inter aliqua. </p>\n<p> [[55.11]] <b>Accentus</b>. </p>\n<p> [[55.12]] <b>Accidit</b> existit praeter regulam, quod sc. nec necessario nec per se existit. </p>\n<p> [[55.13]] <b>Acceptare</b> declarare offerenti, quod grata sit oblatio. </p>\n<p> [[55.14]] <b>Accessorium</b> parvum cum magno. </p>\n<p> [[55.15]] <b>Accedit</b> quod tendit ad aliquid. </p>\n<p> [[55.16]] <b>Accersere</b> absenti significare quod praesentem velimus. </p>\n<p> [[55.17]] <b>Accidens</b> abstractum quod essentia subjecti non continetur. </p>\n<p> [[55.18]] <b>Accingere</b> cingulum circumdare, paratum reddere ad agendum. </p>\n<p> [[55.19]] <b>Accipere</b> incipere habere, voluntate ejus qui tenet. </p>\n<p> [[55.20]] <b>Accipiter</b>. </p>\n<p> [[55.21]] <b>Acclamare</b> clamore approbare. </p>\n<p> [[55.22]] <b>Acclive</b> est via ad superiora angulo obliquo. </p>\n<p> [[55.23]] <b>Accrescit</b> quod magnitudini nunc accessit. </p>\n<p> [[55.24]] <b>Accola</b> Rheni qui habitat apud Rhenum. </p>\n<p> [[55.25]] <b>Accommodare</b> commodum facere. </p>\n<p> [[55.26]] <b>Accurate</b> diligenter et bene. Haec non possunt separari. </p>\n<p> [[55.27]] <b>Accusare</b> crimen imputare. </p>\n<p> [[55.28]] <b>Acer</b>. </p>\n<p> [[55.29]] <b>Acris</b>. </p>\n<p> [[55.30]] <b>Acerbus</b> sapor pomi immaturi. </p>\n<p> [[55.31]] <b>Acervus</b> multitudo corporum exiguorum, bene tamen visibilium, inanimorum\n[[55.32]] quorum alia aliis incumbunt. </p>\n<p> [[56.1]] <b>Acetum</b> est acidum factum ex eo quod spiritum ardentem distillando praebebat. </p>\n<p> [[56.2]] <b>Acies</b> est linea in angulo duarum superficierum seu est linea qua corpus facile\n[[56.3]] penetrat in aliud. </p>\n<p> [[56.4]] <b>Acumen</b> est tale punctum. </p>\n<p> [[56.5]] <b>Actio</b> status in uno ex quo immediate sequitur mutatio in alio. </p>\n<p> [[56.6]] <b>Actus</b> potentiae complementum. </p>\n<p> [[56.7]] <b>Acquiescere</b> est quiescere cum ratio aliqua est non quiescendi. </p>\n<p> [[56.8]] <b>Acquirit</b> qui incipit habere. </p>\n<p> [[56.9]] <b>Acinus</b> granum durum seminale intra fructum. </p>\n<p> [[56.10]] <b>Adeo</b> ut fiat, id est tam, quam opus est, ut fiat. </p>\n<p> [[56.11]] <b>Addere</b> dare conveniens ei quod adest. </p>\n<p> [[56.12]] <b>Adjuro</b> postulo ut facias perinde ac si jurasses. </p>\n<p> [[56.13]] <b>Ad minimum</b>, saltem, si non est <i>A</i>, tamen est <i>B</i>, quod sufficit. </p>\n<p> [[56.14]] <b>Adimo</b> facio ut non habeas. </p>\n<p> [[56.15]] <b>Adest</b> quod non distat notabiliter. </p>\n<p> [[56.16]] <b>Adeps</b>. </p>\n<p> [[56.17]] <b>Adhuc</b> est, quod fuit et est. </p>\n<p> [[56.18]] <b>Adjudicare</b> ipsi <i>A</i>, est judicare quod pertineat ad <i>A.</i> </p>\n<p> [[56.19]] <b>Adjunctum</b> est commune proprio et accidenti. </p>\n<p> [[56.20]] <b>Administrare</b> est negotium gerere cum autoritate. </p>\n<p> [[56.21]] <b>Admirari</b> est considerare cum desiderio magno quaerendi rationem. </p>\n<p> [[56.22]] <b>Adolescens</b> puber adhuc crescens. </p>\n<p> [[56.23]] <b>Adoptare</b>. Ex alio natum pro suo tractare. </p>\n<p> [[56.24]] <b>Adorare</b> est (corpore suo) maximum honorem exhibere. </p>\n<p> [[56.25]] <b>Adoritur</b> qui vim in aliquem facere incipit. </p>\n<p> [[56.26]] <b>Adspirat</b> qui ad bonum tendit. </p>\n<p> [[56.27]] <b>Adsciscere</b> est sibi adjungere. </p>\n<p> [[56.28]] <b>Adulari</b> est mentiri laudando, ut placeas laudato. </p>\n<p> [[56.29]] <b>Adulterare</b>. Injuriam facere supponendo unum pro alio, vel potius supponendo\n[[56.30]] per admistionem inconvenientis. </p>\n<p> [[56.31]] <b>Adumbrare</b> imperfecte repraesentare. </p>\n<p> [[57.1]] <b>Adversari</b> agere ut quae alius vult impediantur aut promoveantur quae non vult. </p>\n<p> [[57.2]] <b>Adversarius</b> qui hoc facere solet. </p>\n<p> [[57.3]] <b>Advertere</b> (percipere cum attentione, vel cum relatione ad alia) considerare relationem\n[[57.4]] ad alia. </p>\n<p> [[57.5]] <b>Advocatus</b> est orator litigantis. </p>\n",
  "number": "11.",
  "title": "Exemplarischer Ansatz zu einer alphabetischen Definitionenliste nach Dalgarno",
  "date": "[Oktober 1677 bis September 1680 (?)]"
};
