---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_167",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 167,
  "text": "<p> [[576.1]] <b>169. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[576.2]] Padua, 12. September [1692]. [168.170.]</b></p>\n<p> [[576.9]] Illu^#'m^#'o Sig^#'r^#'e, mio Sig^#'r^#'e, Padron Colend^#'m^#'o </p>\n<p> [[576.10]] Con questo istesso ordinario hò scritto a V. S. Illu^#'m^#'a per mezo delli Sig^#'r^#'i Hopfer, e\n[[576.11]] Bacmeister, dandole distintissimo raguaglio del mio stato, e delle ragioni, che mi trattengono\n[[576.12]] ancora in Italia, ma perche temo, che le mie lettere si smarriscano, mi hà parso bene replicare\n[[576.13]] questa altra, indrizzandola al Sig^#'r^#'e Mendelino essendo necessitato ad importunarla con doppie\n[[576.14]] lettere, affine d'assicurarmi del loro ricapito. Stimavo a questa hora trovarmi costì, però ne\n[[576.15]] sono stato distolto da vari accidenti, fra quali il principale sì è l'impegno preso di servire questo\n[[576.16]] Eccell^#'m^#'o Sig^#'r^#'e Capitano in tutto il suo reggimento qui in Padova, e benché esso habbia mostrato\n[[576.17]] di condescendere al mio desiderio, limitò talmente la licenza datami, che mi sopragionge\n[[576.18]] l'inverno senza accorgermene. Havevo risolto di prendere licenza con pretesto di divertirmi in\n[[576.19]] queste vacanze in Villa, però da un Sig^#'r^#'e mio confidentissimo ne sono stato dissuaso, non\n[[576.20]] stimando egli cosa onesta ed onorata partirmi con inganno; e perche nell'istesso tempo che\n[[576.21]] termina l'inverno, finisce il reggimento di questo mio Senatore, senza contravenire alle leggi\n[[576.22]] della gratitudine, e dell'onore lungi da ogni strepito, mi potrò mettere in viaggio per la ventura\n[[576.23]] primavera, stagione più propria per accommodarmi al temperamento di cotesto Clima. Mi creda\n[[576.24]] V. S. Illu^#'m^#'a, che i soli motivi dell'onore, e della gratitudine mi trattengono ancora qui, e se\n[[576.25]] havessi ricevuta la prima lettera di V. S. Illu^#'m^#'a in Venetia, pria di portarmi in Padova, senza\n[[576.26]] dubio, che haverei eseguito, quanto hò promesso. Mi potevo partire senza licenza è vero, ma\n[[576.27]] però l'attione sarebbe stata universalmente biasimata, ed haverei ad un tratto perduta quella\n[[576.28]] riputatione, che mi hò qui acquistata per molti anni, e di più mi sarei esposto a pericolo d'essere\n[[576.29]] fermato, essendo questo mio Senatore molto autorevole e potente. Priego dunque la somma\n[[577.1]] bontà di V. S. Illu^#'m^#'a patientare per qualche altro tempo, assicurandola, che per il vegnente aprile\n[[577.2]] al [più tardi] mi portarò senza fallo in Germania, e ciò allora accaderà con sodisfattione\n[[577.3]] universale, e consenso di questo Capitano, a cui sono molto obligato. V. S. Illu^#'m^#'a è così\n[[577.4]] prudente, e dotata d'ottima morale, che approverà certamente i miei sentimenti, che nascono\n[[577.5]] dall'amore dell'onesto, e dell'onore, essendo io tenacissimo ne' miei impegni quando però\n[[577.6]] sono ragionevoli. Del resto s'assicuri che mi piange il cuore di vedermi ancora in Italia,\n[[577.7]] sospirando ardentemente la Germania. Consegnarò quanto prima l'Ongarello con le due <i>Gallerie</i>\n[[577.8]] del Marino e le poesie del Testi al Sig^#'r^#'e Mendelino. La priego avvisarmi se hà ricevuto\n[[577.9]] quattro altre mie lettere che l' hò inviato, come anche a comandarmi liberamente ed assicurarsi\n[[577.10]] che sono </p>\n<p> [[577.11]] Di V. S. Illu^#'m^#'a Umil^#'m^#'o, Oblig^#'m^#'o Affett^#'m^#'o S^#'r^#'e Fardella </p>\n<p> [[577.12]] Padova 12 Settembre </p>\n<p> [[577.13]] All'Illu^#'m^#'o Sig^#'r^#'e, mio Sig^#'r^#'e, Padron Colend^#'m^#'o il Sig^#'r^#'e Leibniz Consigliere di Sua Altezza\n[[577.14]] Elettorale. Hannover </p>\n",
  "number": "169.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Padua, 12. September [1692]. [168.170.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:169. MICHEL ANGELO FARDELLA AN LEIBNIZ Padua, 12. September [1692]. [168.170.] Illu^#'m^#'o Sig^#'r^#'e, mio Sig^#'r^#'e, Padron Colend^#'m^#'o Con questo istesso ordinario hò scritto a V. S. Illu^#'m^#'a per mezo delli Sig^#'r^#'i Hopfer, e Bacmeister, dandole distintissimo raguaglio del mio stato,...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>