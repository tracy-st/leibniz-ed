        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:281. LEIBNIZ AN JOHANN HEINRICH PAPE Hannover, 9. (19.) August 1694. [279.] Vir Nobilissime et Consultissime, Fautor Honoratissime Gaudeo meum Codicem diplomaticum praesertimque praefationem, quae sola mea est, Tibi non displicuisse. Caeterum ita est ut scribis, plerisque, ipsique adeo Feldeno acuti...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii2_278","series":"Band II 2 (1686 - 1694)","seq":278,"text":"<p> [[839.17]] <b>281. LEIBNIZ AN JOHANN HEINRICH PAPE</p>\n<p> [[839.18]] Hannover, 9. (19.) August 1694. [279.]</b></p>\n<p> [[840.1]] Vir Nobilissime et Consultissime, Fautor Honoratissime </p>\n<p> [[840.2]] Gaudeo meum <i>Codicem diplomaticum</i> praesertimque praefationem, quae sola mea est,\n[[840.3]] Tibi non displicuisse. </p>\n<p> [[840.4]] Caeterum ita est ut scribis, plerisque, ipsique adeo Feldeno acutissimo Viro fraudi fuit,\n[[840.5]] quod juris gradus non satis distinxere. </p>\n<p> [[840.6]] Definitionum condendarum cura mihi pene a puero fuit maxima. Vellemque ipse habere in\n[[840.7]] unam collecta farraginem, quae saepe in hanc rem tentavi. Sed multa periere. Resarcienda\n[[840.8]] tamen fortasse non difficulter, si quando esset, quicum de talibus communicare possem. </p>\n<p> [[840.9]] Scripseram aliquando rogatu Baronis Boineburgii, in Poloniam Neoburgici Ducis nomine\n[[840.10]] Legaturientis, libellum de Regis in Polonia electione, Neoburgicis desideriis accomodatum,\n[[840.11]] titulo Georgii Ulicovii Lithuani, quo nunc ipse careo. Spem tamen recuperandi fecit Dn.\n[[840.12]] Avemannus ViceCancellarius Ostfrisius, Vir non minus doctrina, quam rerum usu insignis.\n[[840.13]] Boeclerus in libello quodam in publicum edito ita commendavit scriptum, ut sine exemplo esse\n[[840.14]] dicat. Et mihi ipse significavit olim, definitiones sibi inprimis placuisse, quae quales fuerint,\n[[840.15]] nec ego satis memini. </p>\n<p> [[840.16]] Sane cum omnis ratiocinatio a notionum evolutione pendeat, satis manifestum est definitiones\n[[840.17]] esse potissimum accuratae ratiocinationis instrumentum, quod etiam Aristoteles\n[[840.18]] optime vidit. Idem enim praestat in omni doctrina, quod valor quantitatum in Logica Mathematicorum\n[[840.19]] seu Algebra. </p>\n<p> [[840.20]] Caeterum etsi non male fortasse possim dicere, quid fieri possit debeatve; et acturis\n[[840.21]] aliquid praeclari, Consilia dare non aspernanda: Vereor tamen, ut aliquid magnopere praestem\n[[840.22]] per me, nisi ab amicis adjuver, quoniam sentio et valetudinem nonnihil vacillare. </p>\n<p> [[840.23]] Te quidem, Vir Consultissime, video tam accurate judicare de vera jurisprudentiae emendandae\n[[840.24]] promovendaeque ratione, ut nihil mihi gratius futurum sit, quam adjuvare meditationes\n[[840.25]] tuas, iisque adjuvari. Quod fateor coram fieri posse facilius et jucundius. Eoque mihi gratius\n[[840.26]] fuit intelligere Tuum consilium aliquando ad nos accedendi. </p>\n<p> [[840.27]] Caeterum etsi commendatione mea nemo Te minus egeat, egoque non sim ex eorum\n[[840.28]] numero qui multum possunt, spero tamen occasiones se daturas, quibus probare Tibi optimam\n[[840.29]] meam Voluntatem queam. Vale. Dabam Hanoverae 9 Augusti 1694.\n [[840.30]] / <i>A Monsieur Jean Henry Pape ICte à Lunebourg.</i> </p>\n","number":"281.","title":"LEIBNIZ AN JOHANN HEINRICH PAPE","date":"Hannover, 9. (19.) August 1694. [279.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>