---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_665",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 665,
  "text": "[[2861.11]] <b>505₅.  Fünfter Ansatz FÜNFTER ANSATZ </p>\n<p> [[2861.15]] Jus in quo versamur est scientia caritatis et justitia caritas sapientis. Est enim\n[[2861.16]] <b>caritas</b> habitus amandi omnes, et qui ita affectus est <b>vir bonus</b> vocatur. Justitia vero\n[[2861.17]] virtus est quae affectum hominis erga hominem ratione moderatur. Porro <b>sapientia</b> est\n[[2861.18]] scientia felicitatis. Felicitas autem in eo posita est, ut in Dei gratia atque amore vivamus\n[[2861.19]] cujus potentia et perfectio summa est. Cumque idem sapientissimus sit, perfectionem\n[[2861.20]] rerum generalem, et maxime praestantissimarum creaturarum quae scilicet ratione utuntur\n[[2861.21]] sibi propositam habebit. Itaque qui Deum amat, id est qui sapit omnes amabit, sed\n[[2861.22]] unumquemque eo magis quo expressiora in eo divinae virtutis vestigia lucebunt, et quo\n[[2861.23]] promtiorem validioremque in communi bono, vel quod eodem redit gloria Dei omnium\n[[2861.24]] bonorum autoris procuranda socium habebit. </p>\n<p> [[2862.1]] Si jam omnes ita animati atque exercitati essent, quod recta educatione consequi\n[[2862.2]] possimus, neque Magistrorum praeceptis, neque legum potestate admodum opus esset;\n[[2862.3]] nunc jam vero plerique neque ipsi per se intelligunt veras justi injustique causas; nec\n[[2862.4]] facile ad omnes species factorum generales juris regulas accommodare possint: in horum\n[[2862.5]] gratiam demonstrandum est, justitiam, non ut quidam veterum dicebat, stultitiam, sed\n[[2862.6]] potius sapientiam esse: et enumeratis potissimis causarum figuris admonendum est quid\n[[2862.7]] justum sit. Quia vero plurimi non tam intelligentia <Fn><i>Über</i> intelligentia: ingenio</Fn> quam quod pejus est bona mente et\n[[2862.8]] recte agendi voluntate, alii autem virtutis exercitio carent facileque affectibus abripiuntur,\n[[2862.9]] necesse fuit societatis tuendae causa regulas a prudentibus praescriptas publica potestate\n[[2862.10]] armari, unde in majoribus societatibus communis felicitatis causa initis quas vocant\n[[2862.11]] <b>Respublicas</b>, jura civilia nata esse constat. </p>\n",
  "number": "505₅.",
  "title": "Fünfter Ansatz",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:505₅. Fünfter Ansatz FÜNFTER ANSATZ Jus in quo versamur est scientia caritatis et justitia caritas sapientis. Est enim caritas habitus amandi omnes, et qui ita affectus est vir bonus vocatur. Justitia vero virtus est quae affectum hominis erga hominem ratione moderatur. Porro sapientia est scientia ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_vi4_665","series":"Band VI 4 (1677 - 1690)","seq":665,"text":"[[2861.11]] <b>505₅.  Fünfter Ansatz FÜNFTER ANSATZ </p>\n<p> [[2861.15]] Jus in quo versamur est scientia caritatis et justitia caritas sapientis. Est enim\n[[2861.16]] <b>caritas</b> habitus amandi omnes, et qui ita affectus est <b>vir bonus</b> vocatur. Justitia vero\n[[2861.17]] virtus est quae affectum hominis erga hominem ratione moderatur. Porro <b>sapientia</b> est\n[[2861.18]] scientia felicitatis. Felicitas autem in eo posita est, ut in Dei gratia atque amore vivamus\n[[2861.19]] cujus potentia et perfectio summa est. Cumque idem sapientissimus sit, perfectionem\n[[2861.20]] rerum generalem, et maxime praestantissimarum creaturarum quae scilicet ratione utuntur\n[[2861.21]] sibi propositam habebit. Itaque qui Deum amat, id est qui sapit omnes amabit, sed\n[[2861.22]] unumquemque eo magis quo expressiora in eo divinae virtutis vestigia lucebunt, et quo\n[[2861.23]] promtiorem validioremque in communi bono, vel quod eodem redit gloria Dei omnium\n[[2861.24]] bonorum autoris procuranda socium habebit. </p>\n<p> [[2862.1]] Si jam omnes ita animati atque exercitati essent, quod recta educatione consequi\n[[2862.2]] possimus, neque Magistrorum praeceptis, neque legum potestate admodum opus esset;\n[[2862.3]] nunc jam vero plerique neque ipsi per se intelligunt veras justi injustique causas; nec\n[[2862.4]] facile ad omnes species factorum generales juris regulas accommodare possint: in horum\n[[2862.5]] gratiam demonstrandum est, justitiam, non ut quidam veterum dicebat, stultitiam, sed\n[[2862.6]] potius sapientiam esse: et enumeratis potissimis causarum figuris admonendum est quid\n[[2862.7]] justum sit. Quia vero plurimi non tam intelligentia <Fn><i>Über</i> intelligentia: ingenio</Fn> quam quod pejus est bona mente et\n[[2862.8]] recte agendi voluntate, alii autem virtutis exercitio carent facileque affectibus abripiuntur,\n[[2862.9]] necesse fuit societatis tuendae causa regulas a prudentibus praescriptas publica potestate\n[[2862.10]] armari, unde in majoribus societatibus communis felicitatis causa initis quas vocant\n[[2862.11]] <b>Respublicas</b>, jura civilia nata esse constat. </p>\n","number":"505₅.","title":"Fünfter Ansatz","date":null}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>