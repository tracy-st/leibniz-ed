    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:24. De grammatica rationali et arte memoriae April 1678 April 1678 Aprilis 1678 [Grammatica rationalis] habebitur si partes orationis earumque flexiones et rectiones accurate resolvi possint. Quod ita intelligo: Verba possunt resolvi in nomina. Petrus scribit, id est Est Scribens. Unde omnia verba r...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_vi4_30","series":"Band VI 4 (1677 - 1690)","seq":30,"text":"[[70.10]] <b>24.  De grammatica rationali et arte memoriae April 1678</b>\n [[70.11]] <tab/> April 1678 </p>\n<p> [[70.17]] Aprilis 1678 </p>\n<p> [[70.18]] <p>[Grammatica rationalis] habebitur si partes orationis earumque flexiones et rectiones\n[[70.19]] accurate resolvi possint. Quod ita intelligo: </p>\n<p> [[70.20]] Verba possunt resolvi in nomina. <i>Petrus scribit</i>, id est <i>Est Scribens</i>. Unde omnia\n[[70.21]] verba reducentur denique ad solum verbum substantivum. </p>\n<p> [[71.1]] Reducenda omnia alia ad ea quae sunt absolute necessaria ad sententias animi\n[[71.2]] exprimendas. </p>\n<p> [[71.3]] In cogitando reducuntur omnia ad qualitates sensibiles, tum internas, ut calor, frigus,\n[[71.4]] lux, tum externas, ut, essentia, existentia, cogitatio, sensio, nihil, unitas, multitudo;\n[[71.5]] identitas, diversitas; extensio, duratio, situs; voluptas, possibilitas, actus: hoc. </p>\n<p> [[71.6]] Res est, non est. Res est possibilis. Existens. cogitans, sentiens. una. Eadem.\n[[71.7]] extensa. durans. sita. grata. laeta. </p>\n<p> [[71.8]] In lingua notanda ea tantum quae per regulas constitutas explicari non possunt, item\n[[71.9]] phrasium condendus est catalogus, quae prae caeteris celebrantur. </p>\n<p> [[71.10]] Ars memoriae, ut ea quae retinenda sunt certis loculamentis condamus, quae si\n[[71.11]] praesentia habeamus in animo, aut alias nota, ut Patriarchas, Apostolos, imperatores;\n[[71.12]] aliasque personas quarum nota nobis vita est, facile et ordine omnia collocabimus, et\n[[71.13]] subito inveniemus aliquid quo rem loculamento jungamus.\n[[71.14]] <petit> Johannes <tab/>equus <tab/>mulus <tab/>bos <tab/>leo <tab/>echo <tab/>canis <tab/>asinus <tab/>fornax\n [[71.15]] Julius <tab/>Augustus <tab/>Tiberius <tab/>Caligula <tab/>Claudius <tab/>dum mater <tab/>Galba <tab/>Otho <tab/>Vitellius\n [[71.16]] <tab/>in statua <tab/>seminobilis <tab/>ob <tab/>minime <tab/>Neronis <tab/>ob <tab/>ob <tab/>ob vitellum\n [[71.17]] <tab/>equestri <tab/>ab Augusto <tab/>ineptiam <tab/>leo <tab/>occiditur <tab/>avaritiam <tab/>pigritiam <tab/>ovi prope\n [[71.18]] <tab/>adoptatus <tab/>echo ad <tab/>fornacem\n [[71.19]] <tab/>litus <tab/>cocti</petit> </p>\n<p> [[71.20]] Ut numeros prorsum et retrorsum possimus enuntiare, pro numeris sumamus nobis\n[[71.21]] voces alias hominum vel animalium, easque constanter retineamus, ut postea semper\n[[71.22]] possimus vocem adhibere pro dicto numero. Si quis mihi dicat voces barbaras pro iis\n[[71.23]] substituam vicinas notas, ut pro <i>cipolski, Zwiebeln</i>. </p>\n<p> [[71.24]] Utile est personarum quas eligimus notissimam nobis esse vitam, ad minutias usque\n[[71.25]] ut possimus facile instituere connexiones. Poterimus etiam eligere regiones vel provincias.\n[[71.26]] Item literas Alphabeti. </p>\n<p> [[71.27]] Cuilibet imperatori licebit distichon ascribere Vitam ejus complectens, in quolibet\n[[71.28]] cum sint variae voces, facile una aliqua nostro scopo serviet, et a nobis notabitur,\n[[71.29]] exigendum ut lente dictetur. </p>\n","number":"24.","title":"De grammatica rationali et arte memoriae","date":"April 1678"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>