---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_73",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 73,
  "text": "<p> [[244.1]] <b>73. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[244.2]] Venedig, 15. Juni 1704. [74.] </b></p>\n<p> [[244.26]] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o </p>\n<p> [[244.27]] L'Esibitore della presente è il Sig^#'r^#'e Gio. Filippo Brienio di Dansica, d'anni Giovane, ma\n[[244.28]] nel senno e profonda cognitione delle più sane ed utili discipline vecchio, e veramente maturo.\n[[244.29]] Egli viaggia per maggiormente erudirsi, e conoscere i piu cospicui letterati dell'Europa, ed\n[[244.30]] essendosi fermato per alcuni mesi in Padova s'è guadagnata la stima e l'applauso de piu dotti\n[[244.31]] Professori, che anno in esso ammirata una lucida, e purgata letteratura, congionta con un\n[[244.32]] costume soavissimo e modestissimo che hà lungi d'ogn'esaggeratione rapito il cuore di tutti, e\n[[244.33]] principalmente il mio che l'adora per l'idea del Giovane savio e letterato. Or amando esso con\n[[244.34]] estrema passione, ed esercitando la Sapienza, si trova in necessità d'amare e sommamente\n[[245.1]] venerare V. S. Ill^#'m^#'a che possiede quella in se stesso in grado veramente eminente, e percio m'hà\n[[245.2]] pregato l'accompagnassi colla presente, accio nel suo passaggio per costà potesse avere la tanto\n[[245.3]] sospirata occasione di conoscerla ed approfittarsi della di lei dotta ed erudita conversatione.\n[[245.4]] Percio io mi prendo l'ardire di raccomandarlo con tutto il cuore all'autorevole e stimatissima\n[[245.5]] protettione di V. S. Ill^#'m^#'a, con degnarsi d'accoglierlo come me medesimo. Esso le rappresenterà\n[[245.6]] meglio de quel che io potessi fare colla penna, il mio stato, e la gloria che hò d'essere servitore\n[[245.7]] di V. S. Ill^#'m^#'a, che io venero come il primo letterato del Secolo, e riconosco come mio dichia^#'m^#'o\n[[245.8]] benefattore. Credo che V. S. Ill^#'m^#'a averà ricevute gia due mie, e coll'Ordinario venturo tornerò a\n[[245.9]] scrivergli diffusamente circa i miei studi, e l'opere che disegno publicare. Non sono arrivato\n[[245.10]] che oggi in Venetia, e volendosi partire subito il Sig^#'r^#'e Brienio per Vienna, non hò tempo di\n[[245.11]] scriverle di vantaggio. La prego dell'onore de' suoi stimatissimi comandamenti, e con tutto\n[[245.12]] rispetto riverendola mi rassegno </p>\n<p> [[245.13]] Di V. S. Ill^#'m^#'a Oblig^#'m^#'o Div^#'m^#'o S^#'r^#'e vero Michel Angelo Fardella </p>\n<p> [[245.14]] Venetia 15 Giugno 1704. </p>\n",
  "number": "73.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Venedig, 15. Juni 1704. [74.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:73. MICHEL ANGELO FARDELLA AN LEIBNIZ Venedig, 15. Juni 1704. [74.] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o L'Esibitore della presente è il Sig^#'r^#'e Gio. Filippo Brienio di Dansica, d'anni Giovane, ma nel senno e profonda cognitione delle più sane ed utili discipline vecchio, e ver...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>