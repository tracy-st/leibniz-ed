---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_143",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 143,
  "text": "[[494.13]] <b>116.  De modis syllogisticis primariis atque secundariis [Mai 1682 bis Dezember 1684 (?)]</b>\n [[494.14]] <tab/>[Mai 1682 bis Dezember 1684 (?)] </p>\n<p> [[494.20]] Modi ejusdem figurae distingui possunt in primarios et secundarios. Primarii sunt,\n[[494.21]] qui ex aliis suae figurae modis non consequuntur; secundarii qui omnino. Et secundarii\n[[494.22]] rursus ex primariis consequuntur duobus, uno ex praemissa ad praemissam, altero ex\n[[495.1]] conclusione ad conclusionem. Modus ex praemissa ad praemissam est a particulari ad\n[[495.2]] universale, nam quod ex particulari sequitur praemissa multo magis sequetur ex universali.\n[[495.3]] Modus a conclusione ad conclusionem, est ab universali ad particulare, nam ex quo\n[[495.4]] sequitur conclusio universalis, ex eo multo magis seu facilius sequetur conclusio particularis. </p>\n<p> [[495.6]] Secundarii priore modo sic colliguntur: <b>Primo</b> ex <i>AII</i> infertur <i>AAI</i>. Hinc in prima\n[[495.7]] ex <i>Darii</i> fit <i>Barbari</i>, in tertia ex <i>Datisi</i> fit <i>Darapti</i>. <b>Secundo</b> ex <i>IAI</i> infertur <i>AAI</i>, hinc in\n[[495.8]] tertia ex <i>Disamis</i> fit iterum <i>Darapti</i>, et in quarta ex <i>Digami</i> fit <i>Balani</i>. <b>Tertio</b> ex <i>AOO</i>\n[[495.9]] infertur <i>AEO</i>. Ita in secunda ex <i>Baroco</i> fit <i>Camestros</i>. <b>Quarto</b> ex <i>OAO</i> infertur <i>EAO</i>, ita\n[[495.10]] in tertia ex <i>Bocardo</i> fit <i>Felapton</i>. <b>Quinto</b> ex <i>EIO</i> fit <i>EAO.</i> Hinc in prima ex <i>Ferio</i> fit\n[[495.11]] <i>Celaro</i>, in secunda ex <i>Festino</i> fit <i>Cesaro</i>, in tertia ex <i>Ferison</i> fit iterum <i>Felapton</i>, in\n[[495.12]] quarta ex <i>Fedilom</i> fit <i>Fegano.</i> Sed <i>IEO</i> in nulla datur figura unde nihil inde duci potest.\n[[495.13]] Patet hinc <i>Darapti</i> et <i>Felapton</i> bis esse secundarios modos primae speciei. Et primam\n[[495.14]] speciem secundariorum dare modos novos aliquot, nempe <i>Barbari</i>, <i>Camestros</i>, <i>Cesaro</i>,\n[[495.15]] <i>Celaro</i>. </p>\n<p> [[495.16]] Secundarii posteriore ratione sic colliguntur: <b>Primo</b> ex <i>AAA</i> fit <i>AAI</i>, ita in prima ex\n[[495.17]] <i>Barbara</i> fit <i>Barbari</i>. <b>Secundo</b> ex <i>EAE</i> fit <i>EAO</i>, ita in prima ex <i>Celarent</i> fit <i>Celaro</i>, in\n[[495.18]] secunda ex <i>Cesare</i> fit <i>Cesaro</i>. <b>Tertio</b> ex <i>AEE</i> fit <i>AEO</i>; ita in secunda ex <i>Camestres</i> fit\n[[495.19]] <i>Camestros</i>, in quarta ex <i>Cadere</i> fit <i>Cadero</i>. </p>\n<p> [[495.20]] Omnes Modi secundarii ratione posteriore collecti colliguntur et priore excepto uno\n[[495.21]] modo quartae <i>Cadero</i>.\n[[495.22]] <tab/>ADC <tab/>EBC <tab/>OBD\n [[495.23]] <tab/>ABD\n [[495.24]] <tab/><i>Celarent</i> <tab/>ECB <tab/>ADC <tab/>EDB\n [[495.25]] <tab/><i>Calmentes</i> <tab/>ADC <tab/>ECB <tab/>EBD\n [[495.26]] <tab/><i>Camestres</i> <tab/>ADC <tab/>EBC <tab/>EBD </p>\n",
  "number": "116.",
  "title": "De modis syllogisticis primariis atque secundariis",
  "date": "[Mai 1682 bis Dezember 1684 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:116. De modis syllogisticis primariis atque secundariis [Mai 1682 bis Dezember 1684 (?)] [Mai 1682 bis Dezember 1684 (?)] Modi ejusdem figurae distingui possunt in primarios et secundarios. Primarii sunt, qui ex aliis suae figurae modis non consequuntur; secundarii qui omnino. Et secundarii rursus e...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>