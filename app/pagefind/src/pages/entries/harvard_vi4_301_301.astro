---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_301",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 301,
  "text": "[[1343.17]] <b>247.  Charpentier sur l'explication des mots [Sommer 1689 (?)]</b>\n [[1343.18]] <tab/>[Sommer 1689 (?)] </p>\n<p> [[1343.21]] Du <i>Journal des Sçavans</i> 13 juin 1689. </p>\n<p> [[1343.22]] Mons. Charpentier dans un discours prononcé à la reception de M. de Caillieres (qui\n[[1343.23]] avoit dedié un panegyrique du Roy à l'Academie) et de M. l'Abbé Renaudot (qui fait des\n[[1344.1]] mémoires Historiques sous le nom de <i>la Gazette</i>) 1689, 7. febr. fait la remarque suivante\n[[1344.2]] sur l'explication des mots. </p>\n<p> [[1344.3]] Le Travail ordinaire de l'Academie a pour son principal objet l'explication des mots,\n[[1344.4]] ce que les ennemis des belles lettres traitent de minuties grammaticales. Il fait voir que\n[[1344.5]] l'estude des mots est le bien prendre la partie de la literature la plus utile et la plus\n[[1344.6]] excellente, parceque c'est elle qui nous fait entrer dans la connoissance des plus secrets\n[[1344.7]] ressorts de la raison, qui a tant de rapport avec la parole, que dans la langue la plus\n[[1344.8]] sçavante de l'univers la parole et la raison n'ont qu'un même nom sur quoy il se sert\n[[1344.9]] d'une comparaison excellente. Les plus stupides entre les hommes, dit il, sçavent bien\n[[1344.10]] qu'ils marchent, qu'ils voyent, qu'ils entendent. Mais il n'y a que les grands genies, qui\n[[1344.11]] veuillent connoistre la structure et l'entrelassement admirable des os, des nerfs, et des\n[[1344.12]] muscles, par les quels se font tant de mouvemens et tant de sensations differentes. Ainsi\n[[1344.13]] l'homme le plus grossier sçait bien qu'il parle, et qu'il se fait entendre aux autres, mais il\n[[1344.14]] n'y a que les esprits du premier ordre, qui veuillent connoistre les differentes idées sur les\n[[1344.15]] quelles nos paroles se forment, ce qui en fait la justesse ou l'irregularité, la beauté ou\n[[1344.16]] l'imperfection, la certitude ou le doute. L'Academie ne s'est point voulu charger des mots\n[[1344.17]] des arts et des sciences, et qu'elle s'est retranchée à la langue commune; telle qu'elle est\n[[1344.18]] dans le commerce des honnestes gens, et telle que les orateurs et les poëtes l'employent,\n[[1344.19]] qu'ainsi elle definit les mots communs, dont les idées sont fort simples ce qui est\n[[1344.20]] infiniment plus malaisé que de fixer les mots des arts et des sciences dont les idées sont\n[[1344.21]] fort composées. Il est plus aisé de <angle bracket>dire</angle bracket> que le Telescope est une lunette à voir de loin,\n[[1344.22]] que de dire ce que c'est que voir. D'où l'on peut juger, quelle prodigieuse entreprise a\n[[1344.23]] esté celle de l'Academie quand elle s'est chargée de definir tous les mots communs de la\n[[1344.24]] langue française.\n[[1345.1]] B 1. METAPHYSICA </p>\n",
  "number": "247.",
  "title": "Charpentier sur l'explication des mots",
  "date": "[Sommer 1689 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:247. Charpentier sur l'explication des mots [Sommer 1689 (?)] [Sommer 1689 (?)] Du Journal des Sçavans 13 juin 1689. Mons. Charpentier dans un discours prononcé à la reception de M. de Caillieres (qui avoit dedié un panegyrique du Roy à l'Academie) et de M. l'Abbé Renaudot (qui fait des mémoires His...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_vi4_301","series":"Band VI 4 (1677 - 1690)","seq":301,"text":"[[1343.17]] <b>247.  Charpentier sur l'explication des mots [Sommer 1689 (?)]</b>\n [[1343.18]] <tab/>[Sommer 1689 (?)] </p>\n<p> [[1343.21]] Du <i>Journal des Sçavans</i> 13 juin 1689. </p>\n<p> [[1343.22]] Mons. Charpentier dans un discours prononcé à la reception de M. de Caillieres (qui\n[[1343.23]] avoit dedié un panegyrique du Roy à l'Academie) et de M. l'Abbé Renaudot (qui fait des\n[[1344.1]] mémoires Historiques sous le nom de <i>la Gazette</i>) 1689, 7. febr. fait la remarque suivante\n[[1344.2]] sur l'explication des mots. </p>\n<p> [[1344.3]] Le Travail ordinaire de l'Academie a pour son principal objet l'explication des mots,\n[[1344.4]] ce que les ennemis des belles lettres traitent de minuties grammaticales. Il fait voir que\n[[1344.5]] l'estude des mots est le bien prendre la partie de la literature la plus utile et la plus\n[[1344.6]] excellente, parceque c'est elle qui nous fait entrer dans la connoissance des plus secrets\n[[1344.7]] ressorts de la raison, qui a tant de rapport avec la parole, que dans la langue la plus\n[[1344.8]] sçavante de l'univers la parole et la raison n'ont qu'un même nom sur quoy il se sert\n[[1344.9]] d'une comparaison excellente. Les plus stupides entre les hommes, dit il, sçavent bien\n[[1344.10]] qu'ils marchent, qu'ils voyent, qu'ils entendent. Mais il n'y a que les grands genies, qui\n[[1344.11]] veuillent connoistre la structure et l'entrelassement admirable des os, des nerfs, et des\n[[1344.12]] muscles, par les quels se font tant de mouvemens et tant de sensations differentes. Ainsi\n[[1344.13]] l'homme le plus grossier sçait bien qu'il parle, et qu'il se fait entendre aux autres, mais il\n[[1344.14]] n'y a que les esprits du premier ordre, qui veuillent connoistre les differentes idées sur les\n[[1344.15]] quelles nos paroles se forment, ce qui en fait la justesse ou l'irregularité, la beauté ou\n[[1344.16]] l'imperfection, la certitude ou le doute. L'Academie ne s'est point voulu charger des mots\n[[1344.17]] des arts et des sciences, et qu'elle s'est retranchée à la langue commune; telle qu'elle est\n[[1344.18]] dans le commerce des honnestes gens, et telle que les orateurs et les poëtes l'employent,\n[[1344.19]] qu'ainsi elle definit les mots communs, dont les idées sont fort simples ce qui est\n[[1344.20]] infiniment plus malaisé que de fixer les mots des arts et des sciences dont les idées sont\n[[1344.21]] fort composées. Il est plus aisé de <angle bracket>dire</angle bracket> que le Telescope est une lunette à voir de loin,\n[[1344.22]] que de dire ce que c'est que voir. D'où l'on peut juger, quelle prodigieuse entreprise a\n[[1344.23]] esté celle de l'Academie quand elle s'est chargée de definir tous les mots communs de la\n[[1344.24]] langue française.\n[[1345.1]] B 1. METAPHYSICA </p>\n","number":"247.","title":"Charpentier sur l'explication des mots","date":"[Sommer 1689 (?)]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>