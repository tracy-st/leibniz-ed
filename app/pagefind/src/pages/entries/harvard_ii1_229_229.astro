import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_229",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 229,
  "text": "<p> [[707.11]] <b>205b. EHRENFRIED WALTHER VON TSCHIRNHAUS AN LEIBNIZ</p>\n<p> [[707.12]] [Paris, Mai 1679.] [177.220.]</b></p>\n<p> [[708.3]] [ ... ] Quoad tandem Characteristicam Tuam dicis: <i>Te nescio qua de causa praeoccupatum\n[[708.4]] ab his meis Meditationibus fuisse alienorem</i> quod revera in quantum differam ignoro, <Fn><i>Hier und in den folgenden Fußnoten Bemerkungen von Leibniz' Hand</i>: Fere semper invento a me detecto non ante ei applausit, quam ubi ipse in id aliter incidit.</Fn>\n[[708.5]] nam credo Me talia quaedam prioribus literis, indigitasse, quae quoque citas et confiteris <Fn>arguis </Fn> me\n[[708.6]] tecum sentire; Praeterea multum hac de re olim tecum locutus in quibus aperte dixi, Me in\n[[708.7]] praecipuis tecum convenire, licet non in omnibus; Ut autem perfecte hac de re judicare possis,\n[[708.8]] Meam sententiam clare hisce declarabo. Cum aliquatenus Algebrae cognitionem Mihi acquisivissem,\n[[708.9]] perplacebant in ea quod quasi ludendo, tam remotae a nostra cognitione, veritates\n[[708.10]] possent acquiri; hinc maxime tale quid in aliis scientiis, desideravi, sed cum non ita statim\n[[708.11]] applicatio pateret et Cartesius loquebatur de sua Methodo, quasi haec se universaliter, ad omnia\n[[708.12]] et aeque facile extenderet, ego credebam ipsum tale quid habuisse, ac proinde maxime hoc in\n[[708.13]] suis scriptis perquirebam, in quibus evolvendis tum temporis, maxime occupatus eram. Sed\n[[708.14]] nihil revera inveni, quod animo satisfaceret, interim tamen incidi paulo post in Epistolam, in\n[[708.15]] qua loquitur de lingua aliqua Philosophica, <Fn>Dixit mihi: ego nunquam intellexi quid sibi velit in hac Epistola, sed postquam ego de mea characteristica dixi, coepit intelligere.</Fn> qua Rusticus aeque facile posset (si recte memini)\n[[708.16]] in veritatis inquisitione progredi ac Magnus Philosophus et alia plura his non absimilia, quae\n[[708.17]] admodum admirabar et utique inexpectata Mihi erant; sed Linguae vocabulum mihi obfuit ut\n[[708.18]] haec non perciperem; <Fn>Fassus mihi est Parisiis in colloquio se non intellexisse illam Epistolam, donec ego de mea lingua philosophica disserui.</Fn> sed dum in demonstrationibus concinnandis admodum occupatus essem\n[[708.19]] ac delectarer me [ipsum] ex calculo Algebraico tanta facilitate illas posse elicere, ad quas\n[[708.20]] excogitandas legendo Mathe. Scripta [ipsum] divinum ingenium habuisse existimaram; observavi\n[[709.1]] quod revera eadem res utrobique peragatur, eadem certitudine nisi quod Algebra haec\n[[709.2]] expeditius exsequatur atque adeo nullam aliam differentiam esse, quam si quis duabus diversis\n[[709.3]] linguis eadem loquatur; <Fn>Tantum interest quantum inter characteres numerales commodos, et alios ineptos ad commode calculandum et irregulares.</Fn> hic subito reflexi <Fn>postquam audierat me de characteristica mea disserentem; longe abest ut agnoscat et id hausisse ex meis.</Fn> ad ea quae inveneram in modo indicata epistola et\n[[709.4]] haecce applicans vidi omnia perfecte consentire; hinc existimabam, me verum sensum Cartesii\n[[709.5]] percepisse; adeoque in mea sententia confirmatior factus auctoritate tanti Philosophi, <Fn>et admonitione mea</Fn> multas\n[[709.6]] quidem posthac, sed frustra volvi cogitationes, adeoque quo Mihi viam sternerem, ad illud\n[[709.7]] acquirendum, <Fn>Jam habeo.</Fn> Mihi firmiter proposui Algebram ex professo excolere, <Fn>Non sufficit Algebra, opus est calculo Geometrico qualem monstravi. </Fn> quia nimirum jam tale\n[[709.8]] quid habebamus ut sic bene iis perpensis, simul addiscerem applicationem ejusdem ad omnia;\n[[709.9]] hinc Algebram primo ex variis authoribus in unum corpus collegi; ut sic omnia quae dispersa\n[[709.10]] erant praecipua inventa, simul contemplandi facilior occasio esset, ex quo deinde breve compendium <Fn>Illud\n[[709.11]] compendium erat scriptum mihique ostensum cum adhuc fateretur se Epistolam Cartesii non intelligere.</Fn> adornavi et alia multa peregi quibus recensendis hic supersedeo; Deinde cum in\n[[709.12]] cognitionem pervenissem Dn. Sp., Dom. Schüll. rogavi ut ab ipso inquireret, in veram Methodum\n[[709.13]] investigandi veritatem (quia tunc temporis domum eram ex Hollandia reversus), sed Mihi\n[[709.14]] in responsione retulit quod ipsius praecipua cura fuerit, Ideam veram ab omnibus aliis ideis,\n[[709.15]] falsa ficta et dubia distinguere, et hinc se incredibilem facilitatem in progressu veritatis acquirendae\n[[709.16]] offendisse; Cum demum in Hollandiam reversus; ipsum accessi et post varia quoque\n[[709.17]] ostensa Cartes. epistola, quid de illa sentiret, rogabam, sed ille ridendo respondebat, <i>credisne\n[[709.18]] Mi Amice Omnia quae Cartesius dixit vera esse?</i> <Fn>Scio Spinosam haec non intellexisse.</Fn> dixi <i>non: bene dum</i> replicavit, <i>res itaque\n[[709.19]] haec nobis non magnam solicitudinem causabit</i> et sic alia, uti solebat; Attamen fateor Mihi vix\n[[710.1]] probabile videbatur; quod Cartesius haecce, si non eorum solide persuasus fuisset, ad Mersennum\n[[710.2]] scripsisset, cum sciebat tunc literas suas a Multis visum iri, quapropter hisce non dimovebar\n[[710.3]] a mea opinione; hanc Epistolam <b>Tibi postea</b> <Fn>cum antea de mea essem locutus, et fateretur prius se Cartesium non intelligere. (<i>Das Gesperrte von Leibniz unterstrichen.</i>)</Fn> <b>quoque, ut probe noris</b>, monstravi, <Fn>Eam\n[[710.4]] mihi indicavit Thevenotius. </Fn> et varia de hisce rebus collocuti fuimus; Sed quantum jam recordor, in eo semper se\n[[710.5]] terminabat discursus, quod viderem Te Methodum hanc, <Fn>imo necessario</Fn> ad omnia quae in Mundo sunt\n[[710.6]] extendere (nec video me deceptum, nam et adhuc es in ea sententia, ut clare tuae literae\n[[710.7]] indicant, dicis enim <i>ope ejus omnes nostrae cogitationes</i> etc. in quibus Tibi non contrarius sum\n[[710.8]] et revera perquam optarem, ut tale quid haberemus et quis vellet de ejus praestantia dubitare?).\n[[710.9]] Sed Mea cogitatio tunc erat; quod saltem in tali Methodo occupatus essem acquirenda, ut\n[[710.10]] problemata Physica eadem ratione tractare possem, <Fn>Nemo perfecte unam acquiret sine altera, nam physica resolvuntur in metaphysica.</Fn> et resolvere ac problemata mathematica\n[[710.11]] ope Algebrae, et eo saltem conatus meos postea extendi; Verum deinde percepi non opus esse ut\n[[710.12]] progrederer ad ea, cum necdum habeamus in ipsa Algebra <Fn>certe geometria non bene tractata</Fn> veram ac genuinam artem inveniendi; <Fn>Ego\n[[710.13]] adhuc habeo aliam plane Algebram.</Fn> observavi enim, nos mirum in modum omnes deceptos fuisse Algebrae speciositate;\n[[710.14]] hancque esse confusissimam artem; quod magis magisque videbam, cum mihi illuxit verae\n[[710.15]] Analyseos Idea; praesertim cum infinitis exemplis, hac in re confirmatior factus; Dicam itaque\n[[710.16]] Tibi Me in talem methodum incidisse, quae his praerogativis gaudet <Fn>Si supponit lineas et motus, non est qualis esse debet.</Fn> 1^#'o non posse dari\n[[710.17]] faciliorem, hoc statim ex ejus forma et notione facillimae Methodi patet. 2. Nulla aequationum\n[[710.18]] reductione hic opus esse. 3. Nulla earundem ad simpliciores depressione. 4. Nulla radicum\n[[710.19]] extractione. 5. Nulla radicum electione, nam radice extracta non scimus statim alias, quae radix\n[[710.20]] proposito problemati satisfacit; hisce ad eam perfectionem reductis, quantum temporis angustia\n[[710.21]] mihi permisit, nondum tamen volui aggredi ipsa problemata physica, nisi prius problemata\n[[710.22]] Mechanica et quae motum spectant, quatenus is imaginationi subjicitur, ad similem Methodum\n[[710.23]] reduxissem; Et hic quidem observavi talia tam facile posse solvi, ut vix calculo ullo opus sit,\n[[710.24]] cumque tot viae non occurrant ad idem problema solvendum quot in Geometricis, <Fn>Imo semper in mechanicis innumerae occurrunt viae, magis quam in geometria.</Fn> difficultas\n[[711.1]] hic non tanta est ut ibi ad omnium facillimam determinandam, adeo ut hic facile possunt\n[[711.2]] praescribi praecepta quibus observatis, si centum idem problema solvendum susciperent, necessario\n[[711.3]] tamen omnes per easdem vias cogitationes dirigerent, ad ignotum determinandum, attamen\n[[711.4]] si problemata nimis composita essent vix absque calculi adjumento res procederet; considerans\n[[711.5]] interim hic facilius multo causam quam in Geometricis, quare calculo opus sit:\n[[711.6]] observavi Scientiam aliquam nobis superesse, quae nullo calculo indigeat et qua bene in\n[[711.7]] ordinem redacta omnia particularia in Physicis absque calculo poterunt determinari <Fn>Haec est calculus in linguam redactus vel imagines.</Fn> et huic\n[[711.8]] scientiae convenit, quod dicis ut et <i>in captivi, cui negatur calamus et cui ligatae manus,\n[[711.9]] potestate sit</i>, nec mirum, nam haec ea ipsa est, circa quam et post mortem poterimus esse\n[[711.10]] occupati; Vix interim credo, quod quis talem scientiam (quae merito aeterna posset apellari, ut\n[[711.11]] et omnes quae ad hanc perfectionem possint reduci) nobis facile tradet; licet in hac ipsa,\n[[711.12]] credam, problemata majori posse facilitate solvi, quam ulla analysi Mathematica; nisi quis se,\n[[711.13]] suaque ad talem statum redegerit, ut, quam minime a rebus externis dependeat; Atque hisce\n[[711.14]] meas cogitationes circa haec seu si mavis opiniones aut praeconcepta praejudicia (Ab Amicis\n[[711.15]] siquidem quieto haec suscipio vultu) libere exposui. </p>\n<p> [[711.16]] Quoad definitiones rerum, quod dixerim eas esse difficiles; per eas non intellexi, ut\n[[711.17]] existimas conceptus maxime simplices; credo enim tales conceptus facile posse definiri, imo eo\n[[711.18]] facilius quo simpliciores sunt, ut per se patet; Nec Te credo aliud posse sentire et quando dicis\n[[711.19]] eas esse perdifficiles, absque dubio ad alias respicis, quam ad horum conceptuum naturam; hoc\n[[711.20]] quoque clare patet, si statuatur Essentiale seu no<angle bracket>ta</angle bracket> definitionis perfectae atque adaequatae in\n[[711.21]] eo consistere; quod semper per causam efficientem proximam exprimatur; <Fn>Omnis definitio quae ostendit possibilitatem bona, etiam sine causa efficiente.</Fn> hoc posito omnia\n[[711.22]] quae ab Authoribus afferri solent, quod definitio debeat constare genere et differentia, quod non\n[[711.23]] latius <angle bracket>se</angle bracket> debeat extendere re definita etc. imo quod ipse adfers; quod percepta ea non amplius\n[[711.24]] dubitari possit, utrum sit possi<angle bracket>bilis</angle bracket> nec ne, haec omnia inquam et quae possunt afferri, hinc\n[[711.25]] statim <angle bracket>neces</angle bracket>sario et <angle bracket>tan</angle bracket>quam proprietates sal<angle bracket>tem</angle bracket> sequuntur; tales autem definitiones ego\n[[711.26]] judico maxime difficiles esse et eo difficiliores, quo res magis compos<angle bracket>ita</angle bracket> est; et ut taceam\n[[711.27]] Physica, ubi res nimis clara est (e. g. definitionem hominis per causam efficientem non Mihi\n[[711.28]] quis fa<angle bracket>cile</angle bracket> exhibebit), in ipsis Mathematicis nec statim obvium est tales definitiones dare e. g.\n[[711.29]] definitionem centrorum seu focorum curvarum nemo adhuc hac conditione exhibuit; <Fn>Methodo mea quaecunque definitio assumatur inde per calculum erui potest perfectissima illa.</Fn> Alias\n[[712.1]] autem definitiones quae non nisi proprietates saltem rei definitae exprimunt non vero causam\n[[712.2]] efficientem ego nullatenus aestimo, <Fn>Calculo adhibito statim alterae inde habentur.</Fn> cum probe jam sciam quantum detrimentum factum sit\n[[712.3]] scientiis hoc unico intermisso; nec miror ut Mathematica saltem attingam, quod omnes conqueruntur\n[[712.4]] obscura esse, quae circa proportionem habentur <Fn>Mihi ea clarissima.</Fn> et infinitae aliae disputationes quas\n[[712.5]] habent, haec enim omnia hinc originem trahunt, nec credo ullum adaequatam demonstrationem\n[[712.6]] nobis exhibiturum, quod triangula similia proportionalia, nisi quis definitiones nobis exhibeat\n[[712.7]] quae lineae rectae et proportionis causam efficientem exprimunt, hinc enim res unico intuitu\n[[712.8]] clara; Multa talia habeo assignata, quae si Tempus Mihi concedat in ordinem redigam; [ ... ] </p>\n<p> [[712.9]] <i>A Monsieur Monsieur Godefroy Guillielmo Leibnitz Conseilleur de S.A.S. de Hanover.</i> </p>\n",
  "number": "205b.",
  "title": "EHRENFRIED WALTHER VON TSCHIRNHAUS AN LEIBNIZ",
  "date": "[Paris, Mai 1679.] [177.220.]"
};
