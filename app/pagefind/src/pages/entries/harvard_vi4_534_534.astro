---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_534",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 534,
  "text": "[[2471.1]] <b>422.  Excerpta ex Walenburgiorum libris [1. Hälfte 1677 (?)]</b>\n [[2471.2]] <tab/>[1. Hälfte 1677 (?)]\n[[2471.10]] <tit2><b>Excerpta ex Walenburgiorum libris</b></tit2> </p>\n<p> [[2471.11]] <i>Tract. 1. Examen principiorum fidei</i>. </p>\n<p> [[2471.12]] <i>Tenent Protestantes per modum principii solam scripturam sufficere ad probandos\n[[2471.13]] articulos fidei.</i> (+ Quaeritur an si nullus alius extaret liber de religione Christiana, quam\n[[2471.14]] scriptura sacra, nec aliunde quicquam de ea sciri posset. Fingamus in aliquam Maris\n[[2471.15]] Africani insulam in qua homines Arabicam linguam intelligant ejici naufragio codicem\n[[2471.16]] scripturae sacrae arabica lingua scriptum. Tollunt librum incolae et cum caeteris spoliis in\n[[2471.17]] unum acervum conjiciunt. Noctu igne concepto omnia comburuntur, solo Codice salvo,\n[[2471.18]] attoniti ea re incolae librum avide legunt, et doctrinam ejus praeparatu mirati sequendam\n[[2471.19]] sibi constituunt, quaeritur an ex eo solo mediocri judicio ac diligentia sibi veram religionem\n[[2471.20]] quantum ad salutem satis est concinnare possent, mihi id verisimile admodum\n[[2471.21]] videtur. +) </p>\n<p> [[2471.22]] Walenburch d. l. <i>Commune</i> Romanorum et Protestantium <i>principium est</i>, <i>doctrinam\n[[2471.23]] Christianorum primorum seculorum quae in libris sanctorum patrum et antiquorum\n[[2471.24]] Conciliorum reperitur esse incorruptam; saltem quoad articulos necessarios.</i> (+ Patres\n[[2471.25]] quasdam possunt habere opiniones cum Romana Ecclesia communes sed non ideo illa\n[[2472.1]] quae in Romana Ecclesia habes, quod scilicet Anathematismis Romana Ecclesia difficilem\n[[2472.2]] reddit unionem. +) </p>\n<p> [[2472.3]] An articuli fidei debeant ex sententia Protestantium esse in scriptura ita ut non sit\n[[2472.4]] opus consequentiis. Affirmant Walenburgii. </p>\n<p> [[2472.5]] Nisi Protestantes ex scriptura sacra probare possunt quis sit numerus articulorum\n[[2472.6]] fidei, non est eorum principium sufficiens. Non vero possunt, nam ea in re ipsi dissident\n[[2472.7]] inter se. Hoc argumentum ego non admitto. Sufficit aliquem credere articulum aliquem\n[[2472.8]] tametsi nesciat an sit necessarius. </p>\n<p> [[2472.9]] <i>Quomodo ullam controversiam catholicis movebunt legitime, nescientes an ob\n[[2472.10]] errorem</i> necessarium ab iis <i>recesserint.</i> </p>\n<p> [[2472.11]] Calviniani non possunt ostendere cur consensus inter ipsos et pontificios fundamentalior\n[[2472.12]] quam inter ipsos et Lutheranos. </p>\n<p> [[2472.13]] Decretum synodi Nationalis Carentoniensis anno 1631. (Walenb. pag. 3.) </p>\n<p> [[2472.14]] p. 4. Quaestio inter Protestantes et Pontificios <i>an Ecclesia sit infallibilis</i> [<i>judex</i>]\n[[2472.15]] <i>controversiarum</i> non tantum <i>quoad articulos necessarios</i>, id enim concedunt, inquit,\n[[2472.16]] <i>Protestantes, et eo ipso totam causam nobis tradunt</i>, sed <i>an sit infallibilis judex ex dono\n[[2472.17]] Spiritus Sancti, et promissione Christi sine ulla restrictione ad articulos sive omnibus\n[[2472.18]] necessarios sive non necessarios.</i> </p>\n<p> [[2472.19]] <i>De interpretatione scripturae per scripturam.</i> </p>\n<p> [[2472.20]] <i>Confessio Helvetica posterior artic. 2. illam duntaxat scripturae interpretationem\n[[2472.21]] agnoscimus, quae cum regula fidei et charitatis congruit</i> (+ regula fidei et charitatis, seu\n[[2472.22]] analogia fidei, quid? +). </p>\n<p> [[2472.23]] An si in syllogismo una propositio sit fidei, altera rationis, conclusio sit theologica.\n[[2472.24]] Concedit Musaeus si propositio illa rationis sit absolute necessaria, seu metaphysice cert\n[[2472.25]] [<i>bricht ab</i>] </p>\n",
  "number": "422.",
  "title": "Excerpta ex Walenburgiorum libris",
  "date": "[1. Hälfte 1677 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:422. Excerpta ex Walenburgiorum libris [1. Hälfte 1677 (?)] [1. Hälfte 1677 (?)] Excerpta ex Walenburgiorum libris Tract. 1. Examen principiorum fidei. Tenent Protestantes per modum principii solam scripturam sufficere ad probandos articulos fidei. (+ Quaeritur an si nullus alius extaret liber de re...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>