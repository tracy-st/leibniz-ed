---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_202",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 202,
  "text": "<p> [[533.13]] <b>202. LEIBNIZ AN MICHEL ANGELO FARDELLA</p>\n<p> [[533.14]] Hannover, [28. Februar 1699.] [191.208.]</b></p>\n\n<p> [[534.1]] Vir plurimum Reverende et celeberrime </p>\n<p> [[534.2]] Literas <Fn><i>Am Kopf der Seite von Leibniz' Hand</i>: Ad Dn. Abb. Fardellam.</Fn> a Te accepi ante menses aliquot multis nominibus gratissimas, sed praesertim\n[[534.3]] quod de benevolentiae Tuae perseveratione testantur. Rescripsissem dudum, si vel literae ipsae\n[[534.4]] tuae mihi praebuissent materiam (scis enim quam alienus sim a perdendo tempore inanibus\n[[534.5]] verbis) vel amici Tui causa aliquid sese aperuisset, sed ut jam tum scripsi; ex quo olim elapsa\n[[534.6]] nobis est occasio, omnia adhuc priore sunt loco, tametsi ante annum et amplius aliqua mutatio\n[[534.7]] sperata fuerit, quae si aliquando contingat invigilabo lubens merito. </p>\n<p> [[534.8]] Quod morem attinet problemata in medium proponendi quem in quibusdam nunc florentibus\n[[534.9]] magni nominis viris reprehendis, distinctionem adhibitam fuisse vellem in illa periodo\n[[534.10]] Tua p. 180, nam si problemata dependent a methodis jam vulgatis, pertinent ad tironum\n[[534.11]] exercitia, nec vexandi sunt illis eruditi. Quodsi altius aliquid subsit, et methodi requirantur quae\n[[534.12]] nondum sunt in potestate quantum publice constet, magnam problematum utilitatem esse\n[[534.13]] censeo ad augendam artem inveniendi; praesertim si habeant elegantiam, nec tam prolixo\n[[534.14]] calculo quam arte constent, et a proponente reperta sit solutio per methodum non casum. His\n[[534.15]] conditionibus problematum positis multum illis nostro seculo debet scientiae progressus, dum\n[[534.16]] praeclara ingenia ad laudabilem aemulatationem excitantur. </p>\n<p> [[534.17]] Caeterum alia quaestio est utrum, et quatenus deceat hominem liberaliter eruditum his\n[[534.18]] studiis incumbere intentius. Atque illud quidem extra controversiam est pietatis et virtutis\n[[534.19]] potissimam esse curam debere; sed cum praeterea unusquisque certum vitae atque occupationis\n[[534.20]] genus eligere queat, cui se dare magis e re putet; non video cur reprehendendi sint qui\n[[534.21]] Mathematica illa abstrusiora sibi excolenda deligunt, aut Astronomicis observationibus noctes\n[[534.22]] impendunt; dum quidam alii antiquitates Romanas, et numismata veterum, aut Chronologias\n[[534.23]] vel Genealogias, vel orientales literas sibi sumunt; prorsus ut non reprehendimus artifices qui\n[[535.1]] picturae aut Musicae, aut tornatoriae arti vel anaglypticae se totos tradunt. Interest reipublicae\n[[535.2]] praeter communia officia esse aliquos qui singula illa peculiari cura exornent, neque mihi\n[[535.3]] probantur R. P. Malebranchii dicteria in Astronomos, aut Algebristas aut Orientalistas. Dicit\n[[535.4]] eruditos interdum quaerere viam ad Sinas et domi plateas urbis ignorare; sed hoc mihi nec\n[[535.5]] absurdum nec reprehendendum videtur non magis quam si quis quaerat Genealogias familiarum\n[[535.6]] Romanarum veterum qui ignoret nunc viventium. Discreta sunt studia, discreta auxilia\n[[535.7]] studiorum. Et convenit esse qui quodlibet horum prae alio agat. Itaque miratus sum, quod\n[[535.8]] ibidem ais summopere detestandos qui orientalibus characteribus et nominibus memoriter\n[[535.9]] tenendis invigilent. Vereor ne haec judicia habeant aliquid praecipitis et iniqui, praestatque nihil\n[[535.10]] facile contemnere, etsi aliud alio magis aestimari mereatur. Itaque si quis virtutum officia et\n[[535.11]] Theologiam veram demonstrationibus stabiliat, hujus ego sane scientiam plus quam caeterorum\n[[535.12]] omnium laudabo: sed experiundo didici, vix quenquam magnum aliquid in his praestiturum\n[[535.13]] esse nisi ab interiore Mathesi acceperit artem severius et acutius ratiocinandi, ne haereat in\n[[535.14]] crusta, neve quibusdam falsis aut certe suspectis fulgoribus seduci se patiatur. Quanquam fatear\n[[535.15]] si quis magis plausum quam veritatem quaerat, ingenii et eloquentiae vim non mediocrem cum\n[[535.16]] scientia mediocri sed ad populum phalerata sufficere solere et plus etiam posse quam nudam\n[[535.17]] sine ornamentis veritatem, sed Te vir eximie, scio generosius sentire, quam ut vulgi opinionem\n[[535.18]] vero profectui praeferre velis. </p>\n<p> [[535.19]] Caeterum Tecum sentio in protrudendis cogitationibus novis magna opus esse circumspectione,\n[[535.20]] ne notam publicam incurrant; ita enim veritati obex ponitur imprudentia nostra. Certe\n[[535.21]] cum in Gallia non minus jam quam in ipsa Roma severa sint censorum judicia; meae tamen\n[[535.22]] novae cogitationes nonnullae satis paradoxae in ipso Eruditorum diario Parisino prodiere. Haec\n[[535.23]] enim mihi commoda visa ratio est tentandi publicum vadum. Itaque et in Lipsiensibus et in\n[[535.24]] Batavis alia dispersi, quae qui conjunget omnia facilius conficiet aliquod ­sententiarum corpus.\n[[536.1]] Tantum autem abest ut apud vestros videar <greek>kainologeĩn</greek>, ut potius revocem homines ad\n[[536.2]] antiquam philosophiam, sed a nugis repurgatam. Comperi enim ne scholasticos quidem vestros\n[[536.3]] esse spernendos, et in illo stercore auri multum latere. Itaque saepe optavi exoriri aliquem in\n[[536.4]] illa Scholastica theologia philosophiaque versatum, qui consilia bona audire vellet; nec recentiorum\n[[536.5]] ista traducentium vocibus absterreri se pateretur. Tales in religiosis ordinibus reperiri\n[[536.6]] non dubito, qui si rite ducerentur, possent in hoc quoque praeclaram operam navare. R.P.\n[[536.7]] Ptolemaei Soc. Jes. quem Romae vidi, nondum ad nos pervenit opus, sed vereor ne nimium\n[[536.8]] concesserit recentioribus ea rejicientibus quae imaginatione consequi non possunt, quemadmodum\n[[536.9]] et fecerat R.P. Honoratus Fabri, qui in utramque partem simul excessit: nimis scholasticus\n[[536.10]] dum gravitatem et vim elasticam pro primitivis habet, nimis Democriticus, dum formas\n[[536.11]] substantiam corporum constituentes humana excepta tollit, nec satis vim Monadum aut <greek>th̃w\n[[536.12]] ĕntelexeíaw</i> percipiens, materiam accidentium confluge sola variari putat. Itaque si quis\n[[536.13]] publico opere profiteretur vindicationem et repurgationem veteris Scholarum philosophiae,\n[[536.14]] simul magnam gratiam iniret apud plerosque docentes, et veritati egregie litaret. Nam recentiores\n[[536.15]] in contrarium nimis declinantes, pene nobis omnem veram metaphysicam, ne quid de\n[[536.16]] ipsis physicae radicibus dicam, protrivere. Tuarum investigationum specimina utinam ante\n[[536.17]] editionem videre liceret, praesertim ubi ad mea referuntur, fortasse enim quae amicis tuis visa\n[[536.18]] sunt displicere posse, (quanquam dissuasores et dissuasionum causas alias intelligere mihi ex\n[[536.19]] circumstantiis videar) ita liceret moderari, ut potius gratiosissima haberentur. Vale. Dabam\n[[536.20]] Hanoverae. </p>\n",
  "number": "202.",
  "title": "LEIBNIZ AN MICHEL ANGELO FARDELLA",
  "date": "Hannover, [28. Februar 1699.] [191.208.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:202. LEIBNIZ AN MICHEL ANGELO FARDELLA Hannover, [28. Februar 1699.] [191.208.] Vir plurimum Reverende et celeberrime Literas Am Kopf der Seite von Leibniz' Hand: Ad Dn. Abb. Fardellam. a Te accepi ante menses aliquot multis nominibus gratissimas, sed praesertim quod de benevolentiae Tuae perseverat...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>