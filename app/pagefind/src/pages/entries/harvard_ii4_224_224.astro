---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_224",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 224,
  "text": "<p> [[682.12]] <b>224. MICHAEL GOTTLIEB HANSCH AN LEIBNIZ</p>\n<p> [[682.13]] Leipzig, 5. November 1707. [220.230.] </b></p>\n<p> [[682.19]] Vir Illustris et Excellentissime,\n [[682.20]] Patrone omni observantia devenerande! </p>\n<p> [[682.21]] Recte <Fn><i>Am Kopf des Briefes von Leibniz' Hand</i>: resp.</Fn> accepi Tuas, speroque etiam Excellentiam Tuam a Dno. Forstero accepisse meas\n[[682.22]] rerum apud nos gestarum nuncias. </p>\n<p> [[683.1]] Carpzovii Spartam nactus est Magnificus noster Seligmannus. Magnificus Dn. D. Ittigius\n[[683.2]] de variis Collectionum Scriptorum Ecclesiasticorum editionibus pro more suo erudite commentatus\n[[683.3]] est. Dn. D. Rivinus novam suam Plantarum collectionem sedulo continuat, et postquam\n[[683.4]] Plantarum flore irregulari monopetalo tetrapetalo et pentapetalo Ordinem absolvit,\n[[683.5]] Appendices jam adjungere apud se constituit. </p>\n<p> [[683.6]] Dn. Junckerus Curtium aliosque bonae latinitatis auctores notis suis illustrat. De reditu Dn.\n[[683.7]] Junii multi mira hic loquuntur, sed forte adhuc incerta. De Dn. Tentzelio autem tale nihil audivi.\n[[683.8]] Editio Numismatum Morelliana aegre procedit, cum alia tractet Dn. Slegelius. </p>\n<p> [[683.9]] Tractatulus meus proximis forte nundinis lucem videbit publicam, <angle bracket>in</angle bracket> hanc prodire non\n[[683.10]] ausus nisi Tuo stipatus judicio, quod omnibus aliorum censuris longissime antepono. </p>\n<p> [[683.11]] Mox etiam specimen dabo Physico-mathematicum de Lacrymis, tentaturus phaenomena\n[[683.12]] Lacrymarum ex hypothesi demonstrare mechanico-hydraulica, simul ac occasio dabitur, cogitata\n[[683.13]] circa texturam glandularum et tubulorum lacrymalium viros experimentis roborandi. </p>\n<p> [[683.14]] Dicere n. non possum, quanto in haec studia amore ferar, quibus omne tempus omnesque\n[[683.15]] facultates meas, si liceret, impendere vellem. Hunc enim in finem non tantum praeterito anno\n[[683.16]] sub ductu privatissimo felicissimi nostri Anatomici Dn. D. Naboth Anatomiam absolvi, sed ex\n[[683.17]] praesenti huc anno hujus ex Celeb. Bohnii manuductione in Chymia utor, sine qua neminem in\n[[683.18]] corporum natura et proprietatibus indagandis operae pretium facere posse persuasus sum. </p>\n<p> [[684.1]] At enim vero facultates meae tenues et jam maximam partem Academicis studiis insumtae,\n[[684.2]] his studiis cum fructu continuandis non sufficiunt. Beneficium etiam quo fruor in Collegio\n[[684.3]] hujus Academiae Mariano sup[p]ortationi meae necessariae impendendum est. Quocirca venit\n[[684.4]] nuper in mentem Tuo me et consilio et auxilio posse frui. Nimirum cum essem Hanoverae\n[[684.5]] aditum etiam nactus sum apud supremum Ecclesiarum Vestrarum Directorem Reverendiss.\n[[684.6]] Gerardum Molanum, quem elegantiorum litterarum, et inprimis scientiae naturalis omniumque\n[[684.7]] huic ad nobilitatem generis humani promovendam sedulo studentium amantissimum expertus\n[[684.8]] sum. Quare Tuam, si fas est, sollicitarer indulgentiam, ut Reverendiss. Abbati mea studia\n[[684.9]] commendare, et utrum ex Coenobio Loccumensi ad continuanda illa aliquid commodi in me\n[[684.10]] quoque redundare queat, data occasione explorare, ne dedigneris. Quo ipso faciet Excellentia\n[[684.11]] Tua rem mihi gratissimam omnibusque obsequiorum generibus vicissim demerendam </p>\n<p> [[684.12]] Illustri atque Excellentissi[mi] Nominis Tui Cultor perpetuus </p>\n<p> [[684.13]] Mich. Gottl. Hanschius. </p>\n<p> [[684.14]] Lipsiae MDCCVII d. 5. Nov. </p>\n<p> [[684.15]] NB A Son Excellence Monseigneur de Leibniz Conseiller privé à Son Altesse Electorale\n[[684.16]] de Brounsvic et Lunebourg à Hannover </p>\n",
  "number": "224.",
  "title": "MICHAEL GOTTLIEB HANSCH AN LEIBNIZ",
  "date": "Leipzig, 5. November 1707. [220.230.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:224. MICHAEL GOTTLIEB HANSCH AN LEIBNIZ Leipzig, 5. November 1707. [220.230.] Vir Illustris et Excellentissime, Patrone omni observantia devenerande! Recte Am Kopf des Briefes von Leibniz' Hand: resp. accepi Tuas, speroque etiam Excellentiam Tuam a Dno. Forstero accepisse meas rerum apud nos gestaru...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>