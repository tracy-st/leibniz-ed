---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi3_49",
  "series": "Band VI 3 (1672-1676); durchgesehener Nachdruck 1980",
  "seq": 49,
  "text": "[[428.15]] <b>49. De arte inveniendi </b> <span>428.15;0:63:049:75       :L:l^</span>.\n[[428.25]] Duas partes invenio Artis inveniendi, Combinatoriam et Analyticam; Combinatoria\n[[428.26]] consistit in arte inveniendi quaestiones; Analytica in arte inveniendi quaestionum\n[[428.27]] solutiones. Saepe tamen fit ut quaestionum quarundam solutiones, plus habeant\n[[428.28]] Combinatoriae quam analyticae, ut cum modus quaeritur efficiendi aliquid in\n[[428.29]] re naturali aut civili, tunc enim media quaerenda sunt extra rem. In summa tamen\n[[429.1]] quaestiones invenire combinatoriae potius, solvere Analyticae est. Duo autem sunt\n[[429.2]] genera quaestionum, aut enim quaeritur modus aliquid indagandi aut efficiendi\n[[429.3]] futurus sive praeteritus, aut quaeritur veritas et examen eorum quae sunt ab aliis\n[[429.4]] indagata aut effecta. Et inter haec duo tantum est discriminis quantum inter artem\n[[429.5]] bene scribendi vel loquendi, et inter artem bene de scriptis judicandi. Examen autem\n[[429.6]] eorum quae indagata sunt, pure analyticum est; sed ars ipsa indagandi aut efficiendi\n[[429.7]] magis combinatoria.\n[[429.8]] Haec tamen rursus distingui possunt curatius. Nimirum accurate loquendi Analytica\n[[429.9]] est inquisitio cum rem ipsam quanta possumus exactitudine in partes secamus;\n[[429.10]] observatis morose situ, nexu, forma partium, et partium in partibus. Synthetica sive\n[[429.11]] combinatoria est, cum alia extra rem ad rem explicandam assumimus: ita anatome\n[[429.12]] animalium analytica; ut animalia in Machina pneumatica suffocare, et postea dissecare:\n[[429.13]] combinatorium. Distillatione examinare liquores, analyticum; injectis aliis\n[[429.14]] liquoribus aut pulveribus fermentationem excitantibus, combinatorium. Dices, etiam\n[[429.15]] ignem in distillando, cultrum in dissecando extrinsecus adhibita. Ita est: fateor, et qui\n[[429.16]] primus artem docuit secandi cultro, aut igne liquores in vaporem evehendi, haud\n[[429.17]] dubie combinatoriae opus peregit; sed nunc vulgato horum instrumentorum usu,\n[[429.18]] perinde habendum est, ac si ignis liquori, culter cadaveri perpetuo annectus appictusve\n[[429.19]] esset, cum idea unius ideam alterius semper offerat ex quo eas duas res ex\n[[429.20]] humano arbitrio tam saepe conjunctas nostris temporibus experimur. Unde tractu\n[[429.21]] temporis quaedam operationes quae erant antea combinatoriae, fient analyticae; pervulgato\n[[429.22]] apud omnes eo combinandi more, et tardissimo cuivis occurrente.\n[[429.23]] Quare proficiente paulatim in melius genere humano, effici poterit fortasse post\n[[429.24]] multa secula, ut nemo amplius a judicii exactitudine laudetur; arte analytica quae\n[[429.25]] nunc vix in mathematicis satis recte et generaliter adhibetur, universali reddita, in\n[[429.26]] omni materiarum genere, introducto charactere philosophico, qualem molior; quo\n[[429.27]] semel recepto recte ratiocinari, dato meditandi spatio, non erit magis laudabile, quam\n[[429.28]] magnos numeros sine lapsu calculare. Praeterea si Catalogus historiarum, sive relationum,\n[[429.29]] observationum, experimentorum fidelis eodem charactere scriptus accedat;\n[[429.30]] et majoris momenti theoremata (velut compendia calculi), ex charactere vel solo vel\n[[430.1]] cum observationibus ducta, adjiciantur; fiet, ut artis quoque combinatoriae laus peritura\n[[430.2]] sit. Neque tunc illi aestimabuntur, quibus sumpto meditandi spatio aliquid invenire\n[[430.3]] aut discutere datum est; cum id in medio positum sit futurum; sed illi quibus\n[[430.4]] extemporanea analytica aut combinatoria est. Illi vero qui tardiores sunt, tum demum\n[[430.5]] aestimabuntur, si tanta in illis sit velut inquirendi pertinacia, et penetrandi improbus\n[[430.6]] labor, ut vix alii eum meditandi laborem tolerare velint aut possint. Unde si eos qui\n[[430.7]] nunc in pretio sunt reviviscere fingeremus, post Lethaeos haustus; non ideo minus\n[[430.8]] tunc quoque magnos viros fore putandum est; nam spretis illis quae nunc ab ipsis\n[[430.9]] inveniuntur, longius quam alii tunc quoque non minus quam hodie penetrarent; nec\n[[430.10]] dubitarim Archimedem si nunc in vivis esset, admiranda daturum; cum Quadratura\n[[430.11]] Parabolae dimensionesque coni, et superficierum sphaericarum aut conicarum eo\n[[430.12]] tempore non minus difficiles fuerint, quam nunc abstrusissimae analytices aut indivisibilium\n[[430.13]] indagationes. Neque ergo ideo pauciores erunt magni viri imposterum,\n[[430.14]] quod tam multa jam ab aliis occupata sunt. Contra enim aliorum inventis via illis ad\n[[430.15]] longe majora sternetur; et ipsa in scientiis aut scientiarum partibus jam pene tritis,\n[[430.16]] novorum sterilitas, ad difficiliora coget; magno generis humani bono, cum infinita\n[[430.17]] semper restent, nec nisi aegre ad vestibula usque per media senticeta perrepserimus.\n[[430.18]] Portas autem tum demum apertas fore putandum est, cum ipsa ars inveniendi in\n[[430.19]] clara luce posita erit; id est cum Character aliquis philosophicus recipietur. Cui si\n[[430.20]] adjiciantur theorema(ta) memorabilia, idem erit ac si dictionario cuidam insigni phrases\n[[430.21]] quaedam selectiores subjicerentur; et quemadmodum post dictionaria Apparatus\n[[430.22]] quidam proponuntur juventuti, in quibus fabulas, historias, nomina propria, et quaedam\n[[430.23]] ^nscienötiarum rudimenta discant: ita opus erit accurato labore, multisque conspirantibus\n[[430.24]] Historiam ^nfieri göeneralem qualem imprimis Baconus optavit; quae dum\n[[430.25]] fit, aut etiam ubi facta erit, ^npoteritö compendium condi historiarum selectiorum.\n[[430.26]] Ultimum omnium opus erit, de Felicitate, sive de scientia vitae, in quo ostendatur\n[[430.27]] usus reliquorum omnium, et proble^nmataö quae eorum ope construi poterunt, non\n[[430.28]] subjectorum sed effectuum ordine disponentur. Sed quoniam felicitas quaedam jam\n[[431.1]] tum in nostra potestate est; ideo liber hic ultimus, ad usum erit omnium primus,\n[[431.2]] titulo: Scientiae Architectonicae, de sapientia et felicitate. In quo\n[[431.3]] ostendetur, posse nos esse semper beatos; attamen alios atque alios beatiores; et augendae\n[[431.4]] beatitatis media quaerenda, in quo artium omnium usus consistit. Itaque haec\n[[431.5]] erit vera doctrina de Methodo, non tam quaerendi veritatem, quam vivendi; cum\n[[431.6]] saepe illud de hominibus dici possit, quod (Lucanus) de populis quos aspicit arctos,\n[[431.7]] quos ait, felices errore suo. Et Cicero de eodem quo Lucanus argumento, immortalitate\n[[431.8]] animae, nolle se sibi hunc errorem eripi. Itaque si quis demonstrationes sane\n[[431.9]] certissimas non perspiciet, rectissime faciet, si contra dubitationes obfirmet animum,\n[[431.10]] et ubi primum ingruunt, alio convertat cogitationes; ita enim utique consulet tranquillitati\n[[431.11]] suae. Liber autem de sapientia et felicitate, sive de Methodo vitae, primus\n[[431.12]] omnium dandus est, ordinario sermone. In quo ipse characteris philosophici usus\n[[431.13]] ostendentur; et caeterorum quoque operum, de quibus dixi. Subjicientur omnium\n[[431.14]] illorum operum specimina; communi pariter sermone atque philosophico expressa,\n[[431.15]] sed non nisi philosophico demonstrata. Quibus speciminibus datis, erit generis humani\n[[431.16]] collata opera reliqua absolvere. Nec jam aliud philosopho quaerendum erit,\n[[431.17]] quam ut rationem reperiat, persuadendi rectoribus populorum, et alioqui viris insignibus\n[[431.18]] ut de executione coeptorum serio cogitetur. Porro quae hic de Combinatoriae et\n[[431.19]] Analyseos differentia dixi, inservient ad discernenda hominum ingenia; nam alii\n[[431.20]] magis combinatorii, alii magis Analytici sunt. Ita etsi Galilaeus et Cartesius in utraque\n[[431.21]] arte excelluerint, plus tamen in Galilaeo Combinatoriae, in Cartesio Analyticae.\n[[431.22]] Geometrae et Iurisconsulti Analytici magis, medici vero et politici Combinatorii\n[[431.23]] sunt. Plus est securitatis in Analytica, plus difficultatis in Combinatoria.\n[[431.24]] Mariottus dicit ingenia hominum instar sacci esse, quem inter meditandum tamdiu\n[[431.25]] agites, donec aliquid excitat. Unde quiddam esse fortunae in cogitationibus non\n[[431.26]] debet dubitari. Ego addiderim, ingenia hominum potius habere rationem cribri, quod\n[[431.27]] inter meditandum agitatur, donec subtilissima quaeque transeant. Interea dum transeunt\n[[431.28]] speculatrix ratio arripit quicquid e re videtur. Prorsus quemadmodum si quis\n[[431.29]] furti deprehendendi causa totam civitatem per portam quandam transire jubeat, eo\n[[431.30]] qui furtum passus est in excubiis collocato. Sed compendii causa adhibetur Methodus\n[[432.1]] exclusiva qualis Frenicli in numeris. Ita enim si spoliatus asserat virum fuisse non\n[[432.2]] foeminam; ^nstaturaeö aetatisque virilis, non puerum non juvenem, prodeundi onus\n[[432.3]] ipsis remittetur.\n",
  "number": "49.",
  "title": "De arte inveniendi",
  "date": ""
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:49. De arte inveniendi 428.15;0:63:049:75 :L:l^. Duas partes invenio Artis inveniendi, Combinatoriam et Analyticam; Combinatoria consistit in arte inveniendi quaestiones; Analytica in arte inveniendi quaestionum solutiones. Saepe tamen fit ut quaestionum quarundam solutiones, plus habeant Combinator...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>