---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_197",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 197,
  "text": "<p> [[614.1]] <b>197. LEIBNIZ AN MICHAEL GOTTLIEB HANSCH</p>\n<p> [[614.2]] Hannover, 23. Juni 1707. [184.199.] </b></p>\n<p> [[614.28]] Vir clarissime, Amice honoratissime </p>\n<p> [[614.29]] Gratias Tibi debeo quod praesenti tanta humanitate affuisti. </p>\n<p> [[614.30]] Opusculum Tuum eruditum et elegans remittam per vecturam ordinariam, si ita jubebis,\n[[614.31]] addamque Epistolium quale desiderare visus es. </p>\n<p> [[615.1]] Cum olim Serenissima Prussorum Regina Baylii libros doctrinae et elegantiae plenos\n[[615.2]] libenter legeret, et in iis crebras objectiones, circa justitiam divinam, libertatem arbitrii, originem\n[[615.3]] mali, causam peccati, animadverteret, sententiam meam non raro rogabat. Ego vero\n[[615.4]] ostendebam, non tantas esse difficultates quantae viderentur, et rem omnem (ni fallor) recte et\n[[615.5]] lucide expediri posse. Et sane quae afferebam, non displicebant. Itaque plus semel instabat\n[[615.6]] inclyta Regina, ut meditationes meas eo de argumento in chartam conjicerem, et Gallica\n[[615.7]] quidem lingua, quo ab ipsa et aliis etiam extra Germaniam latinae minus assuetis legi posset.\n[[615.8]] Coeperam opus, sed morte Reginae filum abruperam. Sed cum hac hyeme Berolini agerem,\n[[615.9]] amici quibus voluntas Reginae nota fuerat, ut ejus mandatis ex asse satisfacerem, urgere non\n[[615.10]] destitere. Ita nata est mihi scriptio quae si praelo committeretur octava forma justae magnitudinis\n[[615.11]] libellum daret. Vellem autem Typis Batavis edi Gallicum hoc scriptum: ita enim facilius\n[[615.12]] per varias Europae partes ubi linguae ejus usus est, dispergeretur. Praesertim cum ipsa Baylii et\n[[615.13]] Antagonistarum ejus scripta itidem in Batavis Gallice sint edita. Venit autem in mentem\n[[615.14]] Fritschium nostrum in Batavis jam officinam habere, ibique editionem commode curare posse. </p>\n<p> [[615.15]] Nomen quidem meum non esset praefigendum libello (neque is adeo mos est scribentibus\n[[615.16]] Gallice) sed tamen neminem facile lectorum peritorum latere posset, ob doctrinas passim\n[[615.17]] inspersas, quas alibi jam tum exposui. Vellem autem rem omnem studioso silentio tegi, donec\n[[615.18]] absoluta sit scripti impressio. Quod si consilium Fritschio non placet, attamen silebit ut spero,\n[[615.19]] bona fide. </p>\n<p> [[616.1]] Sed quod vicissim peto, numerus est exemplarium insignis. Calculo enim inito comperi\n[[616.2]] minimum 120 esse amicos, quibus singulis unum exemplum mittere velim. Et cum aliquid\n[[616.3]] desiderem ultra necessitatem opus erit circiter exemplaribus 150. Is numerus venditioni caeterorum,\n[[616.4]] tantum abest, ut sit nociturus, ut potius sparsis ea ratione per varias regiones exemplis\n[[616.5]] notius opus sit redditurus atque expetibilius. </p>\n<p> [[616.6]] Quodsi itaque cum Fritschio hac de re secreto colloqui voles, et sententiam ejus ad me\n[[616.7]] perscribere, me plurimum Tibi obstringes. Charta erit qualem libri apud Batavos habere solent,\n[[616.8]] ipsique in primis Bayliani novissimi in octava forma editi veluti responsio ad provincialem.\n[[616.9]] Vale. </p>\n<p> [[616.10]] Dabam Hanoverae 23. Junii 1707 </p>\n<p> [[616.11]] deditissimus Godefridus Guilielmus Leibnitius </p>\n<p> [[616.12]] A Monsieur Monsieur Hansch Maistre ès arts, et Collegiat à Leipzic </p>\n",
  "number": "197.",
  "title": "LEIBNIZ AN MICHAEL GOTTLIEB HANSCH",
  "date": "Hannover, 23. Juni 1707. [184.199.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:197. LEIBNIZ AN MICHAEL GOTTLIEB HANSCH Hannover, 23. Juni 1707. [184.199.] Vir clarissime, Amice honoratissime Gratias Tibi debeo quod praesenti tanta humanitate affuisti. Opusculum Tuum eruditum et elegans remittam per vecturam ordinariam, si ita jubebis, addamque Epistolium quale desiderare visus...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>