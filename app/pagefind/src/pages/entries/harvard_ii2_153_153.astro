---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_153",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 153,
  "text": "<p> [[544.1]] <b>155. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[544.2]] Padua, 23. Juni [1692]. [149.159.]</b></p>\n<p> [[544.8]] Illu^#'m^#'o Sig^#'r^#'e, mio Sig^#'r^#'e, Padron Colend^#'m^#'o </p>\n<p> [[544.9]] Sono due settimane, che mi trovo con Sua Eccellenza alla visita della Provincia, il che fù\n[[544.10]] caggione che non le scrivessi con l'Ordinario passato; arrivato però oggi in Padova, la prima\n[[544.11]] cosa, che fò, è inchinare con questa V. S. Illu^#'m^#'a, assicurandola della mia ferma risolutione di\n[[544.12]] portarmi costì secondo il concertato. Io già mi sarei partito, se l'Eccell^#'m^#'o Sig^#'r^#'e Capitano non mi\n[[544.13]] havesse ancora con violenza trattenuto, pregandomi di non abbandonarlo, finche si proveda\n[[544.14]] d'altro Soggetto a proposito per dare l'ultima mano all'istruttione del suo Primogenito. Questa\n[[544.15]] mattina hò di nuovo supplicato Il Sig^#'r^#'e Marsilio Pappafava, acciò da mia parte pregasse Sua\n[[544.16]] Eccellenza di lasciarmi andare, con pretesto di dovermi portare in Roma per alcuni miei\n[[544.17]] rilevanti affari. L'Inferno adopera tutte le sue forze per tenermi alla catena dell'errore in Italia,\n[[544.18]] e quando, a Dio piacendo, sarò qui, le raccontarò le difficoltà grandissime, che incontro per\n[[544.19]] separarmi da questo Paese, ove le lusinghe, e preghiere degl'amici, l'amorevoli insidie e larghe\n[[544.20]] promesse di questi Senatori cospirano insieme per tenermi lontano da cotesto Cielo, da me\n[[544.21]] sospirato per mettermi nella vera libertà evangelica, e liberarmi per sempre da questa orribile\n[[544.22]] superstitione, in cui qui viviamo. Se la prima lettera di V. S. Illu^#'m^#'a mi fosse capitata in Venetia,\n[[544.23]] prima di portarmi in questo reggimento con Sua Eccellenza, a questa hora sarei infallibilmente\n[[544.24]] costì, ma l'essermi impegnato a servire questo Sig^#'r^#'e Capitano in tutto il tempo del suo governo\n[[544.25]] qui, è l'unico motivo della mia tardanza. Io farò tutto per partirmi con sodisfattione di S^#'a E^#'a,\n[[544.26]] però quando esso andasse tirando le cose in lungo, e con affettuoso inganno valesse distormi\n[[544.27]] dal mio viaggio, allora io scordato di tutte l' humane convenienze preferirò ad ogni mondano\n[[544.28]] interesse quello di Dio e della mia salute. Priego fratanto V. S. Illu^#'m^#'a patientare ancora, e\n[[544.29]] compatirmi se uso molta cautela nel presente affare, essendo il mio scopo di partirmi con il\n[[544.30]] minore strepito, che si può. Domani, a Dio piacendo, mi portarò dal Sig^#'r^#'e Marchese del Pozzo,\n[[544.31]] che mi hà promesso fare ogni diligenza in Verona per le notitie, che essa brama, e sentirò da\n[[545.1]] Venetia quanto prima qualche cosa circa il diploma delle Carceri. Farò capitare nelle mani del\n[[545.2]] Sig^#'r^#'e Mendelino un Fulvio Testi, e due <i>Gallerie</i> del Marino. Mi comandi con libertà, e\n[[545.3]] pregandole dal Cielo ogni prosperità mi resto </p>\n<p> [[545.4]] Di V. S. Illu^#'m^#'a Umil^#'m^#'o, Oblig^#'m^#'o S^#'r^#'e vero M. A. F. </p>\n<p> [[545.5]] Padova 23 Giugno </p>\n",
  "number": "155.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Padua, 23. Juni [1692]. [149.159.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:155. MICHEL ANGELO FARDELLA AN LEIBNIZ Padua, 23. Juni [1692]. [149.159.] Illu^#'m^#'o Sig^#'r^#'e, mio Sig^#'r^#'e, Padron Colend^#'m^#'o Sono due settimane, che mi trovo con Sua Eccellenza alla visita della Provincia, il che fù caggione che non le scrivessi con l'Ordinario passato; arrivato però o...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii2_153","series":"Band II 2 (1686 - 1694)","seq":153,"text":"<p> [[544.1]] <b>155. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[544.2]] Padua, 23. Juni [1692]. [149.159.]</b></p>\n<p> [[544.8]] Illu^#'m^#'o Sig^#'r^#'e, mio Sig^#'r^#'e, Padron Colend^#'m^#'o </p>\n<p> [[544.9]] Sono due settimane, che mi trovo con Sua Eccellenza alla visita della Provincia, il che fù\n[[544.10]] caggione che non le scrivessi con l'Ordinario passato; arrivato però oggi in Padova, la prima\n[[544.11]] cosa, che fò, è inchinare con questa V. S. Illu^#'m^#'a, assicurandola della mia ferma risolutione di\n[[544.12]] portarmi costì secondo il concertato. Io già mi sarei partito, se l'Eccell^#'m^#'o Sig^#'r^#'e Capitano non mi\n[[544.13]] havesse ancora con violenza trattenuto, pregandomi di non abbandonarlo, finche si proveda\n[[544.14]] d'altro Soggetto a proposito per dare l'ultima mano all'istruttione del suo Primogenito. Questa\n[[544.15]] mattina hò di nuovo supplicato Il Sig^#'r^#'e Marsilio Pappafava, acciò da mia parte pregasse Sua\n[[544.16]] Eccellenza di lasciarmi andare, con pretesto di dovermi portare in Roma per alcuni miei\n[[544.17]] rilevanti affari. L'Inferno adopera tutte le sue forze per tenermi alla catena dell'errore in Italia,\n[[544.18]] e quando, a Dio piacendo, sarò qui, le raccontarò le difficoltà grandissime, che incontro per\n[[544.19]] separarmi da questo Paese, ove le lusinghe, e preghiere degl'amici, l'amorevoli insidie e larghe\n[[544.20]] promesse di questi Senatori cospirano insieme per tenermi lontano da cotesto Cielo, da me\n[[544.21]] sospirato per mettermi nella vera libertà evangelica, e liberarmi per sempre da questa orribile\n[[544.22]] superstitione, in cui qui viviamo. Se la prima lettera di V. S. Illu^#'m^#'a mi fosse capitata in Venetia,\n[[544.23]] prima di portarmi in questo reggimento con Sua Eccellenza, a questa hora sarei infallibilmente\n[[544.24]] costì, ma l'essermi impegnato a servire questo Sig^#'r^#'e Capitano in tutto il tempo del suo governo\n[[544.25]] qui, è l'unico motivo della mia tardanza. Io farò tutto per partirmi con sodisfattione di S^#'a E^#'a,\n[[544.26]] però quando esso andasse tirando le cose in lungo, e con affettuoso inganno valesse distormi\n[[544.27]] dal mio viaggio, allora io scordato di tutte l' humane convenienze preferirò ad ogni mondano\n[[544.28]] interesse quello di Dio e della mia salute. Priego fratanto V. S. Illu^#'m^#'a patientare ancora, e\n[[544.29]] compatirmi se uso molta cautela nel presente affare, essendo il mio scopo di partirmi con il\n[[544.30]] minore strepito, che si può. Domani, a Dio piacendo, mi portarò dal Sig^#'r^#'e Marchese del Pozzo,\n[[544.31]] che mi hà promesso fare ogni diligenza in Verona per le notitie, che essa brama, e sentirò da\n[[545.1]] Venetia quanto prima qualche cosa circa il diploma delle Carceri. Farò capitare nelle mani del\n[[545.2]] Sig^#'r^#'e Mendelino un Fulvio Testi, e due <i>Gallerie</i> del Marino. Mi comandi con libertà, e\n[[545.3]] pregandole dal Cielo ogni prosperità mi resto </p>\n<p> [[545.4]] Di V. S. Illu^#'m^#'a Umil^#'m^#'o, Oblig^#'m^#'o S^#'r^#'e vero M. A. F. </p>\n<p> [[545.5]] Padova 23 Giugno </p>\n","number":"155.","title":"MICHEL ANGELO FARDELLA AN LEIBNIZ","date":"Padua, 23. Juni [1692]. [149.159.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>