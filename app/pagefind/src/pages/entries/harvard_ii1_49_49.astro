---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_49",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 49,
  "text": "<p> [[138.1]] <b>43. FRIEDRICH NITZSCH AN LEIBNIZ</p>\n<p> [[138.2]] Gießen, 8. (18.) Februar 1671. [39.45.]</b></p>\n<p> [[138.8]] Vir Nobilissime et Consultissime Fautor et Amice Honoratissime. </p>\n<p> [[138.9]] Quanquam <Fn><i>Auf Bl. 10 r^#'o eine Bemerkung von Leibniz' Hand</i>: Lana, Du Sonius, Ottius, Titelius, Wrennus dioptricam mechanicam perficere conantur.</Fn> gratissimae fuere literae Tuae, gratiores tamen hoc eas reddidit, quod ab\n[[138.10]] Illustrissimo Boineburgio seculi nostri ornamento mihi sint allatae. Ita enim dedere ansam, ut,\n[[138.11]] quam olim, Te ipso procurante, Illustrissimo Viro declaravi devotionem, mediantibus literis\n[[138.12]] Tuis declarare denuo potuerim. Adeo Tibi soli debeo, quod Tanto Viro non ignorer. Sed porro\n[[138.13]] mirum quantum de me demerereris, si Gallorum Ephemerides Anni 1670. mihi communicares.\n[[138.14]] Memini enim Te mentionem illarum in Epistola quadam facere, et succincta dare Excerpta\n[[138.15]] illorum, quae ibi habentur notatu digna. In eo enim sum, ut proximis Nundinis edatur Versio\n[[138.16]] Anni 69. Quae cum mole sit exigua, igitur commodissime Annus 70. adjungi posset. Est\n[[138.17]] quidem qui Exemplar Gallicum mihi procurabit, sed instantibus demum nundinis. Redderem\n[[138.18]] utique eas non sine magna gratiarum actione. Disputationem Opticam transmitterem hac quidem\n[[138.19]] vice, nisi forte Cursori publico fiat molestia, mittam tamen, quamprimum commoda\n[[138.20]] obtulerit sese occasio. In Mechanicis nunc occupor, quae et forte edentur, siquidem sit, qui\n[[138.21]] impensas ferre velit. Dn. Weigelius in Hydraulico invento laborat, tali quidem, ut Siphones\n[[138.22]] (<i>Ventil</i>) sint extra canalem. Varenii quoque <i>Geographiam</i> integritati suae restituo, suppletis iis\n[[139.1]] quae injuria nescio qua et figurarum absentia et lacunis non unis egregium Autorem mutilum\n[[139.2]] reddidere. Et in hisce aliisque tempus tantum non inutiliter tero. </p>\n<p> [[139.3]] De Optico illo quae\n[[139.4]] scribis inversa credo se\n[[139.5]] ratione habent, ita ut\n[[139.6]] plana polita si faciunt\n[[139.7]] obtusum ^#(kl)^#'l^#'u^#'m, pauciores,\n[[139.8]] sin acutum plures repraesentent\n[[139.9]] imagines, uti et\n[[139.10]] experientia testata est,\n[[139.11]] siquidem recte recordor.\n[[139.12]] Nam et ipse specula illa\n[[139.13]] vidi. Quod si ergo ita est,\n[[139.14]] ratio est in promptu propter\n[[139.15]] reflexionem imaginis,\n[[139.16]] ita ^#(KL)^#'l^#'o talibus planis objecto figura <triangulum>^#'l^#'a^#'r^#'i^#'s apparet, siquidem plana obtuse aperiantur, porro si\n[[139.17]] magis ad se accedunt plana, repraesentatur pentagonum, si adhuc magis, heptagonum etc.\n[[139.18]] praeter imaginem quae in junctura videtur directo radio. Posui vero locum imaginis in ipsam\n[[139.19]] superficiem in figura quod quidem faciendum non esset, siquidem accurate schema depingendum\n[[139.20]] foret, secundum ea quae tradunt Optici de loco imaginis. Nihil vero ad multitudinem\n[[139.21]] imaginum monstrandam id refert. De lentibus Hyperbolicis alio tempore scribam, jam eo\n[[139.22]] intercludor. Interim vale faveque </p>\n<p> [[139.23]] Vir Nobilissime et Consultissime Tuo L. Frid. Nitzschio. </p>\n<p> [[139.24]] Giessae d. 8. Febr. st. v. 1671. </p>\n<p> [[139.25]] P. S. Ergone Geislerus Invitatorias ad nuptias misit? Quid vero Tu et ego facimus? Scilicet\n[[139.26]] philosophamur. Vale. </p>\n<p> [[139.27]] <i>A Monsieur Monsieur Leibnuz Conseiller de Son Altesse Electorale de Mayence. à\n[[139.28]] Mayence.</i> </p>\n",
  "number": "43.",
  "title": "FRIEDRICH NITZSCH AN LEIBNIZ",
  "date": "Gießen, 8. (18.) Februar 1671. [39.45.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:43. FRIEDRICH NITZSCH AN LEIBNIZ Gießen, 8. (18.) Februar 1671. [39.45.] Vir Nobilissime et Consultissime Fautor et Amice Honoratissime. Quanquam Auf Bl. 10 r^#'o eine Bemerkung von Leibniz' Hand: Lana, Du Sonius, Ottius, Titelius, Wrennus dioptricam mechanicam perficere conantur. gratissimae fuere ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>