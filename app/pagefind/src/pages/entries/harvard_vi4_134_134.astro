---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_134",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 134,
  "text": "[[440.1]] <b>109.  Praefatio operis ad instaurationem scientiarum [Frühjahr 1682 (?)]</b>\n [[440.2]] <tab/>[Frühjahr 1682 (?)] </p>\n<p> [[440.8]] Mihi si dicendum quod res est statum humanae cognitionis consideranti in mentem\n[[440.9]] venit imago exercitus, in fugam conjecti, vel praedae causa per agros palantis, a quo nulla\n[[440.10]] signa nulli ordines servantur; vel, ut aptiori similitudine utar; eruditionis hodiernae\n[[440.11]] apparatus, videtur comparari posse tabernae amplissimae, omnigena mercium varietate\n[[440.12]] instructae, sed plane eversae et perturbatae, omnibus inter se confusis, nullis accedentibus\n[[440.13]] numeris literisve indicibus, nullo inventario, nullis rationum libris, unde lux aliqua hauriri\n[[440.14]] possit. Ubi quanto majorem massam conficient res collectae, tanto minus usui erunt.\n[[440.15]] Itaque non tantum novis mercibus undique convectandis, sed et his quae habentur rite\n[[440.16]] ordinandis opera danda est, talisque eligendus ordo, ut nova supplementa semper imposterum\n[[440.17]] locum suum certum inveniant, nec pristina semper ob accessiones quotidianas\n[[440.18]] turbari immutarique indies necesse sit, quod promtis quidem, sed parum judiciosis patribus\n[[440.19]] familias usu venire solet, qui nunquam sibi satisfacientes, singulis noctibus rerum\n[[440.20]] suarum familiarium faciem statumque mutare deliberant. Idem nobis in scientiis usu\n[[440.21]] venire videtur, ubi perpetua reformandi innovandique libidine prurimus, nec tamen\n [[440.22]] quaesitis utimur, sed indigesta relinquentes mox alia captamus, neque aliquid certi constituimus,\n[[440.23]] cui postea inaedificare tuto possimus. Nec parum turbat infinita librorum\n[[440.24]] eadem reciprocantium moles, de qua latius deinde dicendi locus erit. </p>\n<p> [[440.25]] Duobus ergo nobis opus est, ut ex illa confusione eluctemur, inventario amplo suis\n[[440.26]] multiplicibus ac fidelissimis indicibus instructo, et libro subductarum rationum; quorum\n[[440.27]] operum prius, nempe inventarium, Historiam omnem Naturae artisque, et quicquid sensu\n[[441.1]] et relatione constat dignum memoratu vel contineat, vel indicet, at posterius, nimirum\n[[441.2]] Liber rationum ipsas (vel absolutas, vel cum aliter non licet hypothesi nixas), sive\n[[441.3]] veritatis, sive etiam probabilitatis maximae praesumtionisque demonstrationes ex sensu\n[[441.4]] cognitis ductas, comprehendat. Sed neutrum ego sperandum arbitror, in tanta humanarum\n[[441.5]] opinionum varietate, nisi utamur Methodo cujus hic Elementa tradentur, quae omnes\n[[441.6]] controversias e medio tollit, efficitque ut in rebus etiam a sensu et figura remotissimis,\n[[441.7]] calculo quodam irrefragabili ordineque determinato procedere possimus. Ita denique\n[[441.8]] imposterum in omnibus disciplinis magno reipublicae fructu fiet quod in Geometria\n[[441.9]] dudum factum est ut ingeniosi homines famam non evertendis majorum traditis, sed quod\n[[441.10]] jam supra admonui augendis eorum inventis quaerere cogantur, <b>Rationumque</b> semel\n[[441.11]] subductarum examinatarumque publice <b>liber</b>, irrefractabilis habeatur. Et quaecunque in\n[[441.12]] humanam cogitationem cadunt nostra notionum analysi locum ac sedem constantem\n[[441.13]] invariabilemque in generali <b>inventario</b> accipient, licet alioqui saepe eadem res ob\n [[441.14]] usum respectumque multiplicem ad varia loca alia, sed obiter designando tantum per\n[[441.15]] indicis modum referri possit. </p>\n",
  "number": "109.",
  "title": "Praefatio operis ad instaurationem scientiarum",
  "date": "[Frühjahr 1682 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:109. Praefatio operis ad instaurationem scientiarum [Frühjahr 1682 (?)] [Frühjahr 1682 (?)] Mihi si dicendum quod res est statum humanae cognitionis consideranti in mentem venit imago exercitus, in fugam conjecti, vel praedae causa per agros palantis, a quo nulla signa nulli ordines servantur; vel, ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>