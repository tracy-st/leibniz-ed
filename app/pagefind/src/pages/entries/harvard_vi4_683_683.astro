---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_683",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 683,
  "text": "[[2926.1]] <b>518₂.  Ad Placcii tabulas AD PLACCII TABULAS\n[[2926.5]] <k>Tabula Universalis</k>\n [[2926.6]] Actionum ex Naturali Jure Competentium. Ad pag. 13. et seqq.\n[[2926.7]] <k>Actiones</k> dantur ad <i>Correctionem Laesionis vel</i>\n [[2926.8]] <i>Futurae</i> unde <i>Petitiones</i> ...\n [[2926.9]] <i>Praesentis</i> ex laesa obligatione vel ad\n [[2926.10]] <i>Dandum</i> ...\n [[2926.11]] <i>Faciendum</i> ...\n [[2926.12]] <i>Omittendum</i>\n [[2926.13]] <tab/><i>Operis</i> laedentis ...\n [[2926.14]] <tab/><i>Facti meri</i> quo quis impedit obligationem vel\n [[2926.15]] <tab/>Suam ipsius erga me\n [[2926.16]] <tab/>Omittendum <Fn><i>Dafür</i>: Omittendi</Fn> impedimentum meae\n [[2926.17]] <tab/>Facultatis ad omittendum <Fn><i>Dafür</i>: agendum</Fn> quid circa res\n [[2926.18]] <tab/>Universalis <Fn><i>Dafür</i>: Universales</Fn> negando s. impediendo aliis\n [[2926.19]] <tab/>libertatem,\n [[2926.20]] <tab/>civitatem,\n [[2926.21]] <tab/>familiam,\n [[2926.22]] <tab/>societatem aliam\n [[2926.23]] <tab/>locumque in ea\n [[2927.1]] <tab/>Inj. ...\n [[2927.2]] <tab/>Nonj. ...\n [[2927.3]] <tab/>Singularis ...\n [[2927.4]] <tab/>Libertatis ad omittendum quae laeditur ...\n [[2927.5]] <tab/>alienam erga me ...\n [[2927.6]] <tab/>Meam erga alios ...\n[[2927.7]] <k>Tabula Synoptica</k>\n [[2927.8]] Omnium Actionum <k>Personalium</k> Juris Communis. Ad pag. 92.\n[[2927.9]] Civilium <k>Actionum</k> personalium formulae oriuntur vel ex\n [[2927.10]] Delicto\n [[2927.11]] III. Privato ...\n [[2927.12]] XI. <b>Publico</b>\n [[2927.13]] <tab/>Speciatim ...\n [[2927.14]] <tab/>XIII. Generatim <Fn><i>Darunter</i>: actio de dolo <i>Stellionatus</i> </Fn> 58. <i>in Factum ex delicto</i>.\n [[2927.15]] XIV. Quasi delicto ...\n [[2927.16]] XVI. Utroque delicto s. et quasi delicto 67. contra <i>Publicanos</i>.\n [[2927.17]] XVII. Contractu\n [[2927.18]] Proprio eoque vel\n [[2927.19]] <tab/>Nominato eoque vel\n [[2927.20]] <tab/>Principali eoque vel\n [[2927.