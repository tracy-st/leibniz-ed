---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_82",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 82,
  "text": "<p> [[270.1]] <b>82. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[270.2]] Venedig, 30. August [1704]. [81.84.] </b></p>\n<p> [[270.9]] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o </p>\n<p> [[270.10]] Avendo significato all'Ecc^#'m^#'o Sig^#'r^#'e Procu^#'r^#'e Marcello Capo dell'Ecc^#'m^#'o Magistrato de Sig^#'r^#'i\n[[270.11]] Riformatori dello Studio di Padova come V. S. Ill^#'m^#'a m'aveva ricordato il Sig^#'r^#'e Herman per la\n[[270.12]] professione delle Matematiche nella nostra Università, ove ora vaca la catedra di Matematica,\n[[270.13]] mi fù da Sua Eccellenza comandato che sopra di ciò le ne dassi una piccola memoria che fù\n[[270.14]] presentata ieri all' Ecc^#'m^#'o Magistrato che ebbe grandissimo contento d'una tale propositione,\n[[270.15]] persuadendosi che per promovere il Sig^#'r^#'e Herman fosse il maggiore testimonio l'approvatione\n[[270.16]] di V. S. Ill^#'m^#'a oggi così celebre e rinomata per l'alto suo sapere e principalmente per le\n[[270.17]] cognitioni matematiche nel Mondo letterato. L'Ecc^#'m^#'o Sig^#'r^#'e Procu^#'r^#'e Veniero uno de' tre Riformatori\n[[270.18]] ne scrive oggi ad Hannover ad un Sig^#'r^#'e di cotesta Corte, credo, per averne per mezzo di\n[[270.19]] V. S. Ill^#'m^#'a una piu piena e distinta relatione del Soggetto proposto, e forse anche per assicurarsi\n[[270.20]] della di lei approvatione; e se ne scriverà ancora al loro Residente in Milano, accio si maneggi\n[[270.21]] con qualcheduno di Basilea per informarsi meglio del Soggetto, e stabilire le maniere di farlo\n[[270.22]] venire a Padova. Io hò tacciuto il punto della Religione, e dovendo il Sig^#'r^#'e Herman venire per\n[[270.23]] insegnare non gia la Teologia, ma le Matematiche[,] spero, che non si farà sopra ciò difficolta\n[[270.24]] veruna, e poi sperarei questo punto superarlo con altri motivi che ho gia pensati, che riguardano\n[[270.25]] il bene e populatione dello Studio. </p>\n<p> [[270.26]] L'Ecc^#'m^#'o Sig^#'r^#'e Procu^#'r^#'e Marcello m'hà comandato che ne scriva subito a V. S. Ill^#'m^#'a pregandola\n[[270.27]] di disponere il Sig^#'r^#'e Herman ad accettare l'impiego, e spiegarsi sopra lo stipendio che\n[[270.28]] desidera per il suo trattenimento in Padova. Giacche questo Ecc^#'m^#'o Magistrato s'è ora così\n[[271.1]] invogliato d'averlo, molto inclinando a scegliere per la catedra di Matematica Un Uomo dotto e\n[[271.2]] celebre della Germania, per allettare così la Natione Todesca a portarsi in Padova, bisogna\n[[271.3]] operare con calore e sollecitudine, e risolvere presto, accio l'Ecc^#'m^#'o Magistrato possa prendere le\n[[271.4]] sue misure, e sapere cio che deve farsi. Io nella mia memoria dissi che il Sig^#'r^#'e Herman fosse\n[[271.5]] Professore delle Matematiche in Basilea, essendomi per quel che essa mi scrisse così imaginato,\n[[271.6]] non vorrei avere fallato, o trovarmi detta una cosa che non fosse, la prego percio scrivermi\n[[271.7]] sopra questo particolare, e rispondermi subito, e divotamente riverendola, costantemente mi\n[[271.8]] protesto </p>\n<p> [[271.9]] Di V. S. Ill^#'m^#'a Obl^#'m^#'o Div^#'m^#'o S^#'r^#'e vero M. A. Fardella. </p>\n<p> [[271.10]] Venetia 30 Agosto </p>\n",
  "number": "82.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Venedig, 30. August [1704]. [81.84.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:82. MICHEL ANGELO FARDELLA AN LEIBNIZ Venedig, 30. August [1704]. [81.84.] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o Avendo significato all'Ecc^#'m^#'o Sig^#'r^#'e Procu^#'r^#'e Marcello Capo dell'Ecc^#'m^#'o Magistrato de Sig^#'r^#'i Riformatori dello Studio di Padova come V. S. Ill^#'...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>