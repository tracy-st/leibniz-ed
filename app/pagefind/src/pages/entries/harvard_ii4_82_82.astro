---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_82",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 82,
  "text": "<p> [[270.1]] <b>82. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[270.2]] Venedig, 30. August [1704]. [81.84.] </b></p>\n<p> [[270.9]] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o </p>\n<p> [[270.10]] Avendo significato all'Ecc^#'m^#'o Sig^#'r^#'e Procu^#'r^#'e Marcello Capo dell'Ecc^#'m^#'o Magistrato de Sig^#'r^#'i\n[[270.11]] Riformatori dello Studio di Padova come V. S. Ill^#'m^#'a m'aveva ricordato il Sig^#'r^#'e Herman per la\n[[270.12]] professione delle Matematiche nella nostra Università, ove ora vaca la catedra di Matematica,\n[[270.13]] mi fù da Sua Eccellenza comandato che sopra di ciò le ne dassi una piccola memoria che fù\n[[270.14]] presentata ieri all' Ecc^#'m^#'o Magistrato che ebbe grandissimo contento d'una tale propositione,\n[[270.15]] persuadendosi che per promovere il Sig^#'r^#'e Herman fosse il maggiore testimonio l'approvatione\n[[270.16]] di V. S. Ill^#'m^#'a oggi così celebre e rinomata per l'alto suo sapere e principalmente per le\n[[270.17]] cognitioni matematiche nel Mondo letterato. L'Ecc^#'m^#'o Sig^#'r^#'e Procu^#'r^#'e Veniero uno de' tre Riformatori\n[[270.18]] ne scrive oggi ad Hannover ad un Sig^#'r^#'e di cotesta Corte, credo, per averne per mezzo di\n[[270.19]] V. S. Ill^#'m^#'a una piu piena e distinta relatione del Soggetto proposto, e forse anche per assicurarsi\n[[270.20]] della di lei approvatione; e se ne scriverà ancora al loro Residente in Milano, accio si maneggi\n[[270.21]] con qualcheduno di Basilea per informarsi meglio del Soggetto, e stabilire le maniere di farlo\n[[270.22]] venire a Padova. Io hò tacciuto il punto della Religione, e dovendo il Sig^#'r^#'e Herman venire per\n[[270.23]] insegnare non gia la Teologia, ma le Matematiche[,] spero, che non si farà sopra ciò difficolta\n[[270.24]] veruna, e poi sperarei questo punto superarlo con altri motivi che ho gia pensati, che riguardano\n[[270.25]] il bene e populatione dello Studio. </p>\n<p> [[270.26]] L'Ecc^#'m^#'o Sig^#'r^#'e Procu^#'r^#'e Marcello m'hà comandato che ne scriva subito a V. S. Ill^#'m^#'a pregandola\n[[270.27]] di disponere il Sig^#'r^#'e Herman ad accettare l'impiego, e spiegarsi sopra lo stipendio che\n[[270.28]] desidera per il suo trattenimento in Padova. Giacche questo Ecc^#'m^#'o Magistrato s'è ora così\n[[271.1]] invogliato d'averlo, molto inclinando a scegliere per la catedra di Matematica Un Uomo dotto e\n[[271.2]] celebre della Germania, per allettare così la Natione Todesca a portarsi in Padova, bisogna\n[[271.3]] operare con calore e sollecitudine, e risolvere presto, accio l'Ecc^#'m^#'o Magistrato possa prendere le\n[[271.4]] sue misure, e sapere cio che deve farsi. Io nella mia memoria dissi che il Sig^#'r^#'e Herman fosse\n[[271.5]] Professore delle Matematiche in Basilea, essendomi per quel che essa mi scrisse così imaginato,\n[[271.6]] non vorrei avere fallato, o trovarmi detta una cosa che non fosse, la prego percio scrivermi\n[[271.7]] sopra questo particolare, e rispondermi subito, e divotamente riverendola, costantemente mi\n[[271.8]] protesto </p>\n<p> [[271.9]] Di V. S. Ill^#'m^#'a Obl^#'m^#'o Div^#'m^#'o S^#'r^#'e vero M. A. Fardella. </p>\n<p> [[271.10]] Venetia 30 Agosto </p>\n",
  "number": "82.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Venedig, 30. August [1704]. [81.84.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:82. MICHEL ANGELO FARDELLA AN LEIBNIZ Venedig, 30. August [1704]. [81.84.] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o Avendo significato all'Ecc^#'m^#'o Sig^#'r^#'e Procu^#'r^#'e Marcello Capo dell'Ecc^#'m^#'o Magistrato de Sig^#'r^#'i Riformatori dello Studio di Padova come V. S. Ill^#'...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii4_82","series":"Band II 4 (1701 - 1707)","seq":82,"text":"<p> [[270.1]] <b>82. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[270.2]] Venedig, 30. August [1704]. [81.84.] </b></p>\n<p> [[270.9]] Ill^#'m^#'o Sig^#'r^#'e Sig^#'r^#'e Padron Col^#'m^#'o </p>\n<p> [[270.10]] Avendo significato all'Ecc^#'m^#'o Sig^#'r^#'e Procu^#'r^#'e Marcello Capo dell'Ecc^#'m^#'o Magistrato de Sig^#'r^#'i\n[[270.11]] Riformatori dello Studio di Padova come V. S. Ill^#'m^#'a m'aveva ricordato il Sig^#'r^#'e Herman per la\n[[270.12]] professione delle Matematiche nella nostra Università, ove ora vaca la catedra di Matematica,\n[[270.13]] mi fù da Sua Eccellenza comandato che sopra di ciò le ne dassi una piccola memoria che fù\n[[270.14]] presentata ieri all' Ecc^#'m^#'o Magistrato che ebbe grandissimo contento d'una tale propositione,\n[[270.15]] persuadendosi che per promovere il Sig^#'r^#'e Herman fosse il maggiore testimonio l'approvatione\n[[270.16]] di V. S. Ill^#'m^#'a oggi così celebre e rinomata per l'alto suo sapere e principalmente per le\n[[270.17]] cognitioni matematiche nel Mondo letterato. L'Ecc^#'m^#'o Sig^#'r^#'e Procu^#'r^#'e Veniero uno de' tre Riformatori\n[[270.18]] ne scrive oggi ad Hannover ad un Sig^#'r^#'e di cotesta Corte, credo, per averne per mezzo di\n[[270.19]] V. S. Ill^#'m^#'a una piu piena e distinta relatione del Soggetto proposto, e forse anche per assicurarsi\n[[270.20]] della di lei approvatione; e se ne scriverà ancora al loro Residente in Milano, accio si maneggi\n[[270.21]] con qualcheduno di Basilea per informarsi meglio del Soggetto, e stabilire le maniere di farlo\n[[270.22]] venire a Padova. Io hò tacciuto il punto della Religione, e dovendo il Sig^#'r^#'e Herman venire per\n[[270.23]] insegnare non gia la Teologia, ma le Matematiche[,] spero, che non si farà sopra ciò difficolta\n[[270.24]] veruna, e poi sperarei questo punto superarlo con altri motivi che ho gia pensati, che riguardano\n[[270.25]] il bene e populatione dello Studio. </p>\n<p> [[270.26]] L'Ecc^#'m^#'o Sig^#'r^#'e Procu^#'r^#'e Marcello m'hà comandato che ne scriva subito a V. S. Ill^#'m^#'a pregandola\n[[270.27]] di disponere il Sig^#'r^#'e Herman ad accettare l'impiego, e spiegarsi sopra lo stipendio che\n[[270.28]] desidera per il suo trattenimento in Padova. Giacche questo Ecc^#'m^#'o Magistrato s'è ora così\n[[271.1]] invogliato d'averlo, molto inclinando a scegliere per la catedra di Matematica Un Uomo dotto e\n[[271.2]] celebre della Germania, per allettare così la Natione Todesca a portarsi in Padova, bisogna\n[[271.3]] operare con calore e sollecitudine, e risolvere presto, accio l'Ecc^#'m^#'o Magistrato possa prendere le\n[[271.4]] sue misure, e sapere cio che deve farsi. Io nella mia memoria dissi che il Sig^#'r^#'e Herman fosse\n[[271.5]] Professore delle Matematiche in Basilea, essendomi per quel che essa mi scrisse così imaginato,\n[[271.6]] non vorrei avere fallato, o trovarmi detta una cosa che non fosse, la prego percio scrivermi\n[[271.7]] sopra questo particolare, e rispondermi subito, e divotamente riverendola, costantemente mi\n[[271.8]] protesto </p>\n<p> [[271.9]] Di V. S. Ill^#'m^#'a Obl^#'m^#'o Div^#'m^#'o S^#'r^#'e vero M. A. Fardella. </p>\n<p> [[271.10]] Venetia 30 Agosto </p>\n","number":"82.","title":"MICHEL ANGELO FARDELLA AN LEIBNIZ","date":"Venedig, 30. August [1704]. [81.84.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>