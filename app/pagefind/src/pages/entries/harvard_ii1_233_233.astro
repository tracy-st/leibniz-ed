---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_233",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 233,
  "text": "<p> [[731.1]] <b>207b. JOHANN SIGISMUND ELSHOLZ AN LEIBNIZ</p>\n<p> [[731.2]] Berlin, 9. (19.) Juli 1679. [207a.210a.]</b></p>\n<p> [[731.11]] Hochedler, Vester, Insonders Hochgeehrter Herr. </p>\n<p> [[731.12]] Aus dessen vom 24. Junii an mich abermahl abgelassenen Schreiben habe ich ersehen, daß\n[[731.13]] M. h. Herr sinnes ist, zweene Claves, scilicet mathematicam et physicam selbst auß zu fertigen:\n[[731.14]] und daß er nur verlange eine beyhülffe einiger andern, welche über die bißher verhandene\n[[731.15]] Experimenta Register, Tabellen oder Inventaria außarbeiteten, damit sotane Inventaria nachmals\n[[731.16]] mit denen Clavibus conferiret werden könten. Hiebey sind mihr eingefallen die vielfältige\n[[731.17]] Klagen, daß man in rebus Physicis et Mathematicis fast keine oder doch gar wenige Demonstrationes\n[[731.18]] habe, sondern sich mit der probabilitet und mit conjecturis behelffen müsse. Aber\n[[731.19]] auff diesen nunmehr fürhabenden weg, würden Demonstrationes gnug an den tag kommen.\n[[731.20]] Wan also M. h. Herrn beliebet, mihr ferner zu communiciren den modum, wie man die Experimenta\n[[731.21]] necessaria zusammen ordnen und eintäffeln solle, damit sie einander illustriren, und ad\n[[731.22]] calculum mathematicum dienen können: so wil ich nicht allein nach möglichkeit daran arbeiten,\n[[731.23]] sondern auch andere die Naturkündigung liebende dazu disponiren, damit wir communi\n[[731.24]] studio unsern Zweck erreichen. </p>\n<p> [[731.25]] Hiebey sende ich des H. Probst Müllers andwort, und hette ich gern gesehen, daß sie mehr\n[[731.26]] satisfaction in sich hielte: allein es ist andem, daß dergleichen Ihm schon von vielen geschehen,\n[[731.27]] insonderheit von Athanasio Kirchero, mit welchem er unterschiedene Schreiben geweckselt,\n[[731.28]] wie auch von einem Jesuiten in Mähren Adamantio genandt, wie auch von H. Ludolpho Fürstl.\n[[731.29]] Raht zu Gotha: also daß es scheinet, man habe ihn tot repetitionibus etwas verdrießlich\n[[731.30]] gemachet. Jedoch wan I. Hochf. Durchl. zu Hannover eine inclination hiezu spüren liessen,\n[[731.31]] würde er facilior seyn, auch interpretationes librorum Sinensium gern verrichten. Schliesse\n[[731.32]] hiemit, und in erwartung ferner nachricht bleibe ich </p>\n<p> [[732.1]] Meines hochge. Herrn Raths stets willigster diener J. S. Elsholz. </p>\n<p> [[732.2]] Berlin den 9. Julii 1679. </p>\n<p> [[732.3]] <i>A Monsieur Monsieur le Conseiller de Leibniz treshumblⁿ^#'t. à Hannover.</i> </p>\n",
  "number": "207b.",
  "title": "JOHANN SIGISMUND ELSHOLZ AN LEIBNIZ",
  "date": "Berlin, 9. (19.) Juli 1679. [207a.210a.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:207b. JOHANN SIGISMUND ELSHOLZ AN LEIBNIZ Berlin, 9. (19.) Juli 1679. [207a.210a.] Hochedler, Vester, Insonders Hochgeehrter Herr. Aus dessen vom 24. Junii an mich abermahl abgelassenen Schreiben habe ich ersehen, daß M. h. Herr sinnes ist, zweene Claves, scilicet mathematicam et physicam selbst auß...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>