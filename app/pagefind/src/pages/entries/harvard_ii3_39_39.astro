---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_39",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 39,
  "text": "<p> [[108.15]] <b>39. CLAUDE NICAISE AN LEIBNIZ</p>\n<p> [[108.16]] Is sur Tille, 20. November 1695. [34.45.]</b></p>\n\n<p> [[109.1]] Is sur Tille le 20. 9^#'b^#'r^#'e <b>1695</b> </p>\n<p> [[109.2]] Vous reconnoistrés monsieur par le style dont j'écris à mons^#'r Morel combien j'ay eu de\n[[109.3]] Joye de recevoir la sienne aussi bien que la vostre; J'ay faict part à mons^#'r le president Boisot de ce\n[[109.4]] que vous m'avés ecrit sur son chapitre et Je l'ay instruit de vos intentions. Je ne doubte nullement\n[[109.5]] qu'il ne travaille actuellement au memoire que vous desirés de luy. La reflexion que vous faictes\n[[109.6]] sur [la] <i>Bibliotheca pontificia</i> est tres juste aussi bien que celle sur les devoirs de pieté que l'on\n[[109.7]] doit aux deffuncts, éloignée de la raillerie; cependant nostre philosophe platonicien mons^#'r Foucher\n[[109.8]] n'en estoit pas persuadé au commencement, car il trouvoit cette raillerie sur m^#'r Lantin\n[[109.9]] admirable à ce qu'il m'ecrivit; il en est pourtant revenû. Je croy que m^#'r Toinard qui l'a faict mettre\n[[109.10]] dans le <i>journal des scavants</i> reconnoistra à la fin qu'il n'a pas rendû <i>officium pietatis</i> au deffunct\n[[109.11]] et ancore moins à son amy vivant, qui l'a faict, et dont il couvrît la reputation, le seigneur chatie\n[[109.12]] les passions illicites des hommes par des tenebres espaisses dont il les offusque la plus part du\n[[109.13]] têms, <i>spargit poenales coecitates super illicitas Cupiditates</i>. M^#'r le president Cousin en a esté un\n[[109.14]] peu offusqué aussi bien que les autres; demandés un peu à mons^#'r l'abbé Foucher le subject de\n[[109.15]] cette offuscation, l'histoire du cabinet sur le 3^#'e^#'m^#'e tome des oeuvres de Juste Lipse, m^#'r Toinard la\n[[109.16]] scait aussi parfaictement. Cet abbé ne vous dira rien de m^#'r Lantin que ce qu'il aura veû dans\n[[109.17]] l'eloge que j'en ay faict et qu'il a gardé prés de deux mois sens l'envoyer en Hollande à mons^#'r\n[[109.18]] Basnage ce qui est cause qu'on ne l'a point veû dans le tems qu'on devoit; mons^#'r Basnage\n[[109.19]] suppleera par son journal au silence du nostre et vous apprendrés par luy ce que vous pouvés\n[[109.20]] souhaitter de ce cher deffunct et de ce genre merveilleux; J'attends ancore des memoires pour\n[[109.21]] l'eloge de m^#'r Ouvrard, j'ecrivis hier à son frere Minime à Rome à la trinité du mont. </p>\n<p> [[109.22]] Ne doubtés pas mons^#'r qu'on ne travaille à des memoires pour l'histoire du Roy; Je croy\n[[109.23]] bien que m^#'r Pelisson vostre bon amy et le nostre en a laissé, et que d'autres gens que les\n[[110.1]] ministres memes s'y occupent qui donneront lieu à bien des Anecdotes dans le têms; Je veux un\n[[110.2]] peu de mal à nostre s^#'t pere d'estre si long à nous donner des cardinaux et de differer si longtems\n[[110.3]] le plaisir que nous aurions de voir dans ce nombre le p. Noris qui ne nous ecrit plus depuis\n[[110.4]] longtems, et qui attend cette promotion pour le taire comme nous le mande mons^#'r l'abbé de\n[[110.5]] Gondy son bon amy et le nostre, secretaire d'etat de mons^#'r le Grand Duc; Je n'ay point veû le\n[[110.6]] <i>dessein du dictionnaire</i> de mons^#'r Chapuzeau dont vous me parlés; celluy de m^#'r Bayle s'avance\n[[110.7]] fort, l'on en est au second volume; m^#'r Leers y employe les mêmes caracteres et le meme papier\n[[110.8]] qui a esté mis en oeuvre pour le Junius <i>de pictura veterum</i>. Je suis mons^#'r avec tout le Respect\n[[110.9]] possible </p>\n<p> [[110.10]] Tout à vous Nicaise\n[[110.11]] <yi>Pour Vous Monsieur </p></p>\n",
  "number": "39.",
  "title": "CLAUDE NICAISE AN LEIBNIZ",
  "date": "Is sur Tille, 20. November 1695. [34.45.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:39. CLAUDE NICAISE AN LEIBNIZ Is sur Tille, 20. November 1695. [34.45.] Is sur Tille le 20. 9^#'b^#'r^#'e 1695 Vous reconnoistrés monsieur par le style dont j'écris à mons^#'r Morel combien j'ay eu de Joye de recevoir la sienne aussi bien que la vostre; J'ay faict part à mons^#'r le president Boisot...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>