---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_77",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 77,
  "text": "[[257.1]] <b>65.  Encyclopaedia ex sequentibus autoribus, propriisque meditationibus delineanda [Frühjahr 1679 bis Ende 1695 (?)]</b>\n [[257.3]] <tab/>[Frühjahr 1679 bis Ende 1695 (?)]\n[[257.22]] <tit2><b>Encyclopaedia ex sequentibus autoribus, propriisque meditationibus\n[[257.23]] delineanda</i></tit2> </p>\n<p> [[257.24]] <b>Theologia Positiva</b> ex Thom. Aquin[o], P. Fabry; Joh. Musaeo, Dionys.\n[[257.25]] Petav[io], Tomassino, Claubergio et Hundio: ac Wittichio. Calovio. Calixto. Adhibendi\n[[257.26]] autores qui multorum opiniones recitant, ut eligatur semper aequior salva veritate. </p>\n<p> [[257.27]] <b>Theologia Scripturaria</b>, et primum <b>Historia Scripturae</b>, ex libro P.\n[[257.28]] Simon prohibito, ex Huetio, Spinosa. Briano Walton. <i>Critic</i>[<i>i</i>] <i>sac</i>[<i>ri</i>]. </p>\n<p> [[258.1]] <b>Loca Scripturae notabiliora et difficiliora</b> ex Polo, Grotio cum Calovio,\n[[258.2]] Tirinus, <i>Bibliotheca portatilis</i> Raupii, Ravanell, Thaddaei <i>Conciliatore Biblico</i>. Adde\n[[258.3]] Spanheim[ii] <i>dubia</i>, et Pfeifferi etc. </p>\n<p> [[258.4]] <b>Theologia Patrum</b> seu <b>Historia Ecclesiastica</b>. Huc referantur Historia\n[[258.5]] Patrum, quo quisque tempore vixerit, quos scripserit libros, an genuini, quos habeat\n[[258.6]] naevos, aut quae habeat valde difficilia. Huc et <i>summa conciliorum</i>. Cave, du Pin. </p>\n<p> [[258.7]] <b>Theologia Controversiaria</b>, ex Bellarmino, Chamiero, Chemnitio, Gerhardo,\n[[258.8]] Musaeo, Calovio, addatur <i>Breviarium</i> Hulsemanni, Becanus, Hornbeck. Voetius, Calixtus,\n[[258.9]] Dallaeus, Wittichius nuper et Heidanus. Gavanti <i>Thesaurus rituum</i>. </p>\n<p> [[258.10]] <b>Theologia Moralis seu Practica</b>. Diana. Vinc. Baro. Montaltius. Dedekennus.\n[[258.11]] Caramuel. Arn[auld]. Pasc[al]. Amesius. <i>Consilia Theologica</i>. <Fn>Über <i>Consilia Theologica</i>: Dedekennus</Fn> Addenda Bullaria et\n[[258.12]] Concilia etc. <i>Lexicon</i> <i>Theologicum</i>. </p>\n<p> [[258.13]] <b>Jurisprudentiae Historia</b>. Pompon[ius] cum Ruperto et Leewe, Doujeat,\n[[258.14]] Jacob[us] Gothofred[us]. Joseph[us] Mar[ia] Suares. Conring. Alteserra. Circa Hodierna\n[[258.15]] Mauritius. Besold. Text[or]. Chiflet. autor jur. </p>\n<p> [[259.1]] <b>Jus naturae et Gentium</b> ex Grot[io]. Feld[enio]. Pufend[orfio]. Seld[enio].\n[[259.2]] Hobb[esio]. Aerod[io]. Autoribus quaest[ionum] illust[rium]. </p>\n<p> [[259.3]] <b>Jus Romanum</b>, certum et adhuc vegetum ex Vigel[io]. Daoyz. Brederod[eo].\n[[259.4]] Althus[io]. Tolosan[o]. Rennemann. Struv[e]. Lauterbach. Meyer. Cujac[io].\n[[259.5]] Gothofred[o]. Feld[en]. Eckolt., <i>conferens</i> cum aliis juribus Giseberti. </p>\n<p> [[259.6]] <b>Processus</b>. Ex Airer. Hiltrop. Schwend[endörffer]. Text[or]. <i>Nov. ord. nost. Conferent.\n[[259.7]] Lud. XIV</i>. Stylus Curiae Romanae. <i>Camerae</i> Ruland. </p>\n<p> [[259.8]] <b>Jus Controversum</b>. Ex Vigel[io]. Speidel. Berlich. Fachin[aeo]. Carpz[ovio].\n[[259.9]] Lauterb[ach] Struv[e]. etc. <i>Decisiones</i> <Fn><i>Über</i> Decisiones: Rotae</Fn> Martae, Borelli, <i>Aresta</i>. </p>\n<p> [[259.10]] <b>Jus Canonicum</b> ex Vivian[o]. Vigel[io]. Lancellot et Cucch[o]. Concil[ium]\n[[259.11]] Trident[inum]. Bullar[ium]. Laureae summa. Fagnan. Gonzales. </p>\n<p> [[259.12]] <b>Jus publicum</b>. <angle bracket>Auto</angle bracket>res majores: Cocc[ejus], Arnisaeus. Nucleus diss. <angle bracket>Cilnn.</angle bracket>\n[[259.13]] Tabulae Kirchmaieri. Thomas[ius]. Text[or]. Lampad[ius]. Conring. Monzamb[ano].\n[[259.14]] Maurit[ius]. Limn[aeus]. Otto. <i>Notitia</i> Boecl[eri]. Conr[ing]. Forstner. </p>\n<p> [[260.1]] <b>Lex[ica] juris</b>. Besold. Speidel. Schard[ius]. Du Cange etc. </p>\n<p> [[260.2]] <b>Chronologia</b>. Scal[iger]. Petav[ius]. Lydiat. Alsted. Calvis[ius]. Strauch. Helvic.\n[[260.3]] Usser. Marsham. <i>Antiquité des temps</i>. </p>\n<p> [[260.4]] <b>Historia Universalis</b>. Boxhorn. Mnemonici versus. Calvis[ius]. Labb[e].\n[[260.5]] Jonst[on]. </p>\n<p> [[260.6]] <b>Historia superioris seculi brevior</b>. Jovius. Sleidan[us]. Thuan[us]. Guicciardin[i].\n[[260.7]] Strad[a]. Grot[ius]. <i>Notat.</i> <i>com.</i> </p>\n<p> [[260.8]] <b>Historia nostri seculi distinctior</b>. <i>Theatrum</i>. <i>Diarium</i>. Aizema. Victor[ius]\n[[260.9]] Sirus. Guald[o] <i>Historia pacis</i>. Labard. Gramm[ond]. Priol[o]. Lundorp. Lotich. etc.\n[[260.10]] Brachel. Brewer. Tulden. Bissel. <i>Memoires</i> Temple. </p>\n<p> [[260.11]] <b>Genealogia</b>. Famil[iae] maxime extantes. Blondel. Duchene. S. Marthe.\n[[260.12]] Anselme. Du Bouchet. Vignier. Henning. Rittershus. Bucelin. <i>Weltalter</i>. </p>\n<p> [[261.1]] <i><b>Blason</b></i>. <i>Art de blasonner ou les termes</i>. Arma primaria familiarum per Europam et\n[[261.2]] armorum harum brevis explicatio. </p>\n<p> [[261.3]] Praesens status <b>virium</b>, foederum adhuc subsistentium, jurium et praetensionum\n[[261.4]] per Europam. </p>\n<p> [[261.5]] <b>Caeremonialia</b> politica. Duranus, etc. Vicquefortius. Actus publici. Philokenis </p>\n<p> [[261.6]] <b>Politica</b>. Bodin. Tolosan[us]. Arnis[aeus]. Althus[ius]. Keckermann. Macchiavell.\n[[261.7]] Hobb[es]. Feld[en]. Bech[er]. Conr[ing]. Text[or]. Card[anus]. Campanell[a]. <i>Utop</i>. etc.\n[[261.8]] Obrecht. Seckendorf. </p>\n<p> [[261.9]] <b>Militaria</b>. Corp[us] jur[is] militar[is]. Disciplina militar[ia]. Exercitia hodierna.\n[[261.10]] Stratagem[ata]. Fortif[icatoria] ex rationibus Deschales, Fourn[ier]. Gutschoven,\n[[261.11]] Feld[en]. Pagan. Mallet. <i>Artillerie</i> Simienovicz etc. </p>\n<p> [[261.12]] <b>Ethica</b>. Arist[oteles]. Feld[en]. Claram[ontius]. Spinos[a]. Chambre. Placc[ius].\n[[261.13]] Hobb[es]. Cartes[ius]. Fabri (quaerendus). Medicina Animi. </p>\n<p> [[261.14]] <b>Oeconomia</b>. Commercia. Manufactura. Rerum pretia. Res fiscales. Bech[er]. <i>Parfait\n[[261.15]] negotiant. Merchants Mapp</i>. Pretia rerum. Gryphiandri <i>Oecon</i>[<i>omia</i>] <i>legalis</i>. Hämeling.\n[[261.16]] <b>Polizey</b> Sachen. Lohneisen.) Seckendorff. Variae ordinationes colligendae. </p>\n<p> [[261.17]] <b>Cautelae</b> et <b>stylus</b>. Ars enumerandi omnia, de quibus cogitandum. Volkmann.\n[[261.18]] Hornegs <i>stella</i>. etc. <i>Tituli</i> </p>\n<p> [[262.1]] <b>Enchirid. Mathematicum</b>, in quo potissimae regulae et Tabulae. Figuris omnia\n[[262.2]] comprehendenda impressis super serico. Suppleatur Anglus ex Deschalio. Res ita complectenda\n[[262.3]] ut semper ratio appareat. </p>\n<p> [[262.4]] Rerum plerarumque totius Mundi accuratae delineationes, et proportiones ascribendae,\n[[262.5]] addendis explicationibus. Experimenta Medico-Chymico-Curiosa ex variis autoribus\n[[262.6]] probatis colligenda. Formandae inde inductiones seu aphorismi. Digerendaque omnia per\n[[262.7]] indices. </p>\n<p> [[262.8]] <b>Delineatio Medicinae</b> ex Sennerto, Platero, Dingen, Sylvio, Willisio etc.\n[[262.9]] Harv[ey]. Ex hac Encyclopaedia conficiendum postea Enchiridion quod aliquis secum\n[[262.10]] circumferre possit. In quo utiliora. Hoc scribendum compresse. Scribi poterit charactere\n[[262.11]] minus communi ut Graeco. Omnia per schedulas erunt in hoc manuali, ut possint eximi. </p>\n<p> [[262.12]] Percurratur Bibliotheca, et observetur quid in quolibet libro sit quod conferre possit\n[[262.13]] ad Encyclopaediam. </p>\n<p> [[262.14]] Oblitus sum supra rem Architectonicam. Item rem rusticam quae nunc adjungenda. </p>\n<p> [[262.15]] Facienda: Conquirendi amici cum quibus labores partiendi conferendumque. </p>\n<p> [[262.16]] Res pecuniaria, per metallica, <angle bracket>vinum</angle bracket>; <i>Bassette</i>. <i>Paris</i>. </p>\n<p> [[262.17]] Qualibet septimana pars aliqua manualis. </p>\n<p> [[262.18]] Percurrenda Bibliotheca consilio supradicto. </p>\n<p> [[262.19]] Oblitus sum criticam seu notitiam Manuscriptorum, Numismatum, inscriptionum,\n[[262.20]] rituumque veterum. Item autorum omnium veterum, et celebriorum recentiorum indicem,\n[[262.21]] et de iis judicia apta. </p>\n<p> [[262.22]] Oblitus sum et Harmoniae linguarum potissimum. Huc pertinent et facetiae, et\n[[262.23]] materiae mensalium sermonum. </p>\n<p> [[262.24]] Item artes dicendi, seu ars reminiscendi, ordine disponendi, eloquendi, praesentia\n[[262.25]] domini. </p>\n<p> [[262.26]] Denique ars vivendi, seu vitae totius Agenda Legesque. </p>\n",
  "number": "65.",
  "title": "Encyclopaedia ex sequentibus autoribus, propriisque meditationibus delineanda",
  "date": "[Frühjahr 1679 bis Ende 1695 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:65. Encyclopaedia ex sequentibus autoribus, propriisque meditationibus delineanda [Frühjahr 1679 bis Ende 1695 (?)] [Frühjahr 1679 bis Ende 1695 (?)] Encyclopaedia ex sequentibus autoribus, propriisque meditationibus delineanda Theologia Positiva ex Thom. Aquin[o], P. Fabry; Joh. Musaeo, Dionys. Pet...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>