          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:149. MICHEL ANGELO FARDELLA AN LEIBNIZ [Padua,] 26. Mai 1692. [142.155.] Illu^#'m^#'o Sig^#'r^#'e, mio Sig^#'r^#'e, Padron Colend^#'m^#'o Aspettavo con tanta impatienza le risposte di V. S. Illu^#'m^#'a, che mi tormentava sommamente la tardanza, e non sapevo capire, perche le sue lettere dimorassero...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

