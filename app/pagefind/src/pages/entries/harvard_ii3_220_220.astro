        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:/ 220. LEIBNIZ AN CLAUDE NICAISE Hannover, 6./16. August 1699. [217.224.] Hanover 6/16 Aoust 1699 Monsieur Vous Am Kopf von l von Leibniz' Hand: A Monsieur l'Abbé Nicaise 6/16 Aoust 1699 me prenés pour un homme bien negligeant, si vous me croyés capable d'egarer trois fois une chose, que je n'ay rec...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

