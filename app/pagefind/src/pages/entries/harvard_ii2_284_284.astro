---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_284",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 284,
  "text": "<p> [[852.11]] <b>287. LEIBNIZ AN CHRISTIAAN HUYGENS</p>\n<p> [[852.12]] Hannover, 4./14. September 1694. [282.]</b></p>\n[[853.1]] <petit> </p>\n<p> [[853.10]] [ ... ] Comme je vous disois un jour à Paris qu'on avoit de la peine à connoistre le\n[[853.11]] veritable sujet du Mouvement, vous me répondîtes, que cela se pouvoit par le moyen du\n[[853.12]] mouvement circulaire, cela m'arresta; et je m'en souvins en lisant à peu près la même chose\n[[853.13]] dans le livre de Mons. Newton; mais ce fut lorsque je croyois déja voir que le mouvement\n[[853.14]] circulaire n'a point de privilege en cela. Et je voy que vous estes dans le meme sentiment. Je\n[[853.15]] tiens donc que toutes les hypotheses sont equivalentes, et lors que j'assigne certains mouvemens\n[[853.16]] à certains corps, je n'en ay ny puis avoir d'autre raison, que la simplicité de l'Hypothese\n[[853.17]] croyant qu'on peut tenir la plus simple (tout consideré) pour la veritable. Ainsi n'en ayant point\n[[853.18]] d'autre marque, je crois que la difference entre nous, n'est que dans la maniere de parler; que je\n[[853.19]] tache d'accommoder à l'usage commun, autant que je puis <i>salva veritate</i>. Je ne suis pas meme\n[[853.20]] fort eloigné de la vostre, et dans un petit papier que je communiquay à M. Viviani, et qui me\n[[853.21]] paroissoit propre à persuader Messieurs de Rome à permettre l'opinion de Copernic, je m'en\n[[853.22]] accommodois. Cependant si vous estes dans ces sentimens sur la realité du mouvement, je\n[[853.23]] m'imagine que vous deuvriés en avoir sur la nature du corps de differens de ceux qu'on a\n[[853.24]] coustume d'avoir. J'en ay d'assez singuliers et qui me paroissent demonstrés. Je souhaiterois\n[[853.25]] d'apprendre un jour vos reflexions que vous m'aviés fait esperer tant sur mes <i>animadversions\n[[853.26]] in Cartesium</i>, que sur ce que je vous avois écrit contre le vuide et les Atomes. [ ... ] </p>\n<p> [[854.1]] Quelques uns ayant vû des definitions que j'ay données dans la preface de mon <i>Code\n[[854.2]] Diplomatique</i> (dont pour le dire en passant je vous feray remettre un exemplaire) m'ont exhorté\n[[854.3]] de mettre en ordre un amas d'autres que j'ay fabriquées autres fois. Voicy celles de la preface\n[[854.4]] que je soûmets à vostre jugement. Je dis que la justice est une charité conforme à la sagesse. La\n[[854.5]] sagesse est la science de la felicité. La charité est une bienveuillance generale. La bienveuillance\n[[854.6]] est <i>habitus diligendi</i>. <i>Diligere</i>, <tab/>^#T: <i>Aimer</i> <tab/>^#H: <i>Cherir</i> (en nostre sens) est se faire un plaisir de la felicité\n[[854.7]] d'autruy. [ ... ] </p>\n",
  "number": "287.",
  "title": "LEIBNIZ AN CHRISTIAAN HUYGENS",
  "date": "Hannover, 4./14. September 1694. [282.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:287. LEIBNIZ AN CHRISTIAAN HUYGENS Hannover, 4./14. September 1694. [282.] [ ... ] Comme je vous disois un jour à Paris qu'on avoit de la peine à connoistre le veritable sujet du Mouvement, vous me répondîtes, que cela se pouvoit par le moyen du mouvement circulaire, cela m'arresta; et je m'en souvi...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>