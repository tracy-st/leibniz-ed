---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi3_75",
  "series": "Band VI 3 (1672-1676); durchgesehener Nachdruck 1980",
  "seq": 75,
  "text": "[[522.10]] <b>75. De formis simplicibus </b> <span>522.10;0:63:075:76!      :L:l^</span>.\n[[522.15]] Formae simplices: perceptio, situs. At Mutatio et Materia, sive ipsae Modificationes\n[[522.16]] sunt resultantia ex omnibus aliis Formis simul sumtis. Sunt enim infinite varia\n[[522.17]] in materia et motu. Quae varietas infinita, non nisi ex causa infinita, id est variis\n[[522.18]] formis, oriri potest. Unde facile intelligitur formas simplices esse infinitas. Modificationes\n[[522.19]] autem ex omnibus resultantes, relatae ad singulas, constituunt in illis varietatem.\n[[522.20]] Videtur perceptio et situs esse ubique, at materia esse in aliis atque aliis diversa,\n[[522.21]] adeoque aliae atque aliae oriri leges; ut si in nostro sit Lex, ut eadem semper\n[[522.22]] servetur quantitas motus. Potest alia esse rerum natura, in qua etiam aliae leges. Sed\n[[522.23]] tamen necesse est, hoc spatium differre ab illo, erit scilicet positio quaedam, et multitudo,\n[[522.24]] sed non erit necesse ut sit longitudo, latitudo et profunditas. Videmus jam in\n[[522.25]] tempore, in angulo, aliisque varia esse genera quantitatum. Ubique videtur esse perceptio,\n[[523.1]] voluptas, felicitas, eius enim haec est natura mira, ut duplicet imo in infinitum\n[[523.2]] multiplicet rerum varietatem. Sed diversitas videtur aliis modis posse fieri. Quae\n[[523.3]] scilicet in nostram mentem non cadunt. Varietas eadem in quolibet genere mundi,\n[[523.4]] nec est quicquam aliud, quam eadem essentia diversimode relata, ut si urbem eandem\n[[523.5]] ex diversis locis aspicias, aut si essentiam senarii referas ad ternarium, erit 3x2 vel\n[[523.6]] 32, sin ad quaternarium erit 6 / 4 = 3 / 2 seu 6 = 4 x 3 / 2. Unde mirum non est, produci\n[[523.7]] quodammodo diversa.\n[[523.8]] Cum Mens aliquid percipit in Materia, negari non potest, dum alia atque alia\n[[523.9]] percipit, etiam in ipsa esse mutationem. Dum alius fit me major, crescendo, utique in\n[[523.10]] me quoque aliqua accidit mutatio, cum mutata sit denominatio de me. Et hoc modo\n[[523.11]] omnia in omnibus quodammodo continentur. Sed alia plane ratione in Deo, quam in\n[[523.12]] Rebus, et in Rerum generibus, seu Mundis quam in singulis. Fiunt autem res non ex\n[[523.13]] sola combinatione, formarum, in Deo, sed et cum subjecto. Subjectum ipsum seu\n[[523.14]] Deus cum sua ubiquitate dat immensum, hoc immensum combinatum cum aliis subjectis,\n[[523.15]] facit sequi Modos omnes possibiles, seu Res in ipso. Varia resultantia ex formis\n[[523.16]] combinata cum subjecto, faciunt resultare particularia. Quomodo res resultent ex\n[[523.17]] formis, non aliter quam similitudine Numerorum ex unitatibus possum explicare,\n[[523.18]] hoc adhuc discrimine, quod unitates omnes homogeneae, formae vero sunt differentes.\n",
  "number": "75.",
  "title": "De formis simplicibus",
  "date": ""
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:75. De formis simplicibus 522.10;0:63:075:76! :L:l^. Formae simplices: perceptio, situs. At Mutatio et Materia, sive ipsae Modificationes sunt resultantia ex omnibus aliis Formis simul sumtis. Sunt enim infinite varia in materia et motu. Quae varietas infinita, non nisi ex causa infinita, id est var...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>