---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_331",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 331,
  "text": "[[1460.11]] <b>275.  Origo Animarum et Mentium [März bis Juni 1681 (?)]</b>\n [[1460.12]] <tab/>[März bis Juni 1681 (?)]\n[[1460.16]] <tit2><b>Origo Animarum et Mentium</b></tit2> </p>\n<p> [[1460.17]] Quatenus Deus universum refert ad certum quoddam corpus, ipsumque totum velut\n[[1460.18]] ex hoc corpore spectat sive quod idem est omnes apparentias seu rerum relationes ad hoc\n[[1460.19]] corpus velut immobile consideratum cogitat, eo ipso corporis hujus forma substantialis\n[[1460.20]] sive anima inde resultat quae sensu quodam atque appetitu absolvitur. Inest enim rebus\n[[1460.21]] omnibus quidam sensus atque appetitus naturalis qui legibus Mechanismi nihil derogat;\n[[1460.22]] neque enim ille tam causa quam occasio agendi est Deo. </p>\n<p> [[1461.1]] Mentes autem oriuntur, cum Deus totum universum considerat non tantum, ut\n[[1461.2]] Systema rerum sed et ut Civitatem cujus ipse Rex est. Itaque Mentes non tantum\n[[1461.3]] perfectione differunt ab Animabus aliis, sed et toto genere sive natura. Dedit enim Deus\n[[1461.4]] mentibus, ut cogitent de seipsis, unde oritur reminiscentia quae facit ut mens semper\n[[1461.5]] meminerit se eandem illam esse quae prius. Hinc sequitur etiam immortalitas, neque enim\n[[1461.6]] vel incipere potest sui oblivisci, semperque cogitatio alia aliam trahit. At in animabus\n[[1461.7]] nulla est causa cur easdem manere dicamus, tametsi a corpore sint distinctae. Vera enim\n[[1461.8]] conservatio, consistit in conservationis suae sensu, qui si absit perinde est ac si extinctus\n[[1461.9]] sim, et alius creatus loco mei; neque enim unum ab altero discerni potest; adeoque pro\n[[1461.10]] eodem habendum est. </p>\n<p> [[1461.11]] Brutis est sensus, decretumque, sed non animadversio. In Deo solo est intelligere\n[[1461.12]] velle posse. In nobis est intellectus et voluntas, sed potentia nulla. </p>\n<p> [[1461.13]] Realitatem differre ab existentia rei in certo aliquo momento vel ex eo intelligi\n[[1461.14]] potest, quod tempus ipsum quandam realitatem habet, neque tamen unquam dici potest,\n[[1461.15]] ipsum nunc existere, persona intelligens et intellecta certo quodam modo duae sunt, etsi\n[[1461.16]] alio quodam modo sint una eademque. Sunt enim una eademque ex Hypothesi. Ponitur\n[[1461.17]] enim Mens seipsam intelligere. Duae sunt tamen, eo ipso quod duo sunt quodammodo\n[[1461.18]] diversa inter quae relatio est quaedam. Est itaque in Mente Binitas quaedam, sed cum in\n[[1461.19]] Deo ipsa intellectio sit perpetuum quiddam et subsistens, ideo veram Trinitatis ideam\n[[1461.20]] habere non possumus; possumus tamen non minus accurate demonstrare Trinitatem in\n[[1461.21]] Deo sed binitatem in nobis. Contradictio in his nulla, quia non satis considerant homines\n[[1461.22]] quid sit idem et diversum. </p>\n",
  "number": "275.",
  "title": "Origo Animarum et Mentium",
  "date": "[März bis Juni 1681 (?)]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:275. Origo Animarum et Mentium [März bis Juni 1681 (?)] [März bis Juni 1681 (?)] Origo Animarum et Mentium Quatenus Deus universum refert ad certum quoddam corpus, ipsumque totum velut ex hoc corpore spectat sive quod idem est omnes apparentias seu rerum relationes ad hoc corpus velut immobile consi...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>