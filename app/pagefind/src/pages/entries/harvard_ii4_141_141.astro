        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:141. LEIBNIZ AN BARTHÉLEMY DES BOSSES Hannover, 1. September 1706. [140.144.] Admodum Reverende Pater Fautor Honorande Literas Am Kopf der Reinschrift von Leibniz' Hand: Ad R. ­P. Bartholomaeum des Bosses Soc. Jes. Theologum Hildesiae Neben Literas Tuas vermerkt Leibniz am Rand das Datum von N. 140:...">

