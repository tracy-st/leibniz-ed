---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_95",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 95,
  "text": "<p> [[369.1]] <b>96. GERHARD MEIER (BREMEN) AN LEIBNIZ</p>\n<p> [[369.2]] Bremen, 12. (22.) Dezember 1690. [90.99.]</b></p>\n<p> [[369.9]] [ ... ] Mire me affecerunt suavissimae Tuae, quibus non tantum non deposuisse omnem\n[[369.10]] memoriam nostri, sed et amore erga nos ferri abunde significas. Ego quidem nihil mihi prius\n[[369.11]] unquam ducam, quam ut memori sequar mente animi erga Te mei benevolentiam. Egregiam\n[[369.12]] proinde rem fecisti, quod, quae ex Te efflagitabam, ad Carthesiana philosophemata vid. pertinentia,\n[[369.13]] in iis te facilem atque exorabilem praestiteris. Jube in vicem quae potis meae sententiae\n[[369.14]] et animum ad quae licet expositissimum experieris. Remitto quae remissa cupiebas, atque\n[[369.15]] interea veniam ut concedas procrastinationibus meis oro, rejiciunt enim a <greek>proairésh</greek>, praesentissima\n[[369.16]] in medium saepe venientia negotia. Explicavi acta Lipsiensia et quae ad anni XC\n[[369.17]] Mensem Majum illis inseruisti attenta, quantum licuit mihique fas fuit per alias, quae mentem\n[[369.18]] occupant, ideas, cura pervolvi, verum enim cum in altissime reductas retrusasque materias\n[[369.19]] condantur; ut difficile est ad ea penetrare! At vero illud mihi jam nunc perspectissimum est\n[[369.20]] Dⁿ^#'u^#'m Abb. D. C. (cujus integrum nomen, ut proximis explices rogo) plane a janua aberrasse, nec\n[[369.21]] alterum illum Gallum Cl. Dn. P. (qui itidem ex hisce notis solis mihi imperspectus est) Dⁿ^#'o\n[[369.22]] Abbati succenturiatum statum controversiae recte percepisse. Nescio, Vir Celeberrime, an non\n[[369.23]] hoc multis Gallorum ingeniis frequentatum et pervagatum veluti vitium esse animadverteris,\n[[369.24]] animadvertisti autem dubio omni procul, ut quarum saepe rerum nonnisi coecas imagines et\n[[369.25]] adumbrata nomina norint videantque, earum intimos etiam recessus sibi vindicent, et non\n[[369.26]] possint non cum cornicula risum movere. Erant meo tempore qui <i>Les oeuvres de M^#'r Vajer La\n[[369.27]] Motthe</i> veluti in numerato habebant, hujusque viri docti vestiti plumis in publicum passim\n[[369.28]] procedebant, intemperantius se jactantes etiam de ipsis apud inferos, uti in proverbio est,\n[[369.29]] ternionibus, quos si quis propius exploraret, sive ad alias differentesque hypotheses deduceret,\n[[370.1]] si contrarias veritates proferret, mere <greek>kṽfa prósvpa</greek> et piscibus magis mutos eos deprehendebat.\n[[370.2]] Nolim tamen hanc labem affricare solidioribus Gallis, quanquam in tam vasto gurgite\n[[370.3]] revera paucissimis. Quam recte hypothesin falsam Carthesianam ad Keplerum reduxisti! Ut\n[[370.4]] taceam reliqua omnia, quae ubique vim ingenii Tui penetrantissimam repraesentant. Macte hac\n[[370.5]] Tua virtute, Excell^#'e Vir, recrea porro Rempublicam eruditorum. [ ... ] </p>\n",
  "number": "96.",
  "title": "GERHARD MEIER (BREMEN) AN LEIBNIZ",
  "date": "Bremen, 12. (22.) Dezember 1690. [90.99.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:96. GERHARD MEIER (BREMEN) AN LEIBNIZ Bremen, 12. (22.) Dezember 1690. [90.99.] [ ... ] Mire me affecerunt suavissimae Tuae, quibus non tantum non deposuisse omnem memoriam nostri, sed et amore erga nos ferri abunde significas. Ego quidem nihil mihi prius unquam ducam, quam ut memori sequar mente an...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>