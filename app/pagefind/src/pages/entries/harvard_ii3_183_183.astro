---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_183",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 183,
  "text": "<p> [[465.1]] <b>183. LEIBNIZ AN NICOLAS MALEBRANCHE</p>\n<p> [[465.2]] Hannover, 2./12. Oktober 1698. [1.192.]</b></p>\n\n<p> [[465.19]] Mon Reverend Pere Hanover 2/12 Octobr. 1698 </p>\n<p> [[465.20]] Comme <Fn><i>Am Kopf der Seite von Leibniz' Hand</i>: Au R.P. de Malebranche</Fn> Mons. l'Abbé Torelli m'a temoigné d'avoir l'honneur de vous connoistre, je n'ay\n[[465.21]] pas voulu qu'il partist d'icy sans vous porter des marques qui vous puissent faire connoistre\n[[465.22]] combien je continue de vous honorer. J'en ay souvent donné d'autres, lors même que j'ay\n[[465.23]] avoué que nous n'estions pas en tout d'un même sentiment. Nous nous faisons tous deux un si\n[[465.24]] grand interest à avancer la connoissance de la verité, que nous nous sçaurons tousjours bon gré\n[[465.25]] des eclaircissemens que l'un peut fournir à l'autre ou au public. Je vous ay eu de l'obligation de\n[[466.1]] ce que vous avés bien voulu m'en avoir, lorsque vous avés retouché à vos loix du mouvement;\n[[466.2]] et quoyque à mon avis la loy de la continuité que j'avois mise autresfois en avant dans le\n[[466.3]] Journal de Hollande, et qui vous avoit plû jusqu'à donner occasion à vostre changement, s'y\n[[466.4]] trouve encor un peu interessée quoyque d'une manière moins perceptible qu'au commencement;\n[[466.5]] neantmoins j'ay crû que je n'aurois pas bonne grace d'y insister à vostre égard, pouvant\n[[466.6]] m'expliquer sans cela. Car je crois en effect que les loix de la nature ne sont pas si arbitraires\n[[466.7]] qu'on pourroit bien s'imaginer. Tout est determiné dans les choses, ou par des raisons comme\n[[466.8]] geometriques de la necessité, ou par des raisons comme morales de la plus grande perfection.\n[[466.9]] Vos beaux écrits Mon Reverend Pere, ont rendus les hommes beaucoup plus capables qu'ils\n[[466.10]] n'estoient auparavant d'entrer dans les verités profondes. Si je pretends d'en profiter je ne\n[[466.11]] manqueray pas aussi de le reconnoistre. Mons. Bayle a fait des objections contre mon systeme\n[[466.12]] dans son beau <i>Dictionnaire</i> à l'article de <i>Rorarius</i>. Mons. de Beauval publiera mes solutions\n[[466.13]] dans <i>l'Histoire des ouvrages des sçavans</i>, après [les avoir communiquées] à Mons. Bayle, qui\n[[466.14]] m'a écrit là dessus une lettre tres obligeante où il reconnoist la force de ma reponse. Je ne\n[[466.15]] laisseray pas de le prier de me marquer, s'il y a encor quelque chose qui l'arreste. Et rien ne\n[[466.16]] m'est plus agreable que de pouvoir estre instruit par des personnes aussi profondes et aussi\n[[466.17]] eclairées que vous et luy. Je suis avec zele </p>\n<p> [[466.18]] Mon Reverend Pere vostre tres humble et tres obeissant serviteur Leibniz </p>\n",
  "number": "183.",
  "title": "LEIBNIZ AN NICOLAS MALEBRANCHE",
  "date": "Hannover, 2./12. Oktober 1698. [1.192.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:183. LEIBNIZ AN NICOLAS MALEBRANCHE Hannover, 2./12. Oktober 1698. [1.192.] Mon Reverend Pere Hanover 2/12 Octobr. 1698 Comme Am Kopf der Seite von Leibniz' Hand: Au R.P. de Malebranche Mons. l'Abbé Torelli m'a temoigné d'avoir l'honneur de vous connoistre, je n'ay pas voulu qu'il partist d'icy sans...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>