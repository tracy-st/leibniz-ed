---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_628",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 628,
  "text": "[[2761.4]] <b>492₃.  Modalia et elementa juris naturalis. Zweite Fassung </p>\n<p> [[2761.9]] <b>Justitia</b> est charitas recte ordinata, seu virtus servans rationem in affectu hominis\n[[2761.10]] erga hominem. </p>\n<p> [[2761.11]] <b>Vir bonus</b> est, qui justitia praeditus est adeoque bonum commune quaerit quantum\n[[2761.12]] licet. </p>\n<p> [[2761.13]] <b>Bonum</b> <b>societatis</b> est quod plus uni bonum quam alteri malum est. </p>\n<p> [[2761.14]] <b>Malum societatis</b> est, quod plus uni malum quam alteri bonum est. </p>\n<p> [[2761.15]] <b>Bonum</b> alicujus est quod magis ad laetitiam ejus quam tristitam confert. </p>\n<p> [[2761.16]] <b>Malum</b> alicujus est, quod magis ad tristitiam ejus quam laetitiam confert. </p>\n<p> [[2761.17]] <b>Felicitas</b> (<b>Miseria</b>) est laetitia (tristitia) durabilis. </p>\n<p> [[2761.18]] <b>Praemium</b> est bonum privati a voluntate societatis ob bonum societatis a voluntate\n[[2761.19]] privati. </p>\n<p> [[2761.20]] <b>Poena</b> est Malum privati a voluntate societatis ob malum societatis a voluntate\n[[2761.21]] privati. </p>\n<p> [[2762.1]] <b>Debitum</b> est bonum societatis a voluntate privati secundum prudentiam agentis;\n[[2762.2]] itaque tale esse debet ut praemiis poenisque procurari possit in recte ratiocinante. </p>\n<p> [[2762.3]] <b>Illicitum</b> est Malum societatis a voluntate privati contra prudentiam agentis;\n[[2762.4]] itaque tale esse debet, ut praemiis poenisque impediri possit in recte ratiocinante.\n [[2762.5]] <petit> </p>\n<p> [[2762.6]] <i>Die folgenden Absätze in Kleindruck hat Leibniz wieder gestrichen</i>: </p>\n<p> [[2762.7]] Impossibilium nulla est obligatio.\n [[2762.8]] <tab/>Nam impossibile nullis praemiis vel poenis procurari potest. </p>\n<p> [[2762.9]] Omne necessarium est licitum seu Necessitas legem non habet.\n [[2762.10]] <tab/>Nam necessarium nullo modo, ac proinde nec praemiis vel poenis impediri potest. </petit> </p>\n<p> [[2762.11]] Uti se habent inter se necessarium, contingens, possibile, impossibile; ita se habent\n[[2762.12]] debitum, indebitum, licitum, illicitum.\n [[2762.13]] <tab/>Est enim debitum nihil aliud quam necessarium viro bono, et illicitum nihil\n[[2762.14]] aliud quam impossibile viro bono. Est autem vir bonus cujus charitas recte\n[[2762.15]] ordinata est seu qui bonum commune quaerit quantum licet salvo suo. Hinc\n[[2762.16]] patet omnia Theoremata de Modalibus huc transferri, ac totidem novas\n[[2762.17]] propositiones circa justum et injustum enuntiari posse. Eadem theoremata\n[[2762.18]] repeti possunt non tantum ratione viri boni, sed et ratione viri prudentis. </p>\n<p> [[2762.19]] <b>Liberum</b> est quod neque debitum neque illicitum est. Unumquodque praesumitur\n[[2762.20]] liberum. </p>\n",
  "number": "492₃.",
  "title": "Modalia et elementa juris naturalis. Zweite Fassung",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:492₃. Modalia et elementa juris naturalis. Zweite Fassung Justitia est charitas recte ordinata, seu virtus servans rationem in affectu hominis erga hominem. Vir bonus est, qui justitia praeditus est adeoque bonum commune quaerit quantum licet. Bonum societatis est quod plus uni bonum quam alteri mal...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>