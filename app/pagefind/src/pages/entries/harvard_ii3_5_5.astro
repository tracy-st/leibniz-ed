---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_5",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 5,
  "text": "<p> [[19.1]] <b>5. ANTONIO ALBERTI AN RUDOLF CHRISTIAN VON BODENHAUSEN</p>\n<p> [[19.2]] 5. Februar 1695. [18.]</b></p>\n\n<p> [[19.13]] Je suis persuadé Mon tres honoré Monsieur qu'il na pas tenu à vous que je n'aye receu\n[[19.14]] exactement la reponse aux lettres que je me suis donné l'honneur de vous ecrire pour vous\n[[19.15]] informer de ce que j'avois fait en execution de ce que vous m'aviez ordonné. Je vous prie\n[[19.16]] Monsieur de vouloir bien excuser l'Abbé della Stuffa. Je vous asseure qu'il n'a point de tort, et\n[[19.17]] qu'il m'avoit écrit diverses fois de Florence pour me demander ce que j'avois imploré pour vos\n[[19.18]] copies. Mais je ne scais comme quoy j'oubliai de luy repondre sur cet article. Au reste je suis\n[[19.19]] sensiblement affligé de l'Indisposition de notre Illustre et incomparable M. Libnits. En verité je\n[[19.20]] ne puis penser à la perte d'un si grand homme sans ressentir une tres vive douleur. Ce qui\n[[19.21]] m'afflige d'avantage c'est qu'il mourroit hors du sein de l'eglise catholique. À propos de quoy\n[[19.22]] je vous veux dire ce que dit l'autre jour un grand Cardinal à qui on informait du grand merite de\n[[19.23]] notre ami. Il asseura que s'il étoit dans la disposition de se reunir à l'eglise on pouvoit comter\n[[19.24]] que non seulement on lui donneroit le poste de <i>primus Custos</i> de la Vaticane mais encore\n[[19.25]] beaucoup d'autres avantages, en sorte qu'il pourroit employer tout ce qui lui reste de vie à\n[[19.26]] servir utilement et glorieusement le public. Je vous ecris ceci non que je voie grande apparance\n[[20.1]] à le faire reussir; mais pour communiquer à une personne que j'estime et que j'honore\n[[20.2]] infiniment une des choses que je desire le plus au monde. </p>\n<p> [[20.3]] J'ay dit à M^#'r Landini qui me paroit un parfait honnete homme, ce que j'ay depensé pour\n[[20.4]] faire les copies dont est question. J'ay emprunté à Msgr Champini le tome de 1693 et l'ai donné\n[[20.5]] au dit sieur Landini pour en faire copier ce qu'il trouvera à propos et de la manière et par qui il\n[[20.6]] voudra. Je voudrais Mon tres honoré Monsieur trouver quelque occasion plus importante pour\n[[20.7]] vous temoigner à quel point je suis avec tout le respect et l'attachement possible </p>\n<p> [[20.8]] Monsieur votre tres humble et tres obeissant serviteur </p>\n<p> [[20.9]] ce 5 febrier 1695 Ant. Alberti </p>\n",
  "number": "5.",
  "title": "ANTONIO ALBERTI AN RUDOLF CHRISTIAN VON BODENHAUSEN",
  "date": "5. Februar 1695. [18.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:5. ANTONIO ALBERTI AN RUDOLF CHRISTIAN VON BODENHAUSEN 5. Februar 1695. [18.] Je suis persuadé Mon tres honoré Monsieur qu'il na pas tenu à vous que je n'aye receu exactement la reponse aux lettres que je me suis donné l'honneur de vous ecrire pour vous informer de ce que j'avois fait en execution d...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii3_5","series":"Band II 3 (1695 - 1700)","seq":5,"text":"<p> [[19.1]] <b>5. ANTONIO ALBERTI AN RUDOLF CHRISTIAN VON BODENHAUSEN</p>\n<p> [[19.2]] 5. Februar 1695. [18.]</b></p>\n\n<p> [[19.13]] Je suis persuadé Mon tres honoré Monsieur qu'il na pas tenu à vous que je n'aye receu\n[[19.14]] exactement la reponse aux lettres que je me suis donné l'honneur de vous ecrire pour vous\n[[19.15]] informer de ce que j'avois fait en execution de ce que vous m'aviez ordonné. Je vous prie\n[[19.16]] Monsieur de vouloir bien excuser l'Abbé della Stuffa. Je vous asseure qu'il n'a point de tort, et\n[[19.17]] qu'il m'avoit écrit diverses fois de Florence pour me demander ce que j'avois imploré pour vos\n[[19.18]] copies. Mais je ne scais comme quoy j'oubliai de luy repondre sur cet article. Au reste je suis\n[[19.19]] sensiblement affligé de l'Indisposition de notre Illustre et incomparable M. Libnits. En verité je\n[[19.20]] ne puis penser à la perte d'un si grand homme sans ressentir une tres vive douleur. Ce qui\n[[19.21]] m'afflige d'avantage c'est qu'il mourroit hors du sein de l'eglise catholique. À propos de quoy\n[[19.22]] je vous veux dire ce que dit l'autre jour un grand Cardinal à qui on informait du grand merite de\n[[19.23]] notre ami. Il asseura que s'il étoit dans la disposition de se reunir à l'eglise on pouvoit comter\n[[19.24]] que non seulement on lui donneroit le poste de <i>primus Custos</i> de la Vaticane mais encore\n[[19.25]] beaucoup d'autres avantages, en sorte qu'il pourroit employer tout ce qui lui reste de vie à\n[[19.26]] servir utilement et glorieusement le public. Je vous ecris ceci non que je voie grande apparance\n[[20.1]] à le faire reussir; mais pour communiquer à une personne que j'estime et que j'honore\n[[20.2]] infiniment une des choses que je desire le plus au monde. </p>\n<p> [[20.3]] J'ay dit à M^#'r Landini qui me paroit un parfait honnete homme, ce que j'ay depensé pour\n[[20.4]] faire les copies dont est question. J'ay emprunté à Msgr Champini le tome de 1693 et l'ai donné\n[[20.5]] au dit sieur Landini pour en faire copier ce qu'il trouvera à propos et de la manière et par qui il\n[[20.6]] voudra. Je voudrais Mon tres honoré Monsieur trouver quelque occasion plus importante pour\n[[20.7]] vous temoigner à quel point je suis avec tout le respect et l'attachement possible </p>\n<p> [[20.8]] Monsieur votre tres humble et tres obeissant serviteur </p>\n<p> [[20.9]] ce 5 febrier 1695 Ant. Alberti </p>\n","number":"5.","title":"ANTONIO ALBERTI AN RUDOLF CHRISTIAN VON BODENHAUSEN","date":"5. Februar 1695. [18.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>