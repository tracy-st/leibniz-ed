---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_206",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 206,
  "text": "<p> [[664.1]] <b>208. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[664.2]] Padua, 4. Februar 1693. [196.233.]</b></p>\n<p> [[664.7]] Illu^#'m^#'o Sig^#'r^#'e, mio Sig^#'r^#'e, Padron Colend^#'m^#'o </p>\n<p> [[664.8]] È molto tempo, che non ricevo lettere di V. S. Illu^#'m^#'a, benché l' habbia scritto più volte,\n[[664.9]] pregandola rispondermi per rasserenarmi l'animo, che vive molto turbato, quando non viene\n[[664.10]] assicurato del suo ottimo stato, e della continuatione del di lei patrocinio con suoi pretiosissimi\n[[664.11]] caratteri; mi consola però la viva speranza di ricevere quanto prima sue risposte, non dubitando\n[[664.12]] punto del suo generoso amore, e stimatissima gratia. Questo Eccell^#'m^#'o Capitano fra tre mesi\n[[664.13]] termina il suo reggimento, onde s'avvicina il tempo della mia partenza da me con impatienza\n[[664.14]] per molti motivi sospirata, e quando sarà tutto ben disposto subito ne darò parte a V. S. Illu^#'m^#'a,\n[[664.15]] acciò possa con ogni cautela, e prudenza eseguire quanto hò promesso e risolto per restituirmi\n[[664.16]] una volta a quella quiete, che tanto bramo. Spero che alcuni Cavalieri si risolveranno di\n[[664.17]] mandare i loro figliuoli in Germania per erudirsi nell'Illustre Accademia di Volfembutel,\n[[664.18]] sospesi d'animo fin hora, ed irresoluti, per la naturale antipatia, che hanno gl'Italiani di\n[[664.19]] viaggiare, e collocare i loro figliuoli in Accademie lontane e principalmente in paesi protestanti,\n[[664.20]] creduti ingiustamente da essi Asili dell'impietà, e libertinaggio. Nondimeno io farò quanto\n[[664.21]] potrò per disingannarli, e torli da questo pernicioso, e mostruoso pregiuditio. Procurarò ancora\n[[664.22]] in questo tempo mettere insieme tutto quel che potrò havere della Casa Estense, e tentarò ogni\n[[664.23]] strada per cavare una copia del Diploma del Monastero delle Carceri, memore de' suoi pregiatissimi\n[[664.24]] comandi, e bramosissimo di darle qualche saggio della mia riverente gratitudine. Con\n[[664.25]] l'occasione delle feste baccanali celebrate con infinita pompa in questa Corte, hò contratta\n[[664.26]] stretta amicitia con il Sig^#'r^#'e Carlo della Musa, gentilhuomo nativo di Leone di Francia, uscito da\n[[664.27]] quel regno per materia di Religione, il quale è stato sopraintendente, e capo in tutti li concerti\n[[665.1]] musicali, che si sono qui fatti, con somma sodisfattione di questo Eccell^#'m^#'o Capitano. Egli\n[[665.2]] possiede molti talenti, sona per eccellenza il Violino, il Flauto, ed il Flagioletto, sona e canta\n[[665.3]] all'italiana, ed alla francese con la Violetta di gamba, o vero basso di Viola. È stato Maestro di\n[[665.4]] dansa e lingua francese nel famoso Colleggio di Brescia per lo spatio di anni sei, con la quale\n[[665.5]] occasione hà servito alla più cospicua Nobiltà di Venetia, e Lombardia che concorre a quell'Accademia\n[[665.6]] regolata di Gesuiti molto sodisfatti del buon costume e nobile talento del Sig^#'r^#'e Carlo\n[[665.7]] peritissimo negl'istromenti ed arte di dansare, da esso qui esercitata nel nobile Colleggio de\n[[665.8]] Padri Sommaschi, e chiamato in tutte le funtioni musicali con molto gradimento di questa\n[[665.9]] Nobiltà. Porgo questa notitia a V. S. Illu^#'m^#'a acciò se ve ne fosse bisogno, possa proporre questo\n[[665.10]] degno Soggetto a Sua Altezza, parendomi molto a proposito per la cognitione che hà dello stile\n[[665.11]] così italiano come francese nella dansa, suono, e canto per cotesta Corte ed Accademia di\n[[665.12]] Volfembutel, ed essendo confidentissimo di questa Nobiltà, potrebbe facilitare i miei trattati per\n[[665.13]] indurre a portarsi costì qualche Giovane Nobile italiano. Nel caso, che Sua Altezza inclinasse,\n[[665.14]] sarebbe pensiero il mio persuaderlo ad abbandonare l'Italia, per la Germania, con cui hà molto\n[[665.15]] genio per amore della Religione e della sincerità alemana, non ostante che in questa Paese viva\n[[665.16]] con molta commodità, e guadagni soldi in abbondanza come V. S. Illu^#'m^#'a si potrà da altra banda\n[[665.17]] informare, essendo esso conosciuto abastanza in questo Stato, e da me finhora sperimentato per\n[[665.18]] un Sig^#'r^#'e d'onore che possiede il buono della Natione francese, ed italiana senza molto peccare\n[[665.19]] d'incostanza, e simulatione. La priego consolarmi di qualche suo stimatissimo comando,\n[[665.20]] protestandomi d'inalterabilmente essere </p>\n<p> [[665.21]] Di V. S. Illu^#'m^#'a Umil^#'m^#'o, Oblig^#'m^#'o, Divot^#'m^#'o S^#'r^#'e vero M. A. F. </p>\n<p> [[665.22]] Padova in Corte dell'Ecce^#'m^#'o Capitano 4 Febraio 1693 </p>\n",
  "number": "208.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Padua, 4. Februar 1693. [196.233.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:208. MICHEL ANGELO FARDELLA AN LEIBNIZ Padua, 4. Februar 1693. [196.233.] Illu^#'m^#'o Sig^#'r^#'e, mio Sig^#'r^#'e, Padron Colend^#'m^#'o È molto tempo, che non ricevo lettere di V. S. Illu^#'m^#'a, benché l' habbia scritto più volte, pregandola rispondermi per rasserenarmi l'animo, che vive molto ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>