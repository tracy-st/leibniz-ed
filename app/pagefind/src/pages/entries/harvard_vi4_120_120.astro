---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_120",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 120,
  "text": "[[399.1]] <b>98₂.  Zweiter Ansatz ZWEITER ANSATZ </p>\n<p> [[399.2]] Omnia quae cogitamus, his fere continentur quae sunt, <b>Generaliter</b>: Realitas,\n[[399.3]] Varietas, Consequentia, Ordo, Mutatio. <b>Medio loco</b> modi res discriminandi: Qualitas,\n[[399.4]] Quantitas et Positio. <b>Speciatim</b> ipsa discrimina: Extensio, Sensibilis Qualitas, Cogitatio. </p>\n<p> [[399.6]] <b>Realitas</b> complectitur possibile excluso impossibili, positivum excluso negativo.\n[[399.7]] Positivum autem rursus suos habet gradus, nam si completum sit, constituit substantiam,\n[[399.8]] sin minus accidens; si absolutum sit constituit Deum, sin limitatum sit, creaturam. <Fn><i>Am Rande</i>: Existentia seu praesentia ponenda videtur post realitatem.</Fn> </p>\n<p> [[399.9]] Ad <b>Varietatem</b> pertinent: idem et diversum, unum et plura. </p>\n<p> [[399.10]] Ad <b>Consequentiam</b> incompatibilia, inconnegabilia, opposita, conditio et conditionatum,\n[[399.11]] inferens et illatum; et haec quidem omnia vel absolute vel per se seu si nihil\n[[399.12]] impediat. </p>\n<p> [[399.13]] Ad <b>Ordinem</b>, scilicet naturalem, prius et posterius natura. Causa et Effectus. Nam\n[[399.14]] ex ordine et consequentia fit causa; ex causa enim tanquam natura priore sequitur\n[[399.15]] effectus. </p>\n<p> [[399.16]] Ad <b>Mutationem</b>, status, duratio, tempus; tempore prius, posterius et simul.\n[[399.17]] Agens, Patiens. Acturiens. </p>\n<p> [[399.18]] Ad <b>Qualitatem</b> Simile et Dissimile. </p>\n<p> [[399.19]] Ad <b>Quantitatem</b>, Proportio, totum, pars (seu continens contentum), Numeri. </p>\n<p> [[399.20]] Ad <b>Positionem</b> seu modum discernendi non per aliquid essentiam exprimens ut\n[[399.21]] qualitas et quantitas, sed per modum existendi, pertinent: Termini, continuum, contiguum,\n[[399.22]] intervalla. </p>\n<p> [[399.23]] Ad <b>Extensionem</b>, situs, distantia, motus, quies, vis, resistentia. </p>\n<p> [[399.24]] Ad <b>Sensiles Qualitates</b>, Color, Sonus, Odor, Sapor, Calor, aliaque tactus\n[[399.25]] objecta. </p>\n<p> [[400.1]] Ad <b>Cogitationem.</b> Conceptus, intellectio; sensus, perceptio, Memoria, Sententia,\n[[400.2]] Scientia, Voluntas, Voluptas et Dolor. Affectus; Habitus. </p>\n<p> [[400.3]] Videntur et res posse dividi in Metaphysicas, Mathematicas et Physicas. Metaphysicae\n[[400.4]] substantiae sunt, Deus, mens, anima, Entelechia prima seu forma substantialis.\n[[400.5]] <b>Mathematicae</b> tempus, spatium, motus. </p>\n",
  "number": "98₂.",
  "title": "Zweiter Ansatz",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:98₂. Zweiter Ansatz ZWEITER ANSATZ Omnia quae cogitamus, his fere continentur quae sunt, Generaliter: Realitas, Varietas, Consequentia, Ordo, Mutatio. Medio loco modi res discriminandi: Qualitas, Quantitas et Positio. Speciatim ipsa discrimina: Extensio, Sensibilis Qualitas, Cogitatio. Realitas comp...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>