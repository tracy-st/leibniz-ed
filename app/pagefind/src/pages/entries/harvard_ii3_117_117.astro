        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii3_117","series":"Band II 3 (1695 - 1700)","seq":117,"text":"<p> [[310.13]] <b>117. VINCENT PLACCIUS AN LEIBNIZ</p>\n<p> [[310.14]] Neustadt, 27. Mai (6. Juni) 1697. [113.121.]</b></p>\n\n<p> [[311.1]] I. N. J. C. </p>\n<p> [[311.2]] Excellentissimo dignitate officiorum, Virtutum et Eruditionis omnigenae meritis\n[[311.3]] G. G. Leibnitio Electorali Consiliario </p>\n<p> [[311.4]] S. P. D. V. Placcius. </p>\n<p> [[311.5]] Rusticationem in praediolo meo amoenissimo amoeniorem etiam fecere multo litterae\n[[311.6]] Tuae, cum adjecto dono. Cui nunc nisi disputatiunculam hanc, quod reponam non habeo.\n[[311.7]] Habiturus propediem, ni bibliopola fefellerit; qui recepit editionem Problematum IIX. <i>de\n[[311.8]] affectibus</i> et quidem Christiane movendis Primum C. D. B. V. e Theologicis meis opusculum.\n[[311.9]] Ad quod contra decretum animi mei publice professum, edendum me Conscientiae meae arbiter\n[[311.10]] M. Dornemannus impulit. Eis ut adaequent molem Tui libelli, addam alia aeque diu jam pressa.\n[[311.11]] Videlicet 1. <i>de Interitu mundi dissertationem contra annihilationi Luthero improbatae addictos</i>,\n[[311.12]] 2. <i>De hora crucifixionis Christi et antilogia Marci Evangelistae cum Johanne</i>, 3. <i>de\n[[311.13]] Soliloquiis Christianis</i>. Interim tua <i>Sinica</i>, meos etiam <i>Anonymos</i> auctura, perlegi. Sane quam\n[[311.14]] optarem voto tuo respondere successum! tam parum a mea incredulitate impetro spem tantam.\n[[311.15]] Et quaeso quis credat Jesuitas nos in suae felicitatis jam stabilitae partem ullam admissuros, aut\n[[311.16]] rem ita unquam agi permissuros, ut ne intelligant Sinenses quibus inter nos dissideamus. Cum\n[[311.17]] illi dudum impleverint sua superstitione, quam nos antichristianam dicimus omnia nec sine illa\n[[311.18]] unquam sint perrecturi docere? Mitto tot alia impedimenta, etiam a nostris partibus obstitura.\n[[311.19]] Interim exosculor tua pia desideria, sed (faxit ut errem Deus et falsus evadam Vates!) in\n[[311.20]] desideriis substitura. Ni fallor alias etiam Thomae Mori Utopienses narrantur ita sectis suis\n[[311.21]] innumeris addicti, ne quis publicos illorum cultus sacros frequentans id animadvertat. Ita si\n[[311.22]] fieret, revera evaderent id quod sunt, Luthero versae logomachiae 1. <i>Tim.</i> VI. 4. <i>Schuhlgezaenk</i>.\n[[311.23]] Id quod facile impetrari aliquatenus potuisset, si hoc solum egissent statim ab initio Magnates\n[[311.24]] adjuncta potentia; ne aliter quam Latine talia disceptarentur. Sed haec quidem extra oleas. Bina\n[[311.25]] Tua exemplaria Dn. Bussingio et Mejero destinata simulac in urbem rediero tradam. De\n[[311.26]] Weigelio et ipse miror, quod nec indicium sui reditus et transitus fecerit mihi. Quo magis\n[[311.27]] despero et nostros desperare conjecturo de Scholastica per ipsum emendatione hic locorum ulla.\n[[311.28]] Nempe Pietismi et Diotrephis calumnias timent, in hoc qui adjuvare nos debebant, sane hac in\n[[311.29]] parte me magis meticulosi, qui minus esse debebant. Vale, in Neostadorensi meo Tusculanulo,\n[[311.30]] d. 27. Maji 1697. </p>\n","number":"117.","title":"VINCENT PLACCIUS AN LEIBNIZ","date":"Neustadt, 27. Mai (6. Juni) 1697. [113.121.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>