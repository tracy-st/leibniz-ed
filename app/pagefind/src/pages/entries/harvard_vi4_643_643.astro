          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:496₁. Erste Fassung ERSTE FASSUNG Justitia est charitas sapientis, seu charitas quae prudentiae congruit. Itaque Carneadis declamatio in justitiam, quam dicebat esse summam stultitiam, hanc quidem justitiam cujus praecepta molimur, non tangit, utique enim charitas sapientis stulta esse non potest. C...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

