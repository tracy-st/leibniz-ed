---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_144",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 144,
  "text": "<p> [[468.1]] <b>144. BARTHÉLEMY DES BOSSES AN LEIBNIZ</p>\n<p> [[468.2]] Hildesheim, 17. September 1706. [141.145.] </b></p>\n<p> [[468.16]] Illustrissime Domine P[ax] C[hristi] </p>\n<p> [[468.17]] Mitto propositiones quas cupis, missurus etiam non petenti, ut tuum de reliquis judicium\n[[468.18]] intelligam: tantum ne facile divulgentur. Valde mihi gratae fuerunt breves illae notae tuae;\n[[468.19]] tametsi quoad plerasque sententiam tuam habere perspectam videbar. Nec dubito quin illo fere\n[[468.20]] sensu, quem tu quoque improbas, censoribus nostris displicuerint; decimam nonam si excepero.\n[[468.21]] Nam dum Angelos, qui Entelechiae corporis non sunt, causas motus plus quam occasionales\n[[468.22]] esse volunt, motuum a cogitationibus dependentiam exigere aliquam videntur. Nisi tamen forte\n[[468.23]] efficientia ista angelica per quandam cum Entelechiis analogiam explicari posset. Nam Animas\n[[468.24]] rationales quod attinet, satis erit, opinor, si ut entelechiae motum efficiant. Atque hic scire aveo\n[[468.25]] quid de nupera Turneminii hypothesi sentias; Tum etiam, ecquid tibi videatur de ratione qua\n[[469.1]] Aristoteles contra philosophos antiquos vacuum ad motum esse necessarium contendentes\n[[469.2]] demonstrare nititur potius, corpus si in vacuo moveretur, in instanti movendum esse, atque adeo\n[[469.3]] motum in vacuo esse non posse. </p>\n<p> [[469.4]] P. Mutius Vitelleschus varias propositiones a nostris doceri vetuerat ille quidem[,] sed\n[[469.5]] earum catalogus cum insigni auctario in congregatione nona postea confectus, et a P. Francisco\n[[469.6]] Picolomineo primum missus est ad provincias Anno 1651, continetque propositiones universim 65. </p>\n<p> [[469.8]] Dicebas in penultimis tuis Peccatum Originale nec Entelechiam esse nec substantiam, sed\n[[469.9]] imperfectionem quandam animae nostrae, cui et imperfectio in corpore nostro respondet. Duo\n[[469.10]] regero. </p>\n<p> [[469.11]] 1. Si peccatum originale in imperfectione quadam animae nostrae situm est ergo nihil\n[[469.12]] positivum impedit animam quominus agat, uti actura fuerat si non peccasset. Loquor de\n[[469.13]] motibus indeliberatis, non de liberis. </p>\n<p> [[469.14]] 2. Imperfectio corporea quae respondet imperfectioni animae infectae peccato originali,\n[[469.15]] negatio esse non potest, quia causat vere motus in natura lapsa non orituros in natura integra,\n[[469.16]] debet igitur esse substantia vel Entelechia, cum sit virtus agendi. </p>\n<p> [[469.17]] Contra profundam tuam definitionem perceptionis: <i>multorum in uno expressio</i>, occurrit 1^#'o\n[[469.18]] quod videantur aliquae perceptiones circa unum tantum objectum versari; quomodo ergo erunt\n[[469.19]] expressiones multorum? Adde quod creaturae irrationales non percipiant universalia. Ad quod\n[[469.20]] nihil requiri videtur quam ut haberent perceptiones multa in uno exprimentes. Denique si omnis\n[[469.21]] machina naturae Entelechiam habet perceptione praeditam, erit igitur animal. Quid enim est\n[[469.22]] aliud animal quam machina naturae habens Entelechiam perceptione praeditam? Alia quaedam\n[[469.23]] in mentem veniunt, quibus supersedeo quod mentem tuam non satis assecutum me censeam.\n[[469.24]] Vale, illustrissime Domine, mihique favere perge. Dabam Hildesiae 17 Septembris 1706 </p>\n<p> [[469.25]] Illustrissimae Dominationis tuae Humillimus et obedientissimus servus in Christo </p>\n<p> [[469.26]] Bartholomaeus Des Bosses S J </p>\n",
  "number": "144.",
  "title": "BARTHÉLEMY DES BOSSES AN LEIBNIZ",
  "date": "Hildesheim, 17. September 1706. [141.145.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:144. BARTHÉLEMY DES BOSSES AN LEIBNIZ Hildesheim, 17. September 1706. [141.145.] Illustrissime Domine P[ax] C[hristi] Mitto propositiones quas cupis, missurus etiam non petenti, ut tuum de reliquis judicium intelligam: tantum ne facile divulgentur. Valde mihi gratae fuerunt breves illae notae tuae; ...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>