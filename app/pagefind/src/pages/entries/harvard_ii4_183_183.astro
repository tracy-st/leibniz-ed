---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_183",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 183,
  "text": "<p> [[569.1]] <b>183. LEIBNIZ AN CHRISTIAN THOMASIUS</p>\n<p> [[569.2]]  Berlin, 25. Februar 1707. [182.] </b></p>\n<p> [[569.21]] Vir Amplissime et Excellentissime Fautor honoratissime </p>\n<p> [[569.22]] Inexpectata <Fn><i>In L^#'1 am Kopf der Seite von Leibniz' Hand</i>: A Monsieur Thomasius Conseiller du Roy de prusse et ICte celebre à Hall Berolin[i] circa finem Febr. 1707</Fn> literarum tuarum voluptate nihil mihi potuit esse gratius; tum quod multam\n[[569.23]] benevolentiae Tuae significationem continerent, tum quod rem novam et egregiam aperirent. </p>\n<p> [[570.1]] Inventum Tibi gratulor, nobis gaudeo, quem Freherus olim laudaverat <i>de Beneficiis</i>\n[[570.2]] veterem librum; et hortor ut quamprimum edas, neque enim unquam uspiam prodiisse puto. Et\n[[570.3]] qui potuit ille liber extare typis, et fugere tot egregios viros qui talia venati sunt? Nam de mea\n[[570.4]] quidem notitia nihil spondeo, etsi non fuerim talium incuriosus. Te certe video usum libris\n[[570.5]] optimis rarissimisque ut alio Nomenclatore vix opus habeas. Caeterum ex ipso opere indicia\n[[570.6]] aliqua eruptura puto, unde de tempore et patria scriptoris judicetur. Utrum scilicet scriptus sit\n[[570.7]] stante Carolingorum stirpe, et in Franciae orientalis an in Galliae regno. Operae etiam pretium\n[[570.8]] erit videre an aliquid, et quidnam de beneficiorum conservatione in familia constituatur, quam\n[[570.9]] jam longe ante Carolum M. receptam constat, ut non nisi magna ratione interrumperetur. </p>\n<p> [[570.10]] Etsi non omnes Tuas lucubrationes egregias, ita ut vellem, evolvere potuerim; complures\n[[570.11]] tamen inspexi cum voluptate et fructu. Et video Te non iisdem pertinaciter inhaerere opinionibus,\n[[570.12]] sed non raro ingenue profiteri, quid in melius mutandum putes. Memini me quoque olim\n[[570.13]] non raro mutare sententiam, donec visus sum constituisse in quibus quiescere possem. Et nunc\n[[570.14]] ipse mihi demonstrationum opinione blandior, quas aliquando in ordinem redigere cogito, ut\n[[570.15]] judicium insignium virorum experiar in quibus Te merito numero. Vale et fave. Dabam Berolini\n[[570.16]] 25 Febr. 1707 </p>\n<p> [[570.17]] deditissimus G. G. Leibnitius </p>\n<p> [[570.18]] P. S. Si quid jubes porro, recte ad me perveniret si sub operculo huc mittatur, ita inscripto:\n[[570.19]] <i>A Monsieur Monsieur Jablonski secretaire du Roy à Berlin</i> </p>\n",
  "number": "183.",
  "title": "LEIBNIZ AN CHRISTIAN THOMASIUS",
  "date": "Berlin, 25. Februar 1707. [182.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:183. LEIBNIZ AN CHRISTIAN THOMASIUS Berlin, 25. Februar 1707. [182.] Vir Amplissime et Excellentissime Fautor honoratissime Inexpectata In L^#'1 am Kopf der Seite von Leibniz' Hand: A Monsieur Thomasius Conseiller du Roy de prusse et ICte celebre à Hall Berolin[i] circa finem Febr. 1707 literarum tu...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii4_183","series":"Band II 4 (1701 - 1707)","seq":183,"text":"<p> [[569.1]] <b>183. LEIBNIZ AN CHRISTIAN THOMASIUS</p>\n<p> [[569.2]]  Berlin, 25. Februar 1707. [182.] </b></p>\n<p> [[569.21]] Vir Amplissime et Excellentissime Fautor honoratissime </p>\n<p> [[569.22]] Inexpectata <Fn><i>In L^#'1 am Kopf der Seite von Leibniz' Hand</i>: A Monsieur Thomasius Conseiller du Roy de prusse et ICte celebre à Hall Berolin[i] circa finem Febr. 1707</Fn> literarum tuarum voluptate nihil mihi potuit esse gratius; tum quod multam\n[[569.23]] benevolentiae Tuae significationem continerent, tum quod rem novam et egregiam aperirent. </p>\n<p> [[570.1]] Inventum Tibi gratulor, nobis gaudeo, quem Freherus olim laudaverat <i>de Beneficiis</i>\n[[570.2]] veterem librum; et hortor ut quamprimum edas, neque enim unquam uspiam prodiisse puto. Et\n[[570.3]] qui potuit ille liber extare typis, et fugere tot egregios viros qui talia venati sunt? Nam de mea\n[[570.4]] quidem notitia nihil spondeo, etsi non fuerim talium incuriosus. Te certe video usum libris\n[[570.5]] optimis rarissimisque ut alio Nomenclatore vix opus habeas. Caeterum ex ipso opere indicia\n[[570.6]] aliqua eruptura puto, unde de tempore et patria scriptoris judicetur. Utrum scilicet scriptus sit\n[[570.7]] stante Carolingorum stirpe, et in Franciae orientalis an in Galliae regno. Operae etiam pretium\n[[570.8]] erit videre an aliquid, et quidnam de beneficiorum conservatione in familia constituatur, quam\n[[570.9]] jam longe ante Carolum M. receptam constat, ut non nisi magna ratione interrumperetur. </p>\n<p> [[570.10]] Etsi non omnes Tuas lucubrationes egregias, ita ut vellem, evolvere potuerim; complures\n[[570.11]] tamen inspexi cum voluptate et fructu. Et video Te non iisdem pertinaciter inhaerere opinionibus,\n[[570.12]] sed non raro ingenue profiteri, quid in melius mutandum putes. Memini me quoque olim\n[[570.13]] non raro mutare sententiam, donec visus sum constituisse in quibus quiescere possem. Et nunc\n[[570.14]] ipse mihi demonstrationum opinione blandior, quas aliquando in ordinem redigere cogito, ut\n[[570.15]] judicium insignium virorum experiar in quibus Te merito numero. Vale et fave. Dabam Berolini\n[[570.16]] 25 Febr. 1707 </p>\n<p> [[570.17]] deditissimus G. G. Leibnitius </p>\n<p> [[570.18]] P. S. Si quid jubes porro, recte ad me perveniret si sub operculo huc mittatur, ita inscripto:\n[[570.19]] <i>A Monsieur Monsieur Jablonski secretaire du Roy à Berlin</i> </p>\n","number":"183.","title":"LEIBNIZ AN CHRISTIAN THOMASIUS","date":"Berlin, 25. Februar 1707. [182.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>