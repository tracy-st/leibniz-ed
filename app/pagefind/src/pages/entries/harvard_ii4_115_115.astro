---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii4_115",
  "series": "Band II 4 (1701 - 1707)",
  "seq": 115,
  "text": "<p> [[373.1]] <b>115. LEIBNIZ AN GIOVANNI BATTISTA TOLOMEI</p>\n<p> [[373.2]] Hannover, 6. Januar [1706]. [113.] </b></p>\n<p> [[373.19]] Hanoverae 6 Januar [1706] </p>\n<p> [[373.20]] R^#'m^#'e Pater </p>\n<p> [[373.21]] Cum <Fn><i>Am Kopf der Seite vom Leibniz' Hand</i>: R^#'m^#'o Patri Joh. Bapt. Ptolemaeo Societatis Jesu Theologo. Romam</Fn> nuper ad Te scriberem interturbantibus forte quibusdam negotiis omisisse me\n[[373.22]] animadverto nonnulla quibus responsum debebam quod huic velut appendici priorum literarum\n[[373.23]] insero. Etsi enim verear ne Tibi majoribus occupato intempestiva accidant negligentiae tamen\n[[373.24]] culpam evitandam mihi putavi: Cum penes Te sit differre in commodius tempus, quibus nunc\n[[373.25]] animum advertere non vacat. Consilium Tuum renovandi augendique Bellarminum magni\n[[373.26]] momenti est, ac Te inprimis dignum. Multa suppeditata sunt labentibus temporibus quae\n[[374.1]] Bellarmino deerant. Editi sunt scriptores ex Manuscriptis qui olim latebant, quaedam veterum\n[[374.2]] opera asserta suis autoribus aut abjudicata sunt non suis. Nova etiam lux passim textui sacro\n[[374.3]] affusa est. Doctrinae etiam ingeniosae neque plane spernendae emersere. Ut vestros taceam,\n[[374.4]] insignes quoque protestantium scriptores, Chamierus, Gerardus, Calixtus, Calovius, Dallaeus,\n[[374.5]] et ex Anglis non pauci nec proletarii, in arenam prodiere, non negligendi Bellarminum ad\n[[374.6]] nostra tempora accommodaturo. Ipse scriptor plerumque servat humanitatis leges. Interdum\n[[374.7]] tamen animo morem gerens vel exemplo aut adversariorum (ut fit) violentia stimulatus in\n[[374.8]] acriora verba erumpit; quae optem abesse. Ut cum mendacia, haereses, aliaque duriora dissentientibus\n[[374.9]] imputantur: quae etsi enim in iisdem partibus plausum inveniant, aliorum tamen\n[[374.10]] animos ita abalienant, ut non nisi animo contradicendi condemnandique legant. Ita potissimus\n[[374.11]] scriptorum polemicorum fundus corrumpitur, qui esse debebat controversiarum imminutio.\n[[374.12]] Ipsum Bellarminum quidam ex protestantibus strictim aggressi sunt. Amesii extat <i>Bellarminus\n[[374.13]] enervatus</i>, compendiarium opus, sed tamen consulendum. Mayerus nuper Hamburgensium\n[[374.14]] Ecclesiastes nunc Pomeranorum Antistes libellum de Bellarmino et Baronio ante aliquod annos\n[[374.15]] edidit, quem fortasse habetis Romae, et qui non inutiliter inspicietur. Autor enim multae est\n[[374.16]] lectionis. Notatum est a Viris doctis Germanicas Bellarminiani operis editiones a curatoribus\n[[374.17]] non parum immutatas esse praeter autoris mentem, inflexasque ad doctrinas quae tum emergebant,\n[[374.18]] et quibus non admodum favebat Bellarminus inde ipsum editiones eas non omnino pro\n[[374.19]] suis agnovisse. </p>\n<p> [[374.20]] Multum tibi debeo quod qualiacunque scripta mea curas. Adolescens (anno 1666) <i>de Arte\n[[374.21]] Combinatoria</i> diss. edidi, mox <i>Methodum discendae Jurisprudentiae</i> et <i>Hypothesin physicam\n[[374.22]] novam</i>, cujus mentionem fecit Honoratus Fabrius in Epistola quadam sua ad Pardiesium ni\n[[374.23]] fallor separatim edita. Ibi omnia phaenomena reducebam ad gravitatem, vim Elasticam et vim\n[[375.1]] directoriam. Sed haec juvenilia admodum et levia sunt. Circa res principum nonnulla scripsi\n[[375.2]] quibus nomen meum non est praefixum. Duobus voluminibus in 4^#'o edidi <i>Accessiones Historicas</i>\n[[375.3]] quibus continentur scriptores inediti Historici ex medio aevo, atque inter alios Albericus monachus\n[[375.4]] trium Fontium diu desideratus et multis ex Ms^#'o citatus veluti Chifletio et Blondello Antagonistis.\n[[375.5]] Burcardi diarium in Germania inveni, neque ut quidam apud vos sparsisse scribuntur\n[[375.6]] Romae habui: Editionem autoritati superiori negare non licuit. Et pleraque aliunde noscebantur. </p>\n<p> [[375.7]] Quantum ad philosophicas meas meditationes attinet, gaudeo Tanto judici esse perspectas,\n[[375.8]] nec damnatas. Quoniam inprimis animam bruti a spiritu bene distinguendam mones id est ut\n[[375.9]] arbitror perceptionem ab intellectu dicam me omnino vestris hic assentiri statuentem animas\n[[375.10]] non nisi sentientes animadversione sui suarumque operationum carere, mentem vero seu spiritum\n[[375.11]] et sui esse conscium, et quod hinc fluit universalium prorsus seu necessariarum veritatum\n[[375.12]] capacem. In caeteris animalibus transitiones a perceptione praeterita, ad repraesentationem\n[[375.13]] futurae similis consecutionis aliquam analogiam habent, sed non nisi exemplis prioribus\n[[375.14]] nituntur, minime vero propositionibus generalibus. Et homines ipsi quatenus non nisi Empirici\n[[375.15]] sunt animalium tantum more procedunt. Sed veritates aeternae et necessariae, quae solae\n[[376.1]] ­universalitatis perpetuae nos certos reddunt, adeoque etiam rationes et scientiae in bruta non\n[[376.2]] cadunt. Itaque falluntur plerumque animalia argumento a simili et exemplo quia rationes\n[[376.3]] examinare non possunt. Haec si considerassent qui de ratione Brutorum egere, non laborassent\n[[376.4]] tanquam in re ancipiti explicanda. Hinc etiam homo non tantum substantiam sed et personam\n[[376.5]] moralem servat, hoc est memoriam sui, ut in futura vita poenae praemiique sit capax. Caeterum\n[[376.6]] quod mentes creatas nunquam omni corpori exui et naturali cursu animal non oriri sed transformari\n[[376.7]] censeo paradoxotera videri poterunt sed fortasse non aeque Tibi ac multis aliis qui\n[[376.8]] magnas sententiae meae rationes non vident. Nec video quod inde incommodi. Et dicere licebit\n[[376.9]] in homine animam prius simplicem conceptu facto transcreari in rationalem seu in mentem, si\n[[376.10]] quis animam rationalem diu expertem exercitii <angle bracket>exaltarum</angle bracket> ratiocinationum ferre nequit. Fortasse\n[[376.11]] cogar aliquid edere de libertate, fato, praedestinatione et gratia Theologis etiam petentibus,\n[[376.12]] ubi mihi videntur minui admodum controversiae posse, et quae supersunt pertinentque ad <greek>tò\n[[376.13]] báuow</greek> in infiniti contemplationem resolvi, ubi quiescendum est humanae menti. Vale etc. </p>\n",
  "number": "115.",
  "title": "LEIBNIZ AN GIOVANNI BATTISTA TOLOMEI",
  "date": "Hannover, 6. Januar [1706]. [113.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:115. LEIBNIZ AN GIOVANNI BATTISTA TOLOMEI Hannover, 6. Januar [1706]. [113.] Hanoverae 6 Januar [1706] R^#'m^#'e Pater Cum Am Kopf der Seite vom Leibniz' Hand: R^#'m^#'o Patri Joh. Bapt. Ptolemaeo Societatis Jesu Theologo. Romam nuper ad Te scriberem interturbantibus forte quibusdam negotiis omisiss...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>