        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <div class="entry-content" data-pagefind-meta="excerpt:83. LEIBNIZ AN ISAAC JAQUELOT Berlin, 4. September 1704. [69.85.] Berlin 4 Septembr. 1704 Remarque sur l'Appendice du Traité de Mons. Jaquelot de la conformité de la foy et de la raison; qui est intitulé: Systeme abregé de l'Ame et de la liberté. Je ne croyois pas, Monsieur, vous avoir donné sujet d...">
      <div class="text-content">
        {entry.text.split('\n').map(paragraph =>
          paragraph.trim() && <p set:html={paragraph} />
        )}
      </div>
    </div>
  </article>

