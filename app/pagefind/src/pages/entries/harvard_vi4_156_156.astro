import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_156",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 156,
  "text": "[[538.1]] <b>129.  De Synthesi et Analysi universali seu Arte inveniendi et judicandi [Sommer 1683 bis Anfang 1685 (?)]</b>\n [[538.3]] <tab/>[Sommer 1683 bis Anfang 1685 (?)]\n[[538.16]] <tit2><b>De Synthesi et Analysi universali seu Arte inveniendi et judicandi</b> </tit2> </p>\n<p> [[538.17]] Cum puer Logicam discerem, et solerem jam tum altius inquirere in rationes eorum\n[[538.18]] quae mihi proponebantur, objiciebam praeceptoribus, cur non, ut praedicamenta habentur\n[[538.19]] terminorum incomplexorum, quibus ordinantur notiones; ita et praedicamenta fierent\n[[538.20]] terminorum complexorum, quibus ordinarentur veritates; ignorabam scilicet hoc ipsum\n[[538.21]] facere Geometras, cum demonstrant, et propositiones ita collocant, prout aliae ex aliis\n[[538.22]] dependent. Videbatur autem mihi res universaliter fore in potestate, si haberentur prius\n[[538.23]] praedicamenta vera simplicium terminorum et ad ea obtinenda constitueretur quoddam\n[[538.24]] velut Alphabetum cogitandi, seu catalogus summorum (vel pro summis assumtorum)\n[[538.25]] generum, ut <i>a</i>, <i>b</i>, <i>c</i>, <i>d</i>, <i>e</i>, <i>f</i>, ex quorum combinatione fierent inferiores notiones. Sciendum\n[[539.1]] enim est genera sibi mutuo differentias praestare; omnemque differentiam posse concipi\n[[539.2]] ut genus et omne genus ut differentiam; et tam recte dici <i>animal rationale</i>, quam si\n[[539.3]] fingere licet, <i>rational animale</i>. Cum vulgaria vero genera species sua combinatione non\n[[539.4]] exhibeant, concludebam non recte constituta esse. Et quidem genera summis proxime\n[[539.5]] inferiora, forent biniones: ut <i>ab</i>, <i>ac</i>, <i>bd</i>, <i>cf</i>. Genera tertii gradus forent terniones, ut <i>abc</i>,\n[[539.6]] <i>bdf</i>, et ita porro. Quod si summa genera, vel pro summis assumta essent infinita, ut in\n[[539.7]] numeris (ubi numeri primitivi possunt assumi pro summis generibus, nam omnes pares\n[[539.8]] possunt dici binarii, omnes per tres divisibiles possunt dici ternarii, et ita porro, et\n[[539.9]] numerus derivativus exprimi potest per primitivos tanquam genera, ita senarius omnis est\n[[539.10]] binarius ternarius), saltem ordo summorum generum, ut in numeris esset constituendus,\n[[539.11]] et ita ordo quoque appareret in inferioribus. Et proposita qualibet specie ordine enumerari\n[[539.12]] possent propositiones de ea demonstrabiles, seu praedicata tam latiora, quam convertibilia,\n[[539.13]] ex quibus memorabiliora seligi possent. Si enim sit species <i>y</i>; cujus notio <i>abcd</i>; et\n[[539.14]] pro <i>ab</i> ponatur <i>l</i>; pro <i>ac</i>, <i>m</i>; pro <i>ad</i>, <i>n</i>; pro <i>bc</i>, <i>p</i>; pro <i>bd</i>, <i>q</i>; pro <i>cd</i>, <i>r</i>. Quae sunt biniones:\n[[539.15]] Rursus terniones, pro <i>abc</i>, <i>s</i>; pro <i>abd</i>, <i>v</i>; pro <i>acd</i>, <i>w</i>; pro <i>bcd</i>, <i>x</i>. Ista quidem omnia erunt\n[[539.16]] praedicata ipsius <i>y</i>, sed praedicata convertibilia ipsius <i>y</i> erunt tantum haec: <i>ax</i>, <i>bw</i>, <i>cv</i>, <i>ds</i>;\n[[539.17]] <i>lr</i>, <i>mq</i>, <i>np</i>. De quibus plura dixi in Dissertatiuncula <i>De Arte Combinatoria</i>, quam vix ex\n[[539.18]] Ephebis egressus edidi, cum nondum opus Kircherianum ejusdem tituli dudum promissum\n[[539.19]] prodisset, in quo sperabam talia constitutum iri, sed postea cum prodisset, vidi\n[[539.20]] Lulliana tantum aut his similia in eo renovari, Analysin autem humanarum cogitationum\n[[539.21]] veram nec per somnium autori in mentem venisse, quemadmodum nec aliis qui tamen de\n[[539.22]] restauranda philosophia cogitarunt. Primae notiones quarum combinatione fiunt caeterae\n[[540.1]] aut sunt distinctae aut confusae; distinctae quae per se intelliguntur, ut <i>Ens</i>; confusae (et\n[[540.2]] tamen clarae) quae per se percipiuntur, ut <i>coloratum</i>, quod non possumus alteri explicare\n[[540.3]] nisi monstrando, nam etsi sua natura sit resolubile cum causam habeat, nullis tamen notis\n[[540.4]] separatim explicabilibus describi agnoscique satis potest a nobis, sed confuse tantum\n[[540.5]] cognoscitur nec proinde <b>definitionem</b> capit <b>nominalem</b>. Nominalis definitio\n[[540.6]] consistit in enumeratione notarum, seu requisitorum ad rem ab aliis omnibus distinguendam\n[[540.7]] sufficientium, ubi si requisita requisitorum semper quaerantur, veniendum erit tandem\n[[540.8]] ad notiones primitivas quae requisitis (vel absolute, vel a nobis satis explicabilibus)\n[[540.9]] carent. Quae est ars tractandi notiones distinctas. Ad artem vero confusas notiones\n[[540.10]] tractandi pertinet, notare distinctas vel per se intellectas vel saltem resolubiles, quae\n[[540.11]] confusas illas comitantur. Quarum ope possumus aliquando ad confusarum causam sive\n[[540.12]] resolutionem aliquam pervenire. </p>\n<p> [[540.13]] Porro omnes Notiones derivatae oriuntur ex combinatione primitivarum, et decompositae\n[[540.14]] ex combinatione compositarum, verum cavendum est, ne combinationes fiant\n[[540.15]] inutiles, conjungendo ea quae sunt incompatibilia inter se, quod non nisi experimento vel\n[[540.16]] resolutione in distinctas simplices judicari potest. Id vero in definitionibus realibus\n[[540.17]] condendis diligenter observandum est, ut constet esse possibiles seu notiones ex quibus\n[[540.18]] constant inter se conjungi posse. Hinc etsi omnis proprietas rei convertibilis haberi possit\n[[540.19]] pro aliqua definitione nominali, quoniam semper omnia alia rei attributa ex ea possunt\n[[541.1]] demonstrari, tamen ad definitionem realem non semper apta est. Notavi enim esse\n[[541.2]] quasdam proprietates quas voco paradoxas, de quibus dubitari potest an sint possibiles,\n[[541.3]] exempli gratia dubitari potest an detur curva, cujus segmenti cujusque punctum quodcunque\n[[541.4]] duo segmenti sui extrema eodem angulo respiciat. Ponamus enim, nos puncta\n[[541.5]] curvae pro uno segmento ita accommodasse, utique praevidere nondum possumus id\n[[541.6]] quod felici quodam casu tantum alicubi successum videri possit, an eadem puncta in aliud\n[[541.7]] segmentum incidentia rursus satisfaciant, jam enim determinata sunt, nec amplius assumi\n[[541.8]] possunt. Et tamen scimus hanc esse naturam circuli, itaque etsi quis posset nomen\n[[541.9]] imponere curvae illam proprietatem habenti, tamen non constaret an esset possibilis, nec\n[[541.10]] proinde an definitio esset realis. Sed notio circuli ab Euclide proposita, quod sit figura\n[[541.11]] descripta motu rectae in plano circa extremum immotum; definitionem praebet realem,\n[[541.12]] patet enim talem figuram esse possibilem. Hinc utile est habere definitiones involventes\n[[541.13]] rei generationem vel saltem, si ea caret, constitutionem hoc est modum quo vel producibilem\n[[541.14]] vel saltem possibilem esse apparet. Hac observatione olim usus sum in examinanda\n[[541.15]] imperfecta demonstratione existentiae Dei, quam Cartesius attulit, de qua saepe\n[[541.16]] cum doctissimis Cartesianis etiam scripto disputavi. Cartesius enim ita argumentabatur.\n[[541.17]] Quicquid ex rei definitione demonstrari potest, illud de ea potest praedicari. Ex definitione\n[[541.18]] autem Dei (quod sit Ens summe perfectum, seu ut Scholastici quidam efferebant,\n[[541.19]] quo majus cogitari non potest), sequitur Existentia (nam existentia est perfectio, et id\n[[541.20]] ipsum quod praeterea existentiam involvit, utique foret majus seu perfectius). Ergo\n[[541.21]] Existentia de Deo potest praedicari, seu Deus existit. Hoc argumentum a Cartesio renovatum,\n[[541.22]] peculiari libro (<i>Contra insipientem</i> inscripto) quidam ex Scholasticis veteribus\n[[542.1]] defenderat, sed respondit post alios Thomas, id supponere Deum esse; seu ut ego interpretor,\n[[542.2]] essentiam habere, saltem qualis est rosae in hyeme, seu talem conceptum esse\n[[542.3]] possibilem. Hoc igitur est privilegium Entis perfectissimi, ut posito id esse possibile,\n[[542.4]] statim sequatur existere, seu ut ex ejus essentia sive conceptu possibili sequatur existentia.\n[[542.5]] Sed si rigorosa debet esse haec demonstratio, praedemonstranda est possibilitas. Et\n[[542.6]] scilicet non possumus de ulla Notione secure texere demonstrationes, nisi sciamus eam\n[[542.7]] esse possibilem, nam de impossibilibus seu contradictionem involventibus etiam contradictoria\n[[542.8]] possunt demonstrari, quae est ratio a priori cur ad definitionem realem requiratur\n[[542.9]] possibilitas. Unde etiam satisfit difficultati Hobbesianae; Hobbesius scilicet cum\n[[542.10]] videret omnes veritates posse demonstrari ex definitionibus, autem omnes definitiones\n[[542.11]] esse arbitrarias et nominales crederet, quia in arbitrio est nomina rebus imponere, volebat\n[[542.12]] et veritates in nominibus consistere, et arbitrarias esse. Sed sciendum est, non posse pro\n[[542.13]] arbitrio conjungi notiones, sed debere ex iis conceptum formari possibilem, ut habeatur\n[[542.14]] definitio realis; unde patet omnem realem definitionem continere affirmationem aliquam\n[[542.15]] saltem possibilitatis; deinde etsi nomina sint arbitraria, tamen iis semel positis consequentiae\n[[542.16]] sunt necessariae et oriuntur veritates quaedam, quae etsi ex characteribus impositis\n[[542.17]] pendeant, tamen reales sunt, ex. g. probatio per abjectionem novenarii pendet a\n[[542.18]] characteribus impositis progressionis decadicae, et tamen realem continet veritatem.\n[[542.19]] Hypothesin porro condere seu modum producendi explicare, nihil aliud est quam\n[[542.20]] demonstrare rei possibilitatem, quod utile est, etsi saepe res oblata tali modo generata non\n[[542.21]] sit; eadem enim ellipsis vel in plano ope duorum focorum et fili circumligati descripta,\n[[542.22]] vel ex cono, vel ex cylindro secta intelligi potest; et una reperta hypothesi seu modo\n[[542.23]] generandi habetur aliqua definitio realis, unde etiam aliae duci possunt, ex quibus deligantur\n[[542.24]] quae caeteris rebus magis consentaneae sint, quando modus quo res actu producta\n[[542.25]] est quaeritur. Porro ex definitionibus realibus illae sunt perfectissimae, quae omnibus\n[[542.26]] hypothesibus seu generandi modis communes sunt, causamque proximam involvunt,\n[[543.1]] denique ex quibus possibilitas rei immediate patet, nullo scilicet praesupposito experimento,\n[[543.2]] vel etiam nulla supposita demonstratione possibilitatis alterius rei, hoc est, cum\n[[543.3]] res resolvitur in meras notiones primitivas per se intellectas; qualem cognitionem soleo\n[[543.4]] appellare adaequatam seu intuitivam. Ita enim si qua esset repugnantia, statim appareret,\n[[543.5]] quia nulla amplius locum habet resolutio. </p>\n<p> [[543.6]] Ex ideis porro istis sive definitionibus omnes veritates demonstrari possunt, exceptis\n[[543.7]] propositionibus identicis, quas patet sua natura indemonstrabiles esse, et vere axiomata\n[[543.8]] dici posse, vulgaria autem axiomata, resolutione vel subjecti vel praedicati, vel utriusque\n[[543.9]] ad identica revocantur sive demonstrantur, ut contrarium supponendo appareat idem\n[[543.10]] simul esse et non esse. Unde patet ostensivam et apagogicam demonstrationem in ultima\n[[543.11]] analysi coincidere, et recte Scholasticis quoque notatum, omnia axiomata intellectis\n[[543.12]] terminis revocari ad principium contradictionis; itaque cujuscunque veritatis reddi potest\n[[543.13]] ratio, connexio enim praedicati cum subjecto aut per se patet, ut in identicis, aut explicanda\n[[543.14]] est, quod fit resolutione terminorum. Atque hoc unicum summumque est veritatis\n[[543.15]] criterium, in abstractis scilicet neque ab experimento pendentibus, ut sit vel identica vel\n[[543.16]] ad identicas revocabilis. Et hinc duci possunt Elementa veritatis aeternae, methodusque in\n[[543.17]] omnibus, modo intelligantur, aeque demonstrative procedendi, ac in Geometria. Quo\n[[543.18]] modo omnia intelliguntur a Deo a priori et per modum aeternae veritatis, quia ipse\n[[543.19]] experimento non indiget; et quidem ab illo omnia adaequate, a nobis vix ulla adaequate,\n[[543.20]] pauca a priori, pleraque experimento cognoscuntur, in quibus postremis alia principia\n[[543.21]] aliaque criteria sunt adhibenda. In rebus ergo facti sive contingentibus quae non a ratione\n[[543.22]] sed observatione sive experimento pendent, primae veritates (quoad nos) sunt, quaecunque\n[[543.23]] immediate intra nos percipimus seu quorum nobis de nobis conscii sumus, haec enim\n[[543.24]] per alia experimenta nobis propiora magisque intrinseca probari impossibile est. Percipio\n[[543.25]] autem intra me, non tantum me ipsum qui cogito, sed et multas in cogitationibus meis\n[[543.26]] differentias, ex quibus alia praeter me esse colligo, et sensibus paulatim fidem concilio,\n[[544.1]] Scepticisque occurro, nam in talibus, quae non sunt metaphysicae necessitatis, pro veritate\n[[544.2]] habendus est nobis consensus phaenomenorum inter se, qui temere non fiet, sed\n[[544.3]] causam habebit, certe nec somnium a vigilia, nisi hoc phaenomenorum consensu distinguimus,\n[[544.4]] nec cras solem oriturum praedicimus, nisi quia toties fidem implevit. Huc facit\n[[544.5]] magna vis autoritatis et testimonii publici, cum plures ad fallendum conspirare credibile\n[[544.6]] non est, quibus addi possunt quae S. Augustinus <i>De utilitate credendi</i> dixit. Constituta\n[[544.7]] jam et sensuum et aliorum testium autoritate condenda est Historia phaenomenorum,\n[[544.8]] quibus si jungantur veritates abstractae ab experimentis, hinc Scientiae mixtae formantur.\n[[544.9]] Opus est autem arte singulari et ad facienda, et ad ordinanda, et ad conjungenda\n[[544.10]] experimenta, ut inde fiant inductiones utiles, causaeque reperiantur; et constituantur\n[[544.11]] aphorismi ac praenotiones. Sed admiranda est hominum negligentia, nugis vacantium\n[[544.12]] negligentiumque quibus sanitati ac saluti consulere possent, cum fortasse magnae malorum\n[[544.13]] parti remedia in potestate haberent, si jam datis copiosissimis hujus seculi observationibus\n[[544.14]] veraque analysi recte uterentur. Nunc humana naturae cognitio mihi tabernae\n[[544.15]] similis videtur, omnigenis mercibus instructissimae, sed ordine et repertorio carenti. </p>\n<p> [[544.16]] Porro ex istis apparet quoque quale sit discrimen syntheseos et analyseos. Synthesis\n[[544.17]] est cum a principiis inchoando, et ordine veritates percurrendo progressiones quasdam\n[[544.18]] deprehendimus et velut Tabulas vel etiam interdum formulas generales condimus, in\n[[544.19]] quibus postea oblata inveniri possint. Analysis vero solius oblati problematis causa ad\n[[544.20]] principia regreditur, perinde ac si nihil antea inventum jam a nobis vel aliis haberetur.\n[[544.21]] Praestantius est synthesin condere, quia is labor in perpetuum valet, cum analysin ob\n[[544.22]] singularia problemata instituendo saepe actum agamus; sed condita ab aliis synthesi\n[[544.23]] inventisque theorematis uti minoris artis est, quam analysin exercendo omnia per se\n[[544.24]] praestare posse, praesertim cum aliorum vel nostra ipsorummet inventa non semper\n[[544.25]] occurrant aut sint ad manum. Duplex est analysis, una communis per saltum qua utuntur\n[[544.26]] in Algebra, altera peculiaris quam voco reductricem, quae longe elegantior est, sed parum\n[[544.27]] cognita. Analysis praxi magis necessaria est, ut oblata problemata solvamus; at qui\n[[545.1]] theoriae indulgere potest, contentus analysin hactenus exercere, ut artem analyticam in\n[[545.2]] potestate habeat, de caetero potius synthesin prosequetur, nec quaestiones facile attinget,\n[[545.3]] nisi ad quas eum ipse ordo ducet, sic enim semper jucunde et facile progredietur, nec\n[[545.4]] unquam difficultates sentiet, aut successu frustrabitur, et brevi tempore ad multo majora\n[[545.5]] enitetur, quam ipse unquam initio sperasset. Vulgo autem fructum meditationum festinando\n[[545.6]] corrumpunt, dum ad quaestiones difficiliores per saltum contendunt, magnoque\n[[545.7]] labore nihil agunt. Sciendum est illam methodum inquirendi demum perfectam esse, cum\n[[545.8]] praevidere possumus, utrum nos ad exitum sit perductura. Errant vero qui putant analytice\n[[545.9]] scribi cum detegitur, synthetice cum supprimitur origo inventionis. Saepe notavi\n[[545.10]] ingenia inventionis capacia, alia magis analytica, alia magis combinatoria esse. Combinatorium\n[[545.11]] magis est sive syntheticum alicujus rei usum et applicationem invenire, ut data\n[[545.12]] acu magnetica cogitare de applicatione ad pyxidem. Contra magis analyticum est dato\n[[545.13]] titulo inventionis, seu proposito fine, invenire media. Raro tamen pura est analysis,\n[[545.14]] plerumque enim media quaerendo incidimus in artificia ab aliis vel a nobis sive casu sive\n[[545.15]] ratione jam olim inventa, quae sive in memoria nostra, sive in aliorum relationibus,\n[[545.16]] tanquam in Tabula vel repertorio deprehendimus, atque huc applicamus, quod syntheticum\n[[545.17]] est. Caeteroqui Ars Combinatoria speciatim mihi illa est scientia (quae etiam\n[[545.18]] generaliter characteristica, sive <b>speciosa</b> dici posset), in qua tractatur de rerum formis\n[[545.19]] sive formulis in universum, hoc est de <b>qualitate</b> in genere sive de simili et dissimili,\n[[545.20]] prout aliae atque aliae formulae ex ipsis <i>a</i>, <i>b</i>, <i>c</i> etc. (sive quantitates sive aliud quoddam\n[[545.21]] repraesentent) inter se combinatis oriuntur, et distinguitur ab Algebra quae agit de\n[[545.22]] formulis ad <b>quantitatem</b> applicatis, sive de aequali et inaequali, itaque Algebra subordinatur\n[[545.23]] Combinatoriae, ejusque regulis continue utitur, quae tamen longe generaliores\n[[545.24]] sunt, nec in Algebra tantum, sed et in arte deciphratoria, in variis ludorum generibus, in\n[[545.25]] ipsa geometria lineariter ad veterum morem tractata, denique in omnibus ubi similitudinis\n[[545.26]] ratio habetur locum habent. </p>\n",
  "number": "129.",
  "title": "De Synthesi et Analysi universali seu Arte inveniendi et judicandi",
  "date": "[Sommer 1683 bis Anfang 1685 (?)]"
};
