---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_55",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 55,
  "text": "<p> [[156.12]] <b>55. LEIBNIZ AN FRANCISCUS MERCURIUS VAN HELMONT</p>\n<p> [[156.13]] [Hannover, vor dem 17. April 1696.] [80.]</b></p>\n\n<p> [[156.15]] <i>L</i>Konzept: LBr 389, Bl. 24. 1 Bl. 4^#'o. 2 S. (Unsere Druckvorlage.) </p>\n<p> [[156.16]] <i>A</i>Abschrift von <i>L</i> von Schreiberhand: LBr 389, Bl. 23 u. 25. 1 Bog. 2^#'o. 3 ^#'1/₄ S. </p>\n<p> [[157.16]] Monsieur </p>\n<p> [[157.17]] Je <Fn><i>Am Kopf der Seite von Leibniz' Hand</i>: A Monsieur le Baron François Mercure d'Helmont presentement à Berlin.</Fn> ne prendrois pas facilement la liberté de Vous écrire, si la cy jointe ne m'y obligeoit.\n[[157.18]] Ce n'est pas que je ne tiendrois à grand honneur d'avoir l'avantage de vostre commerce, mais\n[[157.19]] ne sçachant point vos manieres et maximes là dessus, je n'osois point vous le demander de peur\n[[157.20]] d'importunité; bien que je souhaitte d'apprendre souvent des nouvelles de vostre santé et de\n[[157.21]] vostre satisfaction, que vous aurés trouvé sans doute à la cour où vous estes et où je souhaiterois\n[[157.22]] que vous vous puissiés arrester encore quelque temps, sur tout dans cette saison si rude et si\n[[157.23]] incommode pour les voyages. </p>\n<p> [[157.24]] La lettre que je vous envoye, Monsieur, est de Monsieur Knorr de Rosenroth fils de feu\n[[157.25]] Monsieur le directeur de Sulsbach, qui estoit vostre digne ami, et encore le mien. Ce jeune\n[[157.26]] Monsieur Knorr est gentilhomme de la Cour de Wolfenbutel. Je voy par celle qu'il m'écrit en\n[[158.1]] même temps, qu'il vous croyoit encore à Hanover, et il me fait sçavoir par ordre de Monseigneur\n[[158.2]] le duc Antoine Ulric, que S.A.S. souhaiteroit de vous voir et entretenir. Je me souviens,\n[[158.3]] de vous avoir dit icy, Monsieur, quoyque de moy même, que vous feriés sans doute un plaisir\n[[158.4]] singulier, à ce Prince, si vous passiés chez luy. Et je voy de n'avoir pas mal deviné. Cependant\n[[158.5]] vostre voyage de Berlin en aussi bonne compagnie que celle que vous avés eue, ne vous ayant\n[[158.6]] pas permis d'aller cette fois à Wolfenbutel, j'espere que ce sera une autre fois, lors que vous\n[[158.7]] repasserés chez nous. Je souhaitte, que vous le fassiés en bonne santé aussi tost que vostre\n[[158.8]] commodité le permettra, et que nous puissions jouir de vostre conversation des années entieres.\n[[158.9]] Madame l'Electrice de Bronsvic ne sçauroit recevoir un plus grand plaisir, puisque le Souvenir\n[[158.10]] même du peu de temps, que vous avés esté icy luy est agreable. Il est vray, qu'elle sera toujours\n[[158.11]] contente de le partager avec Madame l'Electrice de Brandebourg, qui n'a pas moins de goust\n[[158.12]] pour les choses et pour les personnes excellentes. </p>\n<p> [[158.13]] Au reste je me rapporte à nos discours, et je seray bien aise d'apprendre que vous ayiés\n[[158.14]] pris la resolution de communiquer bientost au monde quelques unes de vos belles et importantes\n[[158.15]] pensées. Et je suise avec zele </p>\n<p> [[158.16]] Monsieur vostre tres humble et tres obeissant serviteur Leibniz </p>\n<p> [[158.17]] P.S. Si vous vouliés m'honnorer de quelques ordres pour Mr Knorr ou pour quelque autre\n[[158.18]] sujet, Monsieur le Secretaire Heusch, qui est à Berlin de la part de nostre Cour le pourroit faire\n[[158.19]] tenir. </p>\n",
  "number": "55.",
  "title": "LEIBNIZ AN FRANCISCUS MERCURIUS VAN HELMONT",
  "date": "[Hannover, vor dem 17. April 1696.] [80.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:55. LEIBNIZ AN FRANCISCUS MERCURIUS VAN HELMONT [Hannover, vor dem 17. April 1696.] [80.] LKonzept: LBr 389, Bl. 24. 1 Bl. 4^#'o. 2 S. (Unsere Druckvorlage.) AAbschrift von L von Schreiberhand: LBr 389, Bl. 23 u. 25. 1 Bog. 2^#'o. 3 ^#'1/₄ S. Monsieur Je Am Kopf der Seite von Leibniz' Hand: A Monsie...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii3_55","series":"Band II 3 (1695 - 1700)","seq":55,"text":"<p> [[156.12]] <b>55. LEIBNIZ AN FRANCISCUS MERCURIUS VAN HELMONT</p>\n<p> [[156.13]] [Hannover, vor dem 17. April 1696.] [80.]</b></p>\n\n<p> [[156.15]] <i>L</i>Konzept: LBr 389, Bl. 24. 1 Bl. 4^#'o. 2 S. (Unsere Druckvorlage.) </p>\n<p> [[156.16]] <i>A</i>Abschrift von <i>L</i> von Schreiberhand: LBr 389, Bl. 23 u. 25. 1 Bog. 2^#'o. 3 ^#'1/₄ S. </p>\n<p> [[157.16]] Monsieur </p>\n<p> [[157.17]] Je <Fn><i>Am Kopf der Seite von Leibniz' Hand</i>: A Monsieur le Baron François Mercure d'Helmont presentement à Berlin.</Fn> ne prendrois pas facilement la liberté de Vous écrire, si la cy jointe ne m'y obligeoit.\n[[157.18]] Ce n'est pas que je ne tiendrois à grand honneur d'avoir l'avantage de vostre commerce, mais\n[[157.19]] ne sçachant point vos manieres et maximes là dessus, je n'osois point vous le demander de peur\n[[157.20]] d'importunité; bien que je souhaitte d'apprendre souvent des nouvelles de vostre santé et de\n[[157.21]] vostre satisfaction, que vous aurés trouvé sans doute à la cour où vous estes et où je souhaiterois\n[[157.22]] que vous vous puissiés arrester encore quelque temps, sur tout dans cette saison si rude et si\n[[157.23]] incommode pour les voyages. </p>\n<p> [[157.24]] La lettre que je vous envoye, Monsieur, est de Monsieur Knorr de Rosenroth fils de feu\n[[157.25]] Monsieur le directeur de Sulsbach, qui estoit vostre digne ami, et encore le mien. Ce jeune\n[[157.26]] Monsieur Knorr est gentilhomme de la Cour de Wolfenbutel. Je voy par celle qu'il m'écrit en\n[[158.1]] même temps, qu'il vous croyoit encore à Hanover, et il me fait sçavoir par ordre de Monseigneur\n[[158.2]] le duc Antoine Ulric, que S.A.S. souhaiteroit de vous voir et entretenir. Je me souviens,\n[[158.3]] de vous avoir dit icy, Monsieur, quoyque de moy même, que vous feriés sans doute un plaisir\n[[158.4]] singulier, à ce Prince, si vous passiés chez luy. Et je voy de n'avoir pas mal deviné. Cependant\n[[158.5]] vostre voyage de Berlin en aussi bonne compagnie que celle que vous avés eue, ne vous ayant\n[[158.6]] pas permis d'aller cette fois à Wolfenbutel, j'espere que ce sera une autre fois, lors que vous\n[[158.7]] repasserés chez nous. Je souhaitte, que vous le fassiés en bonne santé aussi tost que vostre\n[[158.8]] commodité le permettra, et que nous puissions jouir de vostre conversation des années entieres.\n[[158.9]] Madame l'Electrice de Bronsvic ne sçauroit recevoir un plus grand plaisir, puisque le Souvenir\n[[158.10]] même du peu de temps, que vous avés esté icy luy est agreable. Il est vray, qu'elle sera toujours\n[[158.11]] contente de le partager avec Madame l'Electrice de Brandebourg, qui n'a pas moins de goust\n[[158.12]] pour les choses et pour les personnes excellentes. </p>\n<p> [[158.13]] Au reste je me rapporte à nos discours, et je seray bien aise d'apprendre que vous ayiés\n[[158.14]] pris la resolution de communiquer bientost au monde quelques unes de vos belles et importantes\n[[158.15]] pensées. Et je suise avec zele </p>\n<p> [[158.16]] Monsieur vostre tres humble et tres obeissant serviteur Leibniz </p>\n<p> [[158.17]] P.S. Si vous vouliés m'honnorer de quelques ordres pour Mr Knorr ou pour quelque autre\n[[158.18]] sujet, Monsieur le Secretaire Heusch, qui est à Berlin de la part de nostre Cour le pourroit faire\n[[158.19]] tenir. </p>\n","number":"55.","title":"LEIBNIZ AN FRANCISCUS MERCURIUS VAN HELMONT","date":"[Hannover, vor dem 17. April 1696.] [80.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>