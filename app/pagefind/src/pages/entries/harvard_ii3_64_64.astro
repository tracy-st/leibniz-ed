---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii3_64",
  "series": "Band II 3 (1695 - 1700)",
  "seq": 64,
  "text": "<p> [[173.21]] <b>64. MICHEL ANGELO FARDELLA AN LEIBNIZ</p>\n<p> [[173.22]] Padua, 20. Juni [1696]. [61.69.]</b></p>\n\n<p> [[174.6]] Ill^#'m^#'o Sig^#'r^#'e, Sig^#'r^#'e, mio Padron Col^#'m^#'o </p>\n<p> [[174.7]] Sul dubio che le lettere inviate da me a V. S. Ill^#'m^#'a possano essere smarrite, torno con\n[[174.8]] questa a darle parte di quanto l' hò per le mie participato. Dal mese di Novembre passato le\n[[174.9]] scrissi una lunghissima lettera accompagnata da un grosso fagotto di manoscritti rari, ed antichi\n[[174.10]] spettanti alle famiglie antiche padovane, ed Istoria di Padova con alcuni libretti curiosi così\n[[174.11]] italiani, come spagnuoli e fra gl'altri vi era un bell^#'m^#'o Trattatino del Turbine composto dal Sig^#'r^#'e\n[[174.12]] Montanari, che occupava il posto in cui io presentemente mi trovo. Queste cose per disgratia\n[[174.13]] sono rimaste in Salisburgo impegnate in un'Osteria. Per ricuperarli inviai a V. S. Ill^#'m^#'a una\n[[174.14]] lettera diretta ad un Canonico di Salisburgo. L' hò ancora dato parte come coll'occasione che si\n[[174.15]] è formato il processo della Beatificatione della Beata Elena Enselmini Nobile Padovana che\n[[174.16]] mori l'anno 1242, hò havuto la fortuna di scuoprire alcuni vecchi Manoscritti molto rari, ed a\n[[174.17]] proposito per il disegno di V. S. Ill^#'m^#'a, e doppo molte diligenze hò trovato l'Istoria cronologica\n[[174.18]] in foglio di Guglielmo Ongarello, custodita con infinita gelosia dal Nobile Uomo Pappafava, e\n[[174.19]] Sig^#'r^#'e Abbate Zacco, se n'è copiata la maggiore parte, però l'altro giorno sono stato in necessità\n[[174.20]] di restituirlo, colla promessa però di farmelo di nuovo havere per compire la copia. Spero anche\n[[174.21]] quando V. S. Ill^#'m^#'a mel[o] comandasse havere tre altri manoscritti Cronologici cioe, Giovanni di\n[[174.22]] Nono, Fava Foschi, ed il libro della Casa Carrarese del Vergerio, come anche una copia del\n[[174.23]] <i>Chronicon Monachi Paduani</i>, rarissimo, che incomincia dalli Marchesi d'Este. Giacché doppo\n[[174.24]] molti anni di ricerca mi si è finalmente aperta la congiuntura di servirla, la priego di significarmi\n[[174.25]] il suo bisogno, che farò tutto per sodisfare il suo desiderio col solo oggetto di farle\n[[175.1]] conoscere, che non mi scordo de' suoi comandi, e tengo viva la memoria delle sue gratie. Io mi\n[[175.2]] apparecchio a stampare il mio libro sopra il trattato di Sant'Agostino <i>De Animae Quantitate</i>.\n[[175.3]] Qui presto sì publicarà l'Opera del Sig^#'r^#'e Scala Siciliano mio Amico, come ella vedera nell'incluso\n[[175.4]] foglio, che stampato, se mel[o] comandarà, subito le lo mandarò. M'ami, e si persuada\n[[175.5]] che costante sono </p>\n<p> [[175.6]] Il Suo Cord^#'m^#'o ed Obl^#'m^#'o Michel Angelo Fardella </p>\n<p> [[175.7]] Padova 20 Giugno.\n[[175.8]] <yi>All'Ill^#'m^#'o Sig^#'r^#'e, Sig^#'r^#'e, mio Padron Col^#'m^#'o Il Sig^#'r^#'e Leibniz Consigliere di S. A. E. <b>Hannover</b> </p>\n",
  "number": "64.",
  "title": "MICHEL ANGELO FARDELLA AN LEIBNIZ",
  "date": "Padua, 20. Juni [1696]. [61.69.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:64. MICHEL ANGELO FARDELLA AN LEIBNIZ Padua, 20. Juni [1696]. [61.69.] Ill^#'m^#'o Sig^#'r^#'e, Sig^#'r^#'e, mio Padron Col^#'m^#'o Sul dubio che le lettere inviate da me a V. S. Ill^#'m^#'a possano essere smarrite, torno con questa a darle parte di quanto l' hò per le mie participato. Dal mese di N...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>