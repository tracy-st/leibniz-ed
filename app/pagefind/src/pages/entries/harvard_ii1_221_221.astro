---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii1_221",
  "series": "Band II 1 (1663 - 1685)",
  "seq": 221,
  "text": "<p> [[688.12]] <b>200. JOHANN VAGETIUS AN LEIBNIZ</p>\n<p> [[688.13]] Hamburg, 21. Februar (3. März) 1679. [180.211.]</b></p>\n<p> [[688.20]] Hamb. 21. Febr. 1679. </p>\n<p> [[688.21]] Jungiana quod attinet, ut postulatis tuis satisfaciam, <i>Vermium</i> <i>historia</i> paratur editioni, hac\n[[688.22]] aestate, ut spero, lucem visura. Fogelii <i>Lexicon Philosophicum</i> jam in eo est, ut praelum subeat.\n[[688.23]] Concinnatum et ipsum maximam partem ex Jungianis hypomnematibus. </p>\n<p> [[688.24]] De caeteris quoque, nil dissimulans, ut respondeam, Demonstrationi resolvendae et dijudicandae\n[[688.25]] Librum IV^#'t^#'u^#'m <i>Log. Hamb.</i> cum Generali Formae resolvendae doctrina conjunctum\n[[689.1]] scio ego sufficere. Heureticam autem Logicae inserendam esse affirmare non ausim. In Axiomatum\n[[689.2]] definitione subintelligendum est genus. Propositio Principalis per se i.e. ex terminis\n[[689.3]] vera i.e. una voce Principium. Ita quod de ideis mones jam in ea deprehenditur inclusum. </p>\n<p> [[689.4]] Inductio vero primus est sciendi gradus, quod vel <i>Geometria</i> Jungii <i>Empirica</i> et Demonstrationum\n[[689.5]] Ecthesis [ostendunt], ubi ad singulas voces inductio ex individuo universalitatem\n[[689.6]] concludit, et indubitato animadvertit, se non falli. Hac certitudine majorem qui quaerit, fixos\n[[689.7]] homini limites quod transit, mihi videtur quaerere. In Cautionibus tamen (quod <i>Log. Hamb.</i>\n[[689.8]] monet) Argus oportet ut sit Inductor. Ita demum deprehensus isto pacto assensus est is ipse\n[[689.9]] certitudinis gradus qui jure scientia audit. </p>\n<p> [[689.10]] Ex definitionibus vero tantum abest, ut solis statim demonstrentur axiomata, ut definitiones\n[[689.11]] ne propositiones quidem sint in demonstratione mentali, cum definitum et definitio eadem\n[[689.12]] apprehendantur notione. </p>\n<p> [[689.13]] Demonstratio autem (more auctoribus recepto) Jungio describitur, qualis in Euclide occurrit,\n[[689.14]] ubi cum axiomatum demonstrationes nullae legantur, nec Jungius eas demonstrari (sc.\n[[689.15]] Mathematicis) docet. Argumentationes vero illas, quibus ex definitionibus illae deducuntur, si\n[[689.16]] non sint identicae, i.e. nugatoriae, apodicticas quidem, non tamen apodixes appellat, partem\n[[689.17]] demonstrationis in oratione externa eas agnoscens, non integram demonstrationem. </p>\n<p> [[689.18]] Protonoëmata secundum quid sunt quaecunque coram sensibus aut intellectui sunt exhibita.\n[[689.19]] Absolute talia inventa nondum sunt. Cogitatio haudquaquam est prima notio. Involvit\n[[689.20]] enim cogitantem et respectum inhaerentis ad subjectum, imo effecti ad causam. Ex horum enim\n[[689.21]] locorum Maximis concludit, qui concludit: Cogito Ergo sum. </p>\n<p> [[689.22]] Haec de rudimento literarum illarum qualia inveni volui transscribere, multis quidem\n[[689.23]] modis tunc mutata, sed quos revocare in memoriam occupatior nunc non possum, nec actum\n[[689.24]] agere. </p>\n",
  "number": "200.",
  "title": "JOHANN VAGETIUS AN LEIBNIZ",
  "date": "Hamburg, 21. Februar (3. März) 1679. [180.211.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:200. JOHANN VAGETIUS AN LEIBNIZ Hamburg, 21. Februar (3. März) 1679. [180.211.] Hamb. 21. Febr. 1679. Jungiana quod attinet, ut postulatis tuis satisfaciam, Vermium historia paratur editioni, hac aestate, ut spero, lucem visura. Fogelii Lexicon Philosophicum jam in eo est, ut praelum subeat. Concinn...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_ii1_221","series":"Band II 1 (1663 - 1685)","seq":221,"text":"<p> [[688.12]] <b>200. JOHANN VAGETIUS AN LEIBNIZ</p>\n<p> [[688.13]] Hamburg, 21. Februar (3. März) 1679. [180.211.]</b></p>\n<p> [[688.20]] Hamb. 21. Febr. 1679. </p>\n<p> [[688.21]] Jungiana quod attinet, ut postulatis tuis satisfaciam, <i>Vermium</i> <i>historia</i> paratur editioni, hac\n[[688.22]] aestate, ut spero, lucem visura. Fogelii <i>Lexicon Philosophicum</i> jam in eo est, ut praelum subeat.\n[[688.23]] Concinnatum et ipsum maximam partem ex Jungianis hypomnematibus. </p>\n<p> [[688.24]] De caeteris quoque, nil dissimulans, ut respondeam, Demonstrationi resolvendae et dijudicandae\n[[688.25]] Librum IV^#'t^#'u^#'m <i>Log. Hamb.</i> cum Generali Formae resolvendae doctrina conjunctum\n[[689.1]] scio ego sufficere. Heureticam autem Logicae inserendam esse affirmare non ausim. In Axiomatum\n[[689.2]] definitione subintelligendum est genus. Propositio Principalis per se i.e. ex terminis\n[[689.3]] vera i.e. una voce Principium. Ita quod de ideis mones jam in ea deprehenditur inclusum. </p>\n<p> [[689.4]] Inductio vero primus est sciendi gradus, quod vel <i>Geometria</i> Jungii <i>Empirica</i> et Demonstrationum\n[[689.5]] Ecthesis [ostendunt], ubi ad singulas voces inductio ex individuo universalitatem\n[[689.6]] concludit, et indubitato animadvertit, se non falli. Hac certitudine majorem qui quaerit, fixos\n[[689.7]] homini limites quod transit, mihi videtur quaerere. In Cautionibus tamen (quod <i>Log. Hamb.</i>\n[[689.8]] monet) Argus oportet ut sit Inductor. Ita demum deprehensus isto pacto assensus est is ipse\n[[689.9]] certitudinis gradus qui jure scientia audit. </p>\n<p> [[689.10]] Ex definitionibus vero tantum abest, ut solis statim demonstrentur axiomata, ut definitiones\n[[689.11]] ne propositiones quidem sint in demonstratione mentali, cum definitum et definitio eadem\n[[689.12]] apprehendantur notione. </p>\n<p> [[689.13]] Demonstratio autem (more auctoribus recepto) Jungio describitur, qualis in Euclide occurrit,\n[[689.14]] ubi cum axiomatum demonstrationes nullae legantur, nec Jungius eas demonstrari (sc.\n[[689.15]] Mathematicis) docet. Argumentationes vero illas, quibus ex definitionibus illae deducuntur, si\n[[689.16]] non sint identicae, i.e. nugatoriae, apodicticas quidem, non tamen apodixes appellat, partem\n[[689.17]] demonstrationis in oratione externa eas agnoscens, non integram demonstrationem. </p>\n<p> [[689.18]] Protonoëmata secundum quid sunt quaecunque coram sensibus aut intellectui sunt exhibita.\n[[689.19]] Absolute talia inventa nondum sunt. Cogitatio haudquaquam est prima notio. Involvit\n[[689.20]] enim cogitantem et respectum inhaerentis ad subjectum, imo effecti ad causam. Ex horum enim\n[[689.21]] locorum Maximis concludit, qui concludit: Cogito Ergo sum. </p>\n<p> [[689.22]] Haec de rudimento literarum illarum qualia inveni volui transscribere, multis quidem\n[[689.23]] modis tunc mutata, sed quos revocare in memoriam occupatior nunc non possum, nec actum\n[[689.24]] agere. </p>\n","number":"200.","title":"JOHANN VAGETIUS AN LEIBNIZ","date":"Hamburg, 21. Februar (3. März) 1679. [180.211.]"}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>