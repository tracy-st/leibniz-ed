---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_ii2_32",
  "series": "Band II 2 (1686 - 1694)",
  "seq": 32,
  "text": "<p> [[144.12]] <b>33. LEIBNIZ AN VINCENT PLACCIUS</p>\n<p> [[144.13]] [Hannover, 20. Januar 1687.] [29.39.]</b></p>\n<p> [[145.1]] Ex mea responsione. </p>\n<p> [[145.2]] Perplacent quae Logicam et Analyticam artem non tantum in se reductam sed et usibus\n[[145.3]] publicis adhibitam tractant, quod revera faciunt JC^#'t^#'i cum de probationibus praesumtionibus\n[[145.4]] interpretationibus, indiciis, Medicique cum de signis [indicantibus] et contra indicantibus\n[[145.5]] agunt. Habebam olim in animo componere aliquid de gradibus probabilitatis aestimandis quam\n[[145.6]] logicae partem maxime practicam et in usu versantem mirabar negligi. Omnes in ore habent,\n[[145.7]] argumenta non numero sed pondere esse aestimanda. Sed quis stateram dedit qua argumenta\n[[145.8]] atque indicia inter se mutuo pugnantia, ponderentur, ut eligamus quod ex datis maxime\n[[145.9]] probabile est[?] Considero autem (Mathematicorum imitatione) certitudinem seu veritatem ut\n[[145.10]] totum, et probabilitates ut partes, ita ut sese habeant probabilitates ad veritatem, quemadmodum\n[[145.11]] anguli acuti ad rectum. Sint duo <i>A</i> et <i>B</i> sitque <i>B</i> duplo probabilius quam <i>A</i> ponamus jam\n[[145.12]] alterutrum eorum esse verum. Hoc posito dico probabilitatem ipsius <i>A</i> esse considerandam, ut\n[[145.13]] tertiam partem veritatis, probabilitatem vero ipsius <i>B</i>, ut veritatis duas tertias. Ambae autem\n[[145.14]] simul alternative componunt totam veritatem. Hoc autem intelligendum est quoad effectum,\n[[145.15]] non quasi veritas ipsa in se partes habeat [falsitatis]. Exempli causa si homines <i>L</i> et <i>M</i> ad\n[[145.16]] summam 30 ex eodem capite jus sibi tribuant, neuterque prae altero sit in possessione, aut ex\n[[145.17]] alio capite praeferendus, et duplo probabilius sit ipsum [<i>M</i> quam <i>L</i>] revera hoc jure frui;\n[[145.18]] aequitatis naturalis foret divisionem in ea quam dixi proportione fieri. Ubi tamen praesumtiones\n[[145.19]] a probabilitatibus caute sunt distinguendae. Sed licet judicibus talis divisio rerum incertarum\n[[145.20]] non sit in usu, idque merito, attamen haec consideratio saltem prodesse potest ad aestimanda\n[[145.21]] indicia et probabilitatum gradus, ut sciamus quorsum potius sit inclinandum. </p>\n<p> [[145.22]] Marq. Gud. saluto missurum me illi quasdam inscriptiones ab Abbate quodam Italo. </p>\n<p> [[145.23]] P. S. Hamburgi urbe [populosissima] (quam Ser^#'m^#'u^#'s Rudolphus Augustus Lutetiam nostram\n[[145.24]] appellat) multi haud dubie agunt omnis generis eruditi, curiosi, artifices in variis excellentes.\n[[145.25]] Horum quasi Catalogum aliquem per otium fieri perutile, nec opinor, injucundum foret. </p>\n<p> [[145.26]] Indicem fasciculorum Jungianorum a Vagetio desideravi. </p>\n",
  "number": "33.",
  "title": "LEIBNIZ AN VINCENT PLACCIUS",
  "date": "[Hannover, 20. Januar 1687.] [29.39.]"
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:33. LEIBNIZ AN VINCENT PLACCIUS [Hannover, 20. Januar 1687.] [29.39.] Ex mea responsione. Perplacent quae Logicam et Analyticam artem non tantum in se reductam sed et usibus publicis adhibitam tractant, quod revera faciunt JC^#'t^#'i cum de probationibus praesumtionibus interpretationibus, indiciis,...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers
      const lineNumberMatch = trimmedLine.match(/\[\[(\d+\.\d+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[\d+\.\d+\]\]/g, '')
        .replace(/<\/?[^>]+(>|$)/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entry && entry.text) {
      const processed = processTextForTranslation(entry.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>