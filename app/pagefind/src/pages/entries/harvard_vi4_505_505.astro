import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_505",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 505,
  "text": "[[2212.11]] <b>397.  Dialogus inter Theologum et Misosophum [2. Hälfte 1678 bis 1. Hälfte 1679 (?)]</b>\n [[2212.12]] <tab/>[2. Hälfte 1678 bis 1. Hälfte 1679 (?)]\n[[2213.1]] <tit2><b>Dialogus inter Theologum et Misosophum </b></tit2> </p>\n<p> [[2213.2]] M. Nunquam ne desinetis o Theologi cum ratione insanire, quos potius cum fide\n[[2213.3]] sapere deceret. </p>\n<p> [[2213.4]] T. Desinemus ratione uti cum Deus sapiens aut homo rationalis esse cessabit. </p>\n<p> [[2213.5]] M. <i>Sapientia hominis stultitia est coram Deo</i>, et ratio hominis in divinis errandi\n[[2213.6]] potius quam sapiendi instrumentum est. </p>\n<p> [[2213.7]] T. Superba sapientia apud Deum stultitia est, a Deo enim confunditur, qui humiliat\n[[2213.8]] superbos: et qui scrutari mysteria ratione volet, a gloria opprimetur ac fulgore illo nimio\n[[2213.9]] occaecabitur, sed qui Deum sincero pectore quaerit, huic Deus rationem illuminat, ut\n[[2213.10]] videat mirabilia ejus; et quemadmodum solem non recta sed aut in aqua aut per vitrum\n[[2213.11]] coloratum intuemur; ita, quem aut pius affectus, aut defendendae fidei necessitas ad\n[[2213.12]] profundiorem rerum divinarum contemplationem vocat, is non sibi rationis oculos effodiet,\n[[2213.13]] ita enim nihil videbit, sed per mediam scripturam sacram (: cujus interiectu nimia\n[[2213.14]] illa radiorum coelestium efficacia nostrae imbecillitati attemperatur :) velut per velum\n[[2213.15]] interpositum in sanctum sanctorum introspiciet. Hoc autem velum tum demum levabitur,\n[[2213.16]] cum Deum non amplius in speculo vel aenigmate sed de facie ad faciem contuebimur. </p>\n<p> [[2213.17]] M. Putas ergo rationem cum fide conjungendam. </p>\n<p> [[2213.18]] T. Quid ni? Si quidem ipsa fides ratione nobis persuadetur: qua enim alia praerogativa\n[[2213.19]] Mahumetanis superiores sumus? </p>\n<p> [[2213.20]] M. Nos vera miracula habemus, non illi. </p>\n<p> [[2213.21]] T. Multa ratiocinatione opus est ad probanda miracula, quae non vidimus; imo etsi\n[[2213.22]] his oculis nostris videamus, multo tamen examine indigemus ne decipiamur: praeterea ex\n[[2214.1]] Scriptura nosti miracula ipsa alio rursus indigere criterio, nempe doctrina: nam et\n[[2214.2]] Antichristus faciet signa deceptura, si possibile esset, etiam electos. Moses dixit prophetae\n[[2214.3]] legi contraria docenti nec si signa edat credendum esse. </p>\n<p> [[2214.4]] M. Concedo miracula ad normam doctrinae esse exigenda: sed doctrinae, inquam\n[[2214.5]] revelatae, non vero naturalis. </p>\n<p> [[2214.6]] T. Nonne ipsa revelatio prima pendet a miraculis? </p>\n<p> [[2214.7]] M. Fateor. </p>\n<p> [[2214.8]] T. Ergo saltem prima illa miracula non ad aliam revelationem priorem exigi debent\n[[2214.9]] ... Quid respondes ad hoc? Cur haeres? </p>\n<p> [[2214.10]] M. Nescio quomodo me decepisti atque in arctum redegisti. </p>\n<p> [[2214.11]] T. Magis ingenue facies si te non a me sed a te ipso deceptum fatearis. </p>\n<p> [[2214.12]] M. Tam fortes sunt rationes tuae, ut cogerer tibi assentiri, nisi didicissem in divinis\n[[2214.13]] omnes ratiocinationes debere esse suspectas. </p>\n<p> [[2214.14]] T. Omnes ratiocinationes etiam in humanis suspectae sunt, id est non admittendae\n[[2214.15]] ante diligens examen, praesertim in re gravi. </p>\n<p> [[2214.16]] M. Et si nihil jam succurrat quod opponere possim superiori illi ratiocinationi tuae,\n[[2214.17]] attamen nec tu habebis quod regeras meae. </p>\n<p> [[2214.18]] T. Cuinam? </p>\n<p> [[2214.19]] M. Quod scilicet admissa analysi fidei in rationem, omnis fides futura sit humana\n[[2214.20]] non divina. </p>\n<p> [[2214.21]] T. Gravissimi autores qui de analysi fidei scripsere, optime satisfecerunt huic difficultati.\n[[2214.22]] Alia enim est analysis fidei humana quoad motiva credibilitatis, quae fit in\n[[2214.23]] historiam et rationem historias examinantem et confirmantem; alia est analysis fidei\n[[2214.24]] divina, quae fit in Spiritus Sancti operationem in cordibus nostris efficacem. </p>\n<p> [[2215.1]] M. At sufficit ille internus Dei sermo, sine rationibus, multi enim in simplicitate\n[[2215.2]] cordis sui credunt, etsi nullas credendi rationes sciant. </p>\n<p> [[2215.3]] T. Fateor multos, singulari Dei benignitate omnium sese captui accomodante, veram\n[[2215.4]] fidem tenere sine ullis rationibus persuadentibus; et hos salvos esse posse: misera tamen\n[[2215.5]] esset religio nostra si argumentis careret, nec Mahumetanae aut paganae praestaret ita\n[[2215.6]] enim nec ratio petentibus reddi nec fides contra impietatem aut etiam scrupulos qui saepe\n[[2215.7]] pios anxios habent defendi posset. </p>\n<p> [[2215.8]] M. Est aliquid quod dicis. Ego tamen putaveram tutius esse omnem ratiocinationem\n[[2215.9]] ablegare e Theologia: credebam enim humana principia in divinis nihil certi probare. </p>\n<p> [[2215.10]] T. Si hoc esset, nec Dei existentia probaretur rationibus. </p>\n<p> [[2215.11]] M. Etiam Dei existentia probanda est revelationibus et miraculis. </p>\n<p> [[2215.12]] T. Sed dixi Tibi revelationes et miracula per rationem examinanda esse. </p>\n<p> [[2215.13]] M. Sed quid respondes huic argumento <b>quod principia humana non sunt\n[[2215.14]] accommodata rebus divinis.</i> </p>\n<p> [[2215.15]] T. Respondeo dari principia communia rebus divinis et humanis, et hoc optime\n[[2215.16]] observarunt Theologi: principia quidem physica fateor sunt humana tantum, verbi gratia\n[[2215.17]] quod ferrum non natat in aqua, quod virgo non parit: nam per absolutam Dei potentiam\n[[2215.18]] quae est supra naturam, contrarium effici potest; sed principia metaphysica sunt communia\n[[2215.19]] divinis et humanis, quia agunt de Veritate et de Ente in genere, quod est commune\n[[2215.20]] Deo et creaturis. Tale principium metaphysicum est: non posse idem simul esse et non\n[[2215.21]] esse: Totum esse majus parte. Item, <b>Principia logica</b> seu formae syllogisticae quae\n[[2215.22]] etiam Deus atque angeli vera esse admittent. </p>\n<p> [[2215.23]] M. At Deus et Angeli non indigent logica. </p>\n<p> [[2215.24]] T. Certe Deus Logica non utitur, angeli fortasse, Syllogismis non indigent, non\n[[2215.25]] tamen ideo eos rejicient: ego non utor arithmetica, per calculos quia scio omnia melius\n[[2215.26]] calamo absolvi, non ideo tamen calculos rejicio, aut pro erroneis habeo. </p>\n<p> [[2216.1]] M. Nunquam tibi concedam nostra principia Metaphysica esse apud Deum vera. </p>\n<p> [[2216.2]] T. Ergone illud principium (non posse idem simul esse et non esse) non valet apud\n[[2216.3]] Deum aut in divinis? </p>\n<p> [[2216.4]] M. Non utique. </p>\n<p> [[2216.5]] T. Nemo Sanctorum Patrum nemo eruditorum Theologorum Tibi assentietur. </p>\n<p> [[2216.6]] M. Si non eruditi, saltem pii a meis partibus stabunt. </p>\n<p> [[2216.7]] T. Vide quam pia sint quae dicis. Sublato e divinis principio illo (de contradictoriis\n[[2216.8]] simul non admittendis) poterimus simul admittere et rejicere Deitatem vel Trinitatem;\n[[2216.9]] poterimus simul eodem respectu esse pii et Athei, Catholici et Ariani. </p>\n<p> [[2216.10]] M. Ego credebam <i>non</i> <i>esse apud Deum impossibile ullum verbum</i>, ergo nec contradictoria\n[[2216.11]] Deo impossibilia erunt. </p>\n<p> [[2216.12]] T. Si nullum verbum Deo impossibile est, etiam possibile illi erit, se destruere;\n[[2216.13]] peccare, et alia id genus. </p>\n<p> [[2216.14]] M. Omnia sunt Deo possibilia, exceptis illis quae perfectioni ejus contraria sunt. </p>\n<p> [[2216.15]] T. Pulchre, optime; sed contradictoria quoque ejus perfectioni contraria sunt, facerent\n[[2216.16]] enim Deum ineptum, ac simul veracem, et falsa dicentem; simul scopum suum\n[[2216.17]] assequentem, et eo excidentem. </p>\n<p> [[2216.18]] M. Admittam (quoniam ita urges) hoc principium contradictionis etiam in divinis;\n[[2216.19]] sed non admittam quod nos bene judicare possimus in divinis quaenam sint contradictoria. </p>\n<p> [[2216.21]] T. Si habemus oculos et memoriam possumus etiam judicare de contradictione. Nam\n[[2216.22]] saltem requiritur ut idem sit subjectum et praedicatum propositionis contradictoriae, id\n[[2216.23]] est, ut eadem sint utrobique verba et idem verborum saltem sensus. An eadem sint\n[[2216.24]] utrobique verba judicabunt oculi, an idem utrobique per verba intelligamus, memoria sive\n[[2216.25]] conscientia nostra nobis dicet, ita ut attentione tantum opus sit. </p>\n<p> [[2217.1]] M. Admittam id fortasse in ratiocinationibus facillimis, ubi statim apparet contradictio,\n[[2217.2]] sed non in ratiocinationibus difficilioribus. </p>\n<p> [[2217.3]] T. In difficilioribus majore tantum opus attentione; et longa syllogismorum catena\n[[2217.4]] non minus certo examinari potest, quam breve argumentum: tantum enim opus est,\n[[2217.5]] unumquemque syllogismum singulatim examinari secundum materiam et formam: itaque\n[[2217.6]] solummodo majus tempus majorque patientia requiritur in pluribus syllogismis quam in\n[[2217.7]] paucis. </p>\n<p> [[2217.8]] M. At mihi indignum videtur logicam tantum valere in divinis. </p>\n<p> [[2217.9]] T. An Grammaticam logica digniorem putas? et constat tamen quanta sit Grammaticae\n[[2217.10]] in textu sacro explicando utilitas. Et vero si syllogismos rejicis, omnes rationes\n[[2217.11]] rejicis, sunt enim semper rationes omnes syllogismi saltem imperfecti, ut Enthymemata\n[[2217.12]] in quibus propositio aliqua vel signum subintelligitur: imperfecti autem non possunt esse\n[[2217.13]] certiores perfectis. Denique formae syllogismorum ex illo principio contradictionis a te\n[[2217.14]] admisso mathematica plane certitudine demonstrantur. </p>\n<p> [[2217.15]] M. Possumus salvari sine logica. </p>\n<p> [[2217.16]] T. Fateor nam possumus etiam salvari sine rationibus et possumus ratiocinari sine\n[[2217.17]] syllogismis: non tamen possumus fidei fundamenta tenere ac tueri sine rationibus; nec in\n[[2217.18]] rebus valde difficilibus facile eruere veritatem, aut convincere pertinacem adversarium,\n[[2217.19]] sine logicis artibus. </p>\n<p> [[2217.20]] M. Sancti patres spreverunt subtilem illam in Theologicis disserendi rationem. </p>\n<p> [[2217.21]] T. Aliqui, non omnes. Nam S. Augustinus potest jure theologiae Scholasticae parens\n[[2217.22]] appellari, ex quo Magister Sententiarum et D. Thomas pleraque hausere. </p>\n<p> [[2217.23]] M. Qui maxime ratiocinantur maxime absunt a fide. </p>\n<p> [[2217.24]] T. Aliquando qui maxime, nunquam qui optime. </p>\n<p> [[2218.1]] M. Tutissimum est simpliciter credere, quod Ecclesia credit. Nosti historiolam illam\n[[2218.2]] Bellarmini de eo qui in agone cum diabolo disputabat. </p>\n<p> [[2218.3]] T. Jocaris opinor, nam historiola illa ridicula est. Nec puto te eodem quo ille circulo\n[[2218.4]] usurum: credo quod Ecclesia credit, et Ecclesia credit quod ego. Necesse est praeterea\n[[2218.5]] Ecclesiam stabilire firmis rationibus. </p>\n<p> [[2218.6]] M. Mihi semper illorum placuit modestia, qui profitentur se sine ullo examine\n[[2218.7]] humiliter credere. </p>\n<p> [[2218.8]] T. Crede mihi illos saepe qui serio ita loquuntur esse aut valde simplices (quibus\n[[2218.9]] Deus, cum fecerint quod in se est, nihilo minus veram fidem dare potest) aut esse veros\n[[2218.10]] Hypocritas Atheosque occultos. Ita Pomponatius loqui solebat et Vaninus qui objectionibus\n[[2218.11]] respondere hoc effugio declinantes, causam Dei prodebant. Cum enim graves\n[[2218.12]] difficultates attulissent simulabant se illis non obstantibus autoritati Ecclesiae cedere.\n[[2218.13]] Nullus major inimicus est religionis et pietatis, quam qui fidem rationi contrariam asserit,\n[[2218.14]] quod eam apud cordatos prostituere est. Etiam Pontifices Maximi et Concilia et Facultates\n[[2218.15]] Theologicae, animadverso simulatorum artificio, prohibuerunt ne duplices veritates\n[[2218.16]] aliae divinae, aliae humanae sibi pugnantes statueruntur. </p>\n<p> [[2218.17]] M. Prope persuades ut credam rationem humanam rite assertam, nunquam fidei\n[[2218.18]] divinae revelatae pugnare nec verbum Dei scriptum aut traditum a naturali lege cordibus\n[[2218.19]] nostris cum nasceremur (Paulo teste) insculpta dissentire. </p>\n<p> [[2218.20]] T. Quoniam Te ad moderatiora rediisse video, vicissim tibi nonnihil concedam ut\n[[2218.21]] facilius concordes dextras jungamus: ut enim ingenia ad meditandum facta, et vero\n[[2218.22]] pietatis Zelo ardentia a divinarum rerum contemplatione minime avocanda censeo, possunt\n[[2218.23]] enim praeclara erui, quibus et excitetur pietas et fides defendatur ac propagetur, et\n[[2218.24]] gloria Dei amplificetur; ita vicissim minime mihi placent jejuni illi ratiocinatores ac\n[[2218.25]] miseri disputatores qui nihil profundi nihil solidi habent, sed inutilibus nugis insanisque\n[[2218.26]] litibus et Veritatem amittunt altercantes et Caritatem laedunt. Hos satius erat rustica fide\n[[2219.1]] salvari, quam ambitiosa, sed inani ac tinnula theologia damnari: qui vero veris rationibus\n[[2219.2]] ac profundis contemplationibus ad liquidam veritatis notitiam venere, horum fides et\n[[2219.3]] stabili fundamento nititur et efficaci caritate exsplendescit: itaque non a solida ratione,\n[[2219.4]] sed inani sophistica impostorum nobis caveamus et illud pro certo credamus: neminem in\n[[2219.5]] terris coelo propiorem esse quam qui mysticae theologiae profundis veritatibus imbutus,\n[[2219.6]] divini amoris sensu gaudet praesertim si felicitatem suam etiam in alios diffundat; illud\n[[2219.7]] enim pro demonstrato habendum est, ut quisque in cognitione atque amore Dei (qui ex\n[[2219.8]] cognitione vera certo sequitur) longius in hac mortalitate progressus fuerit ac majoris\n[[2219.9]] boni causa extiterit, ita illic majore gloria perennaturum. </p>\n",
  "number": "397.",
  "title": "Dialogus inter Theologum et Misosophum",
  "date": "[2. Hälfte 1678 bis 1. Hälfte 1679 (?)]"
};
