---
import Layout from '../../layouts/Layout.astro';

const entry = {
  "id": "harvard_vi4_404",
  "series": "Band VI 4 (1677 - 1690)",
  "seq": 404,
  "text": "[[1696.1]] <b>335₁.  Principia philosophiae, pars secunda, Randbemerkungen PRINCIPIA PHILOSOPHIAE, PARS SECUNDA, RANDBEMERKUNGEN </p>\n<p> [[1696.2]] [XLVII / 8, 68] Secundo, si <i>B</i> esset tantillo major quam <i>C</i>, <Fn><i>Am Rande</i>: Miror <b>casum ommissum</b> cum corpora inaequalia inaequalibus celeritatibus in oppositas partes moventur.</Fn> caeteris positis ut prius,\n[[1696.3]] tunc solum <i>C</i> reflecteretur, et utrumque versus sinistram eadem celeritate moveretur. </p>\n<p> [[1696.4]] [XLVIII / 8, 68] Tertio, <Fn><i>Am Rande</i>: Malebranchius tres priores regulas approbat. </Fn> si mole essent aequalia, sed <i>B</i> tantillo celerius moveretur\n[[1696.5]] quam <i>C</i>, non tantum ambo pergerent moveri versus sinistram, sed etiam transferretur ex\n[[1696.6]] <i>B</i> in <i>C</i>, media pars celeritatis qua hoc ab illo excederetur: hoc est, si fuissent prius sex\n[[1696.7]] gradus celeritatis in <i>B</i>, et quatuor tantum in <i>C</i>, post mutuum occursum unumquodque\n[[1696.8]] tenderet versus sinistram, cum quinque gradibus celeritatis. </p>\n<p> [[1696.9]] [XLIX / 8, 68] Quarto, <Fn><i>Am Rande</i>: Malebranchius vult corpora simul ire post concursum, eadem qua ante, motus quantitate.</Fn> si corpus <i>C</i> plane quiesceret, essetque paulo majus quam <i>B</i>,\n[[1696.10]] quacunque cum celeritate <i>B</i> moveretur versus <i>C</i>, nunquam ipsum <i>C</i> moveret; sed ab eo\n[[1696.11]] repelleretur in contrariam partem: quia corpus quiescens magis resistit magnae celeritati\n[[1696.12]] quam parvae, idque pro ratione excessus unius supra alteram; et idcirco semper major\n[[1696.13]] esset vis in <i>C</i> ad resistendum, quam in <i>B</i> ad impellendum. </p>\n<p> [[1696.14]] [L / 8, 69] Quinto, <Fn><i>Am Rande</i>: Hanc approbat Malebranchius.</Fn> si corpus quiescens <i>C</i>, esset minus quam <i>B</i>, tunc quamtumvis\n[[1696.15]] tarde <i>B</i> versus <i>C</i> moveretur, illud secum moveret, partem scilicet sui motus ei talem\n[[1696.16]] transferendo, ut ambo postea aeque celeriter moverentur: nempe si <i>B</i> esset duplo majus\n[[1696.17]] quam <i>C</i>, transferret ipsi tertiam partem sui motus, quia una illa tertia pars tam celeriter\n[[1696.18]] moveret corpus <i>C</i>, quam duae aliae residuae, corpus <i>B</i> duplo majus. </p>\n<p> [[1696.19]] [LI / 8, 69] Sexto, <Fn><i>Am Rande</i>: Malebranchius vult ambo simul pergere dimidia celeritate.</Fn> si corpus <i>C</i> quiescens, esset accuratissime aequale corpori <i>B</i>\n[[1696.20]] versus illud moto, partim ab ipso inpelleretur, et partim ipsum in contrariam partem\n[[1696.21]] repelleret: nempe si <i>B</i> veniret versus <i>C</i>, cum quatuor gradibus celeritatis, communicaret\n[[1696.22]] ipsi <i>C</i> unum gradum, et cum tribus residuis reflecteretur versus partem adversam. </p>\n<p> [[1696.23]] [LII / 8, 69] Denique, <Fn><i>Am Rande</i>: Malebranchius vult generaliter quicunque celeritatum excessus sit ambo post concursum simul ire, eadem qua ante celeritate.</Fn> si <i>B</i> et <i>C</i> versus eandem partem moverentur, <i>C</i> quidem\n[[1697.1]] tardius, <i>B</i> autem illud insequens celerius, ita ut ipsum tandem attingeret, essetque <i>C</i>\n[[1697.2]] majus quam <i>B</i>; sed excessus celeritatis in <i>B</i> esset major, quam excessus magnitudinis in\n[[1697.3]] <i>C</i>, tunc <i>B</i> transferret tantum de suo motu in <i>C</i>, ut ambo postea aeque celeriter, et in\n[[1697.4]] easdem partes moverentur. Si autem e contra excessus celeritatis in <i>B</i>, minor esset quam\n[[1697.5]] excessus magnitudinis in <i>C</i>, <i>B</i> in contrariam partem reflecteretur, et motum omnem suum\n[[1697.6]] retineret. </p>\n",
  "number": "335₁.",
  "title": "Principia philosophiae, pars secunda, Randbemerkungen",
  "date": null
};
---

<Layout title={`${entry.title || entry.id} - Leibniz Writings`}>
  <article data-pagefind-body>
    <header class="entry-header">
      <h1 data-pagefind-meta="title">{entry.title || entry.id}</h1>

      <div class="entry-meta">
        {entry.date && (
          <div class="meta-item">
            <strong>Date:</strong>
            <span data-pagefind-meta="date">{entry.date}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Series:</strong>
          <span data-pagefind-meta="series">{entry.series}</span>
        </div>

        {entry.number && (
          <div class="meta-item">
            <strong>Number:</strong>
            <span data-pagefind-meta="number">{entry.number}</span>
          </div>
        )}

        <div class="meta-item">
          <strong>Sequence:</strong>
          <span>{entry.seq}</span>
        </div>
      </div>
    </header>

    <!-- View Toggle -->
    <div class="view-controls">
      <button id="translation-view-btn" class="view-btn active">Translation View</button>
      <button id="scholarly-view-btn" class="view-btn">Scholarly View</button>
    </div>

    <div class="entry-content" data-pagefind-meta="excerpt:335₁. Principia philosophiae, pars secunda, Randbemerkungen PRINCIPIA PHILOSOPHIAE, PARS SECUNDA, RANDBEMERKUNGEN [XLVII / 8, 68] Secundo, si B esset tantillo major quam C, Am Rande: Miror casum ommissum cum corpora inaequalia inaequalibus celeritatibus in oppositas partes moventur. caeteris positis...">

      <!-- Translation-friendly continuous text -->
      <div id="translation-view" class="text-view active">
        <div class="translation-notice">
          <p><strong>📖 Translation View:</strong> Continuous text optimized for browser translation tools.</p>
        </div>
        <div class="continuous-text" translate="yes" lang="unknown" id="continuous-text">
          <!-- Will be populated by JavaScript -->
        </div>
        <div class="line-numbers-reference" id="line-numbers-ref">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Hidden data for JavaScript -->
      <script type="application/json" id="entry-data">
        {"id":"harvard_vi4_404","series":"Band VI 4 (1677 - 1690)","seq":404,"text":"[[1696.1]] <b>335₁.  Principia philosophiae, pars secunda, Randbemerkungen PRINCIPIA PHILOSOPHIAE, PARS SECUNDA, RANDBEMERKUNGEN </p>\n<p> [[1696.2]] [XLVII / 8, 68] Secundo, si <i>B</i> esset tantillo major quam <i>C</i>, <Fn><i>Am Rande</i>: Miror <b>casum ommissum</b> cum corpora inaequalia inaequalibus celeritatibus in oppositas partes moventur.</Fn> caeteris positis ut prius,\n[[1696.3]] tunc solum <i>C</i> reflecteretur, et utrumque versus sinistram eadem celeritate moveretur. </p>\n<p> [[1696.4]] [XLVIII / 8, 68] Tertio, <Fn><i>Am Rande</i>: Malebranchius tres priores regulas approbat. </Fn> si mole essent aequalia, sed <i>B</i> tantillo celerius moveretur\n[[1696.5]] quam <i>C</i>, non tantum ambo pergerent moveri versus sinistram, sed etiam transferretur ex\n[[1696.6]] <i>B</i> in <i>C</i>, media pars celeritatis qua hoc ab illo excederetur: hoc est, si fuissent prius sex\n[[1696.7]] gradus celeritatis in <i>B</i>, et quatuor tantum in <i>C</i>, post mutuum occursum unumquodque\n[[1696.8]] tenderet versus sinistram, cum quinque gradibus celeritatis. </p>\n<p> [[1696.9]] [XLIX / 8, 68] Quarto, <Fn><i>Am Rande</i>: Malebranchius vult corpora simul ire post concursum, eadem qua ante, motus quantitate.</Fn> si corpus <i>C</i> plane quiesceret, essetque paulo majus quam <i>B</i>,\n[[1696.10]] quacunque cum celeritate <i>B</i> moveretur versus <i>C</i>, nunquam ipsum <i>C</i> moveret; sed ab eo\n[[1696.11]] repelleretur in contrariam partem: quia corpus quiescens magis resistit magnae celeritati\n[[1696.12]] quam parvae, idque pro ratione excessus unius supra alteram; et idcirco semper major\n[[1696.13]] esset vis in <i>C</i> ad resistendum, quam in <i>B</i> ad impellendum. </p>\n<p> [[1696.14]] [L / 8, 69] Quinto, <Fn><i>Am Rande</i>: Hanc approbat Malebranchius.</Fn> si corpus quiescens <i>C</i>, esset minus quam <i>B</i>, tunc quamtumvis\n[[1696.15]] tarde <i>B</i> versus <i>C</i> moveretur, illud secum moveret, partem scilicet sui motus ei talem\n[[1696.16]] transferendo, ut ambo postea aeque celeriter moverentur: nempe si <i>B</i> esset duplo majus\n[[1696.17]] quam <i>C</i>, transferret ipsi tertiam partem sui motus, quia una illa tertia pars tam celeriter\n[[1696.18]] moveret corpus <i>C</i>, quam duae aliae residuae, corpus <i>B</i> duplo majus. </p>\n<p> [[1696.19]] [LI / 8, 69] Sexto, <Fn><i>Am Rande</i>: Malebranchius vult ambo simul pergere dimidia celeritate.</Fn> si corpus <i>C</i> quiescens, esset accuratissime aequale corpori <i>B</i>\n[[1696.20]] versus illud moto, partim ab ipso inpelleretur, et partim ipsum in contrariam partem\n[[1696.21]] repelleret: nempe si <i>B</i> veniret versus <i>C</i>, cum quatuor gradibus celeritatis, communicaret\n[[1696.22]] ipsi <i>C</i> unum gradum, et cum tribus residuis reflecteretur versus partem adversam. </p>\n<p> [[1696.23]] [LII / 8, 69] Denique, <Fn><i>Am Rande</i>: Malebranchius vult generaliter quicunque celeritatum excessus sit ambo post concursum simul ire, eadem qua ante celeritate.</Fn> si <i>B</i> et <i>C</i> versus eandem partem moverentur, <i>C</i> quidem\n[[1697.1]] tardius, <i>B</i> autem illud insequens celerius, ita ut ipsum tandem attingeret, essetque <i>C</i>\n[[1697.2]] majus quam <i>B</i>; sed excessus celeritatis in <i>B</i> esset major, quam excessus magnitudinis in\n[[1697.3]] <i>C</i>, tunc <i>B</i> transferret tantum de suo motu in <i>C</i>, ut ambo postea aeque celeriter, et in\n[[1697.4]] easdem partes moverentur. Si autem e contra excessus celeritatis in <i>B</i>, minor esset quam\n[[1697.5]] excessus magnitudinis in <i>C</i>, <i>B</i> in contrariam partem reflecteretur, et motum omnem suum\n[[1697.6]] retineret. </p>\n","number":"335₁.","title":"Principia philosophiae, pars secunda, Randbemerkungen","date":null}
      </script>

      <!-- Detailed scholarly view with line numbers -->
      <div id="scholarly-view" class="text-view">
        <div class="scholarly-notice">
          <p><strong>📚 Scholarly View:</strong> Original text with line number annotations preserved.</p>
        </div>
        <div class="annotated-text" id="annotated-text">
          {entry.text.split('\n').map(paragraph =>
            paragraph.trim() && <p set:html={paragraph} />
          )}
        </div>
      </div>

    </div>
  </article>

  <nav class="entry-navigation">
    <a href="/" class="back-link">← Back to Search</a>
  </nav>
</Layout>

<style>
  .entry-header {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border);
  }

  .entry-header h1 {
    color: var(--primary);
    font-size: 2rem;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .entry-meta {
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .meta-item strong {
    color: var(--text);
    min-width: 80px;
  }

  .meta-item span {
    color: var(--text-secondary);
    flex: 1;
  }

  .entry-content {
    margin-bottom: 40px;
  }

  .text-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 30px;
    line-height: 1.7;
  }

  .text-content :global(p) {
    margin-bottom: 16px;
  }

  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .text-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .entry-navigation {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }

  .back-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
  }

  /* View Toggle Controls */
  .view-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }

  .view-btn {
    background: transparent;
    border: 2px solid var(--border);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .view-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .view-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* Text Views */
  .text-view {
    display: none;
  }

  .text-view.active {
    display: block;
  }

  /* Translation View */
  .translation-notice, .scholarly-notice {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .continuous-text {
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    padding: 25px;
    line-height: 1.8;
    font-size: 16px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .line-numbers-reference {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 10px;
    background: var(--background);
    border-radius: 4px;
  }

  /* Scholarly View */
  .annotated-text {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
  }

  .text-line {
    display: flex;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 12px;
  }

  .line-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-width: 80px;
    flex-shrink: 0;
  }

  .line-num {
    background: var(--primary);
    color: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: monospace;
  }

  .line-content {
    flex: 1;
    line-height: 1.6;
  }

  .line-content :global(b) {
    font-weight: 600;
    color: var(--primary);
  }

  .line-content :global(i) {
    font-style: italic;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .entry-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .view-controls {
      flex-direction: column;
    }

    .text-line {
      flex-direction: column;
      gap: 6px;
    }

    .line-refs {
      min-width: auto;
    }
  }
</style>

<script>
  // Process text for translation view
  function processTextForTranslation(text) {
    if (!text) return { translationText: '', lineNumbers: [] };

    const lines = text.split('\n');
    let translationText = '';
    const lineNumbers = [];

    lines.forEach(line => {
      const trimmedLine = line.trim();
      if (!trimmedLine) return;

      // Extract line numbers using proper regex
      const lineNumberMatch = trimmedLine.match(/\[\[([0-9]+\.[0-9]+)\]\]/g);
      const extractedNumbers = lineNumberMatch ?
        lineNumberMatch.map(m => m.replace(/\[|\]/g, '')) : [];

      // Remove line number markers and HTML tags for continuous text
      let contentOnly = trimmedLine
        .replace(/\[\[[0-9]+\.[0-9]+\]\]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      if (contentOnly) {
        if (translationText) translationText += ' ';
        translationText += contentOnly;
        lineNumbers.push(...extractedNumbers);
      }
    });

    return {
      translationText: translationText.trim(),
      lineNumbers: lineNumbers
    };
  }

  // View switching and text processing
  document.addEventListener('DOMContentLoaded', () => {
    const translationBtn = document.getElementById('translation-view-btn');
    const scholarlyBtn = document.getElementById('scholarly-view-btn');
    const translationView = document.getElementById('translation-view');
    const scholarlyView = document.getElementById('scholarly-view');
    const continuousTextDiv = document.getElementById('continuous-text');
    const lineNumbersRef = document.getElementById('line-numbers-ref');

    // Get entry data from JSON script
    const entryDataScript = document.getElementById('entry-data');
    let entryData = null;
    if (entryDataScript) {
      try {
        entryData = JSON.parse(entryDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse entry data:', e);
      }
    }

    // Process the text for translation view
    if (continuousTextDiv && lineNumbersRef && entryData && entryData.text) {
      const processed = processTextForTranslation(entryData.text);
      continuousTextDiv.textContent = processed.translationText;

      if (processed.lineNumbers.length > 0) {
        lineNumbersRef.innerHTML = `<small><strong>Line numbers:</strong> ${processed.lineNumbers.join(', ')}</small>`;
      }
    }

    // View switching functionality
    if (translationBtn && scholarlyBtn && translationView && scholarlyView) {
      translationBtn.addEventListener('click', () => {
        translationBtn.classList.add('active');
        scholarlyBtn.classList.remove('active');
        translationView.classList.add('active');
        scholarlyView.classList.remove('active');
      });

      scholarlyBtn.addEventListener('click', () => {
        scholarlyBtn.classList.add('active');
        translationBtn.classList.remove('active');
        scholarlyView.classList.add('active');
        translationView.classList.remove('active');
      });
    }
  });
</script>