---
import Layout from '../layouts/Layout.astro';
import SearchInterface from '../components/SearchInterface.astro';
---

<Layout title="Leibniz Writings Search">
  <div class="hero">
    <h2>Search Leibniz Writings</h2>
    <p>Explore the philosophical works and correspondence of Gottfried Wilhelm Leibniz</p>
  </div>

  <SearchInterface />

  <div class="actions">
    <a href="/browse/" class="browse-link">Browse All Entries</a>
  </div>

  <div class="info">
    <p>This search interface allows you to explore Leibniz's writings from various series and collections.
    Use the search box above to find specific passages, topics, or references.</p>
  </div>
</Layout>

<style>
  .hero {
    text-align: center;
    margin-bottom: 40px;
  }

  .hero h2 {
    color: var(--primary);
    font-size: 2.5rem;
    margin-bottom: 16px;
  }

  .hero p {
    color: var(--text-secondary);
    font-size: 1.2rem;
    margin-bottom: 0;
  }

  .actions {
    text-align: center;
    margin: 30px 0;
  }

  .browse-link {
    background: var(--primary);
    color: white;
    padding: 12px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    display: inline-block;
    transition: background-color 0.2s;
  }

  .browse-link:hover {
    background: var(--primary-dark);
  }

  .info {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    margin-top: 40px;
    color: var(--text-secondary);
  }
</style>